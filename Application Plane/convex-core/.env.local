# Convex Core Environment Variables
# APPLICATION PLANE: Reactive UI state synchronization layer
# Convex Core is NOT the source of truth - it mirrors backend state

# Instance Configuration
CONVEX_INSTANCE_NAME=coresystem-local
CONVEX_INSTANCE_SECRET=926e27b2f16124ab7a47d9f62eb0a2244a9b1b61b9b5486c2bc9afddfc6579e9

# Storage Configuration
# Options: sqlite, postgres
CONVEX_STORAGE_TYPE=sqlite
CONVEX_SQLITE_PATH=/data/convex.db

# PostgreSQL (if using postgres storage type)
# DATABASE_URL=postgresql://postgres:postgres@aquatiq-postgres-local:5432/convex

# NATS Event Streaming (for syncing orgs and users)
NATS_URL=nats://host.docker.internal:4223
NATS_TOKEN=nats
NATS_SERVICE_NAME=convex-core
NATS_MAX_RECONNECT_ATTEMPTS=10

# AI Core Integration
AI_CORE_URL=http://ai-core:8000
AI_CORE_API_KEY=internal-service-key-change-me

# Org Core Integration (for validation)
ORG_CORE_URL=http://org-core-service:8080
ORG_CORE_API_KEY=internal-service-key-change-me

CONVEX_ADMIN_KEY=coresystem-local|01ab9f7f56630fa0dfe32fe8d7f67a6dda2e54fe97ec256f308cb32cb4c3a28679c0593539

# Auth Server Integration (for JWT validation and org membership)
AUTH_SERVER_URL=http://auth-service:3011
AUTH_SERVER_GRPC_URL=auth-service:50011
JWT_SECRET=your-jwt-secret-here
JWT_ISSUER=auth.coresystem.local
CONVEX_AUTH_ISSUER=http://localhost:3011/api/convex-auth
CONVEX_AUTH_JWKS_URL=http://auth-service:3011/api/convex-auth/jwks
CONVEX_AUTH_AUDIENCE=coresystem-convex
CONVEX_INTERNAL_SERVICE_KEY=change-me-internal-service-secret

# Logging
RUST_LOG=info
CONVEX_LOG_FORMAT=json

# Beacon (telemetry)
CONVEX_DISABLE_BEACON=false

# Node Environment
NODE_ENV=development

# URLs for frontend
NEXT_PUBLIC_CONVEX_URL=http://localhost:3000
CONVEX_BACKEND_URL=http://convex-core:3000
