# AFFiNE backend environment variables
# Copy this file to infrastructure/.env.affine and fill in your values.
# docker-compose reads this file automatically when it's named .env in the
# same directory, or you can pass it explicitly:
#   docker-compose --env-file .env.affine -f docker-compose.affine.yml up -d

# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=change_me_in_production

# ── AFFiNE server ─────────────────────────────────────────────────────────────
# Non-default port 47810 (avoids collision with common dev servers)
AFFINE_SERVER_EXTERNAL_URL=http://localhost:47810

# ── Your Next.js frontend ─────────────────────────────────────────────────────
# Add these to frontend/.env.local:
#
#   NEXT_PUBLIC_AFFINE_SERVER_URL=http://localhost:47810
#   NEXT_PUBLIC_AFFINE_WS_URL=ws://localhost:47810
#
# In production, point these at your deployed AFFiNE server URL.

# ── User sync (JWT secret shared between your backend and AFFiNE) ─────────────
# Your backend signs a short-lived JWT for each user.
# The Next.js API route /api/affine/auth/exchange verifies it and returns an
# AFFiNE session token.  Set both sides to the same secret.
USER_SYNC_JWT_SECRET=change_me_with_a_strong_random_value
