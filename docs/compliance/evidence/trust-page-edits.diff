+++ b/apps/Frontend Plane/verevonv3/apps/verevon-web/src/components/trust/trust-data.test.ts	
@@ -0,0 +1,146 @@
+import { execFileSync } from "node:child_process";
+import { existsSync, readFileSync } from "node:fs";
+import { dirname, join, resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+import { beforeAll, describe, expect, it } from "vitest";
+import { liveControls, subprocessors } from "./trust-data";
+import { recipientsNotListed } from "./trust-recipients";
+
+/**
+ * Drift test for the Trust Center sub-processor list.
+ *
+ * The egress scan (docs/compliance/evidence/tools/scan-egress.mjs) finds every vendor the code
+ * can reach. Each one must either be on a row of `subprocessors` (through `vendorIds`) or be
+ * listed in `recipientsNotListed` with a status and a reason, so a vendor cannot arrive in the
+ * code without a decision about this page. The register in
+ * docs/compliance/evidence/subprocessors-from-code.md holds the engineer's disposition of each
+ * vendor; the `pending` entries are the ones it proposes to list and the page does not yet show.
+ *
+ * Needs `git` and `node` on the path, and reads the repository's docs/compliance/evidence
+ * directory. Set TRUST_REPO_ROOT to point at a checkout from elsewhere.
+ */
+
+/** The number of vendors the register proposes to list that the page does not show. It may only go down. */
+const PENDING_BASELINE = 18;
+
+function repoRoot(): string {
+	const fromEnv = process.env.TRUST_REPO_ROOT;
+	if (fromEnv) return resolve(fromEnv);
+	let dir = dirname(fileURLToPath(import.meta.url));
+	for (;;) {
+		if (existsSync(join(dir, "docs", "compliance", "evidence", "tools", "scan-egress.mjs"))) return dir;
+		const parent = dirname(dir);
+		if (parent === dir) throw new Error("repository root not found; set TRUST_REPO_ROOT");
+		dir = parent;
+	}
+}
+
+function splitRow(line: string): string[] {
+	let text = line.trim();
+	if (text.startsWith("|")) text = text.slice(1);
+	if (text.endsWith("|") && !text.endsWith("\\|")) text = text.slice(0, -1);
+	const cells: string[] = [];
+	let current = "";
+	for (let index = 0; index < text.length; index += 1) {
+		const char = text[index];
+		if (char === "\\" && text[index + 1] === "|") {
+			current += "|";
+			index += 1;
+		} else if (char === "|") {
+			cells.push(current);
+			current = "";
+		} else {
+			current += char;
+		}
+	}
+	cells.push(current);
+	return cells.map((cell) => cell.trim());
+}
+
+function scannedVendorIds(root: string): string[] {
+	const script = join(root, "docs", "compliance", "evidence", "tools", "scan-egress.mjs");
+	const output = execFileSync(process.execPath, [script, "--json"], {
+		cwd: root,
+		encoding: "utf8",
+		maxBuffer: 256 * 1024 * 1024,
+	});
+	const parsed = JSON.parse(output) as { vendors: { id: string }[] };
+	return parsed.vendors.map((vendor) => vendor.id).sort();
+}
+
+function registerDispositions(root: string): Map<string, "LISTED" | "EXCLUDED"> {
+	const text = readFileSync(join(root, "docs", "compliance", "evidence", "subprocessors-from-code.md"), "utf8");
+	const found = new Map<string, "LISTED" | "EXCLUDED">();
+	for (const raw of text.split("\n")) {
+		const line = raw.replace(/\r$/, "");
+		if (!line.startsWith("| `")) continue;
+		const cells = splitRow(line);
+		if (cells.length !== 8) continue;
+		const id = cells[0].replace(/`/g, "");
+		const disposition = cells[6];
+		if (disposition === "LISTED") found.set(id, "LISTED");
+		else if (disposition.startsWith("EXCLUDED:")) found.set(id, "EXCLUDED");
+	}
+	return found;
+}
+
+const pageIds = new Set(subprocessors.flatMap((row) => row.vendorIds));
+const notListedIds = recipientsNotListed.map((entry) => entry.id);
+
+describe("Trust Center sub-processor list against the egress scan", () => {
+	let scanned: string[] = [];
+	let register = new Map<string, "LISTED" | "EXCLUDED">();
+	beforeAll(() => {
+		const root = repoRoot();
+		scanned = scannedVendorIds(root);
+		register = registerDispositions(root);
+	}, 60_000);
+
+	it("accounts for every vendor the scan finds", () => {
+		const unaccounted = scanned.filter((id) => !pageIds.has(id) && !notListedIds.includes(id));
+		expect(unaccounted, "vendors with neither a page row nor an entry in recipientsNotListed").toEqual([]);
+	});
+
+	it("names no vendor the scan no longer finds", () => {
+		const stale = [...pageIds, ...notListedIds].filter((id) => !scanned.includes(id));
+		expect(stale).toEqual([]);
+	});
+
+	it("puts each vendor in one place only", () => {
+		const both = notListedIds.filter((id) => pageIds.has(id));
+		const duplicated = notListedIds.filter((id, index) => notListedIds.indexOf(id) !== index);
+		expect(both).toEqual([]);
+		expect(duplicated).toEqual([]);
+	});
+
+	it("gives every row a vendor id and every not-listed entry a reason", () => {
+		for (const row of subprocessors) expect(row.vendorIds.length, row.name).toBeGreaterThan(0);
+		for (const entry of recipientsNotListed) expect(entry.reason.trim().length, entry.id).toBeGreaterThan(0);
+	});
+
+	it("keeps not-listed statuses in line with the register", () => {
+		for (const entry of recipientsNotListed) {
+			const disposition = register.get(entry.id);
+			expect(disposition, `${entry.id} is missing from the register`).toBeDefined();
+			expect(entry.status, entry.id).toBe(disposition === "LISTED" ? "pending" : "excluded");
+		}
+	});
+
+	it("lets the count of proposed-but-unlisted vendors only go down", () => {
+		const pending = recipientsNotListed.filter((entry) => entry.status === "pending").length;
+		expect(pending).toBeLessThanOrEqual(PENDING_BASELINE);
+	});
+});
+
+describe("Trust Center wording that the code contradicts", () => {
+	const text = JSON.stringify({ liveControls, subprocessors }).toLowerCase();
+	it.each([
+		["null ekstern trafikk", "search forwards queries to external engines through SearXNG"],
+		["null egress", "search forwards queries to external engines through SearXNG"],
+		["bekreftet på denne stien", "the region is a label and the deployment type is unset"],
+		["reserve modell-leverandør (fallback)", "Claude models are first-line for some intents"],
+		["eu-residens som standard", "the default intent path carries no residency floor"],
+	])("does not say %s", (phrase, why) => {
+		expect(text.includes(phrase), `wording came back: "${phrase}" (${why})`).toBe(false);
+	});
+});
