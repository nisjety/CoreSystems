# Currency Service Environment Configuration Template
# Copy this file to .env.production and fill in actual values
# NEVER commit .env.production to Git!

# =============================================================================
# Service Configuration
# =============================================================================
NODE_ENV=production
PORT=8000

# =============================================================================
# Google Cloud Platform: the data warehouse
# =============================================================================
# The rates are written to the warehouse project, dataset dw_staging_currency: tables Rate and
# Historyrates, views RatePowerBI and HistoryratesPowerBI. The Visma Dataform project reads them
# from there. The key must be a service account key with BigQuery Data Editor on that dataset and
# BigQuery Job User on the project.
GOOGLE_APPLICATION_CREDENTIALS=/app/gcp-credentials.json
GCP_PROJECT_ID=aquatiq-datavarehus
GCP_DATASET_ID=dw_staging_currency
# Where the dataset lives. Only used if the service has to create the dataset; Dataform cannot read
# a dataset in another location.
GCP_BQ_LOCATION=europe-north2

# =============================================================================
# Power BI SQL Server Configuration
# =============================================================================
POWERBI_SQL_SERVER=your-server.database.windows.net
POWERBI_SQL_DATABASE=your-database-name
POWERBI_SQL_USERNAME=your-username
POWERBI_SQL_PASSWORD=your-password
POWERBI_SQL_DRIVER=ODBC Driver 18 for SQL Server

# =============================================================================
# Currency API
# =============================================================================
CURRENCY_API_KEY=your-currency-api-key
CURRENCY_API_URL=https://api.exchangerate-api.com/v4/latest/

# =============================================================================
# Cache Configuration
# =============================================================================
CACHE_TTL=3600
CACHE_PATH=/app/cache
