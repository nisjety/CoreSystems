# Currency Service Configuration

# Service settings
CURRENCY_PORT=5004
CURRENCY_HOST=0.0.0.0

# API Keys
ABSTRACT_API_KEY=your_abstract_api_key_here

# Cache settings
CURRENCY_CACHE_DIR=/app/cache/rates
CACHE_TTL=3600

# Flask
FLASK_ENV=production
FLASK_DEBUG=false

# Logging
LOG_LEVEL=INFO

# Power BI SQL Server Configuration
POWERBI_SQL_SERVER=localhost
POWERBI_SQL_DATABASE=CurrencyPowerBI
POWERBI_SQL_USERNAME=sa
POWERBI_SQL_PASSWORD=YourStrongPassword123!
POWERBI_SQL_DRIVER=ODBC Driver 18 for SQL Server

# BigQuery: the data warehouse. The rates go to dataset dw_staging_currency in aquatiq-datavarehus.
# Rate is replaced on every sync, so use a scratch dataset (any name; the service creates it in
# GCP_BQ_LOCATION) for local experiments. Locally leave GOOGLE_APPLICATION_CREDENTIALS unset and
# log in with `gcloud auth application-default login`.
GCP_PROJECT_ID=aquatiq-datavarehus
GCP_DATASET_ID=dw_staging_currency
GCP_BQ_LOCATION=europe-north2
# GOOGLE_APPLICATION_CREDENTIALS=/app/gcp-credentials.json
