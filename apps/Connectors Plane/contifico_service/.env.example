# Contifico Service Environment Variables

# ============================================================
# Service Configuration
# ============================================================
CONTIFICO_PORT=5006
CONTIFICO_HOST=0.0.0.0
FLASK_ENV=development
FLASK_DEBUG=False
LOG_LEVEL=INFO

# ============================================================
# Contifico API Configuration
# ============================================================
# Get these from Contifico support
# Test credentials provided:
# - API_KEY: FrguR1kDpFHaXHLQwplZ2CwTX3p8p9XHVTnukL98V5U
# - API_TOKEN: 02914770-4a13-45f0-bfe3-c2e4666cdbcf
# - Test Account: Usuario: APIPRUEBA, Contraseña: APIPRUEBA
# - Documentation: http://contifico.github.io/

CONTIFICO_API_KEY=your_api_key_here
CONTIFICO_API_TOKEN=your_api_token_here
CONTIFICO_API_BASE_URL=https://api.contifico.com/sistema/api/v1

# ============================================================
# Database Configuration
# ============================================================
DATABASE_URL=postgresql://user:password@localhost:5432/aquatiq_contifico
POSTGRES_URL=postgresql://user:password@localhost:5432/aquatiq_contifico

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_CACHE_TTL=3600

# ============================================================
# GCP Configuration
# ============================================================
GCP_PROJECT_ID=prj-dw-dev
GCP_REGION=europe-west1
GOOGLE_APPLICATION_CREDENTIALS=/app/gcp-credentials.json
GCP_DATASET_ID=dw_1_staging_contifico
GCP_BUCKET_NAME=aquatiq-dw-dev-storage

# ============================================================
# Rate Limiting
# ============================================================
CONTIFICO_RATE_LIMIT_MINUTE=60
CONTIFICO_RATE_LIMIT_DAY=5000

# ============================================================
# Retry Configuration
# ============================================================
CONTIFICO_MAX_RETRIES=5
CONTIFICO_RETRY_DELAY=1.0
CONTIFICO_MAX_DELAY=60.0

# ============================================================
# Sync Configuration
# ============================================================
SYNC_ENABLED=true
SYNC_INTERVAL=900  # 15 minutes
SYNC_BATCH_SIZE=100

# ============================================================
# Security
# ============================================================
# Generate a secure random key:
# python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=your_secret_key_here
