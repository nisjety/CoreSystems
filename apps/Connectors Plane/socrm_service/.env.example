# SuperOffice CRM Service Configuration

# Microsoft Azure AD OAuth settings (Primary - uses your existing frontend auth)
MICROSOFT_CLIENT_ID=your_microsoft_client_id_here
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret_here
MICROSOFT_REDIRECT_URI=http://localhost:5005/api/auth/microsoft/callback
MICROSOFT_TENANT_ID=common

# SuperOffice OAuth settings (Optional - for direct SuperOffice integration)
SOCRM_CLIENT_ID=your_superoffice_client_id_here
SOCRM_CLIENT_SECRET=your_superoffice_client_secret_here
SOCRM_REDIRECT_URI=http://localhost:5005/api/auth/callback
SOCRM_TENANT=sod

# Service settings
SOCRM_HOST=0.0.0.0
SOCRM_PORT=5005
FLASK_ENV=production
FLASK_DEBUG=false

# Database
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/aquatiq_db

# Currency Service Integration
CURRENCY_SERVICE_URL=http://currency-service:5004
DEFAULT_CURRENCY=NOK

# Cache settings
CACHE_DIR=/app/cache
CACHE_TTL=3600

# Redis
REDIS_URL=redis://redis:6379/0

# Logging
LOG_LEVEL=INFO

# Rate limiting
RATE_LIMIT_PER_MINUTE=60

# Timeout settings
REQUEST_TIMEOUT=30

# Sync settings
SYNC_BATCH_SIZE=100
SYNC_INTERVAL_MINUTES=15
