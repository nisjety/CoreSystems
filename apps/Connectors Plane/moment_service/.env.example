# Moment API Configuration
MOMENT_API_KEY= your_api_key_here
MOMENT_COMPANY_CODE=your_company_code_here

# Environment (prod, sandbox, all)
MOMENT_ENVIRONMENT=prod

# API Base URL (default: https://app.moment.team/api/1.0)
MOMENT_BASE_URL=https://app.moment.team/api/1.0

# Flask Configuration
MOMENT_PORT=5006
FLASK_SECRET_KEY=your_secret_key_here
FLASK_DEBUG=false

# Rate Limiting
MOMENT_RATE_LIMIT_REQUESTS_PER_SECOND=30
MOMENT_RATE_LIMIT_REQUESTS_PER_MINUTE=120

# Database Configuration (for future sync features)
DATABASE_PATH=./moment_sync.db
REDIS_URL=redis://localhost:6379/0
POSTGRES_URL=postgresql://aquatiq_user:aquatiq_dev_password@localhost:5432/aquatiq_dev

# GCP Configuration (optional, for BigQuery sync)
# GCP_PROJECT_ID=your-gcp-project
# GCP_DATASET_ID=moment_data
# GCP_REGION=europe-north1
# GCP_BUCKET_NAME=your-gcs-bucket
# Path to a service account JSON key, relative to the project root (this
# repo's own ./app/gcp-credentials.json convention) or an absolute path
# reachable from wherever the service actually runs. Leave unset to fall
# back to Application Default Credentials.
# GOOGLE_APPLICATION_CREDENTIALS=app/gcp-credentials.json

# Sync Configuration
MOMENT_SYNC_INTERVAL_MINUTES=15
