config {
  type: "table",
  schema: "dw_1_silver_xero",
  name: "dim_project",
  disabled: dataform.projectConfig.vars.enable_xero_extended !== "true",
  description: "Current Xero Projects with source-native IDs and full JSON payload.",
  tags: ["silver", "xero", "dimension"]
}

WITH source AS (
  SELECT tenant_id, record_id, payload_json, synced_at
  FROM ${ref("dw_1_silver_xero", "current_extended_records")}
  WHERE endpoint = 'projects_projects'
)
SELECT
  tenant_id,
  record_id AS project_id,
  JSON_VALUE(payload_json, '$.contactId') AS contact_id,
  JSON_VALUE(payload_json, '$.name') AS project_name,
  JSON_VALUE(payload_json, '$.status') AS project_status,
  JSON_VALUE(payload_json, '$.currencyCode') AS currency_code,
  SAFE_CAST(JSON_VALUE(payload_json, '$.estimateAmount.value') AS NUMERIC) AS estimate_amount,
  SAFE_CAST(JSON_VALUE(payload_json, '$.totalInvoiced.value') AS NUMERIC) AS total_invoiced,
  SAFE_CAST(SUBSTR(JSON_VALUE(payload_json, '$.deadlineUtc'), 1, 10) AS DATE) AS deadline_date,
  payload_json,
  synced_at
FROM source
