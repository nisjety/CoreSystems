config {
  type: "table",
  schema: "xero_datamart",
  description: "Xero project-operations consumption mart at project grain. It exposes supported operational billing and time measures without representing project P&L, cost allocation, or margin.",
  assertions: { nonNull: ["project_operations_key", "tenant_id", "project_id"], uniqueKey: ["project_operations_key"] }
}

SELECT
  project_key AS project_operations_key,
  company_key,
  contact_key,
  tenant_id,
  project_id,
  contact_id,
  is_contact_unresolved,
  project_name,
  project_status,
  currency_code,
  deadline_date,
  is_operationally_open,
  is_completed,
  estimate_amount,
  estimate_currency_code,
  total_invoiced_amount,
  total_invoiced_currency_code,
  total_to_be_invoiced_amount,
  total_to_be_invoiced_currency_code,
  total_expense_amount,
  total_expense_currency_code,
  expense_amount_invoiced,
  expense_amount_invoiced_currency_code,
  expense_amount_to_be_invoiced,
  expense_amount_to_be_invoiced_currency_code,
  total_task_amount,
  total_task_currency_code,
  task_amount_invoiced,
  task_amount_invoiced_currency_code,
  task_amount_to_be_invoiced,
  task_amount_to_be_invoiced_currency_code,
  project_amount_invoiced,
  project_amount_invoiced_currency_code,
  credit_note_amount,
  credit_note_currency_code,
  deposit_amount,
  deposit_currency_code,
  deposit_applied_amount,
  deposit_applied_currency_code,
  minutes_logged,
  minutes_to_be_invoiced,
  task_count,
  in_progress_task_count,
  task_total_minutes,
  task_minutes_invoiced,
  task_minutes_to_be_invoiced,
  task_non_chargeable_minutes,
  time_entry_count,
  valid_time_entry_count,
  logged_duration_minutes,
  first_time_entry_date,
  last_time_entry_date,
  has_direct_detail_evidence,
  is_direct_detail_reconciled,
  direct_detail_observed_at,
  direct_detail_source_run_id,
  FALSE AS is_project_pnl_available,
  CAST(NULL AS NUMERIC) AS project_profit_amount,
  CAST(NULL AS NUMERIC) AS project_profit_amount_nok,
  FALSE AS is_nok_amount_available,
  is_source_deleted,
  is_current,
  is_removed,
  removed_in_run_id,
  removed_observed_at,
  record_state,
  first_seen_at,
  last_seen_at,
  project_observed_at,
  source_run_id,
  'xero' AS source_system
FROM ${ref("xero_gold_operations", "fact_project_operational_snapshot")}
