config {
  type: "table",
  schema: "xero_gold_finance",
  description: "Internal bank transfers retained for analysis; currency-unverified source amount is not additive cash flow.",
  assertions: { nonNull: ["tenant_id", "bank_transfer_id", "bank_transfer_key"], uniqueKey: ["bank_transfer_key"] }
}

SELECT FARM_FINGERPRINT(t.tenant_id) AS company_key,
       FARM_FINGERPRINT(CAST(DATE(t.transfer_date) AS STRING)) AS date_key,
       t.bank_transfer_key, t.tenant_id, t.bank_transfer_id,
       t.status, t.reference, DATE(t.transfer_date) AS transfer_date,
       t.from_bank_account_id, t.from_bank_account_code, t.from_bank_account_name,
       t.to_bank_account_id, t.to_bank_account_code, t.to_bank_account_name,
       t.from_bank_transaction_id, t.to_bank_transaction_id,
       t.from_is_reconciled, t.to_is_reconciled,
       TRUE AS is_internal_transfer, t.source_amount,
       t.source_currency_rate, CAST(NULL AS NUMERIC) AS external_cash_flow_in_currency,
       t.synced_at, 'xero' AS source_system
FROM ${ref("dw_1_silver_xero", "fact_bank_transfer")} AS t
