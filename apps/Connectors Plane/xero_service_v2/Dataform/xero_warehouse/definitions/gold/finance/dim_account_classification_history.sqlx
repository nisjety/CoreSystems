config {
  type: "table",
  schema: "xero_gold_finance",
  description: "Tenant-scoped account classification observation history. A classification interval is warehouse observation time and does not claim a finance-approved source-effective policy date.",
  assertions: {
    nonNull: ["account_classification_history_key", "account_key", "tenant_id", "account_id", "source_version_id", "valid_from_observed_at"],
    uniqueKey: ["account_classification_history_key"]
  }
}

SELECT
  FARM_FINGERPRINT(account_classification_history_key) AS account_classification_history_key,
  FARM_FINGERPRINT(account_key) AS account_key,
  FARM_FINGERPRINT(tenant_id) AS company_key,
  tenant_id,
  account_id,
  account_code,
  account_name,
  account_description,
  account_type,
  account_class,
  status,
  is_archived,
  is_active,
  tax_type,
  reporting_code,
  reporting_name,
  source_bs_pl,
  source_fsli_1,
  source_fsli_2,
  source_fsli_3,
  ebitda_flag,
  net_income_flag,
  cash_flow_1,
  cash_flow_2,
  cash_flow_3,
  working_capital_flag,
  capex_flag,
  intercompany_flag,
  account_mapping_id,
  account_mapping_source,
  account_mapping_version,
  mapping_valid_from,
  mapping_valid_to,
  mapping_approved_at,
  bs_pl,
  fsli_1,
  account_mapping_method,
  is_financial_statement_classification_complete,
  source_updated_at,
  valid_from_observed_at,
  valid_to_observed_at,
  is_current_classification,
  first_seen_at,
  source_version_id,
  'xero' AS source_system
FROM ${ref("dw_1_silver_xero", "dim_account_classification_history")}
