config {
  type: "table",
  schema: "xero_gold_finance",
  description: "Current Xero fixed-asset master data with source lifecycle and unresolved-reference flags retained for consumers.",
  assertions: { nonNull: ["tenant_id", "asset_id", "asset_key"], uniqueKey: ["asset_key"] }
}

SELECT
  FARM_FINGERPRINT(CONCAT(tenant_id, '|', asset_id)) AS asset_key,
  FARM_FINGERPRINT(tenant_id) AS company_key,
  tenant_id,
  asset_id,
  IF(asset_type_id IS NULL, NULL,
     FARM_FINGERPRINT(CONCAT(tenant_id, '|', asset_type_id))) AS asset_type_key,
  asset_type_id,
  is_asset_type_unresolved,
  asset_name,
  asset_number,
  asset_status,
  warranty_expiry_date,
  serial_number,
  purchase_date,
  purchase_price,
  accounting_book_value,
  disposal_date,
  disposal_price,
  can_rollback,
  is_delete_enabled_for_date,
  book_depreciation_start_date,
  book_current_accumulated_depreciation,
  book_prior_accumulated_depreciation,
  book_current_capital_gain,
  book_current_gain_loss,
  book_cost_limit,
  book_residual_value,
  book_depreciation_method,
  book_depreciation_calculation_method,
  book_depreciation_rate,
  book_effective_life_years,
  book_effective_date_of_change_id,
  book_depreciation_averaging_method,
  is_source_deleted,
  is_disposed,
  asset_observed_at,
  'xero' AS source_system
FROM ${ref("dw_1_silver_xero", "dim_fixed_asset")}
