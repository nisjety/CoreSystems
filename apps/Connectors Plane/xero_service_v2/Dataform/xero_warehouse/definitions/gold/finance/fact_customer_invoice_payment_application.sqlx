config {
  type: "table",
  schema: "xero_gold_finance",
  description: "Customer invoice settlement applications from authoritative Xero ACCRECPAYMENT records. Source amounts remain visible when an application is deleted, unresolved, or non-reportable.",
  assertions: {
    nonNull: ["tenant_id", "payment_id", "payment_application_key", "date_key"],
    uniqueKey: ["payment_application_key"]
  }
}

SELECT
  FARM_FINGERPRINT(a.tenant_id) AS company_key,
  FARM_FINGERPRINT(CAST(DATE(a.payment_date) AS STRING)) AS date_key,
  IF(a.contact_id IS NULL, NULL, FARM_FINGERPRINT(CONCAT(a.tenant_id, '|', a.contact_id))) AS customer_key,
  a.payment_application_key,
  a.payment_key,
  a.tenant_id,
  a.payment_id,
  a.payment_type,
  a.payment_status,
  a.is_deleted AS is_payment_deleted,
  a.is_missing_from_staging,
  a.is_invoice_resolved AS is_invoice_resolved,
  NOT a.is_invoice_resolved AS is_invoice_unresolved,
  a.is_invoice_type_mismatch,
  a.is_reportable,
  a.invoice_key,
  a.invoice_id,
  a.invoice_number,
  a.invoice_type,
  a.invoice_status,
  a.contact_id AS customer_id,
  a.contact_name AS customer_name,
  a.account_id,
  a.account_code,
  DATE(a.payment_date) AS payment_date,
  a.reference,
  a.currency_code,
  c.base_currency,
  a.source_application_amount_in_currency,
  a.source_bank_amount,
  a.source_exchange_rate,
  a.application_amount_in_currency,
  CAST(NULL AS NUMERIC) AS application_amount_base,
  CAST(NULL AS NUMERIC) AS application_amount_nok,
  a.updated_at,
  a.synced_at,
  'xero' AS source_system
FROM ${ref("dw_1_silver_xero", "bridge_invoice_payment_application")} AS a
LEFT JOIN ${ref("xero_gold_common", "dim_company")} AS c
  ON a.tenant_id = c.tenant_id
WHERE a.payment_type = 'ACCRECPAYMENT'
