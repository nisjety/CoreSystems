config {
  type: "table",
  schema: "xero_gold_finance",
  description: "ACCRECPAYMENT rows with source amount and bank amount kept separate.",
  assertions: { nonNull: ["tenant_id", "payment_id", "payment_key"], uniqueKey: ["payment_key"] }
}

SELECT FARM_FINGERPRINT(p.tenant_id) AS company_key,
       FARM_FINGERPRINT(CAST(DATE(p.payment_date) AS STRING)) AS date_key,
       IF(p.contact_id IS NULL, NULL, FARM_FINGERPRINT(CONCAT(p.tenant_id, '|', p.contact_id))) AS customer_key,
       p.payment_key, p.tenant_id, p.payment_id, p.payment_type, p.status,
       p.is_deleted, p.is_missing_from_staging, p.is_reconciled,
       p.contact_id AS customer_id, p.contact_name AS customer_name,
       p.invoice_id, p.invoice_number, p.account_id, p.account_code,
       DATE(p.payment_date) AS payment_date, p.reference,
       p.amount AS source_payment_amount, p.bank_amount, p.currency_rate AS source_exchange_rate,
       p.header_invoice_currency_code, p.embedded_invoice_currency_code,
       p.invoice_currency_code, p.invoice_currency_source, p.is_currency_conflict,
       p.is_currency_invalid, p.is_invoice_type_mismatch,
       p.is_invoice_type_unresolved, p.is_raw_typed_mismatch,
       c.base_currency, p.is_currency_unresolved,
       p.status = 'AUTHORISED' AND NOT p.is_deleted
         AND NOT p.is_currency_unresolved AND NOT p.is_invoice_type_mismatch
         AND NOT p.is_invoice_type_unresolved AND NOT p.is_raw_typed_mismatch AS is_reportable,
       IF(p.status = 'AUTHORISED' AND NOT p.is_deleted
            AND NOT p.is_currency_unresolved AND NOT p.is_invoice_type_mismatch
            AND NOT p.is_invoice_type_unresolved AND NOT p.is_raw_typed_mismatch,
          p.amount, NULL) AS payment_amount,
       CAST(NULL AS NUMERIC) AS payment_amount_base,
       CAST(NULL AS NUMERIC) AS payment_amount_nok,
       p.synced_at, 'xero' AS source_system
FROM ${ref("dw_1_silver_xero", "fact_customer_payment")} AS p
LEFT JOIN ${ref("xero_gold_common", "dim_company")} AS c
  ON p.tenant_id = c.tenant_id
