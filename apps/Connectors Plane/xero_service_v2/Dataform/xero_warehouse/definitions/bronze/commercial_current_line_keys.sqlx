config {
  type: "view",
  name: "xero_commercial_current_line_keys",
  schema: "dw_bronze_xero",
  description: "Current Xero quote and purchase-order line membership and values from the latest complete raw parent response.",
  assertions: { nonNull: ["tenant_id", "endpoint", "document_id", "line_item_id"], uniqueKey: ["tenant_id", "endpoint", "document_id", "line_item_id"] }
}

SELECT parent.tenant_id, parent.endpoint, parent.record_id AS document_id,
       JSON_VALUE(line, '$.LineItemID') AS line_item_id,
       SAFE_CAST(JSON_VALUE(line, '$.LineAmount') AS FLOAT64) AS raw_line_amount,
       SAFE_CAST(JSON_VALUE(line, '$.TaxAmount') AS FLOAT64) AS raw_tax_amount,
       SAFE_CAST(JSON_VALUE(line, '$.Quantity') AS FLOAT64) AS raw_quantity,
       SAFE_CAST(JSON_VALUE(line, '$.UnitAmount') AS FLOAT64) AS raw_unit_amount,
       JSON_VALUE(line, '$.AccountCode') AS raw_account_code,
       JSON_VALUE(line, '$.TaxType') AS raw_tax_type,
       JSON_VALUE(line, '$.ItemCode') AS raw_item_code,
       JSON_VALUE(line, '$.Description') AS raw_description,
       parent.observed_at, parent.version_id AS parent_source_version_id
FROM ${ref("dw_bronze_xero", "xero_raw_record_current")} AS parent
CROSS JOIN UNNEST(IFNULL(JSON_QUERY_ARRAY(parent.payload_json, '$.LineItems'), [])) AS line
WHERE parent.endpoint IN ('quotes', 'purchase_orders')
  AND parent.record_id = IF(parent.endpoint = 'quotes',
                            JSON_VALUE(parent.payload_json, '$.QuoteID'),
                            JSON_VALUE(parent.payload_json, '$.PurchaseOrderID'))
