config {
  type: "view",
  name: "xero_payment_invoice_currency",
  schema: "dw_bronze_xero",
  description: "Invoice identity and currency explicitly embedded in the latest raw Xero payment observation; no currency is inferred from amounts or rates.",
  assertions: { nonNull: ["tenant_id", "payment_id"], uniqueKey: ["tenant_id", "payment_id"] }
}

SELECT
  generation,
  tenant_id,
  record_id AS payment_id,
  JSON_VALUE(payload_json, '$.Invoice.InvoiceID') AS invoice_id,
  UPPER(NULLIF(TRIM(JSON_VALUE(payload_json, '$.Invoice.CurrencyCode')), ''))
    AS invoice_currency_code,
  JSON_VALUE(payload_json, '$.Status') AS payment_status,
  JSON_VALUE(payload_json, '$.PaymentType') AS payment_type,
  SAFE_CAST(JSON_VALUE(payload_json, '$.Amount') AS FLOAT64) AS payment_amount,
  source_updated_at,
  observed_at,
  run_id
FROM ${ref("dw_bronze_xero", "xero_raw_record_current")}
WHERE endpoint = 'payments'
  AND record_id = JSON_VALUE(payload_json, '$.PaymentID')
