config {
  type: "table",
  schema: "dw_1_silver_xero",
  description: "Same-run reconciliation of Xero getContactGroup direct responses to getContactGroups collection observations. Shared group fields are certified; list membership remains lifecycle authority and any member-count disagreement is visible as an audit flag.",
  assertions: {
    nonNull: ["direct_detail_reconciliation_key", "tenant_id", "contact_group_id", "direct_detail_source_run_id"],
    uniqueKey: ["direct_detail_reconciliation_key"]
  }
}

WITH collection_observations AS (
  SELECT
    raw.tenant_id,
    raw.record_id AS contact_group_id,
    raw.run_id AS source_run_id,
    raw.observed_at AS contact_group_observed_at,
    raw.version_id AS source_version_id,
    raw.receipt_id AS source_receipt_id,
    ARRAY_LENGTH(JSON_QUERY_ARRAY(raw.payload_json, '$.Contacts')) AS collection_member_count,
    TO_HEX(SHA256(TO_JSON_STRING(STRUCT(
      JSON_VALUE(raw.payload_json, '$.ContactGroupID') AS contact_group_id,
      JSON_VALUE(raw.payload_json, '$.Name') AS contact_group_name,
      JSON_VALUE(raw.payload_json, '$.Status') AS contact_group_status
    )))) AS shared_contact_group_fingerprint
  FROM ${ref("dw_bronze_xero", "xero_raw_record_history_canonical")} AS raw
  WHERE raw.endpoint = 'contact_groups'
  QUALIFY ROW_NUMBER() OVER (
    PARTITION BY raw.tenant_id, raw.record_id, raw.run_id
    ORDER BY raw.observed_at DESC, raw.receipt_id DESC, raw.version_id DESC
  ) = 1
), direct_detail_observations AS (
  SELECT
    observation.tenant_id,
    observation.contact_group_id,
    observation.contact_group_detail_observation_id,
    observation.payload_contact_group_id,
    observation.payload_contact_group_count,
    observation.direct_member_count,
    observation.shared_contact_group_fingerprint AS direct_detail_shared_contact_group_fingerprint,
    observation.contact_group_detail_observed_at AS direct_detail_observed_at,
    observation.source_version_id AS direct_detail_source_version_id,
    observation.source_receipt_id AS direct_detail_source_receipt_id,
    observation.source_run_id AS direct_detail_source_run_id
  FROM ${ref("dw_bronze_xero", "xero_contact_group_detail_observations")} AS observation
  QUALIFY ROW_NUMBER() OVER (
    PARTITION BY observation.tenant_id, observation.contact_group_id, observation.source_run_id
    ORDER BY observation.contact_group_detail_observed_at DESC, observation.source_receipt_id DESC,
             observation.source_version_id DESC
  ) = 1
)
SELECT
  CONCAT(detail.tenant_id, '|', detail.contact_group_id, '|', detail.direct_detail_source_run_id,
         '|', detail.direct_detail_source_version_id) AS direct_detail_reconciliation_key,
  detail.tenant_id,
  detail.contact_group_id,
  detail.contact_group_detail_observation_id,
  detail.payload_contact_group_id,
  detail.payload_contact_group_count,
  detail.direct_member_count,
  detail.direct_detail_observed_at,
  detail.direct_detail_source_version_id,
  detail.direct_detail_source_receipt_id,
  detail.direct_detail_source_run_id,
  detail.direct_detail_shared_contact_group_fingerprint,
  collection.contact_group_observed_at AS collection_observed_at,
  collection.source_version_id AS collection_source_version_id,
  collection.source_receipt_id AS collection_source_receipt_id,
  collection.collection_member_count,
  collection.shared_contact_group_fingerprint AS collection_shared_contact_group_fingerprint,
  detail.payload_contact_group_count = 1 AS has_singleton_direct_contact_group_payload,
  detail.payload_contact_group_id = detail.contact_group_id AS has_parent_scoped_payload_identity,
  collection.contact_group_id IS NOT NULL AS has_same_run_collection_counterpart,
  collection.shared_contact_group_fingerprint IS NOT NULL AS has_collection_shared_fingerprint,
  detail.direct_detail_shared_contact_group_fingerprint IS NOT NULL
    AS has_direct_detail_shared_fingerprint,
  collection.collection_member_count IS NOT NULL
    AND detail.direct_member_count = collection.collection_member_count AS has_member_count_match,
  detail.payload_contact_group_count = 1
    AND detail.payload_contact_group_id = detail.contact_group_id
    AND collection.contact_group_id IS NOT NULL
    AND collection.shared_contact_group_fingerprint IS NOT NULL
    AND detail.direct_detail_shared_contact_group_fingerprint IS NOT NULL
    AND collection.shared_contact_group_fingerprint = detail.direct_detail_shared_contact_group_fingerprint
    AS is_direct_detail_reconciled
FROM direct_detail_observations AS detail
LEFT JOIN collection_observations AS collection
  ON detail.tenant_id = collection.tenant_id
 AND detail.contact_group_id = collection.contact_group_id
 AND detail.direct_detail_source_run_id = collection.source_run_id
