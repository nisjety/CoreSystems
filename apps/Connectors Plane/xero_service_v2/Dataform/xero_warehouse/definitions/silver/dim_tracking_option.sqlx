config {
  type: "table",
  schema: "dw_1_silver_xero",
  description: "Tenant-scoped Xero tracking options with archived and deleted source states retained.",
  assertions: { nonNull: ["tenant_id", "tracking_option_id", "tracking_option_key"], uniqueKey: ["tracking_option_key"] }
}

SELECT CONCAT(tenant_id, '|', tracking_option_id) AS tracking_option_key,
       CONCAT(tenant_id, '|', tracking_category_id) AS tracking_category_key,
       tenant_id, tracking_option_id, tracking_category_id,
       record_id AS tracking_option_internal_id, category_name, option_name,
       status, is_active, is_archived, is_deleted, synced_at
FROM ${ref("dw_bronze_xero", "xero_tracking_options")}
