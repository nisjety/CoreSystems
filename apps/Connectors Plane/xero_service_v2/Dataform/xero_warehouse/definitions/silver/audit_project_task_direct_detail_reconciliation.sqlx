config {
  type: "table",
  schema: "dw_1_silver_xero",
  description: "Same-run reconciliation of Xero getTask direct responses to parent-scoped getTasks observations. Direct lookup validates field delivery without controlling task lifecycle.",
  assertions: {
    nonNull: ["direct_detail_reconciliation_key", "tenant_id", "project_id", "task_id", "direct_detail_source_run_id"],
    uniqueKey: ["direct_detail_reconciliation_key"]
  }
}

WITH collection_observations AS (
  SELECT
    task.tenant_id,
    task.project_id,
    task.task_id,
    task.projection_schema_revision,
    task.source_run_id,
    task.project_observed_at AS collection_observed_at,
    task.source_version_id AS collection_source_version_id,
    task.source_receipt_id AS collection_source_receipt_id,
    TO_HEX(SHA256(TO_JSON_STRING(STRUCT(
      task.project_id AS project_id,
      task.task_id AS task_id,
      task.task_name AS task_name,
      task.task_status AS task_status,
      task.charge_type AS charge_type,
      task.rate_amount AS rate_amount,
      task.rate_currency_code AS rate_currency_code,
      task.total_amount AS total_amount,
      task.total_currency_code AS total_currency_code,
      task.amount_invoiced AS amount_invoiced,
      task.amount_invoiced_currency_code AS amount_invoiced_currency_code,
      task.amount_to_be_invoiced AS amount_to_be_invoiced,
      task.amount_to_be_invoiced_currency_code AS amount_to_be_invoiced_currency_code,
      task.fixed_minutes AS fixed_minutes,
      task.total_minutes AS total_minutes,
      task.minutes_invoiced AS minutes_invoiced,
      task.minutes_to_be_invoiced AS minutes_to_be_invoiced,
      task.non_chargeable_minutes AS non_chargeable_minutes
    )))) AS shared_task_fingerprint
  FROM ${ref("dw_bronze_xero", "xero_project_task_observations")} AS task
  QUALIFY ROW_NUMBER() OVER (
    PARTITION BY task.tenant_id, task.project_id, task.task_id, task.source_run_id
    ORDER BY task.projection_schema_revision DESC, task.project_observed_at DESC,
             task.source_receipt_id DESC, task.source_version_id DESC
  ) = 1
), direct_detail_observations AS (
  SELECT
    task.tenant_id,
    task.project_id,
    task.task_id,
    task.projection_schema_revision,
    task.project_task_detail_observation_id,
    task.project_observed_at AS direct_detail_observed_at,
    task.source_version_id AS direct_detail_source_version_id,
    task.source_receipt_id AS direct_detail_source_receipt_id,
    task.source_run_id AS direct_detail_source_run_id,
    TO_HEX(SHA256(TO_JSON_STRING(STRUCT(
      task.project_id AS project_id,
      task.task_id AS task_id,
      task.task_name AS task_name,
      task.task_status AS task_status,
      task.charge_type AS charge_type,
      task.rate_amount AS rate_amount,
      task.rate_currency_code AS rate_currency_code,
      task.total_amount AS total_amount,
      task.total_currency_code AS total_currency_code,
      task.amount_invoiced AS amount_invoiced,
      task.amount_invoiced_currency_code AS amount_invoiced_currency_code,
      task.amount_to_be_invoiced AS amount_to_be_invoiced,
      task.amount_to_be_invoiced_currency_code AS amount_to_be_invoiced_currency_code,
      task.fixed_minutes AS fixed_minutes,
      task.total_minutes AS total_minutes,
      task.minutes_invoiced AS minutes_invoiced,
      task.minutes_to_be_invoiced AS minutes_to_be_invoiced,
      task.non_chargeable_minutes AS non_chargeable_minutes
    )))) AS direct_detail_shared_task_fingerprint
  FROM ${ref("dw_bronze_xero", "xero_project_task_detail_observations")} AS task
  QUALIFY ROW_NUMBER() OVER (
    PARTITION BY task.tenant_id, task.project_id, task.task_id, task.source_run_id
    ORDER BY task.projection_schema_revision DESC, task.project_observed_at DESC,
             task.source_receipt_id DESC, task.source_version_id DESC
  ) = 1
)
SELECT
  CONCAT(detail.tenant_id, '|', detail.project_id, '|', detail.task_id, '|',
         detail.direct_detail_source_run_id, '|', detail.direct_detail_source_version_id)
    AS direct_detail_reconciliation_key,
  detail.tenant_id,
  detail.project_id,
  detail.task_id,
  detail.project_task_detail_observation_id,
  detail.direct_detail_observed_at,
  detail.direct_detail_source_version_id,
  detail.direct_detail_source_receipt_id,
  detail.direct_detail_source_run_id,
  detail.direct_detail_shared_task_fingerprint,
  collection.collection_observed_at,
  collection.collection_source_version_id,
  collection.collection_source_receipt_id,
  collection.shared_task_fingerprint AS collection_shared_task_fingerprint,
  collection.task_id IS NOT NULL AS has_same_run_collection_counterpart,
  collection.shared_task_fingerprint IS NOT NULL AS has_collection_shared_fingerprint,
  detail.direct_detail_shared_task_fingerprint IS NOT NULL AS has_direct_detail_shared_fingerprint,
  collection.task_id IS NOT NULL
    AND collection.shared_task_fingerprint IS NOT NULL
    AND detail.direct_detail_shared_task_fingerprint IS NOT NULL
    AND collection.shared_task_fingerprint = detail.direct_detail_shared_task_fingerprint
    AS is_direct_detail_reconciled
FROM direct_detail_observations AS detail
LEFT JOIN collection_observations AS collection
  ON detail.tenant_id = collection.tenant_id
 AND detail.project_id = collection.project_id
 AND detail.task_id = collection.task_id
 AND detail.direct_detail_source_run_id = collection.source_run_id
