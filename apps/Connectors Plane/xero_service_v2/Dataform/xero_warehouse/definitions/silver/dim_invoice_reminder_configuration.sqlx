config {
  type: "table",
  schema: "dw_1_silver_xero",
  description: "Latest observed Xero invoice-reminder configuration per company and source position. A missing or empty source array remains explicit and is not treated as a deletion.",
  assertions: {
    nonNull: ["invoice_reminder_configuration_key", "tenant_id", "source_receipt_id"],
    uniqueKey: ["invoice_reminder_configuration_key"]
  }
}

WITH ranked_responses AS (
  SELECT
    tenant_id,
    source_receipt_id,
    ROW_NUMBER() OVER (
      PARTITION BY tenant_id
      ORDER BY reminder_observed_at DESC, source_receipt_id DESC
    ) AS receipt_rank
  FROM ${ref("dw_bronze_xero", "xero_invoice_reminder_observations")}
  GROUP BY tenant_id, source_receipt_id, reminder_observed_at
), latest_response AS (
  SELECT tenant_id, source_receipt_id
  FROM ranked_responses
  WHERE receipt_rank = 1
)
SELECT
  observation.reminder_observation_key AS invoice_reminder_configuration_key,
  observation.tenant_id,
  observation.reminder_position,
  observation.is_enabled,
  observation.is_explicitly_empty,
  observation.is_source_configuration_missing,
  observation.reminder_observed_at,
  observation.source_record_id,
  observation.source_version_id,
  observation.source_receipt_id,
  observation.source_run_id,
  observation.source_payload_hash,
  TRUE AS is_current_configuration
FROM ${ref("dw_bronze_xero", "xero_invoice_reminder_observations")} AS observation
INNER JOIN latest_response
  USING (tenant_id, source_receipt_id)
