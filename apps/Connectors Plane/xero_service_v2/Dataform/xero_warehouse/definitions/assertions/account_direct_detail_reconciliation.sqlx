config {
  type: "assertion",
  name: "xero_account_direct_detail_reconciliation",
  schema: "dw_1_silver_xero_assertions",
  description: "Every retained Xero getAccount direct response must prove the expected singleton envelope, parent identity, and same-run shared-field agreement with getAccounts. Direct lookup remains non-authoritative for account lifecycle."
}

SELECT
  tenant_id,
  account_id,
  direct_detail_source_run_id,
  direct_detail_source_version_id,
  payload_account_id,
  payload_account_count,
  has_singleton_direct_account_payload,
  has_parent_scoped_payload_identity,
  has_same_run_collection_counterpart,
  has_collection_shared_fingerprint,
  has_direct_detail_shared_fingerprint
FROM ${ref("dw_1_silver_xero", "audit_account_direct_detail_reconciliation")}
WHERE is_direct_detail_reconciled IS NOT TRUE
