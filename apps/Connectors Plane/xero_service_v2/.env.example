# ── xero_service_v2 — environment (stateless raw → GCS uploader) ──────────────
# Copy to .env and fill in the blanks. NEVER commit real secrets.
#
# This service is a one-shot CLI job: it fetches raw Xero pages and writes them
# verbatim to GCS, then exits. It supports Custom Connections or PKCE and an
# optional shared Redis quota coordinator. BFF/MCP run as separate services.

# ── Auth — custom connection by default ───────────────────────────────────────
# For PKCE use XERO_AUTH_MODE=pkce and the same connection-store configuration
# as the BFF. Custom Connections use client_credentials per organisation.
XERO_CONNECTION_TYPE=custom
# XERO_AUTH_MODE=pkce
# XERO_PKCE_CLIENT_ID=your-xero-pkce-client-id
# XERO_CONNECTION_STORE_BACKEND=gcs
# XERO_CONNECTION_STORE_GCS_BUCKET=dedicated-private-token-bucket
# XERO_CONNECTION_STORE_GCS_OBJECT=xero/pkce/connections.json
# XERO_CONNECTION_STORE_KMS_KEY=projects/PROJECT/locations/LOCATION/keyRings/RING/cryptoKeys/KEY

# Numbered orgs (preferred for a multi-org fleet). One block per organisation,
# N = 1, 2, 3, …. Fill the secret from your secret manager — do not commit it.
XERO_ORG_1_NAME=Aquatiq Australia Pty Ltd
XERO_ORG_1_TENANT_ID=00000000-0000-0000-0000-000000000000
XERO_ORG_1_CLIENT_ID=your_org1_custom_connection_client_id
XERO_ORG_1_CLIENT_SECRET=your_org1_custom_connection_client_secret
# XERO_ORG_2_NAME=...
# XERO_ORG_2_TENANT_ID=...
# XERO_ORG_2_CLIENT_ID=...
# XERO_ORG_2_CLIENT_SECRET=...

# Which numbered org is "primary" (used when a single-org context is needed).
# XERO_CUSTOM_CONNECTION_ORG_INDEX=1

# Single-org alternative to the numbered blocks (XERO_CC_* takes the same role
# as XERO_ORG_1_*). Use one style or the other, not both.
# XERO_CC_TENANT_NAME=Aquatiq Australia Pty Ltd
# XERO_CC_TENANT_ID=00000000-0000-0000-0000-000000000000
# XERO_CC_CLIENT_ID=your_custom_connection_client_id
# XERO_CC_CLIENT_SECRET=your_custom_connection_client_secret

# Grant the Accounting read scopes, including accounting.budgets.read, in the
# Xero Developer Portal for each Custom Connection. XERO_SCOPES is not read by
# client-credentials auth; the portal grant controls the token permissions.
# For xero sync-extended, grant assets.read / projects.read as needed. Bank
# Feeds uses the write-capable bankfeeds scope and requires Xero approval;
# Finance scopes require partner access. Do not grant these speculatively.

# ── GCS destination ───────────────────────────────────────────────────────────
# Bucket per environment simplifies IAM + lifecycle (xero-raw-dev / xero-raw-prod).
GCS_BUCKET=xero-raw-dev
XERO_STAGING_DATASET=dw_staging_xero
# For a separate sensitive sync-extended deployment, set GCS_BUCKET to a
# dedicated restricted bucket and set this variable to the same name.
# XERO_SENSITIVE_GCS_BUCKET=xero-raw-sensitive-dev
# Cloud Function / backfill: required for extended API data.
# GCP_PROJECT=prj-dw-dev
# XERO_SENSITIVE_DATASET=staging_xero_sensitive
# For direct PDF/attachment GETs, use a separate restricted document bucket.
# XERO_DOCUMENT_GCS_BUCKET=xero-documents-dev
# Set this on the document loader after creating the dataset.
# XERO_DOCUMENT_DATASET=staging_xero_documents
# Key prefix for raw objects (default raw/xero). Manifests are written OUTSIDE
# this prefix, under _manifests/xero/…
GCS_PREFIX=raw/xero
# Path to the GCS service-account JSON. The SA needs roles/storage.objectCreator
# (and objectViewer for healthcheck --check-bucket) on GCS_BUCKET.
GOOGLE_APPLICATION_CREDENTIALS=/secrets/gcs-sa.json

# ── Sync tuning ───────────────────────────────────────────────────────────────
# Incremental modified-window look-back in days.
SYNC_WINDOW_DAYS=3
# rolling-full (tight) window — weekly via --full-with-window.
SYNC_ROLLING_FULL_TIGHT_DAYS=30
# rolling-full (wide) window — monthly via --business-from/--business-to.
SYNC_ROLLING_FULL_WIDE_DAYS=90
# Max concurrent (tenant, entity) tasks. Clamped to 1..=6 (Xero per-tenant ceiling).
SYNC_MAX_CONCURRENT=6
# Detail fallback staging contains raw financial data. Use an encrypted private
# volume in production; combined collection/detail cap is per expanded entity.
# XERO_DETAIL_SPOOL_DIR=/private/encrypted/xero-spool
# XERO_DETAIL_SPOOL_MAX_BYTES=536870912

# Optional shared quotas: set BOTH on every worker using one Xero app/database.
# Remote TCP requires verified TLS; provision the authenticated URL as a secret.
# Without these settings quotas are process-local. See docs/OPERATIONS.md.
# XERO_REDIS_URL=rediss://redis.private.example:6379/0
# XERO_REDIS_APP_KEY=xero-app-production

# ── Logging ───────────────────────────────────────────────────────────────────
RUST_LOG=info,xero_cli=info,xero_sync=info,xero_client=info,xero_gcs=info,xero_auth=info

# ── Local docker-compose only ─────────────────────────────────────────────────
# Host path to the GCS SA JSON bind-mounted into the container at
# /secrets/gcs-sa.json (must match GOOGLE_APPLICATION_CREDENTIALS above). Only
# needed for real (non-dry-run) uploads via docker compose.
# GCS_SA_JSON=./gcs-sa.json
