# ── xero-bff — PKCE onboarding gateway environment ───────────────────────────
# Copy to .env.bff (gitignored). The BFF AUTO-LOADS .env.bff at startup — no
# shell sourcing needed. This is the USER-FACING OAuth2 + PKCE flow — separate
# from the uploader's custom-connection creds in .env.example.

# Xero OAuth2 app client id (PKCE flow). From https://developer.xero.com.
XERO_PKCE_CLIENT_ID=your-xero-pkce-client-id

# Client secret — set this ONLY for a confidential "Web app" (Xero's standard
# app type: PKCE + secret). Leave unset for a pure public/mobile PKCE app.
# The v1 service uses a confidential app, so this IS required when reusing it.
XERO_PKCE_CLIENT_SECRET=your-xero-client-secret

# Must EXACTLY match a redirect URI registered on the Xero app. The local BFF
# receives this callback directly; use localhost:5002 to start the login too.
# Xero permits http://localhost redirect URIs for development.
XERO_REDIRECT_URI=http://localhost:5002/api/xero/callback

# Cookie encryption key — base64 of >= 64 random bytes:
#   openssl rand -base64 64
XERO_BFF_COOKIE_KEY=replace-with-openssl-rand-base64-64

# ── Optional (defaults shown) ────────────────────────────────────────────────
XERO_BFF_BIND=127.0.0.1:5002
# offline_access is REQUIRED for a refresh token. Space-separated.
XERO_PKCE_SCOPES="openid profile email offline_access accounting.transactions.read accounting.contacts.read accounting.settings.read accounting.reports.read accounting.journals.read accounting.attachments.read accounting.budgets.read"
# For sync-extended, add only the approved scopes needed by selected families:
# assets.read projects.read bankfeeds finance.cashvalidation.read
# finance.statements.read finance.bankstatementsplus.read
# Existing organisations must reconnect after any PKCE scope change.
# Payment Services is deliberately out of scope for this warehouse. Do not add
# the separate write-capable `paymentservices` scope.
XERO_SPA_CONNECTED_PATH=/connected
XERO_SPA_ERROR_PATH=/auth/error
# Local-only store. The BFF and CLI must use the same backend and configuration.
XERO_CONNECTION_STORE_BACKEND=file
XERO_CONNECTION_STORE_PATH=./data/connections.json
# Production: set XERO_CONNECTION_STORE_BACKEND=gcs, then configure a dedicated
# private bucket, distinct from ordinary and sensitive raw-data buckets.
# XERO_CONNECTION_STORE_GCS_BUCKET=dedicated-private-token-bucket
# XERO_CONNECTION_STORE_GCS_OBJECT=xero/pkce/connections.json
# XERO_CONNECTION_STORE_KMS_KEY=projects/PROJECT/locations/LOCATION/keyRings/RING/cryptoKeys/KEY
# Set true in production (behind HTTPS) so cookies get the Secure flag.
XERO_BFF_SECURE_COOKIES=false
