# SolidJS onboarding SPA — client env (only VITE_* is exposed to the browser).
# NEVER put the Xero client secret or refresh tokens here — those live in the BFF.

# Origin of the Rust xero-bff gateway that the Vite dev server proxies /api/* to.
# Defaults to http://localhost:8080 when unset.
VITE_BFF_ORIGIN=http://localhost:8080
