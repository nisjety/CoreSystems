# Xero credentials and connection-store configuration are shared with the BFF.
# Add these settings to an owner-only environment file; never commit that file.
XERO_AUTH_MODE=pkce
XERO_PKCE_CLIENT_ID=
XERO_PKCE_CLIENT_SECRET=
XERO_CONNECTION_STORE_BACKEND=file
XERO_CONNECTION_STORE_PATH=./data/connections.json

# Tenant UUID allowlist for stdio or a static fallback token. OAuth-only HTTP
# obtains its allowlist from the organizations returned by each Xero sign-in.
XERO_MCP_TENANTS=
XERO_MCP_BIND=127.0.0.1:5003
# Remote/container binds require an enforced TLS proxy and restricted network.
XERO_MCP_TLS_PROXY=false
# Generate at least 32 random characters. This is NOT a Xero API token.
XERO_MCP_TOKEN=
XERO_MCP_ALLOW_EXTRACT=false
XERO_MCP_ALLOW_SENSITIVE=false
XERO_MCP_ALLOW_WAREHOUSE=false
XERO_MCP_ZERO_DATA_RETENTION=false
XERO_MCP_STORAGE_ROOT=./out/mcp
# Xero writes are disabled unless both this flag and an exact per-client action
# allowlist are set. Static XERO_MCP_TOKEN clients never receive write grants.
XERO_MCP_ENABLE_WRITES=false
# Local stdio only; remote clients use write_actions in XERO_MCP_CLIENTS_JSON.
# XERO_MCP_WRITE_ACTIONS=create_contact,update_contact,create_draft_invoice,create_payment
# full: 148 endpoint tools + 9 operational tools. compact: 9 operational tools.
XERO_MCP_TOOL_MODE=full
XERO_MCP_ALLOWED_HOSTS=localhost,127.0.0.1,::1
# Empty rejects browser Origin headers; trusted service clients omit Origin.
XERO_MCP_ALLOWED_ORIGINS=

# Optional Claude sign-in bridge. Leave unset to keep static-bearer HTTP mode.
# Register the exact XERO_MCP_OAUTH_XERO_REDIRECT_URI in the Xero developer app.
# Claude receives MCP-only tokens; Xero refresh tokens remain in this service.
# Single MCP worker: oauth.sqlite in XERO_MCP_STORAGE_ROOT must be persistent
# and private. Use the shared GCS Xero connection store for separate workers.
# XERO_MCP_OAUTH_ISSUER=https://tools.aquatiq.com
# XERO_MCP_OAUTH_CLIENT_ID=claude-xero
# XERO_MCP_OAUTH_XERO_REDIRECT_URI=https://tools.aquatiq.com/oauth/xero/callback
# XERO_MCP_OAUTH_SCOPES=openid offline_access accounting.transactions.read accounting.contacts.read
# OAuth clients default to zero retention and cannot extract or query the warehouse.
# Enable all three only on a private persistent worker with scoped GCP credentials.
# XERO_MCP_OAUTH_ZERO_DATA_RETENTION=true
# XERO_MCP_OAUTH_ALLOW_EXTRACT=false
# XERO_MCP_OAUTH_ALLOW_WAREHOUSE=false

# Optional independent service clients; tokens and tenant permissions stay private.
# XERO_MCP_CLIENTS_JSON='[{"token":"generated-service-secret","client_id":"model-plane","tenant_ids":["tenant-uuid"],"allow_extract":false,"allow_sensitive":false,"allow_warehouse":false,"zero_data_retention":false}]'
# For a separately reviewed writer, add "write_actions":["create_contact"] to
# that client's object. Keep zero_data_retention=false for durable approvals.

# Optional tenant-scoped BigQuery overview and approved aggregates. Set all
# three variables together and provide scoped Application Default Credentials.
# The client must also have allow_warehouse enabled above or in CLIENTS_JSON.
# XERO_MCP_WAREHOUSE_PROJECT=aquatiq-datavarehus
# XERO_MCP_WAREHOUSE_DATASET=dw_staging_xero
# XERO_MCP_WAREHOUSE_LOCATION=europe-north2
# XERO_MCP_WAREHOUSE_MAX_BYTES_BILLED=5368709120

# GCS extraction uses the existing pipeline configuration. Sensitive APIs and
# document downloads require dedicated private buckets, separate from token storage.
# GCS_BUCKET=
# GCS_PREFIX=raw/xero
# XERO_SENSITIVE_GCS_BUCKET=
# XERO_DOCUMENT_GCS_BUCKET=

# Optional shared quotas: same Redis database and cohort on all app workers.
# Store the authenticated URL privately; remote TCP requires verified TLS.
# XERO_REDIS_URL=rediss://redis.private.example:6379/0
# XERO_REDIS_APP_KEY=xero-app-production
# Authorized bulk detail jobs stage raw financial data on this private volume.
# XERO_DETAIL_SPOOL_DIR=/private/encrypted/xero-spool
# XERO_DETAIL_SPOOL_MAX_BYTES=536870912
