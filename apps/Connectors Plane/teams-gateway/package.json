{
  "name": "teams-gateway",
  "version": "1.0.0",
  "description": "Aquatiq Chat Teams Gateway Service",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
  "typeorm": "node -r ts-node/register ./node_modules/typeorm/cli.js -d src/data-source.ts",
  "migration:generate": "npm run typeorm -- migration:generate src/migrations/auto -o",
  "migration:run": "npm run typeorm -- migration:run",
  "migration:revert": "npm run typeorm -- migration:revert",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "test:bot": "node test-bot.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix || echo 'Linting completed with warnings'"
  },
  "keywords": [
    "aquatiq",
    "teams",
    "chatbot",
    "microsoft"
  ],
  "author": "Aquatiq",
  "license": "ISC",
  "dependencies": {
    "@azure/identity": "^4.11.1",
    "@azure/msal-node": "^2.6.6",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@microsoft/teams-ai": "^1.7.4",
    "@microsoft/teams-js": "^2.43.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/microservices": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/platform-fastify": "^10.3.0",
    "@nestjs/platform-socket.io": "^10.4.20",
    "@nestjs/typeorm": "^10.0.1",
    "@nestjs/websockets": "^10.4.20",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/socket.io-client": "^3.0.0",
    "axios": "^1.11.0",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.1",
    "isomorphic-fetch": "^3.0.0",
    "nats": "^2.29.3",
    "nkeys.js": "^1.1.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "restify": "^11.1.0",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "tweetnacl": "^1.0.3",
    "typeorm": "^0.3.26",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/testing": "^10.3.0",
    "@types/jest": "^29.5.12",
    "@types/restify": "^8.5.12",
    "@types/supertest": "^2.0.16",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-prettier": "^4.2.1",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "prettier": "^2.8.8",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0"
  }
}
