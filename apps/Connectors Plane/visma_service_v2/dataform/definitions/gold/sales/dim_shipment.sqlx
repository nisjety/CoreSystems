config {
  type: "table",
  schema: "visma_gold_sales",
  name: "dim_shipment",
  description: "Shipment header dimension for the sales star schema. Maps to Power BI dimShipment.",
  tags: ["gold", "sales", "dimension"]
}

SELECT
    FARM_FINGERPRINT(CONCAT(
        CAST(f.tenant_id AS STRING), '|',
        CAST(f.business_unit_id AS STRING), '|',
        CAST(f.shipment_number AS STRING)
    ))                                              AS shipment_key,

    FARM_FINGERPRINT(CAST(f.tenant_id AS STRING))  AS company_key,

    FARM_FINGERPRINT(CAST(f.shipment_date AS STRING)) AS date_key,

    -- Warehouse identity is physical: tenant + warehouse_id (see dim_warehouse).
    -- Recipient (to_warehouse) is what Transfer-type shipments move stock INTO.
    CASE WHEN f.from_warehouse_id IS NOT NULL THEN FARM_FINGERPRINT(CONCAT(
        CAST(f.tenant_id AS STRING), '|',
        CAST(f.from_warehouse_id AS STRING)
    )) END                                          AS from_warehouse_key,
    CASE WHEN f.to_warehouse_id IS NOT NULL THEN FARM_FINGERPRINT(CONCAT(
        CAST(f.tenant_id AS STRING), '|',
        CAST(f.to_warehouse_id AS STRING)
    )) END                                          AS to_warehouse_key,

    f.tenant_id,
    f.business_unit_id,
    f.shipment_number,
    f.shipment_type,
    f.status,
    f.shipment_date,
    f.customer,
    f.from_warehouse_id,
    f.from_warehouse_name,
    f.to_warehouse_id,
    f.to_warehouse_name,
    f.currency_id,
    f.ship_via,
    f.operation,
    f.shipped_quantity,
    f.shipped_weight,
    f.shipped_volume,
    f.freight_amount,
    f.freight_cost,
    f.last_modified_at,
    'visma' AS source_system

FROM ${ref("visma_silver", "fact_shipment")} AS f
