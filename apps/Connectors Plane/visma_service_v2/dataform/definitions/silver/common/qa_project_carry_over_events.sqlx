config {
  type: "table",
  schema: "visma_silver_common",
  name: "qa_project_carry_over_events",
  description: "QA: the days on which project history was carried over (migrated opening balances, the merger move), per tenant, date and rule, with what was flagged by seed_project_history_rule. Read it to confirm the rule: a new row means a new carry-over event reached the project P&L as history (or, if it should not have, a posting matched the wording of a rule).",
  tags: ["silver", "common", "qa", "project"]
}

SELECT
  l.tenant_id,
  ANY_VALUE(l.organization_name) AS organization_name,
  l.transaction_date,
  l.historical_migration_rule,
  l.module,
  COUNT(*) AS line_count,
  COUNT(DISTINCT l.batch_number) AS batch_count,
  COUNT(DISTINCT l.project_id) AS project_count,
  ROUND(SUM(IF(COALESCE(a.account_type, l.debit_account_type) = 'Income', -COALESCE(l.amount, 0), 0)), 2)
    AS income_amount,
  ROUND(SUM(IF(COALESCE(a.account_type, l.debit_account_type) = 'Expense', COALESCE(l.amount, 0), 0)), 2)
    AS expense_amount,
  ARRAY_AGG(DISTINCT SUBSTR(COALESCE(l.line_description, l.header_description, ''), 1, 60)
            IGNORE NULLS LIMIT 3) AS sample_descriptions
FROM ${ref("visma_silver", "fact_project_transaction_line")} AS l
LEFT JOIN ${ref("visma_silver", "dim_account")} AS a
  ON  a.tenant_id = l.tenant_id
  AND a.account_cd = l.debit_account_cd
WHERE l.is_historical_project_migration
  AND l.project_id IS NOT NULL
GROUP BY l.tenant_id, l.transaction_date, l.historical_migration_rule, l.module
