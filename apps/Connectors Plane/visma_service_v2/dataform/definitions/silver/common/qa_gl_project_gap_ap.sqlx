config {
  type: "table",
  schema: "visma_silver_common",
  name: "qa_gl_project_gap_ap",
  description: "QA: AP general-ledger lines still missing project_id after AP supplier-invoice enrichment. Explains the remaining gap reason per line.",
  tags: ["silver", "common", "qa", "gl", "project", "ap"]
}

WITH gl_ap_missing AS (
  SELECT
    tenant_id,
    organization_name,
    batch_number,
    ref_number,
    line_number,
    transaction_date,
    financial_period,
    account_cd,
    subaccount_id,
    branch_id,
    description,
    debit_amount,
    credit_amount
  FROM ${ref("visma_silver", "fact_general_ledger")}
  WHERE module = 'AP'
    AND project_id IS NULL
),

supplier_doc AS (
  SELECT
    tenant_id,
    reference_number AS ref_number,
    COUNT(*) AS supplier_invoice_line_count,
    COUNTIF(project_id IS NOT NULL) AS supplier_invoice_doc_line_with_project_count,
    COUNT(DISTINCT project_id) AS supplier_invoice_doc_project_count,
    STRING_AGG(DISTINCT project_id, '|' ORDER BY project_id LIMIT 20) AS supplier_invoice_doc_project_ids,
    STRING_AGG(DISTINCT supplier_id, '|' ORDER BY supplier_id LIMIT 20) AS supplier_ids
  FROM ${ref("visma_silver", "fact_supplier_invoice_line")}
  GROUP BY 1, 2
),

supplier_line AS (
  SELECT
    tenant_id,
    reference_number AS ref_number,
    CAST(line_number AS STRING) AS line_number,
    COUNT(*) AS supplier_invoice_line_match_count,
    COUNTIF(project_id IS NOT NULL) AS supplier_invoice_line_match_with_project_count,
    COUNT(DISTINCT project_id) AS supplier_invoice_line_project_count,
    STRING_AGG(DISTINCT project_id, '|' ORDER BY project_id LIMIT 20) AS supplier_invoice_line_project_ids,
    ANY_VALUE(line_description) AS supplier_invoice_line_description
  FROM ${ref("visma_silver", "fact_supplier_invoice_line")}
  GROUP BY 1, 2, 3
),

gl_doc_counts AS (
  SELECT
    tenant_id,
    ref_number,
    COUNT(*) AS gl_ap_doc_line_count
  FROM ${ref("visma_silver", "fact_general_ledger")}
  WHERE module = 'AP'
  GROUP BY 1, 2
)

SELECT
  g.tenant_id,
  g.organization_name,
  g.batch_number,
  g.ref_number,
  g.line_number,
  g.transaction_date,
  g.financial_period,
  g.account_cd,
  g.subaccount_id,
  g.branch_id,
  g.description,
  g.debit_amount,
  g.credit_amount,
  dc.gl_ap_doc_line_count,
  sd.supplier_ids,
  sd.supplier_invoice_line_count,
  sd.supplier_invoice_doc_line_with_project_count,
  sd.supplier_invoice_doc_project_count,
  sd.supplier_invoice_doc_project_ids,
  sl.supplier_invoice_line_match_count,
  sl.supplier_invoice_line_match_with_project_count,
  sl.supplier_invoice_line_project_count,
  sl.supplier_invoice_line_project_ids,
  sl.supplier_invoice_line_description,
  CASE
    WHEN sd.ref_number IS NULL THEN 'no_supplier_invoice_line_match'
    WHEN COALESCE(sd.supplier_invoice_doc_project_count, 0) = 0 THEN 'supplier_invoice_lines_without_project'
    WHEN COALESCE(sl.supplier_invoice_line_project_count, 0) > 1 THEN 'line_level_multi_project_conflict'
    WHEN COALESCE(sd.supplier_invoice_doc_project_count, 0) > 1 THEN 'document_level_multi_project_conflict'
    WHEN COALESCE(sl.supplier_invoice_line_match_count, 0) = 0 THEN 'no_matching_line_number_in_supplier_invoice'
    WHEN COALESCE(sd.supplier_invoice_doc_project_count, 0) = 1 THEN 'unexpected_missing_despite_unique_doc_project'
    ELSE 'unclassified'
  END AS gap_reason,
  CASE
    WHEN sd.ref_number IS NULL THEN 'No supplier invoice line found for tenant + ref_number'
    WHEN COALESCE(sd.supplier_invoice_doc_project_count, 0) = 0 THEN 'Supplier invoice exists, but none of its lines carry project_id'
    WHEN COALESCE(sl.supplier_invoice_line_project_count, 0) > 1 THEN 'This exact supplier invoice line has multiple project candidates'
    WHEN COALESCE(sd.supplier_invoice_doc_project_count, 0) > 1 THEN 'Document contains multiple project_ids, so safe doc-level fallback is blocked'
    WHEN COALESCE(sl.supplier_invoice_line_match_count, 0) = 0 THEN 'Document exists, but GL line_number does not match any supplier invoice line_number'
    WHEN COALESCE(sd.supplier_invoice_doc_project_count, 0) = 1 THEN 'Should have been backfilled by unique document project; investigate edge-case join'
    ELSE 'Review manually'
  END AS gap_reason_detail
FROM gl_ap_missing AS g
LEFT JOIN supplier_doc AS sd
  ON g.tenant_id = sd.tenant_id
 AND g.ref_number = sd.ref_number
LEFT JOIN supplier_line AS sl
  ON g.tenant_id = sl.tenant_id
 AND g.ref_number = sl.ref_number
 AND g.line_number = sl.line_number
LEFT JOIN gl_doc_counts AS dc
  ON g.tenant_id = dc.tenant_id
 AND g.ref_number = dc.ref_number
