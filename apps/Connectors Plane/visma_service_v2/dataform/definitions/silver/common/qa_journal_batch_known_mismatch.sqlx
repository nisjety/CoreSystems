config {
  type: "table",
  schema: "visma_silver_common",
  name: "qa_journal_batch_known_mismatch",
  description: "QA: the posted journal batches whose header control totals differ from their general ledger lines in Visma's own data, accepted as known source differences. assert_journal_batch_control_totals leaves out a batch listed here only while its differences are exactly the recorded ones, so a batch that changes, and any new mismatch, still fails the run.",
  tags: ["silver", "common", "qa", "general_ledger"]
}

-- Recorded 2026-10-13 from the 49 batches that assert_journal_batch_control_totals returned on the
-- staging of 2026-10-01/02 (Aquatiq AS 23, Hygiene Systems 18, Aquatiq Group 5, Sense 2, Sensilist 1).
-- All are AR or AP batches. In 47 the header's debit and credit totals agree and are larger than the sum
-- of the batch's lines; the lines themselves balance (assert_gl_batch_nets_to_zero holds for every batch),
-- so the ledger is intact and only the header claims more than the journal listing returns for the batch.
-- In 2 (Hygiene Systems AP 011229, Aquatiq AS AR 035865) the header's own debit and credit totals differ.
--
-- Not a loss on the way: checked against live Visma on 2026-10-12 for four of the periods involved
-- (Hygiene Systems AP 202402, Hygiene Systems AR 202405, Aquatiq AS AR 202410, Sense AR 202401), the
-- lines staged equal the totalCount Visma returns for that period and module (1,528, 1,557, 8,814 and 567).
-- The batch's own lines in bronze (journalTransactionLines) are as short as the general ledger lines.
--
-- debit_difference and credit_difference are header minus lines, as the assertion computes them. A batch
-- listed here is left out of the assertion only while its differences are exactly these. Remove a row when
-- Visma's data is corrected; keep the list short.
--
-- Reasons: header_total_exceeds_gl_lines, header_debit_differs_from_header_credit.

SELECT * FROM UNNEST([
  STRUCT('61320c0a-102d-11ee-a0e0-0693d8a7c3dd' AS tenant_id, 'AHS' AS entity_code, 'AP' AS module, '003407' AS batch_number, '202402' AS financial_period, NUMERIC '39208.75' AS debit_difference, NUMERIC '39208.75' AS credit_difference, 'header_total_exceeds_gl_lines' AS reason),
  STRUCT('61320c0a-102d-11ee-a0e0-0693d8a7c3dd', 'AHS', 'AP', '003409', '202402', NUMERIC '71354.28', NUMERIC '71354.28', 'header_total_exceeds_gl_lines'),
