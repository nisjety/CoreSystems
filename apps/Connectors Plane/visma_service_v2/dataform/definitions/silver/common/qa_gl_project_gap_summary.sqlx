config {
  type: "table",
  schema: "visma_silver_common",
  name: "qa_gl_project_gap_summary",
  description: "QA summary of remaining GL project gaps by module, tenant, and diagnosed reason.",
  tags: ["silver", "common", "qa", "gl", "project", "summary"]
}

WITH ap AS (
  SELECT
    'AP' AS module,
    tenant_id,
    organization_name,
    gap_reason,
    COUNT(*) AS gap_line_count
  FROM ${ref("visma_silver_common", "qa_gl_project_gap_ap")}
  GROUP BY 1, 2, 3, 4
),

pm AS (
  SELECT
    'PM' AS module,
    tenant_id,
    organization_name,
    gap_reason,
    COUNT(*) AS gap_line_count
  FROM ${ref("visma_silver_common", "qa_gl_project_gap_pm")}
  GROUP BY 1, 2, 3, 4
),

ar AS (
  SELECT
    'AR' AS module,
    tenant_id,
    organization_name,
    gap_reason,
    COUNT(*) AS gap_line_count
  FROM ${ref("visma_silver_common", "qa_gl_project_gap_ar")}
  GROUP BY 1, 2, 3, 4
)

SELECT *
FROM ap
UNION ALL
SELECT *
FROM pm
UNION ALL
SELECT *
FROM ar
