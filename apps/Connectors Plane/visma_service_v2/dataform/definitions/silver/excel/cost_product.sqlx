config {
  type: "table",
  schema: "visma_silver_excel",
  name: "cost_product",
  description: "Products that are charges, not goods: freight, travel time, driving, lodging, diet, packaging, lubricant and environmental fees. The list of Omkostninger.xlsx. Visma gives these order lines no cost price, so a margin over them says nothing; BI_SalesOrder.is_charge_line marks them and sales_order_line_business_unit_strategy keeps them with the business unit of the goods on the order.",
  tags: ["silver", "excel", "reference", "sales"]
}

SELECT DISTINCT TRIM(product_number) AS product_number
FROM ${ref("visma_bronze_excel", "raw_cost_products")}
WHERE product_number IS NOT NULL
  AND TRIM(product_number) != ''
