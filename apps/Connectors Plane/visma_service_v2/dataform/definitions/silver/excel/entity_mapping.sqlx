config {
  type: "table",
  schema: "visma_silver_excel",
  name: "entity_mapping",
  description: "Cleaned and typed entity mapping. Primary source: reference_data.xlsx via bronze (pre-deduplicated via MERGE). Fallback: seed data for bootstrap.",
  tags: ["silver", "excel", "reference"],
//  assertions: {
//    nonNull: ["company_id", "entity_code"],
//    uniqueKey: ["company_id"]
//  }
}

-- Primary source: Excel data ingested through bronze (pre-deduplicated via MERGE)
--
-- The tenant of a workbook row is found by entity_code. It used to be found by company_id, but the
-- workbook (reference_data.xlsx) and seed_entity_mapping number the companies differently (workbook:
-- 1661 Group, 1662 Consult, 1663 AFF, 1664 Sense, 1665 Achem, 1666 AHS; seed: 1661 Aquatiq AS, 1662 Aqua
-- Pharma, ..., 1668 AFF, 1669 AHS), so six entities got another company's tenant (AHS got Consult's,
-- Consult got Aqua Pharma's, ...) and the seed rows for Aquatiq AS, Aqua Pharma, Aqua Pharma Group and
-- Aquatiq Aps were dropped because their ids were "already covered". A seed row now goes when its
-- entity is in the workbook (by code or name), and keeps its company_id unless the workbook uses that id
-- for another entity, in which case it is NULL.
WITH 
bronze_data AS (
  SELECT
    SAFE_CAST(r.company_id AS INT64) AS company_id,
    UPPER(TRIM(SAFE_CAST(r.entity_code AS STRING))) AS entity_code,
    SAFE_CAST(r.entity_name AS STRING) AS entity_name,
    SAFE_CAST(r.business_unit_code AS STRING) AS business_unit_code,
    SAFE_CAST(r.business_unit_name AS STRING) AS business_unit_name,
    SAFE_CAST(r.group_name AS STRING) AS group_name,
    COALESCE(m.tenant_id, SAFE_CAST(r.company_id AS STRING)) AS tenant_id,
    CAST(NULL AS DATE) AS entity_valid_to,
    'bronze' AS _source
  FROM ${ref("visma_bronze_excel", "raw_entity_mapping")} r
  LEFT JOIN (
    SELECT UPPER(TRIM(entity_code)) AS entity_code, ANY_VALUE(tenant_id) AS tenant_id
    FROM ${ref("visma_silver_excel", "seed_entity_mapping")}
    GROUP BY 1
  ) m ON UPPER(TRIM(SAFE_CAST(r.entity_code AS STRING))) = m.entity_code
  WHERE r.company_id IS NOT NULL AND TRIM(r.company_id) != ''
--    AND COALESCE(r.deleted, '0') != '1'
),

-- Fallback: seed data for keys not yet in bronze
seed_rows AS (
  SELECT
    company_id,
    entity_code,
    entity_name,
    business_unit_code,
    business_unit_name,
    group_name,
    tenant_id,
    entity_valid_to,
    'seed' AS _source
  FROM ${ref("visma_silver_excel", "seed_entity_mapping")}
),

bronze_entity_code_keys AS (
  SELECT DISTINCT UPPER(TRIM(COALESCE(entity_code, ''))) AS entity_code_key
  FROM bronze_data
),

bronze_entity_name_keys AS (
  SELECT DISTINCT UPPER(TRIM(COALESCE(entity_name, ''))) AS entity_name_key
  FROM bronze_data
),

bronze_company_id_keys AS (
  SELECT DISTINCT company_id
  FROM bronze_data
  WHERE company_id IS NOT NULL
),

seed_data AS (
  SELECT
    IF(bci.company_id IS NULL, s.company_id, NULL) AS company_id,
    s.entity_code,
    s.entity_name,
    s.business_unit_code,
    s.business_unit_name,
    s.group_name,
    s.tenant_id,
    s.entity_valid_to,
    s._source
  FROM seed_rows AS s
  LEFT JOIN bronze_entity_code_keys AS bec
    ON UPPER(TRIM(COALESCE(s.entity_code, ''))) = bec.entity_code_key
  LEFT JOIN bronze_entity_name_keys AS ben
    ON UPPER(TRIM(COALESCE(s.entity_name, ''))) = ben.entity_name_key
  LEFT JOIN bronze_company_id_keys AS bci
    ON s.company_id = bci.company_id
  WHERE bec.entity_code_key IS NULL
    AND ben.entity_name_key IS NULL
)

SELECT
  company_id,
  entity_code,
  entity_name,
  business_unit_code,
  business_unit_name,
  group_name,
  tenant_id,
  entity_valid_to,
  CURRENT_TIMESTAMP() AS _loaded_at,
  _source
FROM bronze_data

UNION ALL

SELECT
  company_id,
  entity_code,
  entity_name,
  business_unit_code,
  business_unit_name,
  group_name,
  tenant_id,
  entity_valid_to,
  CURRENT_TIMESTAMP() AS _loaded_at,
  _source
FROM seed_data
