config {
  type: "table",
  schema: "visma_bronze",
  name: "visma_shipments",
  description: "Bronze: Outbound shipment headers and detail lines from Visma Global API.",
  tags: ["bronze", "visma"]
}

SELECT
  s.last_run_id AS `syncId`,
  s.updated_at AS `syncedAt`,
  s.first_seen_at AS `firstSyncedAt`,
  s.updated_at AS `refreshedAt`,
  CAST(NULL AS INT64) AS `seenInFullScopeRuns`,
  CAST(NULL AS INT64) AS `consecutiveMissingFullRuns`,
  s.deleted_at IS NOT NULL AS `isDeleted`,
  s.deleted_at AS `deletedAt`,
  s.tenant_id AS `tenantId`,
  CAST(NULL AS STRING) AS `syncBatch`,
  tenant.tenant_name AS `organizationName`,
  ${bronze.bool("container")} AS `container`,
  ${bronze.float("controlQuantity")} AS `controlQuantity`,
  ${bronze.str("currencyId")} AS `currencyId`,
  ${bronze.str("customer")} AS `customer`,
  ${bronze.str("deliveryAddress")} AS `deliveryAddress`,
  ${bronze.str("deliveryContact")} AS `deliveryContact`,
  ${bronze.float("freightAmt")} AS `freightAmt`,
  ${bronze.float("freightCost")} AS `freightCost`,
  ${bronze.str("fromWarehouse")} AS `fromWarehouse`,
  ${bronze.bool("hold")} AS `hold`,
  ${bronze.bool("insurance")} AS `insurance`,
  ${bronze.str("lastModifiedDateTime")} AS `lastModifiedDateTime`,
  ${bronze.str("location")} AS `location`,
  ${bronze.str("metadata")} AS `metadata`,
  ${bronze.str("note")} AS `note`,
  ${bronze.str("operation")} AS `operation`,
  ${bronze.int("packages")} AS `packages`,
  ${bronze.float("packagesWeight")} AS `packagesWeight`,
  ${bronze.bool("residentialDelivery")} AS `residentialDelivery`,
  ${bronze.bool("saturdayDelivery")} AS `saturdayDelivery`,
  ${bronze.str("shipmentDate")} AS `shipmentDate`,
  ${bronze.str("shipmentDetailLines")} AS `shipmentDetailLines`,
  ${bronze.str("shipmentNumber")} AS `shipmentNumber`,
  ${bronze.str("shipmentOrderLines")} AS `shipmentOrderLines`,
  ${bronze.str("shipmentType")} AS `shipmentType`,
  ${bronze.float("shippedQuantity")} AS `shippedQuantity`,
  ${bronze.float("shippedVolume")} AS `shippedVolume`,
  ${bronze.float("shippedWeight")} AS `shippedWeight`,
  ${bronze.str("status")} AS `status`,
  ${bronze.str("timeStamp")} AS `timeStamp`,
  ${bronze.str("transactionType")} AS `transactionType`,
  ${bronze.bool("useCustomerAccount")} AS `useCustomerAccount`,
  ${bronze.str("fobPoint")} AS `fobPoint`,
  ${bronze.str("modeOfTrasport")} AS `modeOfTrasport`,
  ${bronze.str("owner")} AS `owner`,
  ${bronze.float("packagesVolume")} AS `packagesVolume`,
  ${bronze.str("shipVia")} AS `shipVia`,
  ${bronze.str("shipmentPackageLines")} AS `shipmentPackageLines`,
  ${bronze.str("shippingTerms")} AS `shippingTerms`,
  ${bronze.str("toWarehouse")} AS `toWarehouse`,
  CAST(NULL AS STRING) AS `businessUnitId`,  -- v2 does not fetch this field
  CAST(NULL AS STRING) AS `businessUnitName`,  -- v2 does not fetch this field
  ${bronze.float("freightCurAmt")} AS `freightCurAmt`,
  ${bronze.float("freightCurCost")} AS `freightCurCost`
FROM ${ref("dw_staging_visma", "shipments")} AS s
LEFT JOIN ${ref("visma_tenants")} AS tenant ON tenant.tenant_id = s.tenant_id
