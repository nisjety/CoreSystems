config {
  type: "table",
  schema: "visma_bronze",
  name: "visma_projects",
  description: "Bronze: Project master data from Visma Global API.",
  tags: ["bronze", "visma"]
}

SELECT
  s.last_run_id AS `syncId`,
  s.updated_at AS `syncedAt`,
  s.first_seen_at AS `firstSyncedAt`,
  s.updated_at AS `refreshedAt`,
  CAST(NULL AS INT64) AS `seenInFullScopeRuns`,
  CAST(NULL AS INT64) AS `consecutiveMissingFullRuns`,
  s.deleted_at IS NOT NULL AS `isDeleted`,
  s.deleted_at AS `deletedAt`,
  s.tenant_id AS `tenantId`,
  CAST(NULL AS STRING) AS `syncBatch`,
  tenant.tenant_name AS `organizationName`,
  ${bronze.str("allocationRule")} AS `allocationRule`,
  ${bronze.str("attributes")} AS `attributes`,
  ${bronze.bool("autoAllocate")} AS `autoAllocate`,
  ${bronze.bool("automaticReleaseAr")} AS `automaticReleaseAr`,
  ${bronze.str("billingPeriod")} AS `billingPeriod`,
  ${bronze.str("billingRule")} AS `billingRule`,
  ${bronze.str("branch")} AS `branch`,
  ${bronze.str("customer")} AS `customer`,
  ${bronze.str("customerLocation")} AS `customerLocation`,
  ${bronze.str("defAccount")} AS `defAccount`,
  ${bronze.str("defSub")} AS `defSub`,
  ${bronze.str("description")} AS `description`,
  ${bronze.str("employees")} AS `employees`,
  ${bronze.bool("hold")} AS `hold`,
  ${bronze.int("internalID")} AS `internalID`,
  ${bronze.str("lastModifiedDateTime")} AS `lastModifiedDateTime`,
  ${bronze.str("metadata")} AS `metadata`,
  ${bronze.str("nextBillingDate")} AS `nextBillingDate`,
  ${bronze.str("note")} AS `note`,
  ${bronze.str("projectID")} AS `projectID`,
  ${bronze.str("projectManager")} AS `projectManager`,
  ${bronze.str("publicId")} AS `publicId`,
  ${bronze.str("rateTable")} AS `rateTable`,
  ${bronze.bool("restrictEmployees")} AS `restrictEmployees`,
  ${bronze.bool("restrictEquipment")} AS `restrictEquipment`,
  ${bronze.str("startDate")} AS `startDate`,
  ${bronze.str("status")} AS `status`,
  ${bronze.bool("systemTemplate")} AS `systemTemplate`,
  ${bronze.str("tasks")} AS `tasks`,
  ${bronze.str("template")} AS `template`,
  ${bronze.str("timeStamp")} AS `timeStamp`,
  ${bronze.str("visibility")} AS `visibility`,
  ${bronze.str("endDate")} AS `endDate`,
  ${bronze.str("lastBillingDate")} AS `lastBillingDate`,
  CAST(NULL AS STRING) AS `businessUnitId`,  -- v2 does not fetch this field
  CAST(NULL AS STRING) AS `businessUnitName`  -- v2 does not fetch this field
FROM ${ref("dw_staging_visma", "projects")} AS s
LEFT JOIN ${ref("visma_tenants")} AS tenant ON tenant.tenant_id = s.tenant_id
