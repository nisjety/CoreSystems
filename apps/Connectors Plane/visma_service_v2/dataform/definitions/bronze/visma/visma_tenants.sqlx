config {
  type: "table",
  schema: "visma_bronze",
  name: "visma_tenants",
  description: "The Visma tenants (companies) the pipeline fetches, from config/tenants/ of visma_service_v2. Gives every bronze row its organizationName.",
  tags: ["bronze", "visma"]
}

