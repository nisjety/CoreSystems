config {
  type: "table",
  schema: "visma_bronze",
  name: "visma_fixed_asset_transactions",
  description: "Bronze: Fixed asset lifecycle events (acquisition, depreciation, disposal) from Visma Global API.",
  tags: ["bronze", "visma"]
}

SELECT
  s.last_run_id AS `syncId`,
  s.updated_at AS `syncedAt`,
  s.first_seen_at AS `firstSyncedAt`,
  s.updated_at AS `refreshedAt`,
  CAST(NULL AS INT64) AS `seenInFullScopeRuns`,
  CAST(NULL AS INT64) AS `consecutiveMissingFullRuns`,
  s.deleted_at IS NOT NULL AS `isDeleted`,
  s.deleted_at AS `deletedAt`,
  s.tenant_id AS `tenantId`,
  CAST(NULL AS STRING) AS `syncBatch`,
  tenant.tenant_name AS `organizationName`,
  ${bronze.str("accounts")} AS `accounts`,
  ${bronze.str("assetID")} AS `assetID`,
  ${bronze.str("batchNo")} AS `batchNo`,
  ${bronze.str("bookID")} AS `bookID`,
  ${bronze.str("branchID")} AS `branchID`,
  ${bronze.str("lastModifiedDateTime")} AS `lastModifiedDateTime`,
  ${bronze.int("lineNo")} AS `lineNo`,
  ${bronze.str("metadata")} AS `metadata`,
  ${bronze.str("origin")} AS `origin`,
  ${bronze.str("refNo")} AS `refNo`,
  ${bronze.str("register")} AS `register`,
  ${bronze.float("transactionAmount")} AS `transactionAmount`,
  ${bronze.str("transactionDate")} AS `transactionDate`,
  ${bronze.str("transactionDescription")} AS `transactionDescription`,
  ${bronze.str("transactionPeriodID")} AS `transactionPeriodID`,
  ${bronze.str("transactionType")} AS `transactionType`,
  CAST(NULL AS STRING) AS `businessUnitId`,  -- v2 does not fetch this field
  CAST(NULL AS STRING) AS `businessUnitName`  -- v2 does not fetch this field
FROM ${ref("dw_staging_visma", "fixed_asset_transactions")} AS s
LEFT JOIN ${ref("visma_tenants")} AS tenant ON tenant.tenant_id = s.tenant_id
