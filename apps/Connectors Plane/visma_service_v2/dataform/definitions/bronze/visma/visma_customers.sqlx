config {
  type: "table",
  schema: "visma_bronze",
  name: "visma_customers",
  description: "Bronze: Customer master data from Visma Global API.",
  tags: ["bronze", "visma"]
}

SELECT
  s.last_run_id AS `syncId`,
  s.updated_at AS `syncedAt`,
  s.first_seen_at AS `firstSyncedAt`,
  s.updated_at AS `refreshedAt`,
  CAST(NULL AS INT64) AS `seenInFullScopeRuns`,
  CAST(NULL AS INT64) AS `consecutiveMissingFullRuns`,
  s.deleted_at IS NOT NULL AS `isDeleted`,
  s.deleted_at AS `deletedAt`,
  s.tenant_id AS `tenantId`,
  CAST(NULL AS STRING) AS `syncBatch`,
  tenant.tenant_name AS `organizationName`,
  ${bronze.bool("acceptAutoInvoices", "s.payload")} AS `acceptAutoInvoices`,
  ${bronze.str("attributes", "s.payload")} AS `attributes`,
  ${bronze.bool("consolidateInvoices", "s.payload")} AS `consolidateInvoices`,
  ${bronze.str("corporateId", "s.payload")} AS `corporateId`,
  ${bronze.str("createdDateTime", "s.payload")} AS `createdDateTime`,
  ${bronze.int("creditDaysPastDue", "s.payload")} AS `creditDaysPastDue`,
  ${bronze.float("creditLimit", "s.payload")} AS `creditLimit`,
  ${bronze.str("creditTerms", "s.payload")} AS `creditTerms`,
  ${bronze.str("creditVerification", "s.payload")} AS `creditVerification`,
  ${bronze.str("currencyId", "s.payload")} AS `currencyId`,
  ${bronze.str("customerClass", "s.payload")} AS `customerClass`,
  ${bronze.str("defaultPaymentMethodId", "s.payload")} AS `defaultPaymentMethodId`,
  ${bronze.str("deliveryAddress", "s.payload")} AS `deliveryAddress`,
  ${bronze.str("deliveryContact", "s.payload")} AS `deliveryContact`,
  ${bronze.bool("excludeDebtCollection", "s.payload")} AS `excludeDebtCollection`,
  ${bronze.int("internalId", "s.payload")} AS `internalId`,
  ${bronze.str("invoiceAddress", "s.payload")} AS `invoiceAddress`,
  ${bronze.str("invoiceContact", "s.payload")} AS `invoiceContact`,
  ${bronze.bool("invoiceToDefaultLocation", "s.payload")} AS `invoiceToDefaultLocation`,
  ${bronze.str("lastModifiedDateTime", "s.payload")} AS `lastModifiedDateTime`,
  ${bronze.str("location", "s.payload")} AS `location`,
  ${bronze.str("mainAddress", "s.payload")} AS `mainAddress`,
  ${bronze.str("mainContact", "s.payload")} AS `mainContact`,
  ${bronze.str("metadata", "s.payload")} AS `metadata`,
  ${bronze.str("name", "s.payload")} AS `name`,
  ${bronze.str("number", "s.payload")} AS `number`,
  ${bronze.str("paymentMethods", "s.payload")} AS `paymentMethods`,
  ${bronze.bool("printDunningLetters", "s.payload")} AS `printDunningLetters`,
  ${bronze.bool("printInvoices", "s.payload")} AS `printInvoices`,
  ${bronze.bool("printMultiCurrencyStatements", "s.payload")} AS `printMultiCurrencyStatements`,
  ${bronze.bool("printStatements", "s.payload")} AS `printStatements`,
  ${bronze.bool("sendDunningLettersViaEMail", "s.payload")} AS `sendDunningLettersViaEMail`,
  ${bronze.bool("sendInvoicesByEmail", "s.payload")} AS `sendInvoicesByEmail`,
  ${bronze.bool("sendStatementsByEmail", "s.payload")} AS `sendStatementsByEmail`,
  ${bronze.str("statementType", "s.payload")} AS `statementType`,
  ${bronze.str("status", "s.payload")} AS `status`,
  ${bronze.str("timeStamp", "s.payload")} AS `timeStamp`,
  ${bronze.str("vatRegistrationId", "s.payload")} AS `vatRegistrationId`,
  ${bronze.str("vatZone", "s.payload")} AS `vatZone`,
  ${bronze.str("priceClass", "s.payload")} AS `priceClass`,
  ${bronze.str("addressLine1", "o.payload")} AS `addressLine1`,
  ${bronze.str("addressLine2", "o.payload")} AS `addressLine2`,
  ${bronze.str("country", "o.payload")} AS `country`,
  ${bronze.str("customerClassId", "o.payload")} AS `customerClassId`,
  ${bronze.str("defaultLocation", "o.payload")} AS `defaultLocation`,
  ${bronze.str("exportType", "o.payload")} AS `exportType`,
  ${bronze.str("id", "o.payload")} AS `id`,
  ${bronze.str("postalCode", "o.payload")} AS `postalCode`,
  ${bronze.str("salesAccountId", "o.payload")} AS `salesAccountId`,
  ${bronze.str("salesExportAccountId", "o.payload")} AS `salesExportAccountId`,
  ${bronze.str("salesNonTaxableAccountId", "o.payload")} AS `salesNonTaxableAccountId`,
  ${bronze.str("salutation", "o.payload")} AS `salutation`,
  ${bronze.str("salesEuAccountId", "o.payload")} AS `salesEuAccountId`,
  CAST(NULL AS STRING) AS `businessUnitId`,  -- v2 does not fetch this field
  CAST(NULL AS STRING) AS `businessUnitName`,  -- v2 does not fetch this field

  -- Fields v2 fetches that the v1 table never had
  ${bronze.str("glAccounts", "s.payload")} AS `glAccounts`,
  ${bronze.str("gln", "s.payload")} AS `gln`,
  ${bronze.bool("invoiceOrdersSeparately", "s.payload")} AS `invoiceOrdersSeparately`,
  ${bronze.str("parentRecord", "s.payload")} AS `parentRecord`
FROM ${ref("dw_staging_visma", "customers")} AS s
LEFT JOIN (SELECT * FROM ${ref("dw_staging_visma", "sales_order_customers")} WHERE deleted_at IS NULL) AS o
  ON o.tenant_id = s.tenant_id AND JSON_VALUE(o.payload, '$.id') = JSON_VALUE(s.payload, '$.number')
LEFT JOIN ${ref("visma_tenants")} AS tenant ON tenant.tenant_id = s.tenant_id
