config {
  type: "table",
  schema: "visma_bronze",
  name: "visma_landed_cost_codes",
  description: "Bronze: Import/landed cost tracking codes from Visma Global API.",
  tags: ["bronze", "visma"]
}

SELECT
  s.last_run_id AS `syncId`,
  s.updated_at AS `syncedAt`,
  s.first_seen_at AS `firstSyncedAt`,
  s.updated_at AS `refreshedAt`,
  CAST(NULL AS INT64) AS `seenInFullScopeRuns`,
  CAST(NULL AS INT64) AS `consecutiveMissingFullRuns`,
  s.deleted_at IS NOT NULL AS `isDeleted`,
  s.deleted_at AS `deletedAt`,
  s.tenant_id AS `tenantId`,
  CAST(NULL AS STRING) AS `syncBatch`,
  tenant.tenant_name AS `organizationName`,
  ${bronze.str("allocationMethod")} AS `allocationMethod`,
  ${bronze.str("applicationMethod")} AS `applicationMethod`,
  ${bronze.str("description")} AS `description`,
  ${bronze.str("landedCostAccrualAccount")} AS `landedCostAccrualAccount`,
  ${bronze.str("landedCostAccrualSubaccount")} AS `landedCostAccrualSubaccount`,
  ${bronze.str("landedCostCodeId")} AS `landedCostCodeId`,
  ${bronze.str("landedCostType")} AS `landedCostType`,
  ${bronze.str("landedCostVarianceAccount")} AS `landedCostVarianceAccount`,
  ${bronze.str("landedCostVarianceSubaccount")} AS `landedCostVarianceSubaccount`,
  ${bronze.str("metadata")} AS `metadata`,
  ${bronze.str("reasonCode")} AS `reasonCode`,
  ${bronze.str("terms")} AS `terms`,
  ${bronze.str("vatCategory")} AS `vatCategory`,
  CAST(NULL AS STRING) AS `businessUnitId`,  -- v2 does not fetch this field
  CAST(NULL AS STRING) AS `businessUnitName`  -- v2 does not fetch this field
FROM ${ref("dw_staging_visma", "landed_cost_codes")} AS s
LEFT JOIN ${ref("visma_tenants")} AS tenant ON tenant.tenant_id = s.tenant_id
