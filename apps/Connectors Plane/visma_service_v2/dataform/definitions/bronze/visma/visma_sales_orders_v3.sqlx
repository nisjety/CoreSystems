config {
  type: "table",
  schema: "visma_bronze",
  name: "visma_sales_orders_v3",
  description: "Bronze: Sales order headers and lines from Visma SalesOrder V3 API from Visma Global API.",
  tags: ["bronze", "visma"]
}

SELECT
  s.last_run_id AS `syncId`,
  s.updated_at AS `syncedAt`,
  s.tenant_id AS `tenantId`,
  CAST(NULL AS STRING) AS `syncBatch`,
  tenant.tenant_name AS `organizationName`,
  ${bronze.str("attachments")} AS `attachments`,
  ${bronze.str("billing")} AS `billing`,
  ${bronze.str("branch")} AS `branch`,
  ${bronze.object("branch", {"number": "id", "name": "description"})} AS `branchNumber`,
  ${bronze.str("cancelBy")} AS `cancelBy`,
  ${bronze.bool("statusDetails.cancelled")} AS `canceled`,
  ${bronze.str("paymentSettings.cashAccountId")} AS `cashAccountId`,
  ${bronze.str("financialInformation.cashDiscountDate")} AS `cashDiscountDate`,
  ${bronze.str("createdBy")} AS `createdBy`,
  ${bronze.str("currency")} AS `currency`,
  ${bronze.float("currencyRate")} AS `currencyRate`,
  ${bronze.str("customFields")} AS `customFields`,
  ${bronze.str("customer")} AS `customer`,
  ${bronze.str("customerId")} AS `customerId`,
  ${bronze.str("customerName")} AS `customerName`,
  ${bronze.str("customerOrder")} AS `customerOrder`,
  ${bronze.str("customerRefNo")} AS `customerRefNo`,
  ${bronze.str("date")} AS `date`,
  ${bronze.str("description")} AS `description`,
  ${bronze.float("totals.discountTotal")} AS `discountTotal`,
  ${bronze.float("totals.discountTotalInBaseCurrency")} AS `discountTotalInBaseCurrency`,
  ${bronze.str("financialInformation.dueDate")} AS `dueDate`,
  ${bronze.bool("emailed")} AS `emailed`,
  ${bronze.str("financialInformation")} AS `financialInformation`,
  ${bronze.object("shipping.fobPoint", {"id": "id", "description": "description", "name": "description"})} AS `fobPoint`,
  ${bronze.str("freight")} AS `freight`,
  ${bronze.bool("statusDetails.hold")} AS `hold`,
  ${bronze.bool("shipping.insurance")} AS `insurance`,
  ${bronze.str("financialInformation.invoiceDate")} AS `invoiceDate`,
  ${bronze.bool("isRotRutDeductible")} AS `isRotRutDeductible`,
  ${bronze.str("lastModified")} AS `lastModified`,
  ${bronze.str("lastModified")} AS `lastModifiedDateTime`,
  CAST(NULL AS STRING) AS `lines`,  -- v2 does not fetch this field
  ${bronze.str("location")} AS `location`,
  ${bronze.str("orderId")} AS `orderId`,
  ${bronze.str("orderLines")} AS `orderLines`,
  ${bronze.str("orderId")} AS `orderNo`,
  ${bronze.float("orderQty")} AS `orderQty`,
  ${bronze.float("orderTotal")} AS `orderTotal`,
  ${bronze.float("totals.orderTotalInBaseCurrency")} AS `orderTotalInBaseCurrency`,
  ${bronze.str("type")} AS `orderType`,
  ${bronze.str("origin")} AS `origin`,
  ${bronze.str("originalOrderId")} AS `originalOrderId`,
  ${bronze.str("originalOrderType")} AS `originalOrderType`,
  ${bronze.str("owner")} AS `owner`,
  ${bronze.str("parentCustomer")} AS `parentCustomer`,
  ${bronze.object("paymentSettings.paymentMethod", {"id": "id", "description": "description", "name": "description"})} AS `paymentMethod`,
  ${bronze.str("paymentSettings.paymentReference")} AS `paymentReference`,
  ${bronze.str("paymentSettings")} AS `paymentSettings`,
  ${bronze.str("financialInformation.postPeriod")} AS `postPeriod`,
  ${bronze.object("shipping.preferredWarehouse", {"id": "id", "description": "description", "name": "description"})} AS `preferredWarehouse`,
  ${bronze.str("print")} AS `print`,
  ${bronze.int("shipping.priority")} AS `priority`,
  ${bronze.str("project")} AS `project`,
  ${bronze.str("requestOn")} AS `requestOn`,
  ${bronze.bool("shipping.residentialDelivery")} AS `residentialDelivery`,
  ${bronze.str("salesPerson")} AS `salesPerson`,
  ${bronze.bool("shipping.saturdayDelivery")} AS `saturdayDelivery`,
  ${bronze.bool("shipping.shipSeparately")} AS `shipSeparately`,
  ${bronze.object("shipping.shipVia", {"id": "id", "description": "description", "name": "description"})} AS `shipVia`,
  ${bronze.str("shipment")} AS `shipment`,
  CAST(NULL AS STRING) AS `shipments`,  -- v2 does not fetch this field
  ${bronze.str("shipping")} AS `shipping`,
  ${bronze.str("shippingScheduledDate")} AS `shippingScheduledDate`,
  ${bronze.object("shipping.terms", {"id": "id", "description": "description", "name": "description"})} AS `shippingTerms`,
  ${bronze.object("shipping.zone", {"id": "id", "description": "description", "name": "description"})} AS `shippingZone`,
  ${bronze.object("billing.address", {"addressId": ["id", "int"], "overrideAddress": ["overridesDefault", "bool"], "addressLine1": "line1", "addressLine2": "line2", "addressLine3": "line3", "postalCode": "postalCode", "city": "city", "country": "country.id", "county": "county.id"})} AS `soBillingAddress`,
  ${bronze.object("billing.contact", {"contactId": ["id", "int"], "overrideContact": ["overridesDefault", "bool"], "name": "name", "attention": "attention", "email": "email", "phone1": "phone1", "phone2": "phone2", "fax": "fax"})} AS `soBillingContact`,
  ${bronze.object("shipping.address", {"addressId": ["id", "int"], "overrideAddress": ["overridesDefault", "bool"], "addressLine1": "line1", "addressLine2": "line2", "addressLine3": "line3", "postalCode": "postalCode", "city": "city", "country": "country.id", "county": "county.id"})} AS `soShippingAddress`,
  ${bronze.object("shipping.contact", {"contactId": ["id", "int"], "overrideContact": ["overridesDefault", "bool"], "name": "name", "attention": "attention", "email": "email", "phone1": "phone1", "phone2": "phone2", "fax": "fax"})} AS `soShippingContact`,
  ${bronze.str("status")} AS `status`,
  ${bronze.str("statusDetails")} AS `statusDetails`,
  ${bronze.float("taxTotal")} AS `taxTotal`,
  ${bronze.float("totals.taxTotalInBaseCurrency")} AS `taxTotalInBaseCurrency`,
  ${bronze.object("financialInformation.terms", {"id": "id", "description": "description", "name": "description"})} AS `terms`,
  ${bronze.str("version")} AS `timeStamp`,
  ${bronze.str("totals")} AS `totals`,
  ${bronze.str("type")} AS `type`,
  ${bronze.bool("useReplacementCostForMarginAndProfit")} AS `useReplacementCostForMarginAndProfit`,
  ${bronze.float("totals.taxExemptTotal")} AS `vatExemptTotal`,
  ${bronze.float("totals.taxExemptTotalInBaseCurrency")} AS `vatExemptTotalInBaseCurrency`,
  ${bronze.float("totals.taxableTotal")} AS `vatTaxableTotal`,
  ${bronze.float("totals.taxableTotalInBaseCurrency")} AS `vatTaxableTotalInBaseCurrency`,
  ${bronze.str("version")} AS `version`,
  s.first_seen_at AS `firstSyncedAt`,
  s.updated_at AS `refreshedAt`,
  s.deleted_at IS NOT NULL AS `isDeleted`,
  s.deleted_at AS `deletedAt`,
  CAST(NULL AS INT64) AS `seenInFullScopeRuns`,
  CAST(NULL AS INT64) AS `consecutiveMissingFullRuns`,
  ${bronze.str("discounts")} AS `discounts`,
  ${bronze.str("tax")} AS `tax`,
  ${bronze.float("totals.costTotal")} AS `costTotal`,
  ${bronze.float("totals.costTotalInBaseCurrency")} AS `costTotalInBaseCurrency`,
  ${bronze.str("totals.exciseDutyTotal")} AS `exciseDutyTotal`,
  ${bronze.str("totals.exciseDutyTotalInBaseCurrency")} AS `exciseDutyTotalInBaseCurrency`,
  ${bronze.float("totals.freightCost")} AS `freightCost`,
  ${bronze.float("totals.freightCostInBaseCurrency")} AS `freightCostInBaseCurrency`,
  ${bronze.float("totals.freightTotal")} AS `freightTotal`,
  ${bronze.float("totals.freightTotalInBaseCurrency")} AS `freightTotalInBaseCurrency`,
  ${bronze.object("shipping.intrastatTransactionType", {"id": ["id", "int"], "description": "description"})} AS `intrastatTransactionType`,
  ${bronze.str("financialInformation.invoiceId")} AS `invoiceId`,
  ${bronze.bool("financialInformation.invoiceSeparately")} AS `invoiceSeparately`,
  ${bronze.str("totals.paymentTotal")} AS `paymentTotal`,
  ${bronze.str("totals.paymentTotalInBaseCurrency")} AS `paymentTotalInBaseCurrency`,
  ${bronze.str("shipping.scheduledDate")} AS `scheduledDate`,
  ${bronze.str("shipping.rule")} AS `shippingRule`,
  ${bronze.float("totals.unbilledAmount")} AS `unbilledAmount`,
  ${bronze.float("totals.unbilledAmountInBaseCurrency")} AS `unbilledAmountInBaseCurrency`,
  ${bronze.float("totals.unshippedAmount")} AS `unshippedAmount`,
  ${bronze.float("totals.unshippedAmountInBaseCurrency")} AS `unshippedAmountInBaseCurrency`,
  CAST(NULL AS STRING) AS `businessUnitId`,  -- v2 does not fetch this field
  CAST(NULL AS STRING) AS `businessUnitName`,  -- v2 does not fetch this field

  -- Fields v2 fetches that the v1 table never had
  ${bronze.str("commissions")} AS `commissions`,
  ${bronze.str("note")} AS `note`,
  ${bronze.str("payments")} AS `payments`
FROM ${ref("dw_staging_visma", "sales_orders_v3")} AS s
LEFT JOIN ${ref("visma_tenants")} AS tenant ON tenant.tenant_id = s.tenant_id
