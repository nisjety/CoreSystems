config {
  type: "table",
  schema: "visma_bronze",
  name: "visma_purchase_orders",
  description: "Bronze: Purchase order headers and lines from Visma Global API.",
  tags: ["bronze", "visma"]
}

SELECT
  s.last_run_id AS `syncId`,
  s.updated_at AS `syncedAt`,
  s.first_seen_at AS `firstSyncedAt`,
  s.updated_at AS `refreshedAt`,
  CAST(NULL AS INT64) AS `seenInFullScopeRuns`,
  CAST(NULL AS INT64) AS `consecutiveMissingFullRuns`,
  s.deleted_at IS NOT NULL AS `isDeleted`,
  s.deleted_at AS `deletedAt`,
  s.tenant_id AS `tenantId`,
  CAST(NULL AS STRING) AS `syncBatch`,
  tenant.tenant_name AS `organizationName`,
  ${bronze.str("branch")} AS `branch`,
  ${bronze.float("controlTotal")} AS `controlTotal`,
  ${bronze.float("controlTotalInBaseCurrency")} AS `controlTotalInBaseCurrency`,
  ${bronze.str("currency")} AS `currency`,
  ${bronze.str("date")} AS `date`,
  ${bronze.str("description")} AS `description`,
  ${bronze.str("discountDetails")} AS `discountDetails`,
  ${bronze.bool("dontEmail")} AS `dontEmail`,
  ${bronze.bool("dontPrint")} AS `dontPrint`,
  ${bronze.bool("emailed")} AS `emailed`,
  ${bronze.float("exchangeRate")} AS `exchangeRate`,
  ${bronze.bool("hold")} AS `hold`,
  ${bronze.str("lastModifiedDateTime")} AS `lastModifiedDateTime`,
  ${bronze.float("lineTotal")} AS `lineTotal`,
  ${bronze.float("lineTotalInBaseCurrency")} AS `lineTotalInBaseCurrency`,
  ${bronze.str("lines")} AS `lines`,
  ${bronze.str("location")} AS `location`,
  ${bronze.str("metadata")} AS `metadata`,
  ${bronze.str("note")} AS `note`,
  ${bronze.float("openBalance")} AS `openBalance`,
  ${bronze.float("openQuantity")} AS `openQuantity`,
  ${bronze.str("orderNbr")} AS `orderNbr`,
  ${bronze.float("orderTotal")} AS `orderTotal`,
  ${bronze.float("orderTotalInBaseCurrency")} AS `orderTotalInBaseCurrency`,
  ${bronze.str("orderType")} AS `orderType`,
  ${bronze.str("owner")} AS `owner`,
  ${bronze.bool("printed")} AS `printed`,
  ${bronze.str("promisedOn")} AS `promisedOn`,
  ${bronze.str("purchaseReceipts")} AS `purchaseReceipts`,
  ${bronze.str("remitAddress")} AS `remitAddress`,
  ${bronze.str("remitContact")} AS `remitContact`,
  ${bronze.str("shipTo")} AS `shipTo`,
  ${bronze.str("shippingAddress")} AS `shippingAddress`,
  ${bronze.str("shippingContact")} AS `shippingContact`,
  ${bronze.str("shippingDestinationType")} AS `shippingDestinationType`,
  ${bronze.str("status")} AS `status`,
  ${bronze.str("supplier")} AS `supplier`,
  ${bronze.str("supplierVatZone")} AS `supplierVatZone`,
  ${bronze.str("taxDetails")} AS `taxDetails`,
  ${bronze.float("taxTotal")} AS `taxTotal`,
  ${bronze.float("taxTotalInBaseCurrency")} AS `taxTotalInBaseCurrency`,
  ${bronze.str("terms")} AS `terms`,
  ${bronze.str("timeStamp")} AS `timeStamp`,
  ${bronze.float("vatExemptTotal")} AS `vatExemptTotal`,
  ${bronze.float("vatExemptTotalInBaseCurrency")} AS `vatExemptTotalInBaseCurrency`,
  ${bronze.str("warehouse")} AS `warehouse`,
  ${bronze.str("salesOrderNbr")} AS `salesOrderNbr`,
  ${bronze.str("salesOrderType")} AS `salesOrderType`,
  ${bronze.str("shippingLocation")} AS `shippingLocation`,
  ${bronze.str("supplierRef")} AS `supplierRef`,
  ${bronze.str("shipTerms")} AS `shipTerms`,
  ${bronze.str("shipVia")} AS `shipVia`,
  CAST(NULL AS STRING) AS `businessUnitId`,  -- v2 does not fetch this field
  CAST(NULL AS STRING) AS `businessUnitName`  -- v2 does not fetch this field
FROM ${ref("dw_staging_visma", "purchase_orders")} AS s
LEFT JOIN ${ref("visma_tenants")} AS tenant ON tenant.tenant_id = s.tenant_id
