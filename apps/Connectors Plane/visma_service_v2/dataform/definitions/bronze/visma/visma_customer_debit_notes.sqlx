config {
  type: "table",
  schema: "visma_bronze",
  name: "visma_customer_debit_notes",
  description: "Bronze: Customer debit note (AR debit adjustment) headers and lines from Visma Global API.",
  tags: ["bronze", "visma"]
}

SELECT
  s.last_run_id AS `syncId`,
  s.updated_at AS `syncedAt`,
  s.first_seen_at AS `firstSyncedAt`,
  s.updated_at AS `refreshedAt`,
  CAST(NULL AS INT64) AS `seenInFullScopeRuns`,
  CAST(NULL AS INT64) AS `consecutiveMissingFullRuns`,
  s.deleted_at IS NOT NULL AS `isDeleted`,
  s.deleted_at AS `deletedAt`,
  s.tenant_id AS `tenantId`,
  CAST(NULL AS STRING) AS `syncBatch`,
  tenant.tenant_name AS `organizationName`,
  ${bronze.str("account")} AS `account`,
  ${bronze.float("amount")} AS `amount`,
  ${bronze.float("amountInCurrency")} AS `amountInCurrency`,
  ${bronze.str("attachments")} AS `attachments`,
  ${bronze.float("balance")} AS `balance`,
  ${bronze.float("balanceInCurrency")} AS `balanceInCurrency`,
  ${bronze.str("branchNumber")} AS `branchNumber`,
  ${bronze.str("cashAccount")} AS `cashAccount`,
  ${bronze.float("cashDiscount")} AS `cashDiscount`,
  ${bronze.str("cashDiscountDate")} AS `cashDiscountDate`,
  ${bronze.float("cashDiscountInCurrency")} AS `cashDiscountInCurrency`,
  ${bronze.str("childRecord")} AS `childRecord`,
  ${bronze.str("closedFinancialPeriod")} AS `closedFinancialPeriod`,
  ${bronze.str("contact")} AS `contact`,
  ${bronze.str("createdDateTime")} AS `createdDateTime`,
  ${bronze.str("creditTerms")} AS `creditTerms`,
  ${bronze.str("currencyId")} AS `currencyId`,
  ${bronze.str("customer")} AS `customer`,
  ${bronze.str("customerRefNumber")} AS `customerRefNumber`,
  ${bronze.str("customerVatZone")} AS `customerVatZone`,
  ${bronze.float("detailTotal")} AS `detailTotal`,
  ${bronze.float("detailTotalInCurrency")} AS `detailTotalInCurrency`,
  ${bronze.float("discountTotal")} AS `discountTotal`,
  ${bronze.float("discountTotalInCurrency")} AS `discountTotalInCurrency`,
  ${bronze.str("documentDate")} AS `documentDate`,
  ${bronze.str("documentDueDate")} AS `documentDueDate`,
  ${bronze.str("documentType")} AS `documentType`,
  ${bronze.bool("dontEmail")} AS `dontEmail`,
  ${bronze.bool("dontPrint")} AS `dontPrint`,
  ${bronze.float("exchangeRate")} AS `exchangeRate`,
  ${bronze.str("externalReference")} AS `externalReference`,
  ${bronze.str("financialPeriod")} AS `financialPeriod`,
  ${bronze.bool("hold")} AS `hold`,
  ${bronze.str("invoiceText")} AS `invoiceText`,
  ${bronze.str("lastModifiedDateTime")} AS `lastModifiedDateTime`,
  ${bronze.str("lines")} AS `lines`,
  ${bronze.str("location")} AS `location`,
  ${bronze.str("metadata")} AS `metadata`,
  ${bronze.str("note")} AS `note`,
  ${bronze.str("paymentMethod")} AS `paymentMethod`,
  ${bronze.str("paymentReference")} AS `paymentReference`,
  ${bronze.str("postPeriod")} AS `postPeriod`,
  ${bronze.str("project")} AS `project`,
  ${bronze.str("referenceNumber")} AS `referenceNumber`,
  ${bronze.bool("revoked")} AS `revoked`,
  ${bronze.float("roundingDiff")} AS `roundingDiff`,
  ${bronze.str("salesPersonDescr")} AS `salesPersonDescr`,
  ${bronze.int("salesPersonID")} AS `salesPersonID`,
  ${bronze.str("status")} AS `status`,
  ${bronze.str("subaccount")} AS `subaccount`,
  ${bronze.str("taxDetails")} AS `taxDetails`,
  ${bronze.str("timeStamp")} AS `timeStamp`,
  ${bronze.float("vatExemptTotal")} AS `vatExemptTotal`,
  ${bronze.float("vatExemptTotalInCurrency")} AS `vatExemptTotalInCurrency`,
  ${bronze.float("vatTaxableTotal")} AS `vatTaxableTotal`,
  ${bronze.float("vatTaxableTotalInCurrency")} AS `vatTaxableTotalInCurrency`,
  ${bronze.float("vatTotal")} AS `vatTotal`,
  ${bronze.float("vatTotalInCurrency")} AS `vatTotalInCurrency`,
  CAST(NULL AS STRING) AS `businessUnitId`,  -- v2 does not fetch this field
  CAST(NULL AS STRING) AS `businessUnitName`,  -- v2 does not fetch this field
  CAST(NULL AS STRING) AS `dunningLetterDate`,  -- v2 does not fetch this field
  CAST(NULL AS INT64) AS `dunningLetterLevel`,  -- v2 does not fetch this field

  -- Fields v2 fetches that the v1 table never had
  ${bronze.str("applications")} AS `applications`,
  ${bronze.str("invoiceAddress")} AS `invoiceAddress`,
  ${bronze.str("invoiceContact")} AS `invoiceContact`
FROM ${ref("dw_staging_visma", "customer_debit_notes")} AS s
LEFT JOIN ${ref("visma_tenants")} AS tenant ON tenant.tenant_id = s.tenant_id
