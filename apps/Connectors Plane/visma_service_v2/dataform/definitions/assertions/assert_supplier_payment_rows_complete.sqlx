config {
  type: "assertion",
  schema: "visma_assertions",
  name: "assert_supplier_payment_rows_complete",
  description: "Silver must hold every supplier payment document that bronze holds. Returns one row per tenant where the number of distinct (type, refNbr), the staging key of visma_bronze.visma_supplier_payments, differs from the rows of visma_silver.fact_supplier_payment. A payment (or Prepayment, or Refund) and its Void document share one refNbr, so a key without the type silently drops one half of each pair (108 documents in 2026-10).",
  tags: ["assertion", "silver", "supplier_payment"]
}

WITH bronze AS (
  SELECT
    tenantId AS tenant_id,
    COUNT(DISTINCT FORMAT('%t|%t', type, refNbr)) AS bronze_rows
  FROM ${ref("visma_bronze", "visma_supplier_payments")}
  WHERE isDeleted IS DISTINCT FROM TRUE
  GROUP BY tenantId
),

silver AS (
  SELECT tenant_id, COUNT(*) AS silver_rows
  FROM ${ref("visma_silver", "fact_supplier_payment")}
  GROUP BY tenant_id
)

SELECT
  COALESCE(bronze.tenant_id, silver.tenant_id) AS tenant_id,
  COALESCE(bronze_rows, 0) AS bronze_rows,
  COALESCE(silver_rows, 0) AS silver_rows
FROM bronze
FULL OUTER JOIN silver ON bronze.tenant_id = silver.tenant_id
WHERE COALESCE(bronze_rows, 0) != COALESCE(silver_rows, 0)
