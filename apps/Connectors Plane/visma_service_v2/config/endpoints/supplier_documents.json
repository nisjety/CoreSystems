{
  "endpoint_name": "supplier_documents",
  "bigquery_table": "visma_supplier_documents",
  "primary_key": [
    "documentType",
    "referenceNumber"
  ],
  "source": "erp_rest",
  "api_method": "get_supplier_documents",
  "api_endpoint": "/v1/supplierdocument",
  "pagination_profile": "finance_page_number",
  "modified_field": "lastModifiedDateTime",
  "merge_type": "upsert",
  "sync_pattern": "incremental_upsert",
  "validation_fields": [
    "documentType",
    "referenceNumber",
    "lastModifiedDateTime"
  ],
  "datamart": {
    "ready": false,
    "pilot_override": false,
    "query_file": "config/queries/supplier_document.graphql",
    "cursor_field": "updatedInDataMartDateTime",
    "id_field": "id",
    "company_filter": true,
    "fallback_source": "erp_rest",
    "root_field": "supplierDocuments",
    "type_name": "SupplierDocument"
  },
  "default_query": {
    "expandApproval": "true",
    "expandNote": "true",
    "expandLinePrebookAccounts": "true"
  }
}
