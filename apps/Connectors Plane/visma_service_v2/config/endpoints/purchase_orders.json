  "pagination_profile": "finance_page_number",
  "modified_field": "lastModifiedDateTime",
  "merge_type": "upsert",
  "sync_pattern": "incremental_upsert",
  "validation_fields": [
    "orderNbr",
    "lastModifiedDateTime"
  ],
  "datamart": {
    "ready": false,
    "pilot_override": false,
    "query_file": "config/queries/purchase_order.graphql",
    "cursor_field": "updatedInDataMartDateTime",
