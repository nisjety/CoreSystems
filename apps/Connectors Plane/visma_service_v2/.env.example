# --- Visma OAuth ---
VISMA_CLIENT_ID=
VISMA_CLIENT_SECRET=
VISMA_TOKEN_URL=https://connect.visma.com/connect/token
# Same naming as v1 service
VISMA_SCOPES=vismanet_erp_service_api
# Backward-compatible alias accepted by v2 config (used only if VISMA_SCOPES is unset)
VISMA_OAUTH_SCOPE=
VISMA_OAUTH_SCOPE_DATAMART=visma_datamart:read
# Keep quoted if multiple scopes are used.
VISMA_OAUTH_SCOPE_EXPENSE="expense-public-api:transaction-read"
VISMA_OAUTH_SCOPE_SALESORDER=visma.net.erp.salesorder:read

# --- API base URLs ---
VISMA_ERP_REST_BASE_URL=https://api.finance.visma.net
VISMA_DATAMART_GRAPHQL_URL=https://datamart.visma.net/graphql
VISMA_EXPENSE_API_BASE_URL=https://expense.visma.net/expense-services/services

# --- Pilot tenant ---
# Run `vsv2 dm-companies` to discover the DataMart company ID for your tenant.
VSV2_PILOT_TENANT_ID=33f319b9-4d57-11ee-960c-025417856183
VSV2_AQUATIQ_DATAMART_COMPANY_ID=

# --- State store (Postgres + Redis) ---
VSV2_DATABASE_URL=postgres://visma_v2:visma_v2@localhost:55433/visma_v2
VSV2_REDIS_URL=redis://localhost:56380/0

# --- BigQuery ---
GOOGLE_APPLICATION_CREDENTIALS=
# The GCP project everything is written to (the new warehouse: aquatiq-datavarehus).
VSV2_BIGQUERY_PROJECT=
# Where the staging dataset is created when it does not exist (an existing dataset keeps its own).
VSV2_BIGQUERY_LOCATION=europe-north2
# Raw staging (one JSON table per endpoint). When set, syncs write here via vsv2-bq-stage and the
# typed bronze merge below is not used. The tooling virtualenv's bin must be on PATH.
VSV2_BIGQUERY_DATASET_STAGING=dw_staging_visma
VSV2_BIGQUERY_DATASET_BRONZE=visma_bronze_v2
VSV2_BIGQUERY_DATASET_SHADOW=visma_bronze_v2_shadow

# --- Local bronze sink (Postgres fallback when BigQuery is unset) ---
VSV2_LOCAL_BRONZE_POSTGRES_ENABLED=true

# --- Rate limits (requests per minute / per day) ---
VSV2_RATELIMIT_ERP_REST_RPM=60
VSV2_RATELIMIT_ERP_REST_RPD=5000
VSV2_RATELIMIT_DATAMART_RPM=60
VSV2_RATELIMIT_DATAMART_RPD=10000
VSV2_RATELIMIT_EXPENSE_RPM=30
VSV2_RATELIMIT_EXPENSE_RPD=2000

# --- docker compose scheduler (compose-only, read by docker-compose.yml) ---
# Google credentials mounted read-only into the container; default is the gcloud ADC file.
# On a server: a service-account key readable by uid 1001.
# VSV2_GCP_CREDENTIALS_FILE=/path/to/key.json
# The scheduler's own request budget (the limits above apply to manual `vsv2 sync`):
# VSV2_SCHEDULER_ERP_RPM=240
# VSV2_SCHEDULER_ERP_RPD=345600

# --- Logging ---
VSV2_LOG_LEVEL=info

# --- Layer 3 (interactive/write) — leave unset to keep writes impossible ---
# Not used by any operation today: every write goes to the SalesOrders v3 API, which has the scope below.
VISMA_OAUTH_SCOPE_ERP_WRITE=
# Confirmed against the public SalesOrder V3 swagger (2026-10-09):
VISMA_OAUTH_SCOPE_SALESORDER_WRITE=visma.net.erp.salesorder:write
# Comma-separated tenant ids and operation names allowed to write (default: none)
VSV2_WRITE_ENABLED_TENANTS=
# e.g. salesorder.patch,salesorder.create,salesorder.set_status
VSV2_WRITE_ENABLED_OPERATIONS=
# HMAC secret binding dry-run plans to execute (required to execute)
VSV2_WRITE_CONFIRM_SECRET=

# --- Layer 4 (MCP server, vsv2-mcp) ---
# Warehouse project for the warehouse_* tools: the v2 warehouse, aquatiq-datavarehus (the project
# VSV2_BIGQUERY_PROJECT writes to). Leave it empty to leave the warehouse tools out.
VSV2_MCP_BQ_PROJECT=aquatiq-datavarehus
# Readable datasets of that project, exact names or a prefix ending in * (this is the default; list fewer to
# narrow it). Not readable by default: visma_assertions, visma_silver_excel, visma_bronze_excel, the Xero and
# currency datasets. A project other than aquatiq-datavarehus needs its own list.
# VSV2_MCP_BQ_DATASETS=visma_gold_*,visma_silver,visma_silver_common,visma_bronze,visma_datamart,dw_staging_visma
# VSV2_MCP_BQ_MAX_BYTES=2147483648
# Register the write tools (also needs the write scope, confirm secret and allow-lists above)
VSV2_MCP_ENABLE_WRITES=
# elicitation (default): the user approves each write in their client. permission_prompt: weaker opt-in
# for clients without elicitation support.
# VSV2_MCP_WRITE_APPROVAL=elicitation
# VSV2_MCP_BQ_MAX_BYTES_PER_HOUR=21474836480
# VSV2_MCP_CALLER=mcp:you

# --- Sign in as yourself (vsv2-mcp login) — optional ---
# With these set, `vsv2-mcp login` signs you in to Visma, and the MCP server then reads and writes with YOUR
# tokens (Visma applies your own roles) instead of the service credentials above. Needs a WEB application in
# Visma's Developer Portal, with offline_access, and the redirect URL below registered exactly as written.
# See docs/layeSystem/Layer4/sign-in.md. VSV2_MCP_IDENTITY: auto (default: you, once signed in), user, service.
# VISMA_USER_CLIENT_ID=
# VISMA_USER_CLIENT_SECRET=
# VISMA_USER_REDIRECT_URI=http://localhost:38271/callback
# VISMA_USER_SCOPES=openid profile email offline_access vismanet_erp_interactive_api:read
# VISMA_USER_SCOPES_WRITE=visma.net.erp.salesorder:read visma.net.erp.salesorder:write
# VSV2_MCP_IDENTITY=auto
# Where the sign-in is kept, owner-only (an absolute path; default: $HOME/.vsv2/user)
# VSV2_USER_STORE_DIR=
