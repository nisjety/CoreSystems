# Studio Compose injects DATABASE_URL and PORT. Keep this file service-local.
# Supply real values through the approved local secret-management path.
INTERNAL_API_KEY=
STUDIO_SOCIAL_NATS_PASSWORD=

# Optional governed Integration Core access. Mount a verified, org-scoped
# Integration Core bearer through the approved secret path; never put it here.
# INTEGRATION_CORE_URL=http://integration-api:3026
# INTEGRATION_CORE_TENANT_ORGANIZATION_ID=
# INTEGRATION_CORE_TENANT_BEARER_TOKEN_FILE=/run/secrets/social-integration-bearer
# Publishing and metrics workers stay disabled until the URL and both tenant
# settings are available. Provider access is limited to this one organization.
# The bearer is read on startup;
# restart after approved credential rotation.
