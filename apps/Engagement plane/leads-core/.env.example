# Studio Compose injects DATABASE_URL and PORT. Keep this file service-local.
# Supply real values through the approved local secret-management path.
INTERNAL_API_KEY=
STUDIO_LEADS_NATS_PASSWORD=

# Optional LinkedIn lead sync through an org-scoped Integration Core bearer.
# The worker can access only this organization, never enumerate all tenants.
# INTEGRATION_CORE_URL=http://integration-api:3026
# INTEGRATION_CORE_TENANT_ORGANIZATION_ID=
# INTEGRATION_CORE_TENANT_BEARER_TOKEN_FILE=/run/secrets/leads-integration-bearer

# Configure the full triplet to enable entitlement-gated build/export actions.
# BILLING_CORE_URL=
# LEADS_BILLING_SERVICE_ID=
# LEADS_BILLING_SERVICE_TOKEN=
