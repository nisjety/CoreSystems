# Generate a distinct secret for this service; do not reuse OAuth credentials.
INTERNAL_API_KEY=
PORT=3165

# Exact deployment-owned destinations, never browser-supplied redirect URLs.
# Integration Core must allow the return origin and Google must register the
# callback. Production also sets VITE_MARKETING_GOOGLE_OAUTH_CALLBACK_URL in
# Verevon to the same callback before building the frontend.
MARKETING_GOOGLE_CONSENT_RETURN_URL=http://localhost:5173/studio/pulse
MARKETING_GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3026/oauth/callback/google

# Optional unified Studio Search Console overlay. These are identifiers and a
# file path, never the bearer token itself.
# STUDIO_MARKETING_GOOGLE_CONNECTION_ID=
# STUDIO_MARKETING_GSC_PROPERTY=sc-domain:example.com
# STUDIO_MARKETING_INTEGRATION_BEARER_FILE=/approved/secret/path
