# Copy to marketing-local.env and fill each value with a distinct generated secret,
# or use scripts/smoke-marketing-local.sh to generate process-scoped values.
MARKETING_LOCAL_INTEGRATION_API_KEY=
MARKETING_LOCAL_MARKETING_API_KEY=
MARKETING_LOCAL_CONTROL_API_KEY=
MARKETING_LOCAL_ORG_TOKEN=
MARKETING_LOCAL_BILLING_TOKEN=
MARKETING_LOCAL_AUDIT_TOKEN=
# Base64 for exactly 32 random bytes.
MARKETING_LOCAL_ENCRYPTION_KEY=
# JSON array with a trusted Ed25519 public key. The smoke script generates one.
MARKETING_LOCAL_ATTESTATION_KEYS_JSON=
# Optional loopback host-port overrides.
INTEGRATION_CORE_HOST_PORT=3026
MARKETING_CORE_HOST_PORT=3165
