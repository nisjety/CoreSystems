# ── Cohere ─────────────────────────────────────────────────────────────────
COHERE_API_KEY=your_cohere_api_key_here
COHERE_EMBED_MODEL=embed-english-v3.0
COHERE_RERANK_MODEL=rerank-english-v3.0

# ── Azure OpenAI (Embeddings) ───────────────────────────────────────────────
AZURE_OPENAI_API_KEY_EMBEDDING=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT_EMBEDDING=https://your-resource.openai.azure.com
AZURE_OPENAI_DEPLOYMENT_EMBEDDING=text-embedding-3-large
AZURE_OPENAI_API_VERSION_EMBEDDING=2024-12-01-preview

# ── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_USER=dataplane
POSTGRES_PASSWORD=dataplane
POSTGRES_DB=dataplane

# ── Qdrant ──────────────────────────────────────────────────────────────────
QDRANT_COLLECTION=dataplane_knowledge

# ── Knowledge Index ─────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
KNOWLEDGE_INDEX_PENDING_MIN_IDLE_MS=30000
KNOWLEDGE_INDEX_MAX_DELIVERY_ATTEMPTS=5
KNOWLEDGE_INDEX_ADMIN_PORT=9101

# ── Embedding Worker ────────────────────────────────────────────────────────
EMBEDDING_BATCH_SIZE=32
EMBEDDING_PENDING_MIN_IDLE_MS=30000
EMBEDDING_MAX_DELIVERY_ATTEMPTS=5
EMBEDDING_ADMIN_PORT=9102

# ── Retrieval Service ───────────────────────────────────────────────────────
RETRIEVAL_TOP_K=20
RETRIEVAL_TOP_N=5

# ── Velion frontend-plane NATS bus ──────────────────────────────────────────
VELION_NATS_URL=nats://velion-nats:4222
VELION_NATS_TOKEN=replace_with_velion_nats_token
