PORT=3160
SERVICE_NAME=conversation-core-go
DATABASE_URL=postgresql://appuser:application-postgres-secret@application-postgres:5432/application_plane
CONVERSATION_GATEWAY_SERVICE_TOKEN=
CONVERSATION_CORE_INGEST_SERVICE_TOKEN=
INTEGRATION_INTERNAL_API_KEY=
INTEGRATION_BASE_URL=http://integration-api:3026
# Distinct Auth Core service principal. The matching deployment-owned registry
# entry grants aud=ingestion and integration:read/integration:write. Never reuse
# INTEGRATION_INTERNAL_API_KEY or either conversation delegation token.
AUTH_CORE_URL=http://auth-core:3011
CONVERSATION_INTEGRATION_SERVICE_ID=conversation-core
CONVERSATION_INTEGRATION_SERVICE_API_KEY=
# Standard-base64 Ed25519 64-byte private key. Provision the matching 32-byte
# public key under the same kid in integration-corev2's verifier key ring.
CONVERSATION_PROVIDER_WRITE_ATTESTATION_PRIVATE_KEY=
CONVERSATION_PROVIDER_WRITE_ATTESTATION_KEY_ID=
NATS_URL=nats://nats:4222
NATS_USER=application-conversation
NATS_PASSWORD=
# Verevon-owned monitored org every pilot-feedback submission is mirrored into,
# in addition to the submitter's own org (see internal/conversation/service.go
# Service.SubmitFeedback / Service.mirrorFeedback). Needed for the open pilot:
# each external company gets its own isolated org and conversation-core-go has
# no cross-org/platform-admin read bypass, so without this, feedback submitted
# from inside an external org's session would be invisible to the team. The
# value below is the team's real operating org ("HASSAN TRIODELAB DA") --
# update it here (nowhere else) if that ever changes. Leave empty to disable
# mirroring; feedback still lands in the submitter's own org either way.
FEEDBACK_MIRROR_ORG_ID=G240yBgMDU0OjWKnJpdienKD9I7KY4kr
