  "webhooks": [
    {
      "name": "verevon-support-events",
      "endpoint": "http://integration-core:3026/api/v1/webhooks/zammad",
      "sslVerify": false,
      "active": true,
      "note": "Verevon support event bus — routes ticket events to integration-core NATS bridge. Override endpoint with ZAMMAD_WEBHOOK_ENDPOINT env var."
    }
  ],
  "triggers": [
    {
      "name": "50-verevon-ticket-created",
      "webhookName": "verevon-support-events",
      "active": true,
      "condition": {
        "ticket.action": {
          "operator": "is",
          "value": ["create"]
        }
      },
      "note": "Fire verevon-support-events webhook on ticket create"
    },
    {
      "name": "51-verevon-ticket-updated",
      "webhookName": "verevon-support-events",
      "active": true,
      "condition": {
        "ticket.action": {
          "operator": "is",
          "value": ["update"]
        }
      },
      "note": "Fire verevon-support-events webhook on ticket update"
    },
    {
      "name": "52-verevon-article-created",
      "webhookName": "verevon-support-events",
      "active": true,
      "condition": {
        "article.action": {
          "operator": "is",
          "value": ["create"]
        }
      },
      "note": "Fire verevon-support-events webhook on new article (customer reply)"
    }
  ]
}
