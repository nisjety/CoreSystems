{
  "groups": [
    {
      "name": "Support",
      "followUpPossible": "yes",
      "followUpAssignment": true,
      "active": true,
      "note": "Parent namespace for support queues. Do not route mailboxes here."
    },
    {
      "name": "Support::Triage",
      "followUpPossible": "yes",
      "followUpAssignment": true,
      "active": true,
