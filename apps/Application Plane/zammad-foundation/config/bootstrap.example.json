    {
      "name": "Support::Billing",
      "followUpPossible": "yes",
      "followUpAssignment": true,
      "active": true,
      "note": "Billing queue with its own mailbox identity."
    },
    {
      "name": "Support::Escalations",
      "followUpPossible": "yes",
