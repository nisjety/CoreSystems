ZAMMAD_BASE_URL=http://localhost:8088
ZAMMAD_TOKEN=replace-with-a-zammad-admin-access-token
ZAMMAD_CONFIG_PATH=../config/bootstrap.example.json

# Webhook target URL — Docker service name resolves on verevon-net for dev.
# For prod / external access, set to the public URL of integration-core.
ZAMMAD_WEBHOOK_ENDPOINT=http://integration-core:3026/api/v1/webhooks/zammad

# Shared bearer token — must match ZAMMAD_WEBHOOK_TOKEN in integration-core .env.
# Leave empty to disable webhook auth (dev only).
ZAMMAD_WEBHOOK_TOKEN=
