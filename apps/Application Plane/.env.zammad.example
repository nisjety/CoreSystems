# Zammad foundation runtime environment
# Copy to .env.zammad before starting the stack.

# Runtime pin from the upstream official docker-compose repo as of 2026-03-31.
ZAMMAD_VERSION=7.0.0-0042
IMAGE_REPO=ghcr.io/zammad/zammad

# Public access
ZAMMAD_FQDN=support.localhost
ZAMMAD_HTTP_TYPE=http
ZAMMAD_EXPOSE_PORT=8088
NGINX_PORT=8080
NGINX_CLIENT_MAX_BODY_SIZE=50M
TZ=Europe/Oslo

# Persistence
POSTGRES_DB=zammad_production
POSTGRES_USER=zammad
POSTGRES_PASS=change-me
POSTGRES_HOST=zammad-postgresql
POSTGRES_PORT=5432
POSTGRESQL_OPTIONS=?pool=50
REDIS_URL=redis://zammad-redis:6379
MEMCACHE_SERVERS=zammad-memcached:11211

# Search
ELASTICSEARCH_ENABLED=true
ELASTICSEARCH_SCHEMA=http
ELASTICSEARCH_HOST=zammad-elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_NAMESPACE=zammad
ELASTICSEARCH_REINDEX=true
ELASTICSEARCH_JAVA_OPTS=-Xms1g -Xmx1g

# Optional tuning
ZAMMAD_WEB_CONCURRENCY=2
ZAMMAD_PROCESS_SESSIONS_JOBS_WORKERS=1
ZAMMAD_PROCESS_SCHEDULED_JOBS_WORKERS=1
ZAMMAD_PROCESS_DELAYED_JOBS_WORKERS=2
ZAMMAD_PROCESS_DELAYED_JOBS_WORKER_THREADS=4
ZAMMAD_PROCESS_DELAYED_COMMUNICATION_INBOUND_JOBS_WORKERS=2
ZAMMAD_PROCESS_DELAYED_COMMUNICATION_INBOUND_JOBS_WORKER_THREADS=2

# Optional first-run autowizard.
# Leave commented if you prefer to complete setup in the UI.
# AUTOWIZARD_JSON={"locale":"en-us","organization":"CoreSystem","url":"http://support.localhost:8088","logo":"","system_online_service":"https://services.zammad.com","email":"admin@example.com","channel_email":"admin@example.com","password":"change-me"}

# Future outbound webhook receiver placeholders.
ZAMMAD_WEBHOOK_SHARED_SECRET=change-me
ZAMMAD_TRIAGE_RECEIVER_URL=http://support-orchestrator:8080/webhooks/zammad
