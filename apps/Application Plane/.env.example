# Application Plane — environment variables

# Build provenance supplied by CI/release tooling.
SOURCE_REVISION=replace-with-tested-git-sha
BUILD_DATE=2026-01-01T00:00:00Z

# Application base URL
APP_BASE_URL=http://localhost:3000
# Bind published development ports to loopback unless an operator explicitly
# opts into LAN exposure.
APPLICATION_BIND_ADDRESS=127.0.0.1

# Convex backend secret shared by the self-hosted Convex runtime
CONVEX_INSTANCE_SECRET=replace-with-random-32-byte-secret
JWT_SECRET=replace-with-random-32-byte-secret
CONVEX_INTERNAL_SERVICE_KEY=
APPLICATION_CONVEX_CONTROL_PROJECTION_KEY=

# Scoped Application and cross-plane broker principals. Generate a distinct
# random 32+ character value for every entry; no runtime service accepts the
# retired shared NATS token.
APPLICATION_CONVEX_CONTROL_NATS_PASSWORD=
APPLICATION_CONVERSATION_NATS_PASSWORD=
APPLICATION_SOCIAL_NATS_PASSWORD=
APPLICATION_INSIGHT_NATS_PASSWORD=
APPLICATION_LEADS_NATS_PASSWORD=
APPLICATION_NOTIFICATION_NATS_PASSWORD=
AUDIT_APPLICATION_NATS_PASSWORD=
APPLICATION_NATS_PROVISIONER_PASSWORD=
APPLICATION_CONVEX_MODEL_NATS_PASSWORD=
APPLICATION_INSIGHT_MODEL_NATS_PASSWORD=
# Dedicated Data Plane publisher for content-free Knowledge lifecycle telemetry.
# It may publish only `verevon.ingestion.knowledge.>` on Application NATS.
APPLICATION_DATA_PLANE_KNOWLEDGE_NATS_PASSWORD=

# Application Plane persistence
APPLICATION_PLANE_DB_USER=appuser
APPLICATION_PLANE_DB_PASSWORD=replace-with-random-database-password
APPLICATION_PLANE_DB_NAME=application_plane
APPLICATION_PLANE_DRAGONFLY_PASSWORD=replace-with-random-cache-password

# Observability UI (anonymous access is disabled by default in Compose)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-random-grafana-password
GRAFANA_ANONYMOUS_ENABLED=false

# Notification Core
INTERNAL_API_KEY=replace-with-control-issued-internal-key
NOTIFICATION_GATEWAY_SERVICE_TOKEN=
NOTIFICATION_SUPPORT_WORKER_SERVICE_TOKEN=
# Separate provider callback HMAC; leave empty until callback delivery is enabled.
NOTIFICATION_DELIVERY_CALLBACK_SECRET=
# Durable provider-attempt worker is opt-in and remains disabled in dev until
# provider/ZDR/replay evidence is accepted. Enabling it requires Novu mode and
# the callback verifier above; it never creates or rotates credentials.
NOTIFICATION_DELIVERY_WORKER_ENABLED=false
NOTIFICATION_DELIVERY_WORKER_POLL_INTERVAL=5s
NOTIFICATION_DELIVERY_WORKER_LEASE=30s
CONVERSATION_GATEWAY_SERVICE_TOKEN=
CONVERSATION_EMAIL_INGEST_SERVICE_TOKEN=
CONVERSATION_CORE_INGEST_SERVICE_TOKEN=
INTEGRATION_INTERNAL_API_KEY=
# The service API key must be a distinct random 32+ byte value and must match
# the conversation-core entry in Auth Core PLANE_SERVICE_PRINCIPALS_JSON. That
# entry uses audience "ingestion", scopes integration:read/integration:write,
# allowAnyOrg=true (with orgIds=[]); every issued runtime token remains bound
# to one org.
AUTH_CORE_URL=http://auth-core:3011
CONVERSATION_INTEGRATION_SERVICE_ID=conversation-core
CONVERSATION_INTEGRATION_SERVICE_API_KEY=
# Standard-base64 Ed25519 64-byte private key; never reuse an API/delegation key.
# The matching public key is configured in integration-corev2 under this kid.
CONVERSATION_PROVIDER_WRITE_ATTESTATION_PRIVATE_KEY=
CONVERSATION_PROVIDER_WRITE_ATTESTATION_KEY_ID=
# Optional fail-closed Conversation Core owner-action health reporter. Leave
# empty until the dedicated service principal and complete Control-bound
# execution lane are provisioned; no Model capability is enabled by defaults.
CAPABILITY_CORE_HTTP_URL=
CONVERSATION_CAPABILITY_HEALTH_AUTH_CORE_URL=http://auth-core:3011
CONVERSATION_CAPABILITY_HEALTH_SERVICE_ID=conversation-core
CONVERSATION_CAPABILITY_HEALTH_SERVICE_API_KEY=
CONVERSATION_CAPABILITY_HEALTH_INTERVAL_SECONDS=120
CONVEX_RECONCILIATION_KEY=replace-with-dedicated-random-operator-key
# Manual operator CLI only: dedicated read-only Auth Core membership principal.
CONTROL_PLANE_AUTH_CORE_URL=http://auth-core:3011
APPLICATION_RECONCILER_AUTH_TOKEN=replace-with-dedicated-random-auth-reader-token
CONVERSATION_CORE_URL=http://conversation-core-go:3160
CONVERSATION_INGEST_URL=http://conversation-ingest-rs:3161
SUPPORT_ORG_ID=default-org
NOVU_RUNTIME_URL=http://novu-runtime:3150
NOVU_RUNTIME_INTERNAL_API_KEY=replace-with-random-novu-key
# Dedicated WebSocket token — safe to expose as NEXT_PUBLIC_ in the browser.
# Must match NEXT_PUBLIC_NOTIFICATION_WS_TOKEN in the frontend .env.
WS_TOKEN=replace-with-random-websocket-token
RESEND_API_KEY=replace-with-resend-api-key
RESEND_FROM_EMAIL=notifications@yourdomain.com
RESEND_FROM_NAME=CoreSystem

# CoreSystem planner backend (used when running the affine profile)
AFFINE_POSTGRES_PASSWORD=replace-with-random-affine-database-password
AFFINE_ADMIN_EMAIL=admin@localhost
AFFINE_ADMIN_PASSWORD=replace-with-random-affine-admin-password

# Required only with docker-compose.zammad.yml.
POSTGRES_PASS=replace-with-random-zammad-database-password

# Planner Sync Core
AUTH_SERVICE_URL=http://auth-core:3011
USER_SERVICE_URL=http://user-core:3012
AFFINE_CORE_URL=
CONVEX_URL=http://convex-backend:3210

# Self-owned geocoding (Data Plane Nominatim overlay)
NOMINATIM_URL=http://nominatim:8080
