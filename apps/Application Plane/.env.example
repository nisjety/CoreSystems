# Application Plane — environment variables

# Application base URL
APP_BASE_URL=http://localhost:3000

# Convex backend secret shared by the self-hosted Convex runtime
CONVEX_INSTANCE_SECRET=change-me
JWT_SECRET=change-me

# Velion frontend-plane CoreSystem bus
VELION_NATS_URL=nats://velion-nats:4222
VELION_NATS_TOKEN=change-me

# Application Plane persistence
APPLICATION_PLANE_DB_USER=appuser
APPLICATION_PLANE_DB_PASSWORD=application-postgres-secret
APPLICATION_PLANE_DB_NAME=application_plane
APPLICATION_PLANE_REDIS_PASSWORD=application-redis-secret

# Notification Core
INTERNAL_API_KEY=change-me
CONVERSATION_CORE_URL=http://conversation-core-go:3160
CONVERSATION_INGEST_URL=http://conversation-ingest-rs:3161
SUPPORT_ORG_ID=default-org
NOVU_RUNTIME_URL=http://novu-runtime:3150
NOVU_RUNTIME_INTERNAL_API_KEY=change-me
# Dedicated WebSocket token — safe to expose as NEXT_PUBLIC_ in the browser.
# Must match NEXT_PUBLIC_NOTIFICATION_WS_TOKEN in the frontend .env.
WS_TOKEN=change-me
RESEND_API_KEY=re_placeholder
RESEND_FROM_EMAIL=notifications@yourdomain.com
RESEND_FROM_NAME=CoreSystem

# CoreSystem planner backend (used when running the affine profile)
AFFINE_POSTGRES_PASSWORD=affine_secret
AFFINE_ADMIN_EMAIL=admin@localhost
AFFINE_ADMIN_PASSWORD=changeme

# Planner Sync Core
AUTH_SERVICE_URL=http://auth-core:3011
USER_SERVICE_URL=http://user-core:3012
AFFINE_CORE_URL=http://affine-core:3180
CONVEX_URL=http://convex-backend:3210
