# Ingestion Plane local environment overrides

# Required: shared internal API key for all service-to-service calls (X-Internal-Api-Key header).
INTERNAL_API_KEY=replace-with-internal-api-key

# Quarry-v2 is the active web/search ingestion system. Legacy `Quarry/`
# is deferred and should not be used by Velion v2.
QUARRY_CONTROL_API_KEY=replace-with-quarry-control-api-key
QUARRY_RUNTIME_AUTH_TOKEN=replace-with-quarry-runtime-token
QUARRY_EDGE_AUTH_DEV_BYPASS=1
QUARRY_EDGE_BROWSER_PROVIDER=static
QUARRY_EDGE_ARTIFACT_BACKEND=memory
QUARRY_CANARY_PCT=100
QUARRY_CACHE_TTL_SECS=300
QUARRY_FETCH_TIMEOUT_S=30

INTEGRATION_PUBLIC_BASE_URL=http://localhost:3026
INTEGRATION_ENGINE_GO_PUBLIC_BASE_URL=http://localhost:3126
MICROSOFT_FIRST_PARTY_AUTH_ENABLED=true
AZURE_TENANT_ID=replace-me
AZURE_CLIENT_ID=replace-me
AZURE_CLIENT_SECRET=replace-me
INTEGRATION_CREDENTIALS_ENCRYPTION_KEY=replace-with-fernet-key
INTEGRATION_WORKER_RETRY_INTERVAL_SECONDS=15
INTEGRATION_WEBHOOK_MAX_ATTEMPTS=6
CONNECTOR_RUNTIME_ENABLED=false

# Required connector runtime API secret for the target environment.
CONNECTOR_RUNTIME_SECRET=your-runtime-api-secret

# Required webhook signature secret for runtime callback verification.
CONNECTOR_RUNTIME_WEBHOOK_SECRET=your-runtime-webhook-secret

# Optional local connector runtime internals for self-hosted development.
AUTH_CORE_URL=http://auth-core:3011
# Required: shared internal API key for service-to-service calls (must match auth-core).
AUTH_CORE_INTERNAL_API_KEY=replace-with-internal-api-key
USER_CORE_URL=http://user-core:3012
ORG_CORE_URL=http://org-core:8080
BILLING_CORE_URL=http://billing-core:3014
CONNECTOR_RUNTIME_BASE_URL=http://localhost:3003
CONNECTOR_RUNTIME_TIMEOUT_MS=30000
CONNECTOR_RUNTIME_PUBLIC_SERVER_URL=http://localhost:3003
# Optional: only needed when starting docker-compose.ui.yml
CONNECTOR_RUNTIME_CONNECT_URL=http://localhost:3009
CONNECTOR_RUNTIME_CONNECT_PORT=3009
TEMPORAL_UI_CORS_ORIGINS=http://localhost:3000
CONNECTOR_RUNTIME_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32

# Optional Velion frontend-plane cross-plane bus
VELION_NATS_URL=nats://velion-nats:4222
VELION_NATS_TOKEN=replace-with-velion-nats-token

# Self-owned document processors and URL reputation feeds
DOCUMENT_PROCESSOR_ORDER=local
TIKA_ENABLED=false
TIKA_URL=http://tika:9998
TIKA_TIMEOUT_S=20
GOTENBERG_URL=http://gotenberg:3000
STIRLING_PDF_URL=http://stirling-pdf:8080
QUARRY_SECURITY_SNAPSHOT_PATH=/app/data/security-feeds/quarry-security.json
URLHAUS_CSV_URL=https://urlhaus.abuse.ch/downloads/csv_recent/
PHISHTANK_CSV_URL=
SECURITY_FEED_MAX_HOSTS=250000
