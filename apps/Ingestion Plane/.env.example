# Ingestion Plane local environment overrides

# Required build provenance. CI should set the tested Git SHA and an RFC3339
# UTC timestamp; local builds may use `git rev-parse HEAD` and `date -u`.
SOURCE_REVISION=replace-with-tested-git-sha
BUILD_DATE=2026-01-01T00:00:00Z
INGESTION_BIND_ADDRESS=127.0.0.1

# Required persistence/cache credentials. Generate independent random values;
# never reuse these across planes or environments.
INGESTION_PG_PASSWORD=replace-with-random-postgres-password
INGESTION_DRAGONFLY_PASSWORD=replace-with-random-dragonfly-password
INGESTION_NATS_TOKEN=replace-with-random-nats-token
QDRANT_API_KEY=replace-with-random-qdrant-api-key
SEARXNG_SECRET=replace-with-random-searxng-secret

# Required: shared internal API key for all service-to-service calls (X-Internal-Api-Key header).
INTERNAL_API_KEY=replace-with-internal-api-key
CONVERSATION_EMAIL_INGEST_SERVICE_TOKEN=

# Quarry-v2 is the active web/search ingestion system. Legacy `Quarry/`
# is deferred and should not be used by Velion v2.
QUARRY_CONTROL_API_KEY=replace-with-quarry-control-api-key
QUARRY_RUNTIME_AUTH_TOKEN=replace-with-quarry-runtime-token
QUARRY_INTERNAL_SECRET=replace-with-quarry-hmac-secret
# Durable Auth Core credential. Quarry exchanges this for short-lived,
# org-scoped tokens; never place minted JWTs in an environment file.
QUARRY_SERVICE_ID=quarry-edge
QUARRY_SERVICE_API_KEY=replace-with-auth-core-quarry-service-credential
QUARRY_EDGE_AUTH_DEV_BYPASS=0
QUARRY_EDGE_BROWSER_PROVIDER=static
QUARRY_EDGE_ARTIFACT_BACKEND=memory
QUARRY_CANARY_PCT=100
QUARRY_CACHE_TTL_SECS=300
QUARRY_FETCH_TIMEOUT_S=30

INTEGRATION_PUBLIC_BASE_URL=http://localhost:3026
INTEGRATION_ENGINE_GO_PUBLIC_BASE_URL=http://localhost:3126
META_JS_SDK_APP_ID=replace-with-meta-app-id
META_JS_SDK_API_VERSION=v23.0
META_JS_SDK_LOCALE=en_US
META_BUSINESS_LOGIN_CONFIG_ID=replace-with-meta-business-login-config-id
MICROSOFT_FIRST_PARTY_AUTH_ENABLED=true
AZURE_TENANT_ID=replace-me
AZURE_CLIENT_ID=replace-me
MICROSOFT_CLIENT_AUTH_MODE=public
MICROSOFT_TOKEN_ORIGIN=http://localhost:3026
AZURE_CLIENT_SECRET=
INTEGRATION_CREDENTIALS_ENCRYPTION_KEY=replace-with-fernet-key
INTEGRATION_WORKER_RETRY_INTERVAL_SECONDS=15
INTEGRATION_WEBHOOK_MAX_ATTEMPTS=6
CONNECTOR_RUNTIME_ENABLED=false

# TikTok Login Kit / Content Posting API. TikTok names the app id
# `client_key`; TIKTOK_CLIENT_ID is accepted as an alias by integration-corev2.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
SNAPCHAT_REDIRECT_BASE_URL=

# Required connector runtime API secret for the target environment.
CONNECTOR_RUNTIME_SECRET=your-runtime-api-secret

# Required webhook signature secret for runtime callback verification.
CONNECTOR_RUNTIME_WEBHOOK_SECRET=your-runtime-webhook-secret

# Optional local connector runtime internals for self-hosted development.
AUTH_CORE_URL=http://auth-core:3011
# Required: shared internal API key for service-to-service calls (must match auth-core).
AUTH_CORE_INTERNAL_API_KEY=replace-with-internal-api-key
INTEGRATION_ORG_CORE_SERVICE_TOKEN=replace-with-distinct-org-core-service-token
INTEGRATION_BILLING_CORE_SERVICE_TOKEN=replace-with-distinct-billing-core-service-token
INTEGRATION_AUDIT_CORE_SERVICE_TOKEN=replace-with-distinct-audit-core-service-token
IMPORTS_SERVICE_API_KEY=replace-with-auth-core-imports-service-credential
SHIPPING_SERVICE_API_KEY=replace-with-auth-core-shipping-service-credential
INTEGRATION_SERVICE_API_KEY=replace-with-auth-core-integration-service-credential
FINSPO_SERVICE_API_KEY=replace-with-auth-core-finspo-service-credential
AUTOCOMPLETE_INTERNAL_TOKEN=replace-with-random-autocomplete-api-token
SONIC_PASSWORD=replace-with-random-sonic-password
USER_CORE_URL=http://user-core:3012
ORG_CORE_URL=http://org-core:8080
BILLING_CORE_URL=http://billing-core:3014
CONNECTOR_RUNTIME_BASE_URL=http://localhost:3003
CONNECTOR_RUNTIME_TIMEOUT_MS=30000
CONNECTOR_RUNTIME_PUBLIC_SERVER_URL=http://localhost:3003
# Optional: only needed when starting docker-compose.ui.yml
CONNECTOR_RUNTIME_CONNECT_URL=http://localhost:3009
CONNECTOR_RUNTIME_CONNECT_PORT=3009
TEMPORAL_UI_CORS_ORIGINS=http://localhost:3000
CONNECTOR_RUNTIME_ENCRYPTION_KEY=replace-with-openssl-rand-base64-32

# Optional Velion frontend-plane cross-plane bus
VELION_NATS_URL=nats://velion-nats:4222
VELION_NATS_TOKEN=replace-with-velion-nats-token

# Self-owned document processors and URL reputation feeds
DOCUMENT_PROCESSOR_ORDER=local
TIKA_ENABLED=false
TIKA_URL=http://tika:9998
TIKA_TIMEOUT_S=20
GOTENBERG_URL=http://gotenberg:3000
STIRLING_PDF_URL=http://stirling-pdf:8080
QUARRY_SECURITY_SNAPSHOT_PATH=/app/data/security-feeds/quarry-security.json
URLHAUS_CSV_URL=https://urlhaus.abuse.ch/downloads/csv_recent/
PHISHTANK_CSV_URL=
SECURITY_FEED_MAX_HOSTS=250000

# shipping-core (freight aggregator): every carrier below is optional and
# defaults to its mock adapter when unset — empty is a normal, supported
# state, not an error. Set a carrier's vars to replace its mock with the
# real integration; see shipping-core/.env.example for details on each.

# Bring (developer.bring.com/api): Mybring account email + API key +
# customer number. X-Bring-Client-URL defaults to velion.no if unset.
BRING_API_UID=
BRING_API_KEY=
BRING_CUSTOMER_NUMBER=
BRING_CLIENT_URL=
# Must be explicitly "true" to place REAL freight orders; otherwise every
# booking carries Bring's testIndicator=true.
BRING_LIVE_BOOKING=

# DHL Express / MyDHL API (developer.dhl.com): HTTP Basic Auth — API Key as
# username, API Secret as password (no OAuth2). Account number optional for
# rate shopping. Base URL empty = production; set to
# https://express.api.dhl.com/mydhlapi/test for a sandbox-scoped app.
DHL_API_KEY=
DHL_API_SECRET=
DHL_ACCOUNT_NUMBER=
DHL_API_BASE_URL=

# UPS (developer.ups.com): OAuth2 client credentials. Account number
# optional (needed later for negotiated rates/booking). Test/CIE base has
# NO /rest/ suffix (e.g. https://wwwcie.ups.com) — the adapter
# string-concatenates BaseURL + path, so a trailing /rest/ breaks it.
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
UPS_ACCOUNT_NUMBER=
UPS_API_BASE_URL=

# FedEx (developer.fedex.com): OAuth2 client credentials. New developer
# projects have sandbox-only keys — base URL defaults to the sandbox host.
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
FEDEX_ACCOUNT_NUMBER=
FEDEX_API_BASE_URL=
SUPPORT_NOTIFICATION_MODE=disabled
NOTIFICATION_SUPPORT_WORKER_SERVICE_TOKEN=
