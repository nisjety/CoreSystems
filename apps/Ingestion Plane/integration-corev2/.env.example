# integration-corev2 local development example.
# Copy to .env and fill with real values from your secret manager.
# Do not commit live client secrets, tokens, tenant IDs, or webhook secrets.

PORT=3026
SERVICE_NAME=integration-corev2
ENVIRONMENT=dev
DATABASE_URL=postgres://integration:integration@postgres:5432/integration_corev2?sslmode=disable
INTEGRATION_ALLOW_IN_MEMORY_STORE=false
# OAuth redirect URLs are derived from this value:
#   <INTEGRATION_PUBLIC_BASE_URL>/oauth/callback/<normalized-provider>
# Keep this exact stable HTTPS origin registered in each provider console.
# Provider-specific legacy *_REDIRECT_URI variables are not read by
# integration-corev2 and must not override this contract.
INTEGRATION_PUBLIC_BASE_URL=http://localhost:3026
INTEGRATION_CORE_URL=http://integration-api:3026
INTEGRATION_CREDENTIALS_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTE_KEY

# Optional ChatGPT subscription-backed inference. This is an opt-in broker for
# the official Codex app-server, not an API key. The standard Compose API image
# includes the pinned official `codex` CLI; custom images must make it available
# at CODEX_APP_SERVER_COMMAND. Give this directory a protected persistent volume;
# it contains Codex-managed sign-in state and is never exposed to Model Plane or
# the browser.
CODEX_SUBSCRIPTION_ENABLED=false
CODEX_APP_SERVER_COMMAND=codex
CODEX_SUBSCRIPTION_HOME=/var/lib/integration-core/codex-subscriptions
# Dedicated Model Plane-to-Integration Core credential. Do not reuse
# INTERNAL_API_KEY or any user/ChatGPT credential.
CODEX_SUBSCRIPTION_MODEL_PLANE_API_KEY=CHANGE_ME_DEDICATED_MODEL_PLANE_KEY
CODEX_SUBSCRIPTION_LOGIN_TTL=10m
CODEX_SUBSCRIPTION_INVOCATION_TIMEOUT=90s

# Public browser-side Meta/Facebook JavaScript SDK settings. No app secret belongs
# in the browser. META_JS_SDK_APP_ID can usually match META_APP_CLIENT_ID.
META_JS_SDK_APP_ID=CHANGE_ME_META_APP_ID
META_JS_SDK_API_VERSION=v25.0
META_JS_SDK_LOCALE=en_US
# Facebook Login for Business configuration ids (App Dashboard > Facebook
# Login for Business > Configurations). Meta bakes permissions into the
# configuration itself rather than a per-request scope param — a
# Business-type app needing more than one permission set needs one
# configuration per set. "default" covers every meta connection except the
# "conversions" bundle, which uses the second one automatically.
META_BUSINESS_LOGIN_CONFIG_ID=CHANGE_ME_META_BUSINESS_LOGIN_CONFIG_ID
META_BUSINESS_LOGIN_SUPPORT_MESSAGING_CONFIG_ID=CHANGE_ME_META_BUSINESS_LOGIN_SUPPORT_MESSAGING_CONFIG_ID
META_BUSINESS_LOGIN_CONVERSIONS_CONFIG_ID=CHANGE_ME_META_BUSINESS_LOGIN_CONVERSIONS_CONFIG_ID
META_BUSINESS_LOGIN_STUDIO_ADS_CONFIG_ID=CHANGE_ME_META_BUSINESS_LOGIN_STUDIO_ADS_CONFIG_ID
META_WEBHOOK_VERIFY_TOKEN=CHANGE_ME_META_WEBHOOK_VERIFY_TOKEN
# Meta validates the public HTTPS webhook endpoint, never the local OAuth
# callback. For Instagram use https://<public-host>/api/v1/webhooks/instagram
# and enter the exact META_WEBHOOK_VERIFY_TOKEN value in the Meta dashboard.
META_WEBHOOK_SECRET=
THREADS_API_BASE_URL=https://graph.threads.net/v1.0

INTERNAL_API_KEY=CHANGE_ME_INTERNAL_API_KEY
CONVERSATION_EMAIL_INGEST_SERVICE_TOKEN=
INTERNAL_API_KEY_HEADER=X-Internal-API-Key
# Only for isolated E2E compatibility. Production tenant APIs reject the
# shared key and require a verified bearer/service-principal token.
ALLOW_LEGACY_TENANT_KEY=0
AUTH_CORE_URL=http://auth-core:3011
AUTH_CORE_INTERNAL_API_KEY=
# Required for provider writes. JSON array of trusted conversation-core
# Ed25519 public keys: [{"issuer":"conversation-core","kid":"...","public_key":"<standard-base64-32-byte-key>"}].
# Keep this empty until a real public key is provisioned; placeholders and
# symmetric secrets are rejected at startup.
INTEGRATION_PROVIDER_WRITE_ATTESTATION_KEYS_JSON=
USER_CORE_URL=http://user-core:3012
ORG_CORE_URL=http://org-core:8080
SESSION_CORE_URL=http://session-core:9091
BILLING_CORE_URL=http://billing-core:3014
AUDIT_CORE_URL=http://audit-core:8187

NATS_ENABLED=true
NATS_URL=nats://nats:4222
NATS_USERNAME=
NATS_PASSWORD=
# Set when connecting to the shared verevon-nats broker, which enforces
# single-token auth (see nats-shared.conf) instead of username/password.
NATS_TOKEN=
NATS_SUBJECT_PREFIX=

FINSPO_CORE_URL=http://finspo-api:3130
FINSPO_API_KEY=CHANGE_ME_FINSPO_INTERNAL_API_KEY
FINSPO_API_KEY_HEADER=X-API-Key
DATA_PLANE_DOCUMENTS_URL=http://dpv2-documents-api:8010
# Durable Auth Core service-principal credential. integration-corev2 exchanges
# it for short-lived, org-bound aud=data-plane tokens and never forwards it to
# Data Plane. Register this exact id/key in PLANE_SERVICE_PRINCIPALS_JSON with
# audience data-plane and maximum scope documents:write.
INTEGRATION_SERVICE_ID=integration-corev2
INTEGRATION_SERVICE_API_KEY=
DATA_PLANE_GRAPH_INDEX_URL=http://dpv2-graph-index:9203

# Sensitive route rate limits for connect, token leases, actions, webhooks, and SCIM.
INTEGRATION_RATE_LIMIT_ENABLED=true
INTEGRATION_RATE_LIMIT_MAX=120
INTEGRATION_RATE_LIMIT_WINDOW=1m
INTEGRATION_TOKEN_LEASE_CONSUMERS=finspo-core,conversation-core,data-plane-v2,model-plane,application-plane,verevon-v2-bff,verevon-v3-gateway,social-publisher,email-worker

# Optional Rust webhook normalization hot path.
INTEGRATION_WEBHOOK_HOTPATH_URL=http://integration-webhook-normalizer:3036

# Microsoft Graph / Entra ID.
# Redirect URL: http://localhost:3026/oauth/callback/microsoft
AZURE_TENANT_ID=common
AZURE_CLIENT_ID=CHANGE_ME_AZURE_CLIENT_ID
# Use public for SPA/mobile/native Entra app registrations. Use confidential
# only for Web registrations that must redeem auth codes with a client secret.
MICROSOFT_CLIENT_AUTH_MODE=public
# Public/SPAs require an Origin header at the token endpoint. Defaults to
# INTEGRATION_PUBLIC_BASE_URL's origin; override if your public callback origin differs.
MICROSOFT_TOKEN_ORIGIN=http://localhost:3026
AZURE_CLIENT_SECRET=
MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com

# Google Workspace.
# Redirect URL: http://localhost:3026/oauth/callback/google
GOOGLE_CLIENT_ID=CHANGE_ME_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=CHANGE_ME_GOOGLE_CLIENT_SECRET
GOOGLE_AUTHORIZATION_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_API_BASE_URL=https://www.googleapis.com

# Slack.
# Redirect URL: http://localhost:3026/oauth/callback/slack
SLACK_CLIENT_ID=CHANGE_ME_SLACK_CLIENT_ID
SLACK_CLIENT_SECRET=CHANGE_ME_SLACK_CLIENT_SECRET
SLACK_SIGNING_SECRET=CHANGE_ME_SLACK_SIGNING_SECRET
SLACK_AUTHORIZATION_URL=https://slack.com/oauth/v2/authorize
SLACK_TOKEN_URL=https://slack.com/api/oauth.v2.access
SLACK_API_BASE_URL=https://slack.com/api

# GitHub.
# Redirect URL: http://localhost:3026/oauth/callback/github
GITHUB_CLIENT_ID=CHANGE_ME_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=CHANGE_ME_GITHUB_CLIENT_SECRET
GITHUB_AUTHORIZATION_URL=https://github.com/login/oauth/authorize
GITHUB_TOKEN_URL=https://github.com/login/oauth/access_token
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_WEBHOOK_SECRET=CHANGE_ME_GITHUB_WEBHOOK_SECRET

# Notion.
# Redirect URL: http://localhost:3026/oauth/callback/notion
NOTION_CLIENT_ID=CHANGE_ME_NOTION_CLIENT_ID
NOTION_CLIENT_SECRET=CHANGE_ME_NOTION_CLIENT_SECRET
NOTION_AUTHORIZATION_URL=https://api.notion.com/v1/oauth/authorize
NOTION_TOKEN_URL=https://api.notion.com/v1/oauth/token
NOTION_API_BASE_URL=https://api.notion.com

# Shopify.
# Redirect URL: http://localhost:3026/oauth/callback/shopify
SHOPIFY_CLIENT_ID=CHANGE_ME_SHOPIFY_CLIENT_ID
SHOPIFY_CLIENT_SECRET=CHANGE_ME_SHOPIFY_CLIENT_SECRET
SHOPIFY_API_BASE_URL=https://{shop}
SHOPIFY_WEBHOOK_SECRET=CHANGE_ME_SHOPIFY_WEBHOOK_SECRET

# Stripe.
# Redirect URL: http://localhost:3026/oauth/callback/stripe
STRIPE_CLIENT_ID=CHANGE_ME_STRIPE_CLIENT_ID
STRIPE_CLIENT_SECRET=CHANGE_ME_STRIPE_CLIENT_SECRET
STRIPE_AUTHORIZATION_URL=https://connect.stripe.com/oauth/authorize
STRIPE_TOKEN_URL=https://connect.stripe.com/oauth/token
STRIPE_API_BASE_URL=https://api.stripe.com
STRIPE_WEBHOOK_SECRET=CHANGE_ME_STRIPE_WEBHOOK_SECRET

# Social publishing providers.
# LinkedIn redirect URL: http://localhost:3026/oauth/callback/linkedin
LINKEDIN_CLIENT_ID=CHANGE_ME_LINKEDIN_CLIENT_ID
LINKEDIN_CLIENT_SECRET=CHANGE_ME_LINKEDIN_CLIENT_SECRET
LINKEDIN_AUTHORIZATION_URL=https://www.linkedin.com/oauth/v2/authorization
LINKEDIN_TOKEN_URL=https://www.linkedin.com/oauth/v2/accessToken
LINKEDIN_API_BASE_URL=https://api.linkedin.com
LINKEDIN_MARKETING_VERSION=202606

# X redirect URL: http://localhost:3026/oauth/callback/x
X_CLIENT_ID=CHANGE_ME_X_CLIENT_ID
X_CLIENT_SECRET=CHANGE_ME_X_CLIENT_SECRET
X_AUTHORIZATION_URL=https://x.com/i/oauth2/authorize
X_TOKEN_URL=https://api.x.com/2/oauth2/token
X_API_BASE_URL=https://api.x.com

# Unified Meta/Messenger redirect URL: http://localhost:3026/oauth/callback/meta
# Use the Messenger-capable Meta app here. OAuth sends exactly one client_id;
# do not combine these credentials with the legacy Facebook, Instagram, or
# Threads app ids in a single authorization request.
META_APP_CLIENT_ID=CHANGE_ME_META_APP_CLIENT_ID
META_APP_CLIENT_SECRET=CHANGE_ME_META_APP_CLIENT_SECRET
META_AUTHORIZATION_URL=https://www.facebook.com/v25.0/dialog/oauth
META_TOKEN_URL=https://graph.facebook.com/v25.0/oauth/access_token
META_GRAPH_API_BASE_URL=https://graph.facebook.com/v25.0

# Instagram redirect URL: http://localhost:3026/oauth/callback/instagram
# Use the dedicated Instagram-inbox Meta app. Do not reuse the Messenger/
# Instagram API with Instagram Login is its own OAuth and Graph surface. Use
# the linked Instagram App ID/secret and register
# <INTEGRATION_PUBLIC_BASE_URL>/oauth/callback/instagram in its login setup.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_AUTHORIZATION_URL=https://www.instagram.com/oauth/authorize
INSTAGRAM_TOKEN_URL=https://api.instagram.com/oauth/access_token
INSTAGRAM_GRAPH_API_BASE_URL=https://graph.instagram.com/v25.0

# Legacy Facebook, WhatsApp Business, and Meta Ads use these credentials.
# The unified Meta/Messenger provider prefers META_APP_CLIENT_ID above and
# falls back to these only when the dedicated Meta variables are absent.
# Facebook redirect URL: http://localhost:3026/oauth/callback/facebook
# WhatsApp redirect URL: http://localhost:3026/oauth/callback/whatsapp
# Meta Ads redirect URL: http://localhost:3026/oauth/callback/meta-ads
FACEBOOK_CLIENT_ID=CHANGE_ME_FACEBOOK_CLIENT_ID
FACEBOOK_CLIENT_SECRET=CHANGE_ME_FACEBOOK_CLIENT_SECRET
FACEBOOK_AUTHORIZATION_URL=https://www.facebook.com/v25.0/dialog/oauth
FACEBOOK_TOKEN_URL=https://graph.facebook.com/v25.0/oauth/access_token
FACEBOOK_GRAPH_API_BASE_URL=https://graph.facebook.com/v25.0

# Snapchat redirect URL: <SNAPCHAT_REDIRECT_BASE_URL>/oauth/callback/snapchat
# Snapchat OAuth apps require a registered HTTPS callback. Set this to the
# public HTTPS origin that is registered in Snap Business Manager, for example:
# https://connect.example.com -> https://connect.example.com/oauth/callback/snapchat
SNAPCHAT_REDIRECT_BASE_URL=
SNAPCHAT_CLIENT_ID=CHANGE_ME_SNAPCHAT_CLIENT_ID
SNAPCHAT_CLIENT_SECRET=CHANGE_ME_SNAPCHAT_CLIENT_SECRET
SNAPCHAT_AUTHORIZATION_URL=https://accounts.snapchat.com/login/oauth2/authorize
SNAPCHAT_TOKEN_URL=https://accounts.snapchat.com/login/oauth2/access_token
SNAPCHAT_API_BASE_URL=https://adsapi.snapchat.com/v1

# TikTok redirect URL: http://localhost:3026/oauth/callback/tiktok
# TikTok calls this value client_key. TIKTOK_CLIENT_ID is accepted as a
# backwards-compatible alias, but TIKTOK_CLIENT_KEY is preferred.
TIKTOK_CLIENT_KEY=CHANGE_ME_TIKTOK_CLIENT_KEY
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=CHANGE_ME_TIKTOK_CLIENT_SECRET
TIKTOK_AUTHORIZATION_URL=https://www.tiktok.com/v2/auth/authorize/
TIKTOK_TOKEN_URL=https://open.tiktokapis.com/v2/oauth/token/
TIKTOK_API_BASE_URL=https://open.tiktokapis.com/v2

# Discord redirect URL: http://localhost:3026/oauth/callback/discord
DISCORD_CLIENT_ID=CHANGE_ME_DISCORD_CLIENT_ID
DISCORD_CLIENT_SECRET=CHANGE_ME_DISCORD_CLIENT_SECRET
DISCORD_AUTHORIZATION_URL=https://discord.com/oauth2/authorize
DISCORD_TOKEN_URL=https://discord.com/api/oauth2/token
DISCORD_API_BASE_URL=https://discord.com/api/v10
# Required by the inbound Discord worker; keep this in the local secret file.
DISCORD_BOT_TOKEN=

# Enterprise identity / provisioning adapters.
# Okta OAuth redirect URL: http://localhost:3026/oauth/callback/okta
OKTA_DOMAIN=
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
OKTA_API_TOKEN=
OKTA_API_BASE_URL=
# SCIM uses bearer-token provisioning, not OAuth, so it has no redirect URL.
SCIM_BEARER_TOKEN=CHANGE_ME_SCIM_BEARER_TOKEN
SCIM_ORG_BEARER_TOKENS=org_123:CHANGE_ME_ORG_SCIM_BEARER_TOKEN
