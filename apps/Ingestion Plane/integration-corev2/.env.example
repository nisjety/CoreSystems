# integration-corev2 local development example.
# Copy to .env and fill with real values from your secret manager.
# Do not commit live client secrets, tokens, tenant IDs, or webhook secrets.

PORT=3026
SERVICE_NAME=integration-corev2
ENVIRONMENT=dev
DATABASE_URL=postgres://integration:integration@postgres:5432/integration_corev2?sslmode=disable
INTEGRATION_ALLOW_IN_MEMORY_STORE=false
INTEGRATION_PUBLIC_BASE_URL=http://localhost:3026
INTEGRATION_CORE_URL=http://integration-corev2:3026
INTEGRATION_CREDENTIALS_ENCRYPTION_KEY=CHANGE_ME_BASE64_32_BYTE_KEY

INTERNAL_API_KEY=CHANGE_ME_INTERNAL_API_KEY
INTERNAL_API_KEY_HEADER=X-Internal-API-Key
AUTH_CORE_URL=http://auth-core:3011
AUTH_CORE_INTERNAL_API_KEY=
USER_CORE_URL=http://user-core:3012
ORG_CORE_URL=http://org-core:8080
SESSION_CORE_URL=http://session-core:9091
BILLING_CORE_URL=http://billing-core:3014
AUDIT_CORE_URL=http://audit-core:3015

NATS_ENABLED=true
NATS_URL=nats://nats:4222
NATS_USERNAME=
NATS_PASSWORD=
NATS_SUBJECT_PREFIX=

FINSPO_CORE_URL=http://finspo-api:3130
FINSPO_API_KEY=CHANGE_ME_FINSPO_INTERNAL_API_KEY
FINSPO_API_KEY_HEADER=X-API-Key
DATA_PLANE_DOCUMENTS_URL=http://dpv2-documents-api:8010
DATA_PLANE_INTERNAL_API_KEY=CHANGE_ME_DATA_PLANE_INTERNAL_API_KEY
DATA_PLANE_INTERNAL_API_KEY_HEADER=X-Internal-Api-Key
DATA_PLANE_GRAPH_INDEX_URL=http://dpv2-graph-index:9203

# Sensitive route rate limits for connect, token leases, actions, webhooks, and SCIM.
INTEGRATION_RATE_LIMIT_ENABLED=true
INTEGRATION_RATE_LIMIT_MAX=120
INTEGRATION_RATE_LIMIT_WINDOW=1m
INTEGRATION_TOKEN_LEASE_CONSUMERS=finspo-core,conversation-core,data-plane-v2,model-plane,application-plane,velion-v2-bff

# Optional Rust webhook normalization hot path.
INTEGRATION_WEBHOOK_HOTPATH_URL=http://integration-webhook-normalizer:3036

# Microsoft Graph / Entra ID.
AZURE_TENANT_ID=common
AZURE_CLIENT_ID=CHANGE_ME_AZURE_CLIENT_ID
AZURE_CLIENT_SECRET=CHANGE_ME_AZURE_CLIENT_SECRET
MICROSOFT_GRAPH_BASE_URL=https://graph.microsoft.com

# Google Workspace.
GOOGLE_CLIENT_ID=CHANGE_ME_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=CHANGE_ME_GOOGLE_CLIENT_SECRET
GOOGLE_AUTHORIZATION_URL=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_URL=https://oauth2.googleapis.com/token
GOOGLE_API_BASE_URL=https://www.googleapis.com

# Slack.
SLACK_CLIENT_ID=CHANGE_ME_SLACK_CLIENT_ID
SLACK_CLIENT_SECRET=CHANGE_ME_SLACK_CLIENT_SECRET
SLACK_SIGNING_SECRET=CHANGE_ME_SLACK_SIGNING_SECRET
SLACK_AUTHORIZATION_URL=https://slack.com/oauth/v2/authorize
SLACK_TOKEN_URL=https://slack.com/api/oauth.v2.access
SLACK_API_BASE_URL=https://slack.com/api

# GitHub.
GITHUB_CLIENT_ID=CHANGE_ME_GITHUB_CLIENT_ID
GITHUB_CLIENT_SECRET=CHANGE_ME_GITHUB_CLIENT_SECRET
GITHUB_AUTHORIZATION_URL=https://github.com/login/oauth/authorize
GITHUB_TOKEN_URL=https://github.com/login/oauth/access_token
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_WEBHOOK_SECRET=CHANGE_ME_GITHUB_WEBHOOK_SECRET

# Notion.
NOTION_CLIENT_ID=CHANGE_ME_NOTION_CLIENT_ID
NOTION_CLIENT_SECRET=CHANGE_ME_NOTION_CLIENT_SECRET
NOTION_AUTHORIZATION_URL=https://api.notion.com/v1/oauth/authorize
NOTION_TOKEN_URL=https://api.notion.com/v1/oauth/token
NOTION_API_BASE_URL=https://api.notion.com

# Shopify.
SHOPIFY_CLIENT_ID=CHANGE_ME_SHOPIFY_CLIENT_ID
SHOPIFY_CLIENT_SECRET=CHANGE_ME_SHOPIFY_CLIENT_SECRET
SHOPIFY_API_BASE_URL=https://{shop}
SHOPIFY_WEBHOOK_SECRET=CHANGE_ME_SHOPIFY_WEBHOOK_SECRET

# Stripe.
STRIPE_CLIENT_ID=CHANGE_ME_STRIPE_CLIENT_ID
STRIPE_CLIENT_SECRET=CHANGE_ME_STRIPE_CLIENT_SECRET
STRIPE_AUTHORIZATION_URL=https://connect.stripe.com/oauth/authorize
STRIPE_TOKEN_URL=https://connect.stripe.com/oauth/token
STRIPE_API_BASE_URL=https://api.stripe.com
STRIPE_WEBHOOK_SECRET=CHANGE_ME_STRIPE_WEBHOOK_SECRET

# Enterprise identity / provisioning adapters.
OKTA_DOMAIN=
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
OKTA_API_TOKEN=
OKTA_API_BASE_URL=
SCIM_BEARER_TOKEN=CHANGE_ME_SCIM_BEARER_TOKEN
SCIM_ORG_BEARER_TOKENS=org_123:CHANGE_ME_ORG_SCIM_BEARER_TOKEN
