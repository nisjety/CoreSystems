# Generate secrets locally; never commit a populated `.env`.
SOURCE_REVISION=replace-with-tested-git-sha
BUILD_DATE=2026-01-01T00:00:00Z
QUARRY_POSTGRES_PASSWORD=replace-with-random-postgres-password
QUARRY_DRAGONFLY_PASSWORD=replace-with-random-dragonfly-password
QUARRY_CONTROL_API_KEY=replace-with-random-control-token
QUARRY_RUNTIME_AUTH_TOKEN=replace-with-random-runtime-token
QUARRY_INTERNAL_SECRET=replace-with-random-hmac-secret
SEARXNG_SECRET=replace-with-random-searxng-secret

# Required when Quarry calls Data Plane or Model Plane. Register the same
# credential in Auth Core under the fixed service id `quarry-edge`.
AUTH_CORE_URL=http://auth-core:3011
QUARRY_SERVICE_API_KEY=replace-with-random-quarry-service-principal-key

# Explicit development-only escape hatches. Keep both disabled unless the
# stack is isolated and the caller understands the reduced protections.
QUARRY_EDGE_AUTH_DEV_BYPASS=0
QUARRY_CROSS_PLANE_AUTH_DEV_BYPASS=0
QUARRY_BROWSER_NO_SANDBOX=0
