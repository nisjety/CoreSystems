# syntax=docker/dockerfile:1.7
# quarry-edge-rs (Rust hot path: REST/SSE/cache/transform)
#
# Workspace declares rust-version = 1.85 but transitive deps (aws-smithy-*,
# serde_with, time, icu_*) have bumped MSRV to 1.91+ in Cargo.lock. Use
# `rust:1-slim-bookworm` (latest stable, currently 1.91+) so the dep graph
# stays buildable without pinning every transitive crate.
#
# Native deps:
# - protobuf-compiler: tonic-build (gRPC clients, gated behind `grpc`)
# - cmake/perl/clang/build-essential: boring-sys2 (BoringSSL via wreq)

FROM rust:1-slim-bookworm AS build
WORKDIR /src

# System dependencies for our crate graph:
# - pkg-config, libssl-dev, ca-certificates: standard rustls + reqwest
# - protobuf-compiler:                       tonic-build (gRPC clients)
# - cmake, perl, clang, build-essential:     boring-sys2 native compile
# - git, golang-go:                          boring-sys2's build.rs runs
#                                            BoringSSL's util/go tooling and
#                                            git-clones submodules at compile
#                                            time. Without these the build
#                                            panics at boring-sys2/build/main.rs:571
#                                            with "No such file or directory".
RUN set -e; \
    export DEBIAN_FRONTEND=noninteractive DEBCONF_NOWARNINGS=yes; \
    apt-get update -qq; \
    if ! apt-get install -y -qq --no-install-recommends \
        pkg-config libssl-dev ca-certificates \
        protobuf-compiler \
        cmake perl clang build-essential \
        git golang-go \
        > /tmp/apt-install.log 2>&1; then \
        cat /tmp/apt-install.log; \
        exit 1; \
    fi; \
    rm -f /tmp/apt-install.log; \
    rm -rf /var/lib/apt/lists/*

# Copy workspace manifests first so cargo can resolve deps in a cached layer.
# We then copy source last for maximum cache hit rate on incremental rebuilds.
COPY Cargo.toml Cargo.lock ./
COPY .cargo ./.cargo
COPY crates ./crates
COPY lab ./lab

# Wave 7 — reqwest 0.13's http3 surface is gated behind
# `--cfg reqwest_unstable`. The `.cargo/config.toml` copied above sets
# this via `[build] rustflags = [...]`, but we also set the env-var
# form so the gate is audit-visible in `docker image inspect` (the
# config-file form is invisible there). Both produce the same result;
# cargo dedupes the flag.
ENV CARGO_BUILD_RUSTFLAGS="--cfg=reqwest_unstable"

# P2 / cluster #grpc — production image ships with the `grpc` feature
# compiled in. Quarry can then route Data Plane ingest over HTTP/2 +
# protobuf (via `GrpcIngestAdapter` → `DocumentService.CreateDocument`)
# OR over HTTP/JSON (legacy `IngestClient`), selected at runtime via
# `QUARRY_EDGE__DATA_PLANE_TRANSPORT=http|grpc`. Default remains HTTP so
# existing deployments need no env-var change; flipping the var to
# `grpc` activates the proto path without a rebuild.
#
# Wave 7 / cluster #http3 — `http3` is also compiled in so the optional
# QUIC driver is available at runtime. The driver is OFF by default and
# only fires when the request carries `prefer_http3: true` AND the edge
# was started with `QUARRY_EDGE__HTTP3_ENABLED=1`. See
# crates/quarry-runtime/src/http3.rs for the TLS-fingerprint caveat.
#
# Phase 1 Track C / cluster #9 — `postgres-queue` is compiled in so the
# durable baseline + diff store (PostgresBaselineStore) and the
# `/v1/change/*` change-monitoring routes activate at runtime. The store
# is wired only when `QUARRY_EDGE__DATABASE_URL` is set; without it the
# edge runs in-memory exactly as before, and the change routes 501. The
# binary runs `quarry_runtime::run_migrations` against that DSN on boot
# (see main.rs) so the `quarry_baselines` / `quarry_change_diffs` tables
# exist before the store serves a request.
#
# Cap parallel codegen so the release build's peak memory fits a constrained
# Docker Desktop VM — a from-scratch build otherwise spawns one rustc+LLVM per
# core and can OOM (which silently kills the build with exit 101).
ENV CARGO_BUILD_JOBS=2
ARG QUARRY_EDGE_FEATURES=grpc,http3,postgres-queue
RUN --mount=type=cache,id=quarry-edge-cargo-registry,target=/usr/local/cargo/registry,sharing=locked \
    --mount=type=cache,id=quarry-edge-cargo-git,target=/usr/local/cargo/git,sharing=locked \
    --mount=type=cache,id=quarry-edge-target,target=/src/target,sharing=locked \
    if [ -n "${QUARRY_EDGE_FEATURES}" ]; then \
        cargo build --release -p quarry-edge --bin quarry-edge-rs --features "${QUARRY_EDGE_FEATURES}"; \
    else \
        cargo build --release -p quarry-edge --bin quarry-edge-rs; \
    fi \
    && mkdir -p /out \
    && cp /src/target/release/quarry-edge-rs /out/quarry-edge-rs

# ---- Runtime image -----------------------------------------------------------
# Use bookworm-slim (not distroless) so healthcheck has wget available and
# operators can shell in for triage. Chromium is included so the local
# Chromiumoxide browser driver can render JavaScript when Browserbase is not
# configured.
FROM debian:bookworm-slim
RUN set -e; \
    export DEBIAN_FRONTEND=noninteractive DEBCONF_NOWARNINGS=yes; \
    apt-get update -qq; \
    if ! apt-get install -y -qq --no-install-recommends \
        ca-certificates \
        chromium \
        fonts-liberation \
        wget \
        > /tmp/apt-install.log 2>&1; then \
        cat /tmp/apt-install.log; \
        exit 1; \
    fi; \
    rm -f /tmp/apt-install.log; \
    rm -rf /var/lib/apt/lists/*; \
    echo 'quarry:x:65532:' >> /etc/group; \
    echo 'quarry:x:65532:65532::/nonexistent:/usr/sbin/nologin' >> /etc/passwd

COPY --from=build --chown=quarry:quarry \
    /out/quarry-edge-rs /usr/local/bin/quarry-edge-rs

ENV CHROME=/usr/bin/chromium

USER quarry
EXPOSE 8082
# Use -O /dev/null instead of --spider — /health responds to GET only,
# --spider sends HEAD which the axum router rejects with 405.
HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD wget --quiet --tries=1 -O /dev/null http://localhost:8082/health || exit 1
ENTRYPOINT ["/usr/local/bin/quarry-edge-rs"]
