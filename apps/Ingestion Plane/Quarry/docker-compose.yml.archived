name: quarry-stack

services:
  quarry-api:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: quarry-api
    restart: unless-stopped
    environment:
      PORT: "8090"
      CACHE_BACKEND: redis
      REDIS_URL: redis://redis:6379/0
      CHANGE_TRACKING_BACKEND: redis
      CHANGE_TRACKING_TTL_HOURS: "720"
      JOB_STORE_BACKEND: postgres
      TEMPORAL_ENABLED: "true"
      TEMPORAL_ADDRESS: temporal:7233
      TEMPORAL_NAMESPACE: default
      TEMPORAL_TASK_QUEUE: quarry-task-queue
      AI_CORE_GRPC_ADDR: host.docker.internal:50061
      AI_CORE_HTTP_BASE_URL: http://host.docker.internal:8100
      QUARRY_POSTGRES_DSN: postgres://quarry:quarry@postgres:5432/quarry?sslmode=disable
      QUARRY_API_KEY: ${QUARRY_API_KEY:-dev-test-key-12345}
      DATAPLANE_BASE_URL: http://host.docker.internal:9401
      ENABLE_AI_EXTRACTION: "true"
      ENABLE_URL_SCANNING: "true"
      ROD_BROWSER_BIN: /usr/bin/chromium-browser
      ROD_CHROMIUM_BIN: /usr/bin/chromium-browser
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_started
      temporal:
        condition: service_healthy
    ports:
      - "8092:8090"
    extra_hosts:
      - "host.docker.internal:host-gateway"
    networks:
      - quarry-net

  quarry-worker:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: quarry-worker
    restart: unless-stopped
    command: ["/usr/local/bin/quarry-worker"]
    environment:
      TEMPORAL_ENABLED: "true"
      TEMPORAL_ADDRESS: temporal:7233
      TEMPORAL_NAMESPACE: default
      TEMPORAL_TASK_QUEUE: quarry-task-queue
      CACHE_BACKEND: redis
      REDIS_URL: redis://redis:6379/0
      CHANGE_TRACKING_BACKEND: redis
      CHANGE_TRACKING_TTL_HOURS: "720"
      JOB_STORE_BACKEND: postgres
      AI_CORE_GRPC_ADDR: host.docker.internal:50061
      AI_CORE_HTTP_BASE_URL: http://host.docker.internal:8100
      QUARRY_POSTGRES_DSN: postgres://quarry:quarry@postgres:5432/quarry?sslmode=disable
      DATAPLANE_BASE_URL: http://host.docker.internal:9401
      ENABLE_AI_EXTRACTION: "true"
      ZEROLOG_LEVEL: "debug"
      ROD_BROWSER_BIN: /usr/bin/chromium-browser
      ROD_CHROMIUM_BIN: /usr/bin/chromium-browser
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_started
      temporal:
        condition: service_healthy
    extra_hosts:
      - "host.docker.internal:host-gateway"
    networks:
      - quarry-net

  temporal:
    image: temporalio/auto-setup:1.27.2
    container_name: quarry-temporal
    restart: unless-stopped
    environment:
      DB: postgres12
      POSTGRES_SEEDS: postgres
      POSTGRES_USER: quarry
      POSTGRES_PWD: quarry
      DB_PORT: 5432
      POSTGRES_DB: temporal
      VISIBILITY_DB: temporal_visibility
      SKIP_DB_CREATE: false
      SKIP_DEFAULT_NAMESPACE_CREATION: false
    depends_on:
      postgres:
        condition: service_healthy
    ports:
      - "7234:7233"
    healthcheck:
      test: ["CMD", "tctl", "--address", "temporal:7233", "cluster", "health"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 30s
    networks:
      - quarry-net

  temporal-ui:
    image: temporalio/ui:2.34.0
    container_name: quarry-temporal-ui
    restart: unless-stopped
    environment:
      TEMPORAL_ADDRESS: temporal:7233
      TEMPORAL_UI_ENABLED: "true"
    ports:
      - "8089:8080"
    depends_on:
      temporal:
        condition: service_healthy
    networks:
      - quarry-net

  redis:
    image: redis:7.4-alpine
    container_name: quarry-redis
    restart: unless-stopped
    command: ["redis-server", "--appendonly", "yes"]
    ports:
      - "6383:6379"  # offset to avoid conflict with controlplane-redis (6380)
    volumes:
      - redis-data:/data
    networks:
      - quarry-net

  postgres:
    image: postgres:16-alpine
    container_name: quarry-postgres
    restart: unless-stopped
    environment:
      POSTGRES_USER: quarry
      POSTGRES_PASSWORD: quarry
      POSTGRES_DB: quarry
    ports:
      - "5436:5432"
    volumes:
      - postgres-data:/var/lib/postgresql/data
      - ./init-temporal-db.sql:/docker-entrypoint-initdb.d/init.sql
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U quarry -d quarry && pg_isready -U quarry -d temporal && pg_isready -U quarry -d temporal_visibility"]
      interval: 10s
      timeout: 5s
      retries: 10
      start_period: 20s
    networks:
      - quarry-net

volumes:
  redis-data:
  postgres-data:

networks:
  quarry-net:
    name: quarry-net
