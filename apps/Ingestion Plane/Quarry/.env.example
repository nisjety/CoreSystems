# ===========================================
# QUARRY CONFIGURATION EXAMPLE
# Copy this file to .env and customize for your environment
# ===========================================

# Service Configuration
PORT=8090
SERVICE_NAME=quarry
ENVIRONMENT=development

# API Configuration
# ⚠️ IMPORTANT: Change this to a secure random key in production
# Generate with: openssl rand -base64 32
QUARRY_API_KEY=your-secure-api-key-here

# Cache Configuration
CACHE_BACKEND=redis
REDIS_URL=redis://localhost:6380/0
CHANGE_TRACKING_BACKEND=redis
CHANGE_TRACKING_TTL_HOURS=720

# Job Store Configuration
JOB_STORE_BACKEND=postgres
QUARRY_POSTGRES_DSN=postgres://quarry:quarry@localhost:5434/quarry?sslmode=disable

# Temporal Configuration
TEMPORAL_ENABLED=true
TEMPORAL_ADDRESS=localhost:7234
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=quarry-task-queue

# Optional Velion frontend-plane cross-plane bus
VELION_NATS_URL=nats://localhost:4222
VELION_NATS_TOKEN=replace-with-velion-nats-token

# AI Core Configuration (Model Plane v2 — REST only)
# ai-core HTTP port is 8101 (host-mapped from container port 8001)
ENABLE_AI_EXTRACTION=true
AI_CORE_HTTP_BASE_URL=http://localhost:8101

# Auth Core gRPC (optional — if set, VerifyToken uses gRPC instead of HTTP)
# auth-core gRPC port is configured via GRPC_PORT in auth-core (default 50011)
# AUTH_CORE_GRPC_ADDR=localhost:50011

# Control Plane service clients (optional)
# AUTH_CORE_INTERNAL_API_KEY must match Control Plane INTERNAL_API_KEY or
# INTERNAL_SERVICE_SECRET when USER_CORE_URL points at user-core gRPC.
# AUTH_CORE_INTERNAL_API_KEY=
# USER_CORE_URL=localhost:50012
# ORG_CORE_URL=http://localhost:8080
# BILLING_CORE_URL=http://localhost:8095
# CONTROL_PLANE_CACHE_SEC=60

# AI extraction timeout (seconds)
# Controls how long Quarry will wait for ai-core to respond before falling back
# Default: 60
AI_EXTRACTION_TIMEOUT_SEC=60

# Brave Search (required only for /v1/search external web/news/images sources)
# BRAVE_SEARCH_API_KEY=
# BRAVE_SEARCH_BASE_URL=https://api.search.brave.com
# BRAVE_SEARCH_TIMEOUT_SEC=10

# Artifact Storage (MinIO for Docker-first local deployments)
ARTIFACT_STORE_BACKEND=minio
MINIO_ENDPOINT=localhost:9010
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=quarry-artifacts
MINIO_USE_SSL=false
MINIO_PUBLIC_BASE_URL=http://localhost:9010

# Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_SEC=60

# Request Configuration
MAX_REQUEST_BODY_BYTES=10485760
REQUEST_TIMEOUT_SEC=120

# Browser Configuration (for Docker)
ROD_BROWSER_BIN=/usr/bin/chromium-browser
ROD_CHROMIUM_BIN=/usr/bin/chromium-browser

# Security Features
ENABLE_SECURITY_HEADERS=true
ENABLE_INPUT_VALIDATION=true

# Scraper Configuration
SCRAPER_MAX_CONCURRENT=5
SCRAPER_TIMEOUT_SEC=30
SCRAPER_USER_AGENT=Mozilla/5.0 (compatible; QuarryBot/1.0)

# Middleware Configuration
HUMAN_DELAY_ENABLED=false
HUMAN_DELAY_MIN_MS=100
HUMAN_DELAY_MAX_MS=500

PROXY_ENABLED=false

RETRY_ENABLED=true
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_MS=1000

JOB_MONITORING=true

# URL Security Scanning
ENABLE_URL_SCANNING=true
URLHAUS_API_URL=https://urlhaus-api.abuse.ch/v1/

# Optional: Add API keys for enhanced security scanning
# PHISHTANK_API_KEY=your-phishtank-api-key
# SAFEBROWSING_API_KEY=your-google-safebrowsing-api-key
# ABUSEIPDB_API_KEY=your-abuseipdb-api-key
