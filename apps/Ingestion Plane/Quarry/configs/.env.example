# Quarry
PORT=8090

# Scraper / Azure OpenAI (used for enrichment)
AZURE_OPENAI_ENDPOINT=https://your-endpoint.openai.azure.com/
AZURE_OPENAI_KEY=your-key
AZURE_OPENAI_MODEL=gpt-4o-mini

MAX_CONCURRENT_PAGES=10
BROWSER_POOL_SIZE=5
ENABLE_STEALTH=true
SCREENSHOT_ENABLED=false

# Cache
CACHE_BACKEND=memory
CACHE_PATH=./data/cache
REDIS_URL=
JOB_STORE_BACKEND=memory
QUARRY_POSTGRES_DSN=postgres://quarry:quarry@localhost:5432/quarry?sslmode=disable

# Batch
BATCH_MAX_WORKERS=10
BATCH_JOB_TTL_HOURS=24
WEBHOOK_SECRET=change-me

# Security providers
GOOGLE_SAFE_BROWSING_API_KEY=
PHISHTANK_API_KEY=
ABUSEIPDB_API_KEY=
SECURITY_BLOCK_THRESHOLD=0.8

# ai-core gRPC
AI_CORE_GRPC_ADDR=localhost:50851

# Temporal (Phase 3)
TEMPORAL_ENABLED=false
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=quarry-task-queue

# Service bus / storage (Phase 3+)
QUARRY_NATS_URL=nats://localhost:4222
QUARRY_POSTGRES_DSN=postgres://quarry:quarry@localhost:5432/quarry?sslmode=disable
QUARRY_QDRANT_URL=http://localhost:6333

# Phase 1.1 hardening
QUARRY_API_KEY=
QUARRY_API_KEY_HEADER=X-API-Key
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_SEC=60
REQUEST_TIMEOUT_SEC=30
MAX_REQUEST_BODY_BYTES=1048576
SCRAPE_MAX_PAGES=20
SCRAPE_MAX_ENRICH_LIMIT=200
SCRAPE_MAX_AGE_MS=172800000

# Control Plane service clients
# AUTH_CORE_INTERNAL_API_KEY must match Control Plane INTERNAL_API_KEY or
# INTERNAL_SERVICE_SECRET when USER_CORE_URL points at user-core gRPC.
AUTH_CORE_INTERNAL_API_KEY=
USER_CORE_URL=
ORG_CORE_URL=
BILLING_CORE_URL=
CONTROL_PLANE_CACHE_SEC=60

# Phase 4 middleware
HUMAN_DELAY_ENABLED=false
HUMAN_DELAY_MIN_MS=25
HUMAN_DELAY_MAX_MS=150
PROXY_ENABLED=false
PROXY_POOL=
RETRY_ENABLED=true
RETRY_MAX_ATTEMPTS=2
RETRY_BACKOFF_MS=250
JOB_MONITORING_ENABLED=true
