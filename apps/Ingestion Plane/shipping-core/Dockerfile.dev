# Development-only image. Pin the toolchain and hot-reload helper so a fresh
# checkout does not silently change behavior between builds.
FROM golang:1.26.5-alpine3.24

RUN apk add --no-cache git && \
    go install github.com/air-verse/air@v1.65.3

WORKDIR /app

COPY go.mod go.sum ./
RUN go mod download

COPY . .

EXPOSE 8080

CMD ["air", "-c", ".air.toml"]
