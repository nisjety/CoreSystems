# For running `go run ./cmd/shipping-core` directly on the host (not via
# docker compose). Copy to .env and `export $(cat .env | xargs)` first, or
# use a tool like direnv — Go doesn't load .env files on its own.
#
# If you're using docker-compose for everything, ignore this file — see
# the root .env.example instead.

# Required. If Postgres is running via `docker compose up postgres`
# (or `make dev`), it's reachable at the host port from docker-compose.yml
# (default 5435, or your SHIPPING_CORE_HOST_PORT/POSTGRES_HOST_PORT override).
DATABASE_URL=postgres://shipping:shipping@localhost:5435/shipping_core?sslmode=disable

# Optional, defaults to 8080.
PORT=8080

# Optional — all three (UID/KEY/CUSTOMER_NUMBER) required together to use
# the real Bring adapter instead of MockAdapter. developer.bring.com/api
# requires THREE headers on every call: the two below plus
# X-Bring-Client-URL (BRING_CLIENT_URL — defaults to velion.no if unset).
BRING_API_UID=
BRING_API_KEY=
BRING_CUSTOMER_NUMBER=
BRING_CLIENT_URL=
BRING_API_BASE_URL=
# Must be explicitly "true" to place REAL freight orders via the Booking
# API; otherwise every booking carries Bring's testIndicator=true.
BRING_LIVE_BOOKING=

# Optional — both required together to activate the real DHL Express (MyDHL
# API) adapter instead of MockAdapter. developer.dhl.com: HTTP Basic Auth —
# API Key as username, API Secret as password (no OAuth2). Account number
# optional for rate shopping. Base URL empty = production; a freshly
# approved sandbox-scoped app (e.g. named "...-sandbox-...") needs:
# DHL_API_BASE_URL=https://express.api.dhl.com/mydhlapi/test
DHL_API_KEY=
DHL_API_SECRET=
DHL_ACCOUNT_NUMBER=
DHL_API_BASE_URL=

# Optional — both required together to activate the real UPS adapter.
# Account number is optional (needed for negotiated rates/booking later).
# Test environment: UPS_API_BASE_URL=https://wwwcie.ups.com
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
UPS_ACCOUNT_NUMBER=
UPS_API_BASE_URL=

# Optional — all three required together to activate the real FedEx
# adapter. New developer projects have sandbox-only keys:
# FEDEX_API_BASE_URL=https://apis-sandbox.fedex.com
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
FEDEX_ACCOUNT_NUMBER=
FEDEX_API_BASE_URL=
