# Service
IMPORT_SERVICE_NAME=import-service
IMPORT_SERVICE_PORT=3025
LOG_LEVEL=INFO

# Data ownership: temporary import job state only
DATABASE_URL=postgresql+asyncpg://ingestion_user:replace-with-postgres-password@ingestion-postgres:5432/imports

# Delegation targets
DOCUMENT_SERVICE_URL=http://dpv2-documents-api:8010
DOCUMENT_SERVICE_IMPORT_PATH=/v1/documents/
ORG_SERVICE_URL=http://org-core-service:8080
ORG_SERVICE_QUOTA_PATH=/api/v1/org/quota/check

# Auth Core audience tokens (canonical org/user identity)
AUTH_CORE_URL=http://auth-core:3011
AUTH_CORE_JWKS_URL=http://auth-core:3011/api/convex-auth/jwks
PLANE_TOKEN_ISSUER=http://auth-core:3011/api/convex-auth
INGESTION_AUTH_AUDIENCE=ingestion
INGESTION_SERVICE_ID=imports-core
INGESTION_SERVICE_API_KEY=replace-with-auth-core-registered-service-key
INTERNAL_API_KEY=replace-with-isolated-e2e-only-key
# Shared tenant keys require all three flags and must never be enabled in production.
ALLOW_LEGACY_TENANT_KEY=0
ALLOW_INSECURE_DEV_DEFAULTS=0
ISOLATED_E2E=0

# Messaging and workflow orchestration
NATS_URL=nats://nats:4222
NATS_TOKEN=replace-with-ingestion-nats-token
VELION_NATS_URL=nats://localhost:4222
VELION_NATS_TOKEN=replace-with-velion-nats-token
TEMPORAL_ENABLED=false
TEMPORAL_HOST_PORT=org-core-temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=import-service-task-queue

# Import behavior
MAX_UPLOAD_FILES=100
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,docx,txt,md,csv,json,html,htm

# Self-owned document processors
# Keep local default for dev. Enable the docker compose profile
# `self-owned-docs` and set DOCUMENT_PROCESSOR_ORDER=tika,local to parse
# through Apache Tika before falling back to the in-process parser.
DOCUMENT_PROCESSOR_ORDER=local
TIKA_ENABLED=false
TIKA_URL=http://tika:9998
TIKA_TIMEOUT_S=20
GOTENBERG_URL=http://gotenberg:3000
STIRLING_PDF_URL=http://stirling-pdf:8080
