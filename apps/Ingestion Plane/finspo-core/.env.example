PORT=3130
ENVIRONMENT=dev
SERVICE_NAME=finspo-core

FINSPO_API_KEY=
FINSPO_API_KEY_HEADER=X-API-Key

# Integration plane (Microsoft Graph access tokens).
INTEGRATION_CORE_URL=http://integration-api:3026
INTERNAL_API_KEY=

# Postgres — finspo-core owns its schema via embedded migrations.
FINSPO_DSN=postgres://ingestion_user:ingestion_secure_password_2026@ingestion-postgres:5432/finspo?sslmode=disable

# NATS — leave empty to run with a no-op publisher (dev only).
NATS_URL=nats://nats:4222
NATS_SUBJECT_PREFIX=finspo

# OTEL collector — exporter wiring lands in a follow-up phase but the
# endpoint is recorded so misconfigured environments are obvious.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Data Plane source-object/document ingest target.
DATA_PLANE_DOCUMENTS_BASE_URL=http://dpv2-documents-api:8010
DATA_PLANE_INTERNAL_API_KEY=

# Optional one-shot replay of existing finspo inventory into Data Plane
# source_objects:
#   go run ./cmd/backfill-source-objects
FINSPO_BACKFILL_ORG_ID=
FINSPO_BACKFILL_BATCH_SIZE=500
FINSPO_BACKFILL_TIMEOUT=30m

# Phase 3 — background scheduler + ACL capture.
# How often the scheduler fans out SyncDrive across enabled sources.
FINSPO_SYNC_INTERVAL=5m
# Set to "false" to disable Graph permissions capture entirely.
FINSPO_CAPTURE_PERMISSIONS=true

# Phase 5 — governance execution (DESTRUCTIVE). Hard kill-switch; an approved
# proposal still cannot be executed unless this is explicitly "true". The
# connection also needs Files.ReadWrite.All / Sites.ReadWrite.All scopes — the
# default read-only Nango seed does NOT grant these.
FINSPO_ALLOW_EXECUTION=false
# Destination folder id (within each item's own drive) for 'archive' proposals.
FINSPO_ARCHIVE_FOLDER_ID=
