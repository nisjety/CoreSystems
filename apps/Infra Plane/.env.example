# CoreSystem Infra Plane. Never put another plane's database, provider, auth,
# or tenant credentials in this file — this plane owns local edge routing and a
# bounded operator surface only.
#
# Local port for the HTTP entrypoint (bound to 127.0.0.1 by the base compose).
CORE_INFRA_HTTP_PORT=8090

# Optional: leave empty to disable /infra/v1/operator/status.
# Generate a value with: openssl rand -hex 32
CORE_INFRA_OPERATOR_TOKEN=

# ── Public edge (docker-compose.production.yml only) ────────────────────────
# These are ignored by the local base compose, which never binds publicly.
# Domains served: verevon.no is canonical; verevon.com and both www hosts
# permanently redirect to it. The hostnames themselves live in
# configs/traefik/dynamic.yml, since Traefik Host() rules are static config.
#
# Override only if something else already owns :80/:443 on the host.
CORE_INFRA_PUBLIC_HTTP_PORT=80
CORE_INFRA_PUBLIC_HTTPS_PORT=443

# TLS certificate for verevon.no / verevon.com is NOT in this repo. Place a
# Cloudflare Origin certificate at ./cloudflare-certs/origin-cert.pem and
# origin-key.pem (mode 0600) and uncomment the `certificates:` block in
# configs/traefik/dynamic.yml. See docker-compose.production.yml for the full
# procedure and the Let's Encrypt/ACME alternative.
