# Server-only. Never prefix these credentials with NEXT_PUBLIC_.
# The site shows an email link until all required contact settings are valid.
RESEND_API_KEY=
# Plain email address on a domain verified in Resend.
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=post@triodelab.no
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional Search Console URL-prefix verification; DNS verification also works.
GOOGLE_SITE_VERIFICATION=

# Public installation IDs, not secrets. These variables are embedded at build time.
# Keep disabled until privacy/cookie disclosures, provider settings and publication are approved.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
# Owner-created Triodelab GA4 web stream; an explicit valid value overrides the site default.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=G-ZEWPHF6X3K
# Optional public Clarity project ID only. Never put an export token here.
NEXT_PUBLIC_CLARITY_PROJECT_ID=z5gsvus553

# First-party Web Vitals. Both switches must be deliberately enabled.
# Production collection requires Cookiebot Statistics consent.
# Local development at http://localhost:3000 uses a separate document-only
# Allow/Stop control for first-party Web Vitals, never GA4/Clarity consent.
NEXT_PUBLIC_WEB_VITALS_ENABLED=false
WEB_VITALS_ENABLED=false
WEB_VITALS_WEBSITE_ID=
WEB_VITALS_WEBSITE_REVISION=
WEB_VITALS_SITE=https://triodelab.no/
WEB_VITALS_ENVIRONMENT=production
WEB_VITALS_REPORTING_ORIGIN=https://www.triodelab.no
# Dedicated server-only TLS Redis URL and per-installation read-only export token.
# For local development use mutually exclusive *_FILE variants (absolute, mode 0600).
WEB_VITALS_REDIS_URL=
WEB_VITALS_EXPORT_TOKEN=

# Optional first-party inquiry delivery into Leads Core, instead of email.
# Server-only installation credential; never expose it as NEXT_PUBLIC_*.
# Development accepts localhost HTTP; production requires HTTPS.
# Leave unset to retain the existing Resend email delivery behavior.
CONTACT_DELIVERY_MODE=
CONTACT_WEBSITE_INTAKE_URL=
CONTACT_WEBSITE_INTAKE_TOKEN_FILE=
