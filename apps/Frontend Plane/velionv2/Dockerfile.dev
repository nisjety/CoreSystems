# velionv2 — dev container image (Next.js 16 + React 19).
#
# Mirrors the velion v1 dev pattern: pnpm install once during build, stash
# node_modules into /opt so the runtime bind-mount can rehydrate them if the
# host's volume is empty. The compose file mounts only the source paths so
# editing files locally triggers Next's file watcher.
FROM node:20-alpine

WORKDIR /app

ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    NO_UPDATE_NOTIFIER=1

RUN set -e; \
 if ! apk add --no-cache --quiet bash curl docker-cli docker-cli-compose git > /tmp/apk-add.log 2>&1; then \
   cat /tmp/apk-add.log; \
   exit 1; \
 fi; \
 rm -f /tmp/apk-add.log; \
 corepack enable \
 && corepack prepare pnpm@10.14.0 --activate

COPY package.json pnpm-lock.yaml* pnpm-workspace.yaml* ./
RUN pnpm install --frozen-lockfile --config.update-notifier=false
RUN mkdir -p /opt/velionv2-deps && cp -R node_modules /opt/velionv2-deps/node_modules

COPY . .

ENV PORT=3000
EXPOSE 3000

CMD ["pnpm", "dev"]
