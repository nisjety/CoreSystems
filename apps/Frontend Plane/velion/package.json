{
  "name": "agencia-app",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "check:internal-keys": "node scripts/check-internal-api-keys.mjs",
    "dev": "node scripts/check-internal-api-keys.mjs && next dev --webpack",
    "build": "next build",
    "perf:build": "pnpm build && node scripts/check-perf-budget.mjs",
    "start": "node scripts/check-internal-api-keys.mjs && next start",
    "lint": "eslint . --ext .ts,.tsx && bash scripts/lint-proxy-routes.sh && bash ../../../scripts/lint-env-files.sh",
    "lint:proxy": "bash scripts/lint-proxy-routes.sh",
    "lint:env": "bash ../../../scripts/lint-env-files.sh",
    "render:onboarding:product-reveal": "remotion render remotion/index.ts ProductReveal public/videos/onboarding/product-reveal.webm --codec=vp9 --crf=18 --timeout=60000 --concurrency=2",
    "render:onboarding:product-reveal:poster": "remotion still remotion/index.ts ProductReveal public/imagens/onboarding/product-reveal-poster.png --frame=228 --timeout=60000",
    "render:onboarding:assets": "pnpm render:onboarding:product-reveal && pnpm render:onboarding:product-reveal:poster",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "bash scripts/typecheck.sh"
  },
  "dependencies": {
    "@better-auth/sso": "^1.3.34",
    "@blocksuite/blocks": "0.19.5",
    "@blocksuite/global": "0.19.5",
    "@blocksuite/presets": "0.19.5",
    "@blocksuite/store": "0.19.5",
    "@blocksuite/sync": "0.19.5",
    "@bufbuild/protobuf": "^2.2.5",
    "@connectrpc/connect": "^2.0.1",
    "@connectrpc/connect-web": "^2.0.1",
    "@gsap/react": "^2.1.2",
    "@hookform/resolvers": "^5.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@orpc/client": "^1.11.1",
    "@orpc/contract": "^1.11.1",
    "@orpc/openapi": "^1.11.1",
    "@orpc/server": "^1.11.1",
    "@orpc/tanstack-query": "^1.11.1",
    "@orpc/zod": "^1.11.1",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.8",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.2.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@tanstack/react-query": "^5.90.7",
    "@tanstack/react-query-devtools": "^5.90.2",
    "@tanstack/react-query-persist-client": "^5.90.7",
    "@tanstack/react-virtual": "^3.13.25",
    "@toeverything/theme": "^1.1.23",
    "better-auth": "^1.3.34",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.32.0",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.23.24",
    "gsap": "^3.14.2",
    "idb-keyval": "^6.2.4",
    "lucide-react": "^0.553.0",
    "motion": "^12.29.2",
    "next": "^16.1.6",
    "next-auth": "^4.24.13",
    "next-themes": "^0.4.6",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.66.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "three": "^0.182.0",
    "wavesurfer.js": "^7.11.1",
    "y-indexeddb": "^9.0.12",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.30",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.59.1",
    "@remotion/cli": "4.0.464",
    "@tailwindcss/postcss": "^4.1.17",
    "@tanstack/eslint-plugin-query": "^5.91.2",
    "@testing-library/jest-dom": "^6.9.1",
