    "baseline-browser-mapping": "^2.10.0",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.1",
    "jsdom": "^29.1.1",
    "remotion": "4.0.464",
    "tailwindcss": "^4.1.17",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.7"
  },
  "pnpm": {
    "overrides": {
      "@blocksuite/icons": "2.1.75"
    }
  }
