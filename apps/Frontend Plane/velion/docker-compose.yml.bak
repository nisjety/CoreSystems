name: frontend-plane-agencia
# Frontend Plane: Aqencia application
# This compose file is the current application entrypoint, not the future
# Triodelab marketing site. Aqencia owns the shared application-level NATS bus
# used when planes surface into a user-facing app.

services:
  # ============================================================================
  # SHARED NATS JETSTREAM BROKER — Event-Driven Architecture Backbone
  # ============================================================================
  # This NATS broker facilitates real-time cross-plane event consumption:
  #
  # CONTROL PLANE publishes to these subjects (via AQENCIA_CONTROLPLANE stream):
  #   • aqencia.controlplane.user.provider_linked         → Ingestion (setup providers)
  #   • aqencia.controlplane.org.plan_changed             → Data Plane (enforce quotas)
  #   • aqencia.controlplane.billing.quota_exceeded       → All planes (enforce limits)
  #
  # SUBSCRIBERS (all planes listening):
  #   • Ingestion imports-api:   user.provider_linked, org.plan_changed, billing.quota_exceeded
  #   • Data retrieval-service:  org.plan_changed, billing.quota_exceeded
  #   • Data documents-service:  org.plan_changed, billing.quota_exceeded
  #   • Reasoning ai-core:       billing.quota_exceeded
  #
  # Lives here (frontend network) as anchor so all planes can reach it by DNS name.
  # Each plane also has its own internal NATS instance for plane-local events.
  # ============================================================================
  triodelab-nats:
    image: nats:2.10-alpine
    command: -js --http_port 8222
    ports:
      - "4222:4222"      # NATS protocol
      - "8222:8222"      # HTTP monitoring
      - "6222:6222"      # Route port for clustering
    environment:
      NATS_JET_STREAM_MAX_MEMORY: 1Gi
    networks:
      - triodelab-net
    restart: unless-stopped
    healthcheck:
      test: ["CMD-SHELL", "nc -zv localhost 4222 > /dev/null 2>&1"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 15s

  frontend:
    build:
      context: .
      dockerfile: Dockerfile
    ports:
      - "3000:3000"
    env_file:
      - .env
    environment:
      NODE_ENV: production
      HOSTNAME: "0.0.0.0"
    networks:
      - triodelab-net
    restart: unless-stopped
    depends_on:
      triodelab-nats:
        condition: service_healthy
    healthcheck:
      test: ["CMD-SHELL", "wget -q --timeout=5 --tries=1 -O /dev/null http://127.0.0.1:3000 || exit 1"]
      interval: 30s
      timeout: 8s
      retries: 5
      start_period: 120s

networks:
  triodelab-net:
    external: true
    name: triodelab-net
    labels:
      com.docker.compose.network: "triodelab-net"
      com.docker.compose.project: "triodelab"
