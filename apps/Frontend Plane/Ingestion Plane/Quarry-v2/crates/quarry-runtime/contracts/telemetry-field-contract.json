    "run_id",
    "step",
    "zdr",
    "outcome",
    "error_class",
    "status",
    "status_code",
    "driver",
    "driver_name",
    "attempt",
    "count",
    "bytes",
    "byte_size",
    "duration_ms",
    "elapsed_ms",
    "kind",
    "method",
    "route"
