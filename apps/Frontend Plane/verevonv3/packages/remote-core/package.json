{
  "name": "@verevon/remote-core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Browser-first remote desktop client library for Verevon support sessions. Framework-agnostic; does not depend on React or Solid.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "dependencies": {
    "libsodium": "^0.8.4",
    "libsodium-wrappers": "^0.8.4"
  },
  "devDependencies": {
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "typescript": "^7.0.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
