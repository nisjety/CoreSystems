{
  "contract": "model-plane.approval-edit",
  "version": 1,
  "note": "EP-10-S3. Owned by mp-contracts (src/approval_edit.rs); the SPA holds a byte-identical copy pinned by sha256. A value {\"$repeat\": s, \"count\": n} stands for s repeated n times. 'client' is what the SPA's limit check returns for the patch alone (null: only the server can tell).",
  "limits": {
    "min_recipients": 1,
    "max_recipients": 50,
    "max_subject_bytes": 998,
    "max_body_text_bytes": 49152,
    "max_recipient_bytes": 320
  },
  "codes": [
    "not_editable",
    "invalid_recipient",
    "too_many_recipients",
    "invalid_subject",
    "invalid_body",
    "edit_too_large",
    "no_change"
  ],
  "edited_fields": [
    "to",
    "subject",
    "body_text"
  ],
  "cases": [
    {
      "name": "subject_edit_keeps_html_and_threading",
      "input": {
        "connection_id": "conn-1",
        "operation": "gmail.send",
        "params": {
          "userId": "me"
        },
        "body": {
          "to": "alice@example.com, bob@example.com",
          "subject": "Status",
          "bodyText": "Hei",
          "bodyHtml": "<p>Hei</p>",
          "threadId": "t-1",
          "inReplyTo": "<m-1@example.com>"
        }
      },
      "patch": {
        "subject": "  Status, revised "
      },
      "expect": {
        "input": {
          "connection_id": "conn-1",
          "operation": "gmail.send",
          "params": {
            "userId": "me"
          },
          "body": {
            "to": "alice@example.com, bob@example.com",
            "subject": "Status, revised",
            "bodyText": "Hei",
            "bodyHtml": "<p>Hei</p>",
            "threadId": "t-1",
            "inReplyTo": "<m-1@example.com>"
          }
        },
        "edited_fields": [
          "subject"
        ]
      },
      "client": null
    },
