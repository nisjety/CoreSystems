+/* Opt-in, chat-only experiment. Each token is independent; an empty token
+   list restores the existing cascade. No shared/global tokens are changed. */
+
+/* Review controls: native disclosure/checkboxes preserve keyboard behavior. */
+.chat-appearance-preview { position: relative; flex-shrink: 0; }
+.chat-appearance-preview > summary {
+  display: inline-flex;
+  min-height: 40px;
+  align-items: center;
+  gap: 6px;
+  padding: 0 10px;
+  border-radius: 8px;
+  color: var(--verevon-text-muted);
+  font-size: 12px;
+  cursor: pointer;
+  list-style: none;
+}
+.chat-appearance-preview > summary::-webkit-details-marker { display: none; }
+.chat-appearance-preview > summary:hover,
+.chat-appearance-preview[open] > summary { background: var(--verevon-surface-soft); color: var(--verevon-text); }
+.chat-appearance-preview__panel {
+  position: absolute;
+  top: calc(100% + 8px);
+  right: 0;
+  width: min(344px, calc(100vw - 32px));
+  max-height: calc(100dvh - 88px);
+  overflow-y: auto;
+  padding: 20px;
+  border: 1px solid var(--verevon-border);
+  border-radius: 16px;
+  background: var(--panel);
+  color: var(--text);
+  box-shadow: var(--shadow-md);
+}
+.chat-appearance-preview__panel h2 { margin: 0; font-size: 17px; font-weight: 600; letter-spacing: -0.02em; }
+.chat-appearance-preview__panel p { margin: 8px 0 16px; color: var(--verevon-text-muted); font-size: 12px; line-height: 1.5; }
+.chat-appearance-preview__compare { display: flex; padding: 4px; gap: 4px; border-radius: 10px; background: var(--verevon-surface-soft); }
+.chat-appearance-preview__panel button { min-height: 40px; border: 0; border-radius: 8px; padding: 0 12px; background: transparent; color: inherit; font: inherit; font-size: 12px; cursor: pointer; }
+.chat-appearance-preview__compare button { flex: 1; }
+.chat-appearance-preview__compare button[aria-pressed='true'] { background: var(--panel); box-shadow: 0 1px 3px rgb(0 0 0 / 6%); font-weight: 600; }
+.chat-appearance-preview__panel fieldset { margin: 12px 0; padding: 0; border: 0; }
+.chat-appearance-preview__option { display: flex; min-height: 64px; align-items: center; gap: 16px; cursor: pointer; }
+.chat-appearance-preview__option > span { flex: 1; }
+.chat-appearance-preview__option strong { display: block; font-size: 13px; font-weight: 550; }
+.chat-appearance-preview__option small { display: block; margin-top: 4px; color: var(--verevon-text-muted); font-size: 11px; line-height: 1.4; }
+.chat-appearance-preview__option input { width: 18px; height: 18px; flex-shrink: 0; accent-color: var(--verevon-accent-ink); cursor: pointer; }
+.chat-appearance-preview__footer { display: flex; justify-content: space-between; gap: 8px; padding-top: 12px; border-top: 1px solid var(--verevon-border-soft); }
+.chat-appearance-preview__footer button:last-child { background: var(--verevon-surface-soft); font-weight: 600; }
+.chat-appearance-preview__panel button:hover { background: var(--verevon-surface-muted); }
+.chat-appearance-preview :is(summary, button, input):focus-visible,
+.chat-appearance-ideas-toggle:focus-visible { outline: 2px solid var(--verevon-accent-ink); outline-offset: 3px; }
+
+/* 1. Welcome: one focal greeting. Supporting material remains reachable. */
+[data-chat-appearance~='welcome'] .verevon-chat-empty__heading { text-align: center; margin-bottom: 32px; }
+[data-chat-appearance~='welcome'] .verevon-chat-empty__heading h1 { max-width: none; font-size: clamp(26px, 3vw, 34px); font-weight: 450; line-height: 1.2; letter-spacing: -0.025em; text-wrap: balance; }
+[data-chat-appearance~='welcome'] .verevon-chat-empty__brand { display: flex; justify-content: center; margin-bottom: 24px; color: var(--verevon-e-muted); }
+[data-chat-appearance~='welcome'] .verevon-chat-empty__brand > span:last-child { display: none; }
+[data-chat-appearance~='welcome'] .verevon-chat-empty__mark,
+[data-chat-appearance~='welcome'] .verevon-chat-empty__mark > span { width: 36px; height: 36px; }
+[data-chat-appearance~='welcome'] .verevon-chat-empty__heading > p { margin-inline: auto; }
+[data-chat-appearance~='welcome'] [data-ideas-open='false'] :is(.verevon-chat-empty__heading > p, .verevon-chat-empty__resume, .verevon-chat-empty__prompts, .verevon-chat-empty__trust) { display: none; }
+.chat-appearance-ideas-toggle { display: flex; min-height: 44px; align-items: center; justify-content: center; gap: 4px; align-self: center; margin: 8px auto 0; padding: 0 12px; border: 0; border-radius: 8px; background: transparent; color: var(--verevon-e-muted); font: inherit; font-size: 12px; cursor: pointer; }
+.chat-appearance-ideas-toggle:hover { color: var(--verevon-j-text); background: var(--verevon-surface-soft); }
+.chat-appearance-ideas-toggle[aria-expanded='true'] svg { transform: rotate(90deg); }
+[data-chat-appearance~='welcome'] .verevon-chat-empty__prompts { margin-top: 4px; }
+
+/* 2. Dock: normal flex flow, never a fixed overlay over drafts or suggestions. */
+[data-chat-appearance~='dock'] .verevon-chat-empty { align-items: stretch; padding: 24px 24px 16px; overflow-y: auto; }
+[data-chat-appearance~='dock'] .verevon-chat-empty__inner { display: flex; flex-direction: column; flex: 1; min-height: min-content; transform: none; }
+[data-chat-appearance~='dock'] .verevon-chat-empty__heading { display: flex; min-height: 180px; flex: 1 0 auto; flex-direction: column; justify-content: center; align-items: stretch; gap: 0; margin-bottom: 32px; }
+[data-chat-appearance~='dock'] .verevon-chat-empty__composer { flex-shrink: 0; }
+
+/* 3. Composer: join the existing controls and input visually, without
+   remounting/reordering the form or changing its submit/voice/upload state. */
+[data-chat-appearance~='composer'] .dashboard-composer-root--chat .dashboard-composer-controls {
+  gap: 8px;
+  margin-bottom: 0;
+  padding: 8px 12px;
+  border: 1px solid var(--verevon-border);
+  border-bottom: 0;
+  border-radius: 18px 18px 0 0;
+  background: var(--verevon-surface-soft);
+}
+[data-chat-appearance~='composer'] .dashboard-composer-root--chat .verevon-composer-shell {
+  border: 1px solid var(--verevon-border);
+  border-top: 0;
+  border-radius: 0 0 18px 18px;
+  padding: 12px 16px;
+  background: var(--verevon-surface-soft);
+  box-shadow: none;
+}
+[data-chat-appearance~='composer'] .dashboard-composer-root--chat .verevon-composer-shell:focus-within { box-shadow: inset 0 0 0 1px var(--verevon-chat-fjord); }
+[data-chat-appearance~='composer'] .dashboard-composer-root--chat .verevon-composer-shell::before,
+[data-chat-appearance~='composer'] .dashboard-composer-root--chat .verevon-composer-shell::after { display: none; }
+[data-chat-appearance~='composer'] .dashboard-composer-root--chat .verevon-composer-control { border-color: transparent; background: transparent; box-shadow: none; }
+[data-chat-appearance~='composer'] .dashboard-composer-root--chat .verevon-composer-control:hover { background: var(--verevon-i-surface); }
+[data-chat-appearance~='composer'] .dashboard-composer-root--chat .dashboard-composer-intent-segment { background: transparent; }
+[data-chat-appearance~='composer'] .dashboard-composer-root--chat .dashboard-composer-intent-segment button.is-active { box-shadow: none; }
+
+/* 4. History: titles lead. Status remains visible; timestamp stays in the
+   accessible name and native tooltip and returns on hover/keyboard focus. */
+[data-chat-appearance~='history'] .core-chat-sidebar__sessions { gap: 4px; scrollbar-width: thin; scrollbar-color: transparent transparent; }
+[data-chat-appearance~='history'] .core-chat-sidebar__sessions:hover,
+[data-chat-appearance~='history'] .core-chat-sidebar__sessions:focus-within { scrollbar-color: var(--sidebar-muted) transparent; }
+[data-chat-appearance~='history'] .core-chat-session { position: relative; min-height: 40px; padding-block: 10px; }
+[data-chat-appearance~='history'] .core-chat-session > em { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
+[data-chat-appearance~='history'] .core-chat-session:is(:hover, :focus-visible) > em { position: static; width: auto; height: auto; margin: 2px 0 0; clip-path: none; }
+[data-chat-appearance~='history'] .core-chat-session__status { font-weight: 450; }
+[data-chat-appearance~='history'] .core-chat-session-row:focus-within .core-chat-session__pin { opacity: 1; }
+
+/* 5. Navigation: retain every destination and action; quiet the frames. */
+[data-chat-appearance~='navigation'] .core-navbar { border-bottom-color: transparent; }
+[data-chat-appearance~='navigation'] .core-nav-divider { background: transparent; }
+[data-chat-appearance~='navigation'] .core-navbar__home-mark,
+[data-chat-appearance~='navigation'] .core-history-nav,
+[data-chat-appearance~='navigation'] .verevon-navbar-search-trigger { background: transparent; border-color: transparent; box-shadow: none; }
+[data-chat-appearance~='navigation'] .verevon-navbar-search-trigger:hover { background: var(--verevon-surface-soft); }
+[data-chat-appearance~='navigation'] .core-mini-nav-button:not(.verevon-sidebar-mini-active) { color: var(--sidebar-muted); }
+[data-chat-appearance~='navigation'] .core-navbar__profile-ring { opacity: 0; }
+
+@media (max-width: 767px) {
+  /* Keep the development control out of the already compact mobile toolbar. */
+  .chat-appearance-preview { position: fixed; top: 68px; left: 12px; }
+  .chat-appearance-preview > summary { width: 40px; padding: 0; justify-content: center; background: var(--panel); border: 1px solid var(--verevon-border-soft); }
+  .chat-appearance-preview > summary > span { display: none; }
+  .chat-appearance-preview__panel { position: fixed; inset: 116px 12px auto; width: auto; max-height: calc(100dvh - 132px); }
+  [data-chat-appearance~='dock'] .verevon-chat-empty { padding: 20px 12px 12px; }
+  [data-chat-appearance~='dock'] .verevon-chat-empty__heading { min-height: 160px; margin-bottom: 24px; }
+  [data-chat-appearance~='composer'] .dashboard-composer-root--chat .dashboard-composer-controls { flex-wrap: wrap; padding-inline: 8px; }
+  [data-chat-appearance~='composer'] .dashboard-composer-root--chat .verevon-composer-shell { padding: 12px 8px; }
+}
