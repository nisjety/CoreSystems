@@ -0,0 +1,189 @@
+/* Home preview: warm paper surfaces, an asymmetric workspace board, and a
+   compact chat dock. Every rule stays inside the independent Home switch. */
+.dashboard-home--overview {
+  --home-canvas: var(--panel);
+  --home-card: color-mix(in srgb, var(--panel) 96%, var(--verevon-text));
+  --home-line: color-mix(in srgb, var(--verevon-text) 9%, transparent);
+  --home-ink: var(--verevon-text);
+  --home-muted: var(--verevon-text-muted);
+  --home-weather: color-mix(in srgb, var(--verevon-accent) 16%, var(--panel));
+  background: var(--home-canvas);
+  color: var(--home-ink);
+  --dashboard-home-h1-size: 36px;
+  --dashboard-home-h2-size: 20px;
+  --dashboard-home-h3-size: 15px;
+  --dashboard-home-body-size: 13px;
+}
+.dark .dashboard-home--overview {
+  color-scheme: dark;
+  --home-canvas: #20211f;
+  --home-card: #2a2b28;
+  --home-ink: #f0f0eb;
+  --home-muted: #babbb4;
+  --home-line: rgb(240 240 235 / 12%);
+  --home-weather: color-mix(in srgb, var(--verevon-accent) 10%, var(--home-card));
+}
+.dark .home-chat-dock .verevon-dashboard-textarea { color: var(--home-ink); }
+.dark .home-chat-dock .verevon-dashboard-textarea::placeholder { color: var(--home-muted); }
+.dashboard-home--overview .dashboard-home-grid { display: none; }
+.dashboard-home--overview .verevon-home-stage { overflow-y: auto; padding: 40px 40px 24px; scrollbar-gutter: stable; }
+.home-overview-heading { display: flex; flex-shrink: 0; align-items: flex-start; justify-content: space-between; gap: 24px; width: 100%; max-width: 1240px; margin: 0 auto 24px; }
+.home-eyebrow { display: block; color: var(--home-muted); font-size: 11px; font-weight: 500; line-height: 16px; letter-spacing: .015em; }
+.home-eyebrow > span { padding: 0 8px; color: var(--home-line); }
+.home-overview-heading h1 { margin: 12px 0 8px; font-size: clamp(26px, 2.6vw, 36px); font-weight: 400; line-height: 1.2; letter-spacing: -.035em; }
+.home-overview-heading p { margin: 0; color: var(--home-muted); font-size: 13px; }
+.home-overview-heading > time { padding-top: 3px; color: var(--home-muted); font-size: 12px; white-space: nowrap; }
+.dashboard-home--overview .verevon-home-tabs { position: static; width: 100%; max-width: 1240px; height: auto; min-height: 44px; margin: 0 auto 20px; padding: 0; flex-shrink: 0; }
+.dashboard-home--overview .dashboard-home-tabs__inner { justify-content: flex-start; width: 100%; max-width: none; padding: 0; }
+.dashboard-home--overview .dashboard-home-tabs__pill { gap: 6px; padding: 0; border: 0; background: transparent; box-shadow: none; }
+.dashboard-home--overview .dashboard-home-tabs__pill button { min-width: 76px; min-height: 40px; padding: 8px 18px; border: 0; border-radius: 8px; color: var(--home-muted); background: transparent; font-size: 13px; font-weight: 500; box-shadow: none; }
+.dashboard-home--overview .dashboard-home-tabs__pill button:hover { background: var(--home-card); color: var(--home-ink); }
+.dashboard-home--overview .dashboard-home-tabs__pill .dashboard-home-tabs__tab--active { background: var(--home-card) !important; color: var(--home-ink) !important; }
+.dashboard-home--overview .verevon-home-bands { position: relative; inset: auto; height: auto; display: flex; flex: 1 0 auto; flex-direction: column; width: 100%; max-width: 1240px; margin: 0 auto; padding: 0; overflow: visible; gap: 28px; }
+.home-overview-grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 16px; align-items: stretch; }
+.home-overview-card,
+.home-overview-grid .verevon-dashboard-card { min-width: 0; border: 0; border-radius: 12px; background: var(--home-card); box-shadow: none; }
+.home-overview-card { padding: 20px; }
+.home-overview-card h2 { margin: 8px 0 0; font-size: 18px; font-weight: 450; line-height: 1.3; letter-spacing: -.025em; }
+.home-overview-card__header { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
+.home-recent { grid-column: span 8; display: flex; flex-direction: column; }
+.home-quiet-button { display: inline-flex; align-items: center; justify-content: center; gap: 6px; min-height: 36px; padding: 6px 10px; border: 0; border-radius: 7px; background: transparent; color: var(--home-muted); font: inherit; font-size: 12px; cursor: pointer; }
+.home-quiet-button:hover, .home-quiet-button[aria-pressed='true'] { background: var(--home-canvas); color: var(--home-ink); }
+.home-recent__list { margin-top: 14px; }
+.home-recent__row { display: flex; align-items: center; gap: 12px; min-height: 48px; padding: 6px 0; border-bottom: 1px solid var(--home-line); color: inherit; text-decoration: none; }
+.home-recent__row:last-child { border-bottom: 0; }
+.home-recent__row:hover .home-recent__copy strong { text-decoration: underline; text-underline-offset: 3px; }
+.home-recent__icon { display: grid; flex: 0 0 32px; place-items: center; color: var(--home-muted); }
+.home-recent__copy { min-width: 0; flex: 1; }
+.home-recent__copy strong, .home-recent__copy small { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
