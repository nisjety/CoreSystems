+/* The editable step list (plan-gate): the model's plan as data, in the order it
+   will run. Numbering is a counter rather than the list's own marker because
+   each row is a flex line (input + actions), and a flex `li` has no marker. */
+.verevon-chat-plan__summary {
+  margin: 0;
+  font-size: 13px;
+  font-weight: 600;
+  line-height: 1.4;
+  color: var(--verevon-text);
+}
+
+.verevon-chat-plan__steps {
+  display: flex;
+  flex-direction: column;
+  gap: 6px;
+  margin: 0;
+  padding: 0;
+  list-style: none;
+  counter-reset: plan-step;
+}
+
+.verevon-chat-plan__step {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+  counter-increment: plan-step;
+}
+
+.verevon-chat-plan__step::before {
+  content: counter(plan-step) '.';
+  min-width: 18px;
+  font-size: 12px;
+  text-align: right;
+  color: var(--verevon-text-muted);
+}
+
+.verevon-chat-plan__step-input {
+  flex: 1;
+  min-width: 0;
+  padding: 8px 10px;
+  font: inherit;
+  font-size: 12px;
+  color: var(--verevon-text);
+  background: var(--verevon-i-surface);
+  border: 0;
+  border-radius: var(--chat-r-sm, 8px);
+  box-shadow: var(--verevon-chat-shadow);
+}
+
+.verevon-chat-plan__step-actions {
+  display: flex;
+  gap: 2px;
+}
+
+.verevon-chat-plan__step-actions button {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 28px;
+  height: 28px;
+  padding: 0;
+  border: 0;
+  border-radius: 999px;
+  background: transparent;
+  color: var(--verevon-text-muted);
+  cursor: pointer;
+  transition: background-color 140ms ease, color 140ms ease;
+}
+
+.verevon-chat-plan__step-actions button:hover:not(:disabled) {
+  background: var(--verevon-i-surface);
+  color: var(--verevon-text);
+}
+
+.verevon-chat-plan__step-actions button:focus-visible,
+.verevon-chat-plan__add-step:focus-visible,
+.verevon-chat-plan__reject:focus-visible {
+  outline: 2px solid var(--verevon-a-earth);
+  outline-offset: 1px;
+}
+
+.verevon-chat-plan__step-actions button:disabled {
+  opacity: 0.35;
+  cursor: not-allowed;
+}
+
+@media (pointer: coarse) {
+  .verevon-chat-plan__step-actions button {
+    width: 36px;
+    height: 36px;
+  }
+}
+
+.verevon-chat-plan__add-step,
+.verevon-chat-plan__reject {
+  padding: 6px 12px;
+  font: inherit;
+  font-size: 12px;
+  border: 0;
+  border-radius: 999px;
+  background: transparent;
+  color: var(--verevon-text-muted);
+  cursor: pointer;
+  transition: background-color 140ms ease, color 140ms ease;
+}
+
+.verevon-chat-plan__add-step {
+  align-self: flex-start;
+}
+
+.verevon-chat-plan__add-step:hover,
+.verevon-chat-plan__reject:hover:not(:disabled) {
+  background: var(--verevon-i-surface);
+  color: var(--verevon-text);
+}
+
+.verevon-chat-plan__reject:disabled {
+  opacity: 0.55;
+  cursor: not-allowed;
+}
