+/* The canvas fills its frame, so the ring is drawn inset. An inset box-shadow
+   would paint beneath the (opaque) canvas bitmap, so use an inset outline. */
+.verevon-remote-support__screen canvas:focus-visible {
+  outline: 2px solid var(--focus-ring);
+  outline-offset: -2px;
+}
+
 .verevon-remote-support__screen canvas[data-view-only='true'] {
