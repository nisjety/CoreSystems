# verevonv3 stack environment. Copy to `.env` and fill in. `.env` is gitignored.

SOURCE_REVISION=replace-with-tested-git-sha
BUILD_DATE=2026-01-01T00:00:00Z
VEREVON_NATS_TOKEN=replace-with-random-shared-nats-token

# Published development ports bind to loopback by default. Set 0.0.0.0 only
# when LAN access is deliberate and the host firewall is configured.
VEREVON_BIND_ADDRESS=127.0.0.1

# Legacy internal service key for upstreams that have not yet migrated. Control
# Org/Billing/Audit use the distinct audience credentials below and never this.
INTERNAL_API_KEY=
# The anbud core (tender matching) takes its key from Studio's protected anbud_internal_api_key, not from this
# file. Absent, the tender pages say that tender search is not connected in this environment.
CONVERSATION_GATEWAY_SERVICE_TOKEN=

# Canonical browser origin used by the gateway to derive OAuth, invitation,
# and billing return URLs. Production requires one HTTPS origin; loopback HTTP
# is accepted only for local development.
VEREVON_PUBLIC_ORIGIN=http://localhost:5173
# Public build-time URL, not a credential. Must exactly match Marketing's
# MARKETING_GOOGLE_OAUTH_CALLBACK_URL and the callback registered with Google.
VITE_MARKETING_GOOGLE_OAUTH_CALLBACK_URL=http://localhost:3026/oauth/callback/google

# Dedicated session-core credential. This is separate from the fleet key and
# is bound by session-core to the verevon-gateway principal and session scopes.
SESSION_CORE_SERVICE_TOKEN=
GATEWAY_ORG_CORE_SERVICE_TOKEN=
GATEWAY_BILLING_CORE_SERVICE_TOKEN=
GATEWAY_AUDIT_CORE_SERVICE_TOKEN=
USER_CORE_GATEWAY_TOKEN=
NOTIFICATION_GATEWAY_SERVICE_TOKEN=

# Browser → gateway base URL. Leave EMPTY for same-origin: the SPA calls /api on
# its own origin and nginx (Docker) / Vite (dev) reverse-proxies to the gateway,
# keeping the Better Auth session cookie first-party. Only set an absolute URL
# for a direct (cross-origin, cookie-losing) connection.
VITE_VEREVON_GATEWAY_URL=

# Browser omnibox search (WS9.A). `1` puts free text in the browser address bar
# through Verevon search; unset or `0` keeps URL navigation only. Set it to `1` for
# dev and staging builds; production stays `0` until the gateway search cache
# carries the org key (WS4.A deployed).
VITE_BROWSER_OMNIBOX_SEARCH=0

# Browser replay scrubber (F-t3-050 R1). `true` shows the timeline slider and
# auto-play in the browser chrome. Unset or `false` keeps today's timeline.
VITE_BROWSER_REPLAY_SCRUBBER=false

# Per-action brief in the agent run console (F-t3-050 R2). `true` shows one row per
# browser action with its gate, decision and observation. Unset or `false` keeps
# today's two rows per action.
VITE_BROWSER_ACTION_BRIEF=false

# Browser walkthrough in the run proof bundle (F-t3-050, W4-R3-b). `true` shows one filmstrip frame per browser
# action, from the screenshots the run already recorded. Unset or `false` keeps the proof bundle as it was.
VITE_RUN_PROOF_WALKTHROUGH=false

# Support reference and support bundle in the run console (W5-096-b). `true` shows the run id and the proof read's
# request id as a copyable reference, and a download of the run's support bundle. A run that keeps no content gets a
# bundle of ids, statuses and timestamps only. Unset or `false` hides both.
VITE_RUN_SUPPORT_BUNDLE=false

# Auth bypass is disabled by default. Set both only for deliberate local
# smoke-testing without auth-core; never enable them in shared environments.
CONTROL_PLANE_ENFORCEMENT=strict
VITE_ALLOW_DEV_AUTH_BYPASS=false
ALLOW_DEV_AUTH_BYPASS=0
# Legacy Model Plane bypass token. Leave empty; normal requests use a scoped,
# short-lived audience token minted from the authenticated user session.
MODEL_GATEWAY_DEV_BEARER=

# Public Cloudflare Turnstile site key used by the signup captcha widget.
# Auth-core must also have CAPTCHA_ENABLED=true and TURNSTILE_SECRET_KEY set.
VITE_TURNSTILE_SITE_KEY=

# Offer "run the approved plan" after a plan is approved (WS14 S2a). Default off. Flip
# it together with MODEL_GATEWAY_PLAN_EXECUTE_ENABLED and the other coupled loop
# switches (gateway first on, SPA last on; roll back in reverse). With it off, an
# approval arms nothing and the composer shows no third pill.
VITE_PLAN_EXECUTE_ENABLED=false
# WS08-S4: images ride as parts; flip together with the gateway's CHAT_VISION_AS_PARTS_ENABLED.
VITE_CHAT_VISION_AS_PARTS_ENABLED=false
# Computer panel (EP-1 W4-B, P1). `true` draws a tool call's terminal output and workspace file in typed viewers
# inside its tool card. Off keeps every tool card as it was.
VITE_CHAT_COMPUTER_PANEL=false
# Image card (W4-IMG-4). `true` shows a generated image's tool call with the model and provider that made it, and its
# typed refusals in words. Off keeps the image call's card as it was. Only matters once the gateway offers the image tool.
VITE_CHAT_IMAGE_TOOL=false
# Changed-files card (F-t3-076). `true` lists the files a run saved to its Space workspace under the answer, new or
# edited. Off keeps every answer as it was.
VITE_CHAT_CHANGED_FILES=false
# Image strip (F-t3-044, W4-IO-1). `true` shows the image results of a settled web-search answer under the answer, each
# linked to its page. Never shown in a temporary chat or a Space thread. Off keeps every answer as it was.
VITE_CHAT_IMAGE_STRIP=false
# Double-Escape stop (F-t3-077). `true` lets two bare Escape presses within 600 ms stop the streaming answer, as the
# Stop button does. Off keeps Escape as it was.
VITE_CHAT_DOUBLE_ESCAPE_STOP=false
# Connection pill (F-t3-078). `true` shows "Offline" or "Reconnecting…" above the composer when the chat cannot reach its
# service, after a short hold so a blip does not flicker. Off keeps the composer as it was.
VITE_CHAT_CONNECTION_PILL=false
# Long-task beacon (F-t3-096). `true` sends a content-free beacon at most once a minute per duration bucket: the build id
# and the bucket, never an entry name or a URL. Off sends nothing.
VITE_LONG_TASK_BEACON=false

# Support › Remote support surface config, read from apps/Support Plane
# (hbbs/hbbr). All three empty by default -- the gateway reports
# configured:false and the UI refuses to connect rather than guess a host;
# it never itself connects to hbbs/hbbr, only the browser does. See
# apps/Support Plane/README.md for how to run Support Plane and generate
# the shared key (SUPPORT_PLANE_KEY must NOT be `_` once a relay is needed).
REMOTE_SUPPORT_RENDEZVOUS_URL=
REMOTE_SUPPORT_RELAY_URL=
REMOTE_SUPPORT_SERVER_PUBLIC_KEY=
