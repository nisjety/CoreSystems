{
  "name": "verevonv3",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "vite",
    "dev:studio-demo": "vite --config vite.studio-demo.config.ts --host 127.0.0.1 --port 5174 --strictPort",
    "build": "pnpm typecheck && vite build",
    "build:studio-demo": "pnpm typecheck && vite build --config vite.studio-demo.config.ts",
    "audit": "pnpm audit",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:studio-demo": "vite preview --config vite.studio-demo.config.ts --host 127.0.0.1 --port 5174 --strictPort",
    "test": "node --test apps/gateway/scripts/security-coverage-gate.test.mjs apps/gateway/scripts/action-surface-contract.test.mjs apps/gateway/scripts/product-truth-contract.test.mjs apps/gateway/scripts/zdr-seed-test-org.test.mjs && vitest run",
    "test:scripts": "node --test scripts/frontend-build-contract.test.mjs scripts/run-frontend-plane.test.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "typecheck": "pnpm --filter @quarry/client build && pnpm --filter @verevon/remote-core build && tsc -b",
    "demo:build": "node scripts/build-product-demo.mjs",
    "demo:probe": "node scripts/probe-product-demo.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "3d-force-graph": "^1.80.0",
    "@kobalte/core": "^2.0.0-alpha.0",
    "@quarry/client": "workspace:*",
    "@solidjs/router": "^2.0.0-next.16",
    "@solidjs/web": "^2.0.0-rc.0",
    "@tanstack/ai": "^0.53.0",
    "@tanstack/ai-client": "^0.31.0",
    "@tanstack/solid-query": "^6.0.0-rc.0",
    "@verevon/remote-core": "workspace:*",
    "clsx": "^2.1.1",
    "d3-force-3d": "^3.0.6",
    "katex": "^0.18.7",
    "mermaid": "^12.0.0",
    "solid-js": "^2.0.0-rc.0",
    "three": "^0.185.1",
    "three-spritetext": "^1.10.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@solidjs/testing-library": "^1.0.0-beta.2",
    "@solidjs/vite-plugin": "^3.0.0-next.30",
    "@types/node": "^26.4.1",
    "@types/three": "^0.185.4",
    "@typescript/native": "npm:typescript@^7.0.2",
    "eslint": "^10.10.0",
    "eslint-plugin-solid": "^0.17.0",
    "@vitest/coverage-v8": "4.1.10",
    "jsdom": "^30.0.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-mcp": "^0.3.2",
    "vitest": "^4.1.10"
  }
}
