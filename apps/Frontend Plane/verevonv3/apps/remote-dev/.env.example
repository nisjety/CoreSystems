# Copy to .env.local (git-ignored) and point at a running Support Plane.
#
# Local Support Plane without TLS termination talks plain ws:// on the
# native WebSocket ports; a deployed one behind Caddy uses wss:// on 443.
VITE_REMOTE_RENDEZVOUS_URL=ws://localhost:21118
VITE_REMOTE_RELAY_URL=ws://localhost:21119

# Base64 Ed25519 public key of the rendezvous server (hbbs prints/stores one
# in its data volume as `id_ed25519.pub`). WITHOUT this the peer cannot be
# authenticated, and remote-dev falls back to an unverified handshake — fine
# for a local test rig, never for anything real. See docs/security.md.
VITE_REMOTE_SERVER_PUBLIC_KEY=
