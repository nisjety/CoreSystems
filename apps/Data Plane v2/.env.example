# Data Plane v2 environment

# Required image provenance. `make docker-build` derives both automatically;
# direct Compose invocations must provide them explicitly.
SOURCE_REVISION=
BUILD_DATE=

# ── Postgres ─────────────────────────────────────────────────
POSTGRES_USER=dataplane
# Required. Generate a unique value; never reuse the example file as a secret.
POSTGRES_PASSWORD=
POSTGRES_DB=dataplane
PG_MAX_CONNECTIONS=20
PG_MIN_CONNECTIONS=2
PG_ACQUIRE_TIMEOUT_SECS=5

# ── Infra (container-internal only; Compose does not publish these ports) ──
# Required unique password for the plane-local cache.
DATAPLANE_DRAGONFLY_PASSWORD=
DRAGONFLY_URL=redis://dragonfly:6379
QDRANT_URL=http://qdrant:6334
# Required URL-safe token for the plane-local JetStream broker.
DATAPLANE_NATS_TOKEN=
NATS_URL=nats://nats:4222

# ── Object storage + sparse search read model ────────────────
# Required unique credentials. No checked-in/default object-store secret exists.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Optional scoped credential for the Ingestion Plane's visual-RAG CAS producer
# (quarry-edge PageRenderer). When both are set, minio-init provisions a MinIO
# user restricted to read/write on the `dataplane-cas` bucket only — the same
# values go into the Ingestion Plane's secret store as QUARRY_CAS_ACCESS_KEY /
# QUARRY_CAS_SECRET_KEY. Leave empty to keep the producer contract unprovisioned.
CAS_INGESTION_ACCESS_KEY=
CAS_INGESTION_SECRET_KEY=
QUICKWIT_URL=http://quickwit:7280
QUICKWIT_INDEX_ID=dataplane-corpus
# postgres = simplest local fallback. quickwit = corpus-scale sparse search
# with Postgres fallback inside retrieval-engine.
SPARSE_SEARCH_BACKEND=postgres
QUICKWIT_SEARCH_TIMEOUT_MS=1500
QUICKWIT_ADAPTER_ADMIN_PORT=9204
QUICKWIT_ADAPTER_BATCH_SIZE=500
# true is useful for ephemeral dev stacks; production should rebuild
# deliberately through scripts/rebuild-quickwit.sh or an ops job.
QUICKWIT_ADAPTER_REBUILD_ON_START=false

# ── Keyword arm (Meilisearch — typo-tolerant exact-ID/code lookup) ──
# Required. Generate a unique value (e.g. `openssl rand -hex 32`); never
# reuse the example file as a secret. Used both as Meilisearch's admin/master
# key (meilisearch-adapter-rs's indexing writes) and as the bearer
# retrieval-engine-rs sends when querying the keyword arm. An unset key
# disables the arm end to end rather than sending an unauthenticated request.
MEILISEARCH_MASTER_KEY=
MEILISEARCH_URL=http://meilisearch:7700
MEILISEARCH_INDEX_UID=dataplane-knowledge
MEILISEARCH_ADAPTER_ADMIN_PORT=9205
# Small by design: a new, unproven arm starts at the same modest calibration
# w_visual launched with, not at parity with the established arms.
W_KEYWORD=0.05
# Sparse/BM25 fusion weight — measured 2026-08-26 (87 judged queries, both eval
# orgs): recall flat 0.0..0.4, nDCG declines monotonically as it rises. 0.1
# keeps the arm alive for exact-term/Norwegian lookups the query set
# under-represents. Re-measure with `make eval-retrieval` before changing.
W_BM25=0.1
# Fused candidates sent to the Cohere cross-encoder per query. At 50 each query
# is exactly one provider call; unbounded sharding 429'd 93/94 queries against
# the Foundry S0 per-second quota and silently degraded to fused order.
RERANK_TOP_K=50

# ── Embedding provider ───────────────────────────────────────
# Default path: Data Plane → current Model Plane inference-core gRPC → Azure OpenAI.
# Direct Azure from Data Plane is kept only as an explicit fallback:
# set EMBEDDING_PROVIDER=azure_openai and fill the Azure values below.
EMBEDDING_PROVIDER=model_plane
MODEL_PLANE_AI_CORE_GRPC_URL=http://inference-core:9092
MODEL_PLANE_EMBEDDING_PROVIDER=azure_openai
MODEL_PLANE_EMBEDDING_TIMEOUT_MS=30000
# Auth Core audited service-principal contract for inference-core callers.
# Register this deployment secret for audience inference-core and scope
# inference:invoke in Auth Core's PLANE_SERVICE_PRINCIPALS_JSON.
MODEL_PLANE_INFERENCE_TOKEN_URL=http://auth-core:3011/api/inference-core/internal-token
MODEL_PLANE_INFERENCE_TOKEN_ISSUER=http://auth-core:3011/api/convex-auth
MODEL_PLANE_INFERENCE_SERVICE_ID=graph-index
# The retention posture graph-index's token must carry, as the principal registry
# spells it for inference-core:
#   persistent  zdr:false. Must match the principal's retentionByAudience entry.
#   zdr         zdr:true. Must match the entry.
#   tenant      zdr is the ORGANIZATION's own setting, resolved by Auth Core at the
#               mint. Either value is accepted and honoured; the token lives 60 s,
#               and when Auth Core cannot resolve the organization's posture it
#               issues no token (503 retention_posture_unavailable) and the work
#               waits. A `tenant` client works against every registry entry, so
#               the order of the enablement step is: ship the client, set this to
#               `tenant`, then change the registry. Never the other way round: a
#               client left on `persistent` refuses the zdr:true token a ZDR
#               organization gets from a `tenant` entry and that organization waits.
# An unknown value stops the service at startup. `make cross-plane-env` checks it.
MODEL_PLANE_INFERENCE_RETENTION_POSTURE=persistent
MODEL_PLANE_INFERENCE_SERVICE_API_KEY=
# Embedding-engine uses the same audience-bound Auth Core contract with its own
# registered principal. Never reuse the graph/retrieval credential. Its posture is
# set by ITS OWN variable (compose passes it to the container as
# MODEL_PLANE_INFERENCE_RETENTION_POSTURE); same values, same enablement order,
# set separately from graph-index's.
MODEL_PLANE_EMBEDDING_INFERENCE_SERVICE_ID=embedding-engine
MODEL_PLANE_EMBEDDING_INFERENCE_RETENTION_POSTURE=persistent
MODEL_PLANE_EMBEDDING_INFERENCE_SERVICE_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
EMBEDDING_DIMENSION=3072

# ── Contextual retrieval (embedding-engine) ──────────────────
# A model writes one or two situating sentences for each chunk, and the chunk is embedded and
# keyword-indexed together with them. It is ON by default and stays on (owner ruling of
# 2026-10-03): every variable below carries the default shown, so a deployment that sets none of
# them generates contexts, and the compose file has the same defaults (a contract test keeps the
# two, and this file, equal). The runbook is docs/contextual-retrieval-runbook.md; its section 3
# lists every switch with its boot-time check.
#
# The incident kill switch. Set CONTEXTUAL_RETRIEVAL_ENABLED=false only when content must stop
# going to the provider (a confirmed posture failure, a provider incident, a legal instruction),
# never to relieve load or cost, and tell the owner first. The service refuses to start with it
# off unless CONTEXT_RETRIEVAL_KILL_SWITCH_REASON says why: 8 to 240 characters, one line, nothing
# a reader of /readyz should not see (no customer name, no personal data). The reason is logged
# at startup and reported by /readyz. An empty value of the switch is the default (on), never
# off, and a value that is not true, 1, false or 0 stops the service. Nothing stored is removed.
CONTEXTUAL_RETRIEVAL_ENABLED=true
CONTEXT_RETRIEVAL_KILL_SWITCH_REASON=
# The model: the Azure deployment inference-core serves, always named, never implicit. The shared
# gpt-4o-mini deployment is the default. A dedicated background deployment alias (an operator
# action on the Model Plane: add the deployment to inference-core's chat catalog,
# AZURE_OPENAI_CHAT_DEPLOYMENTS) is another value of this one variable, and it ends the sharing
# with chat; until it exists, the caps and the circuit breaker below protect chat's share.
CONTEXTUAL_RETRIEVAL_MODEL=gpt-4o-mini
# The route is pinned to Azure OpenAI and the residency floor is the EU; an empty value takes
# these, never "any provider" or "no floor". The floor is only as good as inference-core's own
# AZURE_OPENAI_REGION, which must name an EU region or every call is refused as
# residency_unavailable. The floor is one of global, eu, eea, norway, no, sovereign.
CONTEXTUAL_RETRIEVAL_PROVIDER_HINT=azure-openai
CONTEXTUAL_RETRIEVAL_MIN_RESIDENCY=eu
# The prompt version. ctx-v1 is the one every stored context came from; ctx-v2 ships only through
# the evaluation gate.
CONTEXTUAL_RETRIEVAL_PROMPT_VERSION=ctx-v1
# Characters of document text in one prompt: a document up to this size is read whole, a longer
# one in overlapping sections (8000 up to the next variable). The next is the most document text a
# prompt may carry, whatever the window is.
CONTEXTUAL_RETRIEVAL_WINDOW_CHARS=32000
CONTEXTUAL_RETRIEVAL_MAX_DOCUMENT_CHARS=48000
# The output cap in tokens (16 to 1024), the timeout of one call, how many chunks of one document
# are generated at once, and the retries on a transient status (a rate limit, unavailable, a
# timeout): attempts, and the first backoff step in milliseconds, which doubles.
CONTEXTUAL_RETRIEVAL_MAX_TOKENS=128
CONTEXTUAL_RETRIEVAL_TIMEOUT_MS=30000
CONTEXTUAL_RETRIEVAL_CONCURRENCY=4
CONTEXTUAL_RETRIEVAL_RETRY_ATTEMPTS=4
CONTEXTUAL_RETRIEVAL_RETRY_BASE_MS=2000
# The inline time box: the milliseconds of one batch (at most 30000) and of one document spent
# generating contexts while the ingest waits. A chunk not finished by then is embedded raw, left
# pending, and filled by the reconciler; 0 makes all generation asynchronous. The third is how
# many documents of one batch are worked at once (1 to 32): the most provider calls one batch has
# in flight is that times CONTEXTUAL_RETRIEVAL_CONCURRENCY. Raise them with the dedicated
# deployment alias, not before.
CONTEXT_INLINE_BUDGET_MS=20000
CONTEXT_INLINE_DOCUMENT_BUDGET_MS=8000
CONTEXT_INLINE_DOCUMENT_CONCURRENCY=2
# The reconciler: the loop that fills the units that have no context, verifies the legacy ones
# (no model is asked), re-embeds a vector that is not the one its stored context makes, and
# rechecks the units skipped for zero retention. It ships dark: 0 until the live proof of the
# runbook (section 5.2), then 1 with the limits below. Turned on, the service refuses to start
# unless signed events are enabled and every value is inside its bounds, and the message names
# the variable.
CONTEXT_RECONCILER_ENABLED=0
# Seconds between passes when there was nothing to do (1 to 3600); units one pass leases in all
# (1 to 500) and for one organization (1 to the first); documents worked at once in all and for
# one organization (1 to 16, 1 to the first); chunks of one document at once (1 to 16).
CONTEXT_RECONCILER_INTERVAL_SECS=30
CONTEXT_RECONCILER_UNITS_PER_PASS=32
CONTEXT_RECONCILER_ORG_UNITS_PER_PASS=16
CONTEXT_RECONCILER_CONCURRENCY=2
CONTEXT_RECONCILER_ORG_CONCURRENCY=1
CONTEXT_RECONCILER_CHUNK_CONCURRENCY=2
# How long a leased unit belongs to the reconciler that leased it (60 to 3600 seconds, and more
# than twice the time box); the time box of one batch and of one document in milliseconds (the
# batch's at most 30000, the document's never more).
CONTEXT_RECONCILER_LEASE_SECS=300
CONTEXT_RECONCILER_BUDGET_MS=30000
CONTEXT_RECONCILER_DOCUMENT_BUDGET_MS=25000
# A unit that fails for its own sake this many times becomes failed_permanent, with an alert (1 to
# 100). After this many passes in a row in which the provider failed everything, the circuit
# breaker pauses the reconciler for the pause below (1 to 20 passes, 10 to 3600 seconds); a
# refused credential opens it at once. Creating the pause file stops every pass from the next one
# on, with no restart (docker exec <container> touch <file>; remove it to resume); empty turns the
# file off.
CONTEXT_RECONCILER_MAX_ATTEMPTS=8
CONTEXT_RECONCILER_BREAKER_FAILURES=3
CONTEXT_RECONCILER_BREAKER_PAUSE_SECS=300
CONTEXT_RECONCILER_PAUSE_FILE=/tmp/context-reconciler.pause
# Seconds between two checks of an organization whose units were skipped for zero retention (60 to
# 86400), and between the sweeps for the work the queue does not cover (10 to 86400).
CONTEXT_RECONCILER_ZDR_RECHECK_SECS=3600
CONTEXT_RECONCILER_SWEEP_SECS=300
# Regenerate the contexts of a document that changed after they were made (a chunk whose inputs did
# not change costs nothing), and how many documents one sweep checks (1 to 100). Off: an edited
# document costs one provider call per chunk whose window changed, and that is a decision.
CONTEXT_RECONCILER_STALE_ENABLED=0
CONTEXT_RECONCILER_STALE_DOCUMENTS=8
# A prompt refresh: regenerate the contexts made with another prompt version than the one in
# force. Off, and always capped: with the first on, the service refuses to start unless the cap is
# above zero. The cap counts over the life of the process, so a restart grants it again; write
# that in the change record.
CONTEXT_REFRESH_ON_PROMPT_CHANGE=0
CONTEXT_REFRESH_MAX_UNITS=0
# The usage events of these calls and the background budget are set below (the usage ledger) and
# with graph extraction (BACKGROUND_BUDGET_*).

# ── Reranker (Cohere — optional; set empty to disable) ───────
COHERE_API_KEY=
RERANKER_MODEL=rerank-english-v3.0

# ── Graph extraction (through inference-core only) ───────────
# graph-index reaches a model through inference-core with the Auth Core service token above
# (MODEL_PLANE_INFERENCE_*), never with a key of its own: the direct-Azure backend, and with it
# GRAPH_EXTRACTION_PROVIDER, AZURE_OPENAI_EXTRACTION_DEPLOYMENT and the Azure key and endpoint in
# graph-index's environment, is gone (setting GRAPH_EXTRACTION_PROVIDER=azure_openai stops the service).
# The poison cap: attempts after which a failing chunk is given up on (1 to 50).
GRAPH_EXTRACTION_MAX_ATTEMPTS=6
# Background LLM budget, read by embedding-engine (contextual retrieval) AND graph-index (graph
# extraction and community summaries): one setting holds for both, and the spend is one figure, the
# month's `llm` tokens of the organization in cost_events. Owner default: alert only, no figure, no
# prices built in. Over a figure, alert_only logs, counts ctx_budget_exceeded_total (embedding-engine
# /metrics) and keeps working; throttle works one chunk at a time and the rest wait; stop withholds
# the work and marks the units skipped_budget until the budget allows it again. An organization's own
# budget_mode and figure (org_processing_policy) win over these; the policy API accepts them only
# after the images that read them are deployed (runbook 5.5). The prices (USD per million tokens) are
# set together or not at all. Without them, with the usage ledger off (USAGE_EMIT_ENABLED=0) or when
# the ledger cannot be read, a budget that applies cannot be measured: it is alerted in the log and
# the work proceeds, never stopped on a guess. Boot checks (both services): an unknown mode, a figure
# or price that is not a number from 0 up, one price without the other, and, in embedding-engine, a
# throttle or stop with a figure and no prices or with the ledger off, stop the service and name the
# variable.
BACKGROUND_BUDGET_MODE=alert_only
BACKGROUND_BUDGET_MONTHLY_USD=
BACKGROUND_PRICE_INPUT_USD_PER_MTOK=
BACKGROUND_PRICE_OUTPUT_USD_PER_MTOK=
# Community summaries are a paid call each: off unless 1, true or yes; at most this many per run.
COMMUNITY_SUMMARY_ENABLED=0
COMMUNITY_SUMMARY_MAX_PER_RUN=5

# ── Retrieval defaults ───────────────────────────────────────
RETRIEVAL_TOP_K=100
RETRIEVAL_TOP_N=10
CONFIDENCE_THRESHOLD=0.35
HYBRID_ENABLED=true
BM25_WEIGHT=0.3

# ── gRPC server tuning (Tower middleware, v2.1) ──────────────
GRPC_TIMEOUT_SECS=30
GRPC_MAX_CONCURRENT=256

# ── Cross-plane NATS (Control-owned; never invent these values) ─────────────
# `make standalone-up` starts without Control/User/Model. It explicitly pauses
# only the Control-owned GDPR consumer; protected requests and grant-only reads
# still fail closed until the authorities return. `make cross-plane-up` attaches
# to the pre-provisioned shared network after Control is running.
# Production must inject the exact broker URL/password provisioned by Control;
# random strings here will not match its ACL and are rejected by the consumer.
VEREVON_NATS_TOKEN=
NATS_SHARED_URL=
DOCUMENTS_GDPR_NATS_USER=documents-api-gdpr
DOCUMENTS_GDPR_NATS_PASSWORD=
# Optional Application Plane publisher for the durable, content-free Knowledge
# observability mirror. In the local shared stack, first start Application Plane
# once (its runner creates the dedicated credential), then run:
#   bash scripts/provision-knowledge-observability-bridge.sh
# Docker Compose reads the resulting isolated `.secrets/knowledge-observability.env`
# file. It contains only this bridge identity and never the wider Application
# Plane secret store. Direct non-Compose Documents API runs may instead set the
# following three values. Never reuse the GDPR, integration, or Data-Plane-local
# NATS identities; leaving them empty keeps a standalone Data Plane disabled.
KNOWLEDGE_OBSERVABILITY_NATS_URL=
KNOWLEDGE_OBSERVABILITY_NATS_USER=data-plane-knowledge-publisher
KNOWLEDGE_OBSERVABILITY_NATS_PASSWORD=
QUICKWIT_ADAPTER_GDPR_NATS_USER=quickwit-adapter-gdpr
QUICKWIT_ADAPTER_GDPR_NATS_PASSWORD=
# retrieval-engine-rs's GDPR consumer uses a fully distinct env var trio
# (including its own URL) rather than reusing NATS_SHARED_URL above — this
# service already reads a similarly-named SHARED_NATS_URL for its own
# Data-Plane-local NATS fallback chain, so sharing the near-identical
# NATS_SHARED_URL name here would invite exactly the kind of mix-up the GDPR
# rollout's fix pass already found once. Empty URL = consumer disabled.
RETRIEVAL_ENGINE_GDPR_NATS_URL=
RETRIEVAL_ENGINE_GDPR_NATS_USER=retrieval-engine-gdpr
RETRIEVAL_ENGINE_GDPR_NATS_PASSWORD=
INTER_PLANE_BUS_NETWORK=inter-plane-bus
USER_CORE_GRANTS_REQUIRED=1
GDPR_DURABLE_CONSUMER_REQUIRED=1

# Dedicated asynchronous event signing keys. Generate one independent RSA-2048+
# pair per producer; mount private keys only into that producer and distribute
# only the matching public verification file to its direct consumers.
# Production containers use UID/GID 10001. On Linux, provision private keys as
# group 10001 with mode 0440 and public keys as mode 0444 so the non-root
# services can read them without making private material world-readable.
DOCUMENTS_EVENT_SIGNING_PRIVATE_KEY_PATH=.secrets/event-keys/documents-events.pem
DOCUMENTS_EVENT_VERIFYING_PUBLIC_KEY_PATH=.secrets/event-keys/documents-events.pub
INDEX_EVENT_SIGNING_PRIVATE_KEY_PATH=.secrets/event-keys/index-events.pem
INDEX_EVENT_VERIFYING_PUBLIC_KEY_PATH=.secrets/event-keys/index-events.pub
EMBEDDING_EVENT_SIGNING_PRIVATE_KEY_PATH=.secrets/event-keys/embedding-events.pem
EMBEDDING_EVENT_VERIFYING_PUBLIC_KEY_PATH=.secrets/event-keys/embedding-events.pub
WIKI_EVENT_SIGNING_PRIVATE_KEY_PATH=.secrets/event-keys/wiki-events.pem
WIKI_EVENT_VERIFYING_PUBLIC_KEY_PATH=.secrets/event-keys/wiki-events.pub
# For local standalone, generate a distinct retrieval pair under the ignored
# `.secrets/event-keys` directory (or use the isolated harness). Production
# paths must point at deployment-secret-manager mounts, not copied keys.
RETRIEVAL_EVENT_SIGNING_PRIVATE_KEY_PATH=.secrets/event-keys/retrieval-events.pem
RETRIEVAL_EVENT_VERIFYING_PUBLIC_KEY_PATH=.secrets/event-keys/retrieval-events.pub
# graph-index's own pair (CR-T10): it signs its usage events, data-orchestrator verifies them.
# The private key is mounted into graph-index only, the public key into data-orchestrator only.
# The bootstrap creates the local pair; production keys come from the secret manager at an
# absolute path, never under .secrets/event-keys (`make cross-plane-up` rejects that path).
GRAPH_EVENT_SIGNING_PRIVATE_KEY_PATH=.secrets/event-keys/graph-events.pem
GRAPH_EVENT_VERIFYING_PUBLIC_KEY_PATH=.secrets/event-keys/graph-events.pub

# ── Usage ledger (CR-T10) ────────────────────────────────────
# Every paid provider call (contextual retrieval, embedding, graph extraction) is recorded as a
# signed version 2 event on the durable DATAPLANE_COST stream, read by data-orchestrator into
# cost_events and forwarded to cost-core. Both switches ship as 0 and are turned on in this
# order (the contextual retrieval runbook, section 5.8): the consumer first, then producers,
# then the forwarder.
#   USAGE_EMIT_ENABLED   embedding-engine and graph-index. 1 or true turns it on. Needs signed
#                        events; the service refuses to start unless the stream can be created
#                        or verified. Off, the version 1 cost event is published as before.
#   USAGE_FORWARDER_ENABLED  data-orchestrator. Exactly 1 turns it on. Only after cost-core
#                        accepts the `feature` and `units` fields (CR-T4) and has priced the
#                        models the Data Plane meters; refuses to start without the credential.
USAGE_EMIT_ENABLED=0
USAGE_FORWARDER_ENABLED=0
# The data-orchestrator principal's credential for cost-core (registry row `data-orchestrator`,
# scope cost:write). Deployment-owned, 32+ characters, no placeholder marker, shared with no
# other credential. Provisioned by the Control Plane launcher; only read when the forwarder is on.
DATA_ORCHESTRATOR_COST_SERVICE_API_KEY=
USAGE_FORWARDER_COST_CORE_URL=http://cost-core:8089
USAGE_FORWARDER_TOKEN_URL=http://auth-core:3011/api/cost-core/internal-token

# ── Auth (cross-plane shared secret) ─────────────────────────
INTERNAL_API_KEY=
AUTH_CORE_GRPC_URL=
ORG_CORE_GRPC_URL=
# Read-only Auth Core public key mount. Override this in a standalone Data
# deployment; the running Auth Core process is not required for startup.
AUTH_CORE_PUBLIC_KEY_PATH=../Control Plane/auth-core/keys/convex-auth.pub

# ── Wave 3: Control Plane policy enforcement ─────────────────
# Registered retrieval service principal. The credential is presented only to
# the token issuer; the decision endpoint receives an org-bound bearer.
CONTROL_POLICY_SERVICE_ID=retrieval-engine
CONTROL_POLICY_SERVICE_API_KEY=
CONTROL_POLICY_TOKEN_URL=http://auth-core:3011/api/control-policy/internal-token
USER_CORE_RETRIEVAL_TOKEN=
USER_CORE_DOCUMENTS_TOKEN=
CONTROL_PLANE_ENFORCEMENT=strict
CONTROL_PLANE_DECISION_URL=http://auth-core:3011/api/v1/internal/authorization/data-plane/decision
USER_SERVICE_HTTP_URL=http://user-service:3012
ORG_CORE_HTTP_URL=http://org-core-service:8080
# JWT validation is mandatory. The public key is mounted from auth-core for Rust
# services; Go services use the internal JWKS endpoint.
# JWKS resolves through the Control Plane network alias. The issuer is the
# canonical token claim Auth Core emits, so it deliberately remains the stable
# local public origin rather than the internal Docker hostname.
AUTH_CORE_JWKS_URL=http://auth-core:3011/api/convex-auth/jwks
AUTH_CORE_ISSUER=http://localhost:3011/api/convex-auth
JWT_PUBLIC_KEY_PEM=
JWT_REQUIRED_ISSUER=http://auth-core:3011/api/convex-auth
JWT_REQUIRED_AUDIENCE=data-plane

# ── Observability (optional — set to enable OTel export) ─────
OTEL_EXPORTER_OTLP_ENDPOINT=
GRAFANA_ADMIN_PASSWORD=

# ── Self-owned data services (optional overlays) ─────────────
OPENSANCTIONS_YENTE_URL=http://opensanctions-yente:8000
YENTE_INDEX_URL=http://opensanctions-elasticsearch:9200
YENTE_AUTO_REINDEX=false
YENTE_UPDATE_TOKEN=
NOMINATIM_URL=http://nominatim:8080
NOMINATIM_PBF_URL=https://download.geofabrik.de/europe/monaco-latest.osm.pbf
NOMINATIM_REPLICATION_URL=
NOMINATIM_PASSWORD=
OPEN_DATA_MANIFEST_PATH=manifests/open-data/self-owned-open-data.json
USER_CORE_DOCUMENTS_TOKEN=
USER_CORE_RETRIEVAL_TOKEN=

# Set to 1 to run the page-image (visual RAG) consumer alongside signed text
# consumers even though the quarry-edge producer does not sign envelopes yet.
ALLOW_UNSIGNED_PAGE_IMAGE_EVENTS=
