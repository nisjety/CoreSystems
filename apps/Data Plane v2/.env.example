# Data Plane v2 environment

# Required image provenance. `make docker-build` derives both automatically;
# direct Compose invocations must provide them explicitly.
SOURCE_REVISION=
BUILD_DATE=

# ── Postgres ─────────────────────────────────────────────────
POSTGRES_USER=dataplane
# Required. Generate a unique value; never reuse the example file as a secret.
POSTGRES_PASSWORD=
POSTGRES_DB=dataplane
PG_MAX_CONNECTIONS=20
PG_MIN_CONNECTIONS=2
PG_ACQUIRE_TIMEOUT_SECS=5

# ── Infra (container-internal only; Compose does not publish these ports) ──
# Required unique password for the plane-local cache.
DATAPLANE_DRAGONFLY_PASSWORD=
DRAGONFLY_URL=redis://dragonfly:6379
QDRANT_URL=http://qdrant:6334
# Required URL-safe token for the plane-local JetStream broker.
DATAPLANE_NATS_TOKEN=
NATS_URL=nats://nats:4222

# ── Object storage + sparse search read model ────────────────
# Required unique credentials. No checked-in/default object-store secret exists.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Optional scoped credential for the Ingestion Plane's visual-RAG CAS producer
# (quarry-edge PageRenderer). When both are set, minio-init provisions a MinIO
# user restricted to read/write on the `dataplane-cas` bucket only — the same
# values go into the Ingestion Plane's secret store as QUARRY_CAS_ACCESS_KEY /
# QUARRY_CAS_SECRET_KEY. Leave empty to keep the producer contract unprovisioned.
CAS_INGESTION_ACCESS_KEY=
CAS_INGESTION_SECRET_KEY=
QUICKWIT_URL=http://quickwit:7280
QUICKWIT_INDEX_ID=dataplane-corpus
# postgres = simplest local fallback. quickwit = corpus-scale sparse search
# with Postgres fallback inside retrieval-engine.
SPARSE_SEARCH_BACKEND=postgres
QUICKWIT_SEARCH_TIMEOUT_MS=1500
QUICKWIT_ADAPTER_ADMIN_PORT=9204
QUICKWIT_ADAPTER_BATCH_SIZE=500
# true is useful for ephemeral dev stacks; production should rebuild
# deliberately through scripts/rebuild-quickwit.sh or an ops job.
QUICKWIT_ADAPTER_REBUILD_ON_START=false

# ── Embedding provider ───────────────────────────────────────
# Default path: Data Plane → current Model Plane inference-core gRPC → Azure OpenAI.
# Direct Azure from Data Plane is kept only as an explicit fallback:
# set EMBEDDING_PROVIDER=azure_openai and fill the Azure values below.
EMBEDDING_PROVIDER=model_plane
MODEL_PLANE_AI_CORE_GRPC_URL=http://inference-core:9092
MODEL_PLANE_EMBEDDING_PROVIDER=azure_openai
MODEL_PLANE_EMBEDDING_TIMEOUT_MS=30000
# Auth Core audited service-principal contract for inference-core callers.
# Register this deployment secret for audience inference-core and scope
# inference:invoke in Auth Core's PLANE_SERVICE_PRINCIPALS_JSON.
MODEL_PLANE_INFERENCE_TOKEN_URL=http://auth-core:3011/api/inference-core/internal-token
MODEL_PLANE_INFERENCE_TOKEN_ISSUER=http://localhost:3011/api/convex-auth
MODEL_PLANE_INFERENCE_SERVICE_ID=graph-index
MODEL_PLANE_INFERENCE_SERVICE_API_KEY=
# Embedding-engine uses the same audience-bound Auth Core contract with its own
# registered principal. Never reuse the graph/retrieval credential.
MODEL_PLANE_EMBEDDING_INFERENCE_SERVICE_ID=embedding-engine
MODEL_PLANE_EMBEDDING_INFERENCE_SERVICE_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large
EMBEDDING_DIMENSION=3072

# ── Reranker (Cohere — optional; set empty to disable) ───────
COHERE_API_KEY=
RERANKER_MODEL=rerank-english-v3.0

# ── Graph extraction (uses GPT-4o by default) ────────────────
AZURE_OPENAI_EXTRACTION_DEPLOYMENT=gpt-4o

# ── Retrieval defaults ───────────────────────────────────────
RETRIEVAL_TOP_K=100
RETRIEVAL_TOP_N=10
CONFIDENCE_THRESHOLD=0.35
HYBRID_ENABLED=true
BM25_WEIGHT=0.3

# ── gRPC server tuning (Tower middleware, v2.1) ──────────────
GRPC_TIMEOUT_SECS=30
GRPC_MAX_CONCURRENT=256

# ── Cross-plane NATS (Control-owned; never invent these values) ─────────────
# `make standalone-up` starts without Control/User/Model. It explicitly pauses
# only the Control-owned GDPR consumer; protected requests and grant-only reads
# still fail closed until the authorities return. `make cross-plane-up` attaches
# to the pre-provisioned shared network after Control is running.
# Production must inject the exact broker URL/password provisioned by Control;
# random strings here will not match its ACL and are rejected by the consumer.
VELION_NATS_TOKEN=
NATS_SHARED_URL=
DOCUMENTS_GDPR_NATS_USER=documents-api-gdpr
DOCUMENTS_GDPR_NATS_PASSWORD=
QUICKWIT_ADAPTER_GDPR_NATS_USER=quickwit-adapter-gdpr
QUICKWIT_ADAPTER_GDPR_NATS_PASSWORD=
# retrieval-engine-rs's GDPR consumer uses a fully distinct env var trio
# (including its own URL) rather than reusing NATS_SHARED_URL above — this
# service already reads a similarly-named SHARED_NATS_URL for its own
# Data-Plane-local NATS fallback chain, so sharing the near-identical
# NATS_SHARED_URL name here would invite exactly the kind of mix-up the GDPR
# rollout's fix pass already found once. Empty URL = consumer disabled.
RETRIEVAL_ENGINE_GDPR_NATS_URL=
RETRIEVAL_ENGINE_GDPR_NATS_USER=retrieval-engine-gdpr
RETRIEVAL_ENGINE_GDPR_NATS_PASSWORD=
INTER_PLANE_BUS_NETWORK=inter-plane-bus
USER_CORE_GRANTS_REQUIRED=1
GDPR_DURABLE_CONSUMER_REQUIRED=1

# Dedicated asynchronous event signing keys. Generate one independent RSA-2048+
# pair per producer; mount private keys only into that producer and distribute
# only the matching public verification file to its direct consumers.
# Production containers use UID/GID 10001. On Linux, provision private keys as
# group 10001 with mode 0440 and public keys as mode 0444 so the non-root
# services can read them without making private material world-readable.
DOCUMENTS_EVENT_SIGNING_PRIVATE_KEY_PATH=.secrets/event-keys/documents-events.pem
DOCUMENTS_EVENT_VERIFYING_PUBLIC_KEY_PATH=.secrets/event-keys/documents-events.pub
INDEX_EVENT_SIGNING_PRIVATE_KEY_PATH=.secrets/event-keys/index-events.pem
INDEX_EVENT_VERIFYING_PUBLIC_KEY_PATH=.secrets/event-keys/index-events.pub
EMBEDDING_EVENT_SIGNING_PRIVATE_KEY_PATH=.secrets/event-keys/embedding-events.pem
EMBEDDING_EVENT_VERIFYING_PUBLIC_KEY_PATH=.secrets/event-keys/embedding-events.pub
WIKI_EVENT_SIGNING_PRIVATE_KEY_PATH=.secrets/event-keys/wiki-events.pem
WIKI_EVENT_VERIFYING_PUBLIC_KEY_PATH=.secrets/event-keys/wiki-events.pub
# For local standalone, generate a distinct retrieval pair under the ignored
# `.secrets/event-keys` directory (or use the isolated harness). Production
# paths must point at deployment-secret-manager mounts, not copied keys.
RETRIEVAL_EVENT_SIGNING_PRIVATE_KEY_PATH=.secrets/event-keys/retrieval-events.pem
RETRIEVAL_EVENT_VERIFYING_PUBLIC_KEY_PATH=.secrets/event-keys/retrieval-events.pub

# ── Auth (cross-plane shared secret) ─────────────────────────
INTERNAL_API_KEY=
AUTH_CORE_GRPC_URL=
ORG_CORE_GRPC_URL=
# Read-only Auth Core public key mount. Override this in a standalone Data
# deployment; the running Auth Core process is not required for startup.
AUTH_CORE_PUBLIC_KEY_PATH=../Control Plane/auth-core/keys/convex-auth.pub

# ── Wave 3: Control Plane policy enforcement ─────────────────
# Registered retrieval service principal. The credential is presented only to
# the token issuer; the decision endpoint receives an org-bound bearer.
CONTROL_POLICY_SERVICE_ID=retrieval-engine
CONTROL_POLICY_SERVICE_API_KEY=
CONTROL_POLICY_TOKEN_URL=http://auth-core:3011/api/control-policy/internal-token
USER_CORE_RETRIEVAL_TOKEN=
USER_CORE_DOCUMENTS_TOKEN=
CONTROL_PLANE_ENFORCEMENT=strict
CONTROL_PLANE_DECISION_URL=http://auth-core:3011/api/v1/internal/authorization/data-plane/decision
USER_SERVICE_HTTP_URL=http://user-service:3012
ORG_CORE_HTTP_URL=http://org-core-service:8080
# JWT validation is mandatory. The public key is mounted from auth-core for Rust
# services; Go services use the internal JWKS endpoint.
AUTH_CORE_JWKS_URL=http://auth-core:3011/api/convex-auth/jwks
AUTH_CORE_ISSUER=http://localhost:3011/api/convex-auth
JWT_PUBLIC_KEY_PEM=
JWT_REQUIRED_ISSUER=http://localhost:3011/api/convex-auth
JWT_REQUIRED_AUDIENCE=data-plane

# ── Observability (optional — set to enable OTel export) ─────
OTEL_EXPORTER_OTLP_ENDPOINT=
GRAFANA_ADMIN_PASSWORD=

# ── Self-owned data services (optional overlays) ─────────────
OPENSANCTIONS_YENTE_URL=http://opensanctions-yente:8000
YENTE_INDEX_URL=http://opensanctions-elasticsearch:9200
YENTE_AUTO_REINDEX=false
YENTE_UPDATE_TOKEN=
NOMINATIM_URL=http://nominatim:8080
NOMINATIM_PBF_URL=https://download.geofabrik.de/europe/monaco-latest.osm.pbf
NOMINATIM_REPLICATION_URL=
NOMINATIM_PASSWORD=
OPEN_DATA_MANIFEST_PATH=manifests/open-data/self-owned-open-data.json
USER_CORE_DOCUMENTS_TOKEN=
USER_CORE_RETRIEVAL_TOKEN=

# Set to 1 to run the page-image (visual RAG) consumer alongside signed text
# consumers even though the quarry-edge producer does not sign envelopes yet.
ALLOW_UNSIGNED_PAGE_IMAGE_EVENTS=
