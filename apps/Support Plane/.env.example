# Copy to .env and fill in real values. Never commit the real .env file.

# Public DNS names Caddy requests TLS certificates for — must match what
# @verevon/remote-core is configured with (createRemoteClient's
# rendezvousUrl/relayUrl). Two separate hostnames, matching the top-level
# product spec's own example (wss://remote.verevon.com / wss://relay.verevon.com).
SUPPORT_PLANE_RENDEZVOUS_DOMAIN=remote.example.com
SUPPORT_PLANE_RELAY_DOMAIN=relay.example.com

# Address Caddy uses for Let's Encrypt account registration/expiry notices.
SUPPORT_PLANE_ACME_EMAIL=ops@example.com

# Shared access key hbbs and hbbr must both present to authorize connections
# (rustdesk-server's `-k`/KEY option). Generate a real random secret per
# environment — never reuse this placeholder.
SUPPORT_PLANE_KEY=CHANGE_ME_GENERATE_A_REAL_SECRET

# The address clients are told to use for the relay hop once hbbs negotiates
# one — must be reachable from wherever @verevon/remote-core actually runs
# (a customer's browser). Use the plain hbbr port, not the WSS domain: the
# relay negotiation itself is native-protocol, only remote-core's transport
# to it is WSS (Caddy translates that at the edge).
SUPPORT_PLANE_RELAY_ADDR=relay.example.com:21117

SUPPORT_PLANE_LOG_LEVEL=info
