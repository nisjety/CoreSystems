# ============================================
# ai-core v2 — Environment Template
# ============================================
# Copy to .env and fill in real values.
# NEVER commit .env with real credentials.
# Generate secrets: python -c "import secrets; print(secrets.token_hex(32))"
# ============================================

# ── Core Runtime (required) ─────────────────────────────────────
ENVIRONMENT=development
SERVICE_NAME=model-plane-ai-core
SERVICE_VERSION=2.0.0
HOST=0.0.0.0
PORT=8001
GRPC_PORT=50051
LOG_LEVEL=INFO
DEBUG=false

# ── Internal Auth (required) ────────────────────────────────────
INTERNAL_API_KEY=

# ── Infrastructure (required) ──────────────────────────────────
REDIS_URL=redis://localhost:6389/6
NATS_URL=nats://localhost:4232
NATS_TOKEN=

# ── Object Storage (required) ──────────────────────────────────
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=velion-completions
OBJECT_STORAGE_REGION=us-east-1

# ── Agent Core Delegation ──────────────────────────────────────
AGENT_CORE_URL=http://localhost:8102
AGENT_CORE_TIMEOUT=120

# ============================================
# Provider Credentials (optional per provider)
# ============================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
COHERE_API_KEY=
MISTRAL_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# ── Azure OpenAI (primary) ─────────────────────────────────────
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-01-01-preview

# ============================================
# Azure AI Services
# ============================================

# Speech
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=swedencentral

# Translator
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=swedencentral

# Document Intelligence (Tier 1: structured documents)
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
AZURE_DOCUMENT_INTELLIGENCE_KEY=

# Mistral Document AI (Tier 2: complex document reasoning)
MISTRAL_DOCUMENT_AI_ENDPOINT=
MISTRAL_DOCUMENT_AI_KEY=

# Content Understanding (multimodal analyzer — GA)
AZURE_CONTENT_UNDERSTANDING_ENDPOINT=
AZURE_CONTENT_UNDERSTANDING_KEY=
AZURE_CONTENT_UNDERSTANDING_API_VERSION=2025-05-01-preview

# AI Language (text analytics)
AZURE_AI_LANGUAGE_ENDPOINT=
AZURE_AI_LANGUAGE_KEY=
AZURE_AI_LANGUAGE_API_VERSION=2024-11-15-preview

# Content Safety
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_CONTENT_SAFETY_KEY=

# ============================================
# Model Deployments
# ============================================
AZURE_OPENAI_VIDEO_DEPLOYMENT=sora
AZURE_OPENAI_VIDEO_API_VERSION=2025-04-01-preview
AZURE_OPENAI_REALTIME_DEPLOYMENT=gpt-realtime
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview-2025-01-09
AZURE_OPENAI_DEPLOYMENT_EMBEDDING=text-embedding-3-large

# ============================================
# Feature Flags
# ============================================
ENABLE_CHAT=true
ENABLE_TTS=true
ENABLE_ASR=true
ENABLE_TRANSLATION=true
ENABLE_IMAGE_GENERATION=true
ENABLE_VISION=true
ENABLE_DOCUMENT_INTELLIGENCE=true
ENABLE_CONTENT_SAFETY=true
ENABLE_CONTENT_UNDERSTANDING=false
ENABLE_VIDEO_GENERATION=false
ENABLE_REALTIME=false
ENABLE_MISTRAL_DOCUMENT_AI=false

# ============================================
# Pipeline
# ============================================
CONTENT_SAFETY_ENABLED=true
CONTENT_SAFETY_BLOCK_THRESHOLD=4
CONTENT_SAFETY_FLAG_THRESHOLD=2
INTENT_LLM_ENABLED=true
INTENT_MODEL=gpt-4o-mini
RAG_REFLECTION_ENABLED=true
RAG_SYNTHESIS_ENABLED=true
RAG_MAX_REFLECTION_ITERATIONS=1
RATE_LIMIT_RPM=120
RATE_LIMIT_TPM=200000

# ============================================
# gRPC
# ============================================
GRPC_MAX_WORKERS=10
GRPC_MAX_MESSAGE_LENGTH=52428800
GRPC_KEEPALIVE_TIME_MS=30000
GRPC_KEEPALIVE_TIMEOUT_MS=5000
GRPC_ENABLE_REFLECTION=true

# ============================================
# ASR
# ============================================
DEEPGRAM_API_KEY=
DEFAULT_ASR_LANGUAGE=en-US
INTERNAL_API_KEY=REPLACE_WITH_SECURE_INTERNAL_API_KEY