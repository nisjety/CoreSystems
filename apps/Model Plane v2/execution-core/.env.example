# execution-core environment variables

# Service
SERVICE_NAME=execution-core
ENVIRONMENT=development
DEBUG=false
HOST=0.0.0.0
PORT=8003

# Postgres (reasoning-postgres, separate DB)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=execution_core_db
POSTGRES_USER=reasoning_user
POSTGRES_PASSWORD=reasoning_secure_password_2026

# Redis (reasoning-redis, DB 3)
REDIS_URL=redis://:reasoning_redis_password_2026@redis:6379/3

# NATS cross-plane (velion-nats)
NATS_URL=nats://velion-nats:4222
NATS_TOKEN=

# NATS local (reasoning-nats)
NATS_LOCAL_URL=nats://nats:4222
NATS_LOCAL_TOKEN=

# Object storage (workspace artifacts)
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=velion-artifacts
OBJECT_STORAGE_REGION=us-east-1

# Runner defaults
RUNNER_HEARTBEAT_INTERVAL=30
RUNNER_LEASE_TTL=300
MAX_CONCURRENT_RUNNERS=10
WORKSPACE_BASE_PATH=/tmp/workspaces
