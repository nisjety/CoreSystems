# ── llm-worker ──────────────────────────────────────────────────
# Stateless LLM executor — receives fully-resolved model selection,
# calls the provider, returns/streams the result.

# Server
HOST=0.0.0.0
PORT=8005
SERVICE_VERSION=0.1.0
DEBUG=false

# Redis (rate limiting only — DB 5)
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@localhost:6389/5

# NATS
NATS_URL=nats://localhost:4232
NATS_LOCAL_URL=nats://localhost:4232

# Object storage (MinIO)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_BUCKET=velion-completions
OBJECT_STORAGE_REGION=us-east-1

# Provider API keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
COHERE_API_KEY=
MISTRAL_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Azure OpenAI (optional — set to use Azure instead of vanilla OpenAI)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

# Rate limiting
RATE_LIMIT_RPM=60
RATE_LIMIT_TPM=100000

# Result store
RESULT_STORE_THRESHOLD_BYTES=4096

# Internal auth
INTERNAL_API_KEY=REPLACE_WITH_SECURE_INTERNAL_API_KEY
