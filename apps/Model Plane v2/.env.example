# Model Plane v2
# Compose-level environment template for apps/Model Plane v2/docker-compose.yml.
# Safe to commit. Keep secrets blank and only include vars that compose consumes.

# -----------------------------------------------------------------------------
# Provider API keys
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
COHERE_API_KEY=
MISTRAL_API_KEY=

# -----------------------------------------------------------------------------
# Azure OpenAI (shared by ai-core and llm-worker)
# -----------------------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21

# -----------------------------------------------------------------------------
# Azure AI services (ai-core)
# -----------------------------------------------------------------------------
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=swedencentral
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=swedencentral

# -----------------------------------------------------------------------------
# Internal platform auth
# -----------------------------------------------------------------------------
INTERNAL_API_KEY=REPLACE_WITH_SECURE_INTERNAL_API_KEY
CONTROL_PLANE_NATS_TOKEN=REPLACE_WITH_SECURE_NATS_TOKEN
TOOL_EXECUTION_API_KEY=

# -----------------------------------------------------------------------------
# Optional local providers
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL=http://host.docker.internal:11434

# -----------------------------------------------------------------------------
# Object storage / result store
# -----------------------------------------------------------------------------
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# -----------------------------------------------------------------------------
# Letta / self-improvement
# -----------------------------------------------------------------------------
LETTA_ENABLED=false