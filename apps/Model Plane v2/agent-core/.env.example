# ---- Service identity ----
SERVICE_NAME=agent-core-v2
ENVIRONMENT=development
DEBUG=false

# ---- HTTP / gRPC ----
HOST=0.0.0.0
PORT=8002
GRPC_PORT=50053

# ---- PostgreSQL (shared Model Plane infra) ----
# Use localhost for direct local runs. Docker compose injects service names.
POSTGRES_HOST=localhost
POSTGRES_PORT=5442
POSTGRES_DB=agent_core_v2_db
POSTGRES_USER=reasoning_user
POSTGRES_PASSWORD=REPLACE_WITH_POSTGRES_PASSWORD
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=10

# ---- Redis (shared Model Plane infra, DB 2) ----
REDIS_URL=redis://:REPLACE_WITH_REDIS_PASSWORD@localhost:6389/2
REDIS_MAX_CONNECTIONS=50

# ---- NATS: velion-nats (cross-plane JetStream) ----
NATS_URL=nats://localhost:4232
NATS_TOKEN=

# ---- NATS: reasoning-nats (local) ----
NATS_LOCAL_URL=nats://localhost:4232
NATS_LOCAL_TOKEN=

# ---- NATS: control-plane usage reporting ----
CONTROL_PLANE_NATS_URL=nats://localhost:4223
CONTROL_PLANE_NATS_TOKEN=REPLACE_WITH_SECURE_NATS_TOKEN

# ---- v2 service URLs ----
CAPABILITY_CORE_URL=http://localhost:8104
LLM_WORKER_URL=http://localhost:8105
DATA_PLANE_RETRIEVAL_URL=http://localhost:8004
DATA_PLANE_DOCUMENTS_URL=http://localhost:8001
LLM_TIMEOUT=120
TOOL_EXECUTION_API_KEY=

# ---- LLM provider keys ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ---- Internal auth ----
INTERNAL_API_KEY=REPLACE_WITH_SECURE_INTERNAL_API_KEY

# ---- Agent runtime ----
PLANNER_MODEL=gpt-4o-mini
PLANNER_PROVIDER=openai
PLANNER_TEMPERATURE=0.0
MAX_RUN_ACTIONS=10
WORKER_COUNT=2
LEASE_TTL_SECONDS=300

# ---- Temporal ----
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=velion
TEMPORAL_TASK_QUEUE=agent-core

# ---- Letta / self-improvement ----
LETTA_API_URL=http://localhost:8283
LETTA_ENABLED=false
TRAJECTORY_RECORDING_ENABLED=true
ORG_INSIGHTS_INTERVAL_MINUTES=30
ATROPOS_EXPORT_ENABLED=true
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
