# capability-core
SERVICE_NAME=capability-core
ENVIRONMENT=development
DEBUG=false

# HTTP
HOST=0.0.0.0
PORT=8004

# PostgreSQL (reasoning-postgres, separate DB)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=capability_core_db
POSTGRES_USER=reasoning_user
POSTGRES_PASSWORD=changeme

# Redis (reasoning-redis, DB 4)
REDIS_URL=redis://redis:6379/4
REDIS_MAX_CONNECTIONS=50

# NATS: velion-nats (cross-plane, JetStream)
NATS_URL=nats://velion-nats:4222
NATS_TOKEN=

# NATS: reasoning-nats (local Model Plane)
NATS_LOCAL_URL=nats://nats:4222
NATS_LOCAL_TOKEN=

# Internal auth
INTERNAL_API_KEY=
