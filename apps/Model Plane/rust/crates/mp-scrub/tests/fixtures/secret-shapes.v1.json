      "applies_to": ["quarry", "mp"],
      "template": "Your session token is {s0} please keep it",
      "secrets": {
        "s0": ["eyJhbGciOiJI", "UzI1NiIsInR5cCI6", "IkpXVCJ9", ".eyJzdWIiOiIxMjM0", "NTY3ODkwIiwibmFtZSI6Ikpv", ".SflKxwRJSMeKKF2QT4fwpMeJf36POk6yJV_adQssw5c"]
