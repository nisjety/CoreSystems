{
  "contract": "browser-domain-canonical",
  "version": 1,
  "owner": "apps/Model Plane/go/services/browser-broker/internal/grant/grant.go NormalizeAllowedDomains",
  "status": "pins the browser-broker's current normalizer; consumers in WS21 S4, S5a and S10 must match it",
  "rules": {
    "min_entries": 1,
    "max_entries": 32,
    "max_host_octets": 253,
    "max_label_octets": 63,
    "preprocess": "trim surrounding whitespace, then fold ASCII and Unicode letters to lower case",
    "charset": "a-z, 0-9 and hyphen only, in every dot-separated label",
    "label_edges": "a label may not start or end with a hyphen and may not be empty",
    "dot_shape": "at least one dot; no leading or trailing dot",
    "address_literals": "IPv4 and IPv6 literals are rejected",
    "all_or_nothing": "one invalid entry rejects the whole list",
    "dedupe": "after preprocessing; the entry cap counts raw entries",
    "order": "bytewise ascending",
    "error": "invalid_domain_policy"
  },
  "vectors": [
    {
      "id": "lowercase_single",
      "input": [
        "example.com"
      ],
      "expect": "accept",
      "output": [
        "example.com"
      ]
    },
    {
      "id": "uppercase_folded",
      "input": [
        "Example.COM"
      ],
      "expect": "accept",
      "output": [
        "example.com"
      ]
    },
    {
      "id": "surrounding_whitespace_trimmed",
      "input": [
        "\t  example.com \n"
      ],
      "expect": "accept",
      "output": [
        "example.com"
      ]
    },
    {
      "id": "duplicates_collapse_after_trim_and_fold",
      "input": [
        "Example.com",
        " example.com ",
        "EXAMPLE.COM"
      ],
      "expect": "accept",
      "output": [
        "example.com"
      ]
    },
    {
      "id": "unsorted_input_sorted_bytewise",
      "input": [
        "zeta.example.com",
        "alpha.example.org",
        "mid.example.net"
      ],
      "expect": "accept",
      "output": [
        "alpha.example.org",
        "mid.example.net",
        "zeta.example.com"
      ]
    },
    {
      "id": "hyphen_inside_label",
      "input": [
        "my-shop.example.co.uk"
      ],
      "expect": "accept",
      "output": [
        "my-shop.example.co.uk"
      ]
    },
    {
      "id": "digit_bearing_label",
      "input": [
        "api2.example.com"
      ],
      "expect": "accept",
      "output": [
        "api2.example.com"
      ]
    },
    {
      "id": "punycode_idn_label_accepted",
      "input": [
        "xn--bcher-kva.example"
      ],
      "expect": "accept",
      "output": [
        "xn--bcher-kva.example"
      ],
      "note": "the ASCII (punycode) form is the only accepted IDN spelling"
    },
    {
      "id": "label_of_63_octets",
      "input": [
        "fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff.example.com"
      ],
      "expect": "accept",
      "output": [
        "fffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff.example.com"
      ]
    },
    {
