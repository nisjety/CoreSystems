{
  "contract": "space-room-run-frames",
  "version": 1,
  "owner": "model-gateway (src/room_run.rs)",
  "notes": "Room-safe frames of a live room turn. Authored with WS09-S3; a generated check under MP_UPDATE_GOLDEN=1 is owed to the test phase. Every payload is rebuilt field by field from an allowlist; free text (tool arguments and output, step titles, steer text, error messages, reasoning) never appears. Text offsets are UTF-16 code units. The SSE id of a frame is the source buffer seq.",
  "limits": { "max_steps": 64, "max_text_units": 32768, "max_artifacts": 16 },
  "classes": ["search_knowledge", "web", "code", "artifact", "lookup", "effect", "memory", "delegate", "plan", "check", "tool"],
  "reserved_classes": ["browser"],
  "step_states": ["running", "ok", "error", "denied"],
  "stored_step_states": ["ok", "error", "denied"],
  "outcomes": ["completed", "failed", "stopped"],
  "failure_reasons": ["model_unavailable", "budget", "policy", "internal", "unknown"],
  "frame_events": ["snapshot", "text", "text_progress", "step", "steer", "plan", "artifact", "finished", "reauth_required", "error"],
  "source_events_forwarded": ["chunk", "tool_call", "tool_result", "step_update", "plan_proposed", "artifact", "queued_input", "stopped", "error"],
  "source_events_dropped": [
    "reasoning_delta", "memory_recall", "grounding", "citation", "citations", "search_results",
    "source_scope_applied", "verification", "attachment", "retrieval_notice", "usage", "usage_progress",
    "turn_timing", "result_receipt", "title", "follow_ups", "retry_scheduled", "compaction",
    "context_change", "run_parked", "run_resumed", "awaiting_approval", "user_question", "connected", "done"
  ],
  "default_for_unnamed_source_event": "drop",
  "builtin_tool_classes": {
    "count_words": "check",
    "reattach_context": null,
    "reattach_skill": null,
    "skill_file": "lookup",
    "web_search": "web",
    "fetch_url": "web",
    "get_weather": "lookup",
    "get_statistics": "lookup",
    "code_interpreter": "code",
    "create_artifact": "artifact",
    "read_artifact": "artifact",
    "update_artifact": "artifact",
    "inbox_search": "lookup",
    "inbox_get_conversation": "lookup",
    "result_query": "lookup",
    "knowledge_search": "search_knowledge",
    "knowledge_graph_search": "search_knowledge",
    "knowledge_wiki_search": "search_knowledge",
    "knowledge_contradictions": "search_knowledge",
    "knowledge_list_documents": "search_knowledge",
    "shipping_get_quotes": "lookup",
    "insights_overview": "lookup",
    "social_list_accounts": "lookup",
    "social_list_posts": "lookup",
    "social_list_campaigns": "lookup"
  },
  "frames": {
    "snapshot": {
      "v": 1,
      "run_id": "run_01",
      "thread_id": "thr_01",
      "started_by": "usr_01",
      "agent_name": "Driftsassistent",
      "phase": "running",
      "started_at": 1790000000,
      "text": { "offset": 0, "value": "Blåbær 😀", "truncated": false, "visible": true },
      "steps": [{ "id": "call_1", "class": "web", "state": "ok" }],
      "steer": 1,
      "plan": { "plan_id": "plan_1", "steps": 3 },
      "artifacts": [{ "id": "art_1", "kind": "document" }],
      "expires_at": 1790000120
    },
    "snapshot_text_hidden": {
      "v": 1,
      "run_id": "run_01",
      "thread_id": "thr_01",
