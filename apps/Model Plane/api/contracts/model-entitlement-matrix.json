{
  "contract": "model-entitlement.matrix",
  "version": 1,
  "description": "The model entitlement matrix (ADR-0005, WS10): what org-core resolves for a caller, which models a policy permits, how a route is pruned, and when an unreadable answer refuses. Authored data, not generated: it is the specification each side's own real function is tested against. Rows with kind resolve, permit, route and shape are evaluated by org-core's modelentitlement package; rows evaluated by mp-contracts (permit, route, availability, refusal, shape) are evaluated by Model Plane's matcher once WS10-S3 lands. The copy under apps/Control Plane/org-core/internal/modelentitlement/testdata is vendored byte for byte, and org-core's test fails when the two differ. Change a row deliberately, in both places.",
  "vocabulary": {
    "kinds": [
      "resolve",
      "permit",
      "route",
      "availability",
      "refusal",
      "shape"
    ],
    "evaluators": [
      "org-core",
      "mp-contracts"
    ],
    "states": [
      "none",
      "org",
      "role",
      "member_not_found"
    ],
    "layers": [
      "org_default",
      "role_override"
    ],
    "reasons": [
      "not_in_allow_list",
      "explicitly_denied",
      "no_entitled_route",
      "member_not_found",
      "deployment_allowlist"
    ],
    "required_rows": [
      "r_refusal_is_content_free",
      "z_policy_has_no_content",
      "z_policy_survives_zdr_toggle",
      "z_zdr_token_pinned_denied",
      "z_zdr_org_policy_strips_all_attested",
      "z_entitlement_unavailable_under_zdr_refuses"
    ]
  },
  "rows": [
