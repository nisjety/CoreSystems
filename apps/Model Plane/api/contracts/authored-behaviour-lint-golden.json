{
  "contract": "authored-behaviour-lint",
  "version": 1,
  "note": "Inputs and the codes each must produce, in rule order. A missing field is empty; frontmatter_name absent means no bundle; kind absent reads as skill and settings absent means none. repeat replaces one text field (name, description or content) with text repeated count times.",
  "cases": [
    {"id": "clean", "input": {"name": "Weekly report", "description": "How to write the weekly report.", "content": "1. Pull the numbers.\n2. Write three bullets."}, "expect": []},
    {"id": "everything_empty", "input": {}, "expect": ["name_empty", "description_missing", "content_empty"]},
    {"id": "blank_name_is_only_empty", "input": {"name": "   ", "description": "d", "content": "c"}, "expect": ["name_empty"]},
    {"id": "name_at_limit", "input": {"description": "d", "content": "c"}, "repeat": {"field": "name", "text": "a", "count": 64}, "expect": []},
    {"id": "name_over_limit", "input": {"description": "d", "content": "c"}, "repeat": {"field": "name", "text": "a", "count": 65}, "expect": ["name_too_long"]},
    {"id": "name_counts_characters_not_bytes", "input": {"description": "d", "content": "c"}, "repeat": {"field": "name", "text": "ø", "count": 64}, "expect": []},
    {"id": "name_leading_space", "input": {"name": " Report", "description": "d", "content": "c"}, "expect": ["name_charset"]},
    {"id": "name_control_character", "input": {"name": "Re\u0007port", "description": "d", "content": "c"}, "expect": ["name_charset"]},
    {"id": "description_missing_is_a_warning", "input": {"name": "Report", "description": " ", "content": "c"}, "expect": ["description_missing"]},
    {"id": "description_over_limit", "input": {"name": "Report", "content": "c"}, "repeat": {"field": "description", "text": "d", "count": 301}, "expect": ["description_too_long"]},
    {"id": "content_blank", "input": {"name": "Report", "description": "d", "content": "  \n\t "}, "expect": ["content_empty"]},
    {"id": "content_at_budget", "input": {"name": "Report", "description": "d"}, "repeat": {"field": "content", "text": "c", "count": 8000}, "expect": []},
    {"id": "content_over_budget", "input": {"name": "Report", "description": "d"}, "repeat": {"field": "content", "text": "c", "count": 8001}, "expect": ["content_exceeds_budget"]},
    {"id": "content_at_limit", "input": {"name": "Report", "description": "d"}, "repeat": {"field": "content", "text": "c", "count": 32000}, "expect": ["content_exceeds_budget"]},
    {"id": "content_over_limit", "input": {"name": "Report", "description": "d"}, "repeat": {"field": "content", "text": "c", "count": 32001}, "expect": ["content_too_long"]},
    {"id": "transcript_three_lines", "input": {"name": "Report", "description": "d", "content": "User: hi\nAssistant: hello\nUser: again"}, "expect": ["transcript_shape"]},
    {"id": "transcript_two_lines", "input": {"name": "Report", "description": "d", "content": "User: hi\nAssistant: hello\nThe lesson: greet first."}, "expect": []},
    {"id": "transcript_norwegian_and_indented", "input": {"name": "Report", "description": "d", "content": "Bruker: hei\n  Assistant: hallo\nBruker: igjen"}, "expect": ["transcript_shape"]},
    {"id": "transcript_prefix_is_case_sensitive", "input": {"name": "Report", "description": "d", "content": "user: a\nuser: b\nuser: c"}, "expect": []},
    {"id": "keywords_at_limit", "input": {"name": "Report", "description": "d", "content": "c", "trigger_keywords": ["k1", "k2", "k3", "k4", "k5", "k6", "k7", "k8", "k9", "k10", "k11", "k12", "k13", "k14", "k15", "k16", "k17", "k18", "k19", "k20"]}, "expect": []},
    {"id": "keywords_over_limit", "input": {"name": "Report", "description": "d", "content": "c", "trigger_keywords": ["k1", "k2", "k3", "k4", "k5", "k6", "k7", "k8", "k9", "k10", "k11", "k12", "k13", "k14", "k15", "k16", "k17", "k18", "k19", "k20", "k21"]}, "expect": ["trigger_keyword_count"]},
    {"id": "keyword_too_long_reported_once", "input": {"name": "Report", "description": "d", "content": "c", "trigger_keywords": ["aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"]}, "expect": ["trigger_keyword_too_long"]},
    {"id": "tool_names_plain", "input": {"name": "Report", "description": "d", "content": "c", "tool_restrictions": ["web_search", "mcp.files-read"]}, "expect": []},
    {"id": "tool_wildcard", "input": {"name": "Report", "description": "d", "content": "c", "tool_restrictions": ["*"]}, "expect": ["tool_restriction_invalid"]},
    {"id": "tool_with_space_and_empty", "input": {"name": "Report", "description": "d", "content": "c", "tool_restrictions": ["read file", ""]}, "expect": ["tool_restriction_invalid"]},
    {"id": "frontmatter_matches_after_trim", "input": {"name": "Weekly report", "description": "d", "content": "c", "frontmatter_name": " Weekly report "}, "expect": []},
    {"id": "frontmatter_mismatch", "input": {"name": "Weekly report", "description": "d", "content": "c", "frontmatter_name": "weekly-report"}, "expect": ["frontmatter_name_mismatch"]},
    {"id": "template_input_placeholder", "input": {"name": "Weekly", "description": "d", "content": "Write the weekly report for {{input}}.", "kind": "template"}, "expect": []},
    {"id": "template_without_placeholder", "input": {"name": "Weekly", "description": "d", "content": "Write the weekly report.", "kind": "template"}, "expect": []},
    {"id": "template_unknown_placeholder", "input": {"name": "Weekly", "description": "d", "content": "Dear {{name}}, {{input}}", "kind": "template"}, "expect": ["template_placeholder_invalid"]},
    {"id": "template_spaced_placeholder", "input": {"name": "Weekly", "description": "d", "content": "{{ input }}", "kind": "template"}, "expect": ["template_placeholder_invalid"]},
    {"id": "template_triple_brace", "input": {"name": "Weekly", "description": "d", "content": "{{{input}}}", "kind": "template"}, "expect": ["template_placeholder_invalid"]},
    {"id": "skill_placeholder_not_checked", "input": {"name": "Weekly", "description": "d", "content": "Dear {{name}}"}, "expect": []},
    {"id": "preset_full_settings", "input": {"name": "Research", "description": "d", "content": "c", "kind": "preset", "settings": {"modeId": "research", "browseWeb": true, "planMode": true, "skillIds": ["s1", "s2", "s3", "s4"], "templateId": "t1"}}, "expect": []},
    {"id": "preset_empty_settings", "input": {"name": "Research", "description": "d", "content": "c", "kind": "preset", "settings": {}}, "expect": []},
    {"id": "preset_plan_mode_false", "input": {"name": "Research", "description": "d", "content": "c", "kind": "preset", "settings": {"planMode": false}}, "expect": ["preset_settings_invalid"]},
    {"id": "preset_too_many_skills", "input": {"name": "Research", "description": "d", "content": "c", "kind": "preset", "settings": {"skillIds": ["s1", "s2", "s3", "s4", "s5"]}}, "expect": ["preset_settings_invalid"]},
    {"id": "preset_wrong_types", "input": {"name": "Research", "description": "d", "content": "c", "kind": "preset", "settings": {"modeId": 3, "browseWeb": "yes"}}, "expect": ["preset_settings_invalid"]},
    {"id": "preset_settings_not_an_object", "input": {"name": "Research", "description": "d", "content": "c", "kind": "preset", "settings": ["planMode"]}, "expect": ["preset_settings_invalid"]},
    {"id": "preset_unknown_key", "input": {"name": "Research", "description": "d", "content": "c", "kind": "preset", "settings": {"persona": "pirate", "toolAllowList": ["*"]}}, "expect": ["preset_unknown_key"]},
    {"id": "preset_invalid_and_unknown", "input": {"name": "Research", "description": "d", "content": "c", "kind": "preset", "settings": {"planMode": false, "autonomy": "full"}}, "expect": ["preset_settings_invalid", "preset_unknown_key"]},
    {"id": "errors_and_warnings_in_rule_order", "input": {"name": "Report ", "description": "", "content": "User: a\nAssistant: b\nUser: c", "trigger_keywords": ["k"], "tool_restrictions": ["a b"], "frontmatter_name": "Other"}, "expect": ["name_charset", "description_missing", "transcript_shape", "tool_restriction_invalid", "frontmatter_name_mismatch"]}
  ]
}
