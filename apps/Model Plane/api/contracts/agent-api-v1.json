{
  "contract": "model-plane.agent-api",
  "version": 1,
  "authored_by": "EP-12-S3; docs/plans/wave3/EP-12-sharing-export-and-agent-api.md sections 3 (D4 to D6) and 4 (S3). Read with api/agent-api.v1.yaml by model-gateway tests/agent_api_contract.rs.",
  "spec": {
    "file": "api/agent-api.v1.yaml",
    "version": "1.0.0",
    "public_prefix": "/api/agent/v1",
    "gateway_prefix": "/v1/agent"
  },
  "auth": {
    "scheme": "apiKey",
    "header": "x-api-key",
    "scope": "agent:runs"
  },
  "envelope": {
    "success_key": "data",
    "list_meta": ["has_more", "next_cursor"],
    "list_links": ["next"],
    "error_key": "error",
    "error_fields": ["code", "message", "details"]
  },
  "limits": {
    "input_min_chars": 1,
    "input_max_chars": 32000,
    "thread_id_max_chars": 128,
    "model_max_chars": 128,
    "run_id_max_chars": 128,
    "metadata_max_pairs": 16,
    "metadata_key_max_chars": 64,
    "metadata_value_max_chars": 512,
    "page_limit_default": 20,
    "page_limit_max": 100,
    "live_runs_per_key": 2
  },
  "policy": {
    "ask_only": true,
    "tools_offered": [],
    "unpaged_reads": false,
    "zdr_keys": "every route refuses a key whose organisation has zero data retention on, before any upstream call"
  },
  "zdr": {
    "refusal_code": "zdr_feature_not_supported",
    "feature": "agent_api",
    "http_status": 412
  },
  "refused_features": [
    "tools",
    "attachments",
    "skills",
    "connectors",
    "retrieval",
    "web_search",
    "deep_research",
    "image_generation",
    "plan_mode",
    "code_execution",
    "browser",
    "mcp_servers"
  ],
  "refused_fields": {
    "tools": "tools",
    "tool_choice": "tools",
    "attachments": "attachments",
    "skill_ids": "skills",
    "connector_scope": "connectors",
    "retrieval_scope": "retrieval",
    "browse_web": "web_search",
    "deep_research": "deep_research",
    "generate_image": "image_generation",
    "plan_mode": "plan_mode",
    "execute_granted": "plan_mode",
    "approved_plan_id": "plan_mode",
    "code_execution": "code_execution",
    "browser": "browser",
    "mcp_servers": "mcp_servers"
  },
  "routes": [
    {
      "operation_id": "startRun",
      "method": "POST",
      "path": "/runs",
      "gateway_path": "/v1/agent/runs",
      "scope": "agent:runs",
      "success": 202,
      "content_type": "application/json",
      "body_fields": ["input", "thread_id", "model", "metadata"],
      "query_fields": [],
      "headers": [],
      "errors": [
        "invalid_request",
        "api_key_invalid",
        "agent_api_scope_missing",
        "model_not_entitled",
        "thread_not_found",
        "zdr_feature_not_supported",
        "agent_api_feature_not_supported",
        "rate_limited",
        "internal_error",
        "agent_api_disabled",
        "upstream_unavailable",
        "model_entitlement_unavailable"
      ]
    },
    {
      "operation_id": "getRun",
      "method": "GET",
      "path": "/runs/{run_id}",
      "gateway_path": "/v1/agent/runs/{run_id}",
      "scope": "agent:runs",
      "success": 200,
      "content_type": "application/json",
      "body_fields": [],
      "query_fields": [],
      "headers": [],
      "errors": [
        "invalid_request",
        "api_key_invalid",
        "agent_api_scope_missing",
        "run_not_found",
        "zdr_feature_not_supported",
        "rate_limited",
        "internal_error",
        "agent_api_disabled",
        "upstream_unavailable"
      ]
    },
    {
      "operation_id": "streamRunEvents",
      "method": "GET",
      "path": "/runs/{run_id}/events",
      "gateway_path": "/v1/agent/runs/{run_id}/events",
      "scope": "agent:runs",
      "success": 200,
      "content_type": "text/event-stream",
      "body_fields": [],
      "query_fields": [],
      "headers": ["Last-Event-ID"],
      "errors": [
        "invalid_request",
        "api_key_invalid",
        "agent_api_scope_missing",
        "run_not_found",
        "zdr_feature_not_supported",
        "rate_limited",
        "internal_error",
        "agent_api_disabled",
        "upstream_unavailable"
      ]
    },
    {
      "operation_id": "cancelRun",
      "method": "POST",
      "path": "/runs/{run_id}/cancel",
      "gateway_path": "/v1/agent/runs/{run_id}/cancel",
      "scope": "agent:runs",
      "success": 200,
      "content_type": "application/json",
      "body_fields": [],
      "query_fields": [],
      "headers": [],
      "errors": [
        "invalid_request",
        "api_key_invalid",
        "agent_api_scope_missing",
        "run_not_found",
        "zdr_feature_not_supported",
        "rate_limited",
        "internal_error",
        "agent_api_disabled",
        "upstream_unavailable"
      ]
    },
    {
      "operation_id": "listThreadRuns",
      "method": "GET",
      "path": "/threads/{thread_id}/runs",
      "gateway_path": "/v1/agent/threads/{thread_id}/runs",
      "scope": "agent:runs",
      "success": 200,
      "content_type": "application/json",
      "body_fields": [],
      "query_fields": ["after", "limit"],
      "headers": [],
      "errors": [
        "invalid_request",
        "api_key_invalid",
        "agent_api_scope_missing",
        "thread_not_found",
        "zdr_feature_not_supported",
        "rate_limited",
        "internal_error",
        "agent_api_disabled",
        "upstream_unavailable"
      ]
    },
    {
      "operation_id": "listThreadMessages",
      "method": "GET",
      "path": "/threads/{thread_id}/messages",
      "gateway_path": "/v1/agent/threads/{thread_id}/messages",
      "scope": "agent:runs",
      "success": 200,
      "content_type": "application/json",
      "body_fields": [],
      "query_fields": ["before", "limit"],
      "headers": [],
      "errors": [
        "invalid_request",
        "api_key_invalid",
        "agent_api_scope_missing",
        "thread_not_found",
        "zdr_feature_not_supported",
        "rate_limited",
        "internal_error",
        "agent_api_disabled",
        "upstream_unavailable"
      ]
    }
  ],
  "response_fields": {
    "StartRunAccepted": ["run_id", "thread_id", "status"],
    "Run": [
      "run_id",
      "thread_id",
      "parent_run_id",
      "status",
      "error",
      "input_tokens",
      "output_tokens",
      "created_at",
      "updated_at",
      "metadata"
    ],
    "Run.metadata": ["origin", "api_key_id"],
    "RunCancellation": ["run_id", "status", "cancelled", "receipt_id"],
    "Message": ["message_id", "role", "content", "created_at"],
    "PageMeta": ["has_more", "next_cursor"],
    "PageLinks": ["next"]
  },
  "error_codes": [
    {
      "code": "invalid_request",
      "http_status": 400,
      "retryable": false,
      "details_keys": ["field"],
      "shared_with": null
    },
    {
      "code": "api_key_invalid",
      "http_status": 401,
      "retryable": false,
      "details_keys": [],
      "shared_with": null
    },
    {
      "code": "agent_api_scope_missing",
      "http_status": 403,
      "retryable": false,
      "details_keys": ["scope"],
      "shared_with": null
    },
    {
      "code": "model_not_entitled",
      "http_status": 403,
      "retryable": false,
      "details_keys": ["model", "reason"],
      "shared_with": "model-entitlement-refusals.json"
    },
    {
      "code": "run_not_found",
      "http_status": 404,
      "retryable": false,
      "details_keys": [],
      "shared_with": null
    },
    {
      "code": "thread_not_found",
      "http_status": 404,
      "retryable": false,
      "details_keys": [],
      "shared_with": null
    },
    {
      "code": "zdr_feature_not_supported",
      "http_status": 412,
      "retryable": false,
      "details_keys": ["feature"],
      "shared_with": "zdr-refusals.json"
    },
    {
      "code": "agent_api_feature_not_supported",
      "http_status": 422,
      "retryable": false,
      "details_keys": ["feature"],
      "shared_with": null
    },
    {
      "code": "rate_limited",
      "http_status": 429,
      "retryable": true,
      "details_keys": ["retry_after_seconds"],
      "shared_with": null
    },
    {
      "code": "internal_error",
      "http_status": 500,
      "retryable": false,
      "details_keys": [],
      "shared_with": null
    },
    {
      "code": "agent_api_disabled",
      "http_status": 503,
      "retryable": false,
      "details_keys": [],
      "shared_with": null
    },
    {
      "code": "upstream_unavailable",
      "http_status": 503,
      "retryable": true,
      "details_keys": [],
      "shared_with": null
    },
    {
      "code": "model_entitlement_unavailable",
      "http_status": 503,
      "retryable": true,
      "details_keys": [],
      "shared_with": "model-entitlement-refusals.json"
    }
  ]
}
