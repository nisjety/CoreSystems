# Build provenance (CI should provide the tested revision and UTC build time).
SOURCE_REVISION=replace-with-tested-git-sha
BUILD_DATE=2026-01-01T00:00:00Z

# Generate independent URL-safe random values for every credential.
MODEL_POSTGRES_PASSWORD=replace-with-random-postgres-password
MODEL_TEMPORAL_POSTGRES_PASSWORD=replace-with-random-temporal-postgres-password
MODEL_NATS_TOKEN=replace-with-random-nats-token
MODEL_DRAGONFLY_PASSWORD=replace-with-random-dragonfly-password
MODEL_MINIO_ROOT_USER=replace-with-minio-service-user
MODEL_MINIO_ROOT_PASSWORD=replace-with-random-minio-password
AGENT_MEMORY_REDIS_PASSWORD=replace-with-random-agent-memory-redis-password
AGENT_MEMORY_TOKEN=replace-with-random-agent-memory-api-token
MODEL_BRIDGE_JWT_SECRET=replace-with-random-bridge-jwt-secret
INTERNAL_API_KEY=replace-with-scoped-internal-service-key

# Auth Core service-principal/JWKS contract. These are durable credentials;
# model services exchange them for short-lived, org-scoped Quarry tokens.
AUTH_CORE_URL=http://auth-core:3011
AUTH_CORE_JWKS_URL=http://auth-core:3011/api/convex-auth/jwks
AUTH_CORE_ISSUER=http://auth-core:3011/api/convex-auth
MODEL_GATEWAY_SERVICE_ID=model-gateway
MODEL_GATEWAY_SERVICE_API_KEY=replace-with-auth-core-model-gateway-credential
SESSION_CORE_SERVICE_ID=session-core
SESSION_CORE_SERVICE_API_KEY=replace-with-auth-core-session-core-credential
EXECUTION_CORE_SERVICE_ID=execution-core
EXECUTION_CORE_SERVICE_API_KEY=replace-with-auth-core-execution-core-credential
INGESTION_SERVICE_ID=model-execution
MODEL_EXECUTION_SERVICE_API_KEY=replace-with-auth-core-model-execution-credential

# Auth Core's PLANE_SERVICE_PRINCIPALS_JSON must independently allow the
# session-core principal to mint aud=letta-bridge tokens for the intended orgs
# and only the memory:read/memory:write scopes. Do not place raw Letta or
# provider credentials in Model Plane registry records.
