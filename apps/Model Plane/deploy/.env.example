# Build provenance (CI should provide the tested revision and UTC build time).
SOURCE_REVISION=replace-with-tested-git-sha
BUILD_DATE=2026-01-01T00:00:00Z

# Generate independent URL-safe random values for every credential.
MODEL_POSTGRES_PASSWORD=replace-with-random-postgres-password
MODEL_TEMPORAL_POSTGRES_PASSWORD=replace-with-random-temporal-postgres-password
MODEL_GATEWAY_NATS_PASSWORD=
MODEL_COST_CORE_NATS_PASSWORD=
MODEL_SESSION_CORE_NATS_PASSWORD=
# Shared cross-plane broker (control-shared-nats) identity for session-core's
# GDPR erasure consumer only. Provisioned as `session-core-gdpr` in
# apps/Control Plane/control-shared-nats.conf — do not confuse with the
# unrelated `session-core-shared` identity used by the Go session-core in
# Control Plane.
SESSION_CORE_GDPR_NATS_PASSWORD=
MODEL_CAPABILITY_CORE_NATS_PASSWORD=
MODEL_ORCHESTRATOR_CORE_NATS_PASSWORD=
# Not injected into Compose. Assign only to a verified external
# tool-completion worker after its ownership and health are attested.
MODEL_TOOL_COMPLETION_NATS_PASSWORD=
APPLICATION_CONVEX_MODEL_NATS_PASSWORD=
APPLICATION_INSIGHT_MODEL_NATS_PASSWORD=
AUDIT_MODEL_NATS_PASSWORD=
MODEL_NATS_PROVISIONER_PASSWORD=
# Migration/dev fallback only; release compose does not wire it.
MODEL_NATS_TOKEN=
MODEL_DRAGONFLY_PASSWORD=replace-with-random-dragonfly-password
MODEL_MINIO_ROOT_USER=replace-with-minio-service-user
MODEL_MINIO_ROOT_PASSWORD=replace-with-random-minio-password
AGENT_MEMORY_REDIS_PASSWORD=replace-with-random-agent-memory-redis-password
AGENT_MEMORY_TOKEN=replace-with-random-agent-memory-api-token
MODEL_BRIDGE_JWT_SECRET=replace-with-random-bridge-jwt-secret
INTERNAL_API_KEY=replace-with-scoped-internal-service-key

# Optional Letta tool-definition ranking for capability discovery. Disabled by
# default. This is not semantic memory search and cannot authorize/execute a
# tool. Remote endpoints require HTTPS; never put credentials in registry rows.
LETTA_TOOL_SEARCH_ENABLED=false
LETTA_TOOL_SEARCH_URL=
LETTA_API_KEY=
LETTA_TOOL_SEARCH_MODE=hybrid
LETTA_TOOL_SEARCH_TIMEOUT=2s
LETTA_TOOL_SEARCH_LIMIT=50
LETTA_TOOL_SEARCH_MAX_RESPONSE_BYTES=262144
LETTA_TOOL_SEARCH_ALLOW_INSECURE_LOOPBACK=false

# Auth Core service-principal/JWKS contract. These are durable credentials;
# model services exchange them for short-lived, org-scoped tokens. The issuer
# is a claim value, not a network route: it must exactly match Control Plane's
# AUTH_CORE_ISSUER even though containers reach Auth Core through auth-core.
AUTH_CORE_URL=http://auth-core:3011
AUTH_CORE_JWKS_URL=http://auth-core:3011/api/convex-auth/jwks
AUTH_CORE_ISSUER=http://localhost:3011/api/convex-auth
MODEL_GATEWAY_SERVICE_ID=model-gateway
MODEL_GATEWAY_SERVICE_API_KEY=replace-with-auth-core-model-gateway-credential
# Secret half of the org-core service credential whose id half is
# MODEL_GATEWAY_SERVICE_ID above. Registered in org-core's
# ORG_CORE_SERVICE_CREDENTIALS (Control Plane docker-compose.yml) under
# principal "model-gateway", scope org:read:any — this is what makes the
# per-org spend/token ceiling actually enforce, since fetch_org_limits fails
# OPEN and an unset token means no ceiling is applied at all.
#
# LEAVE THIS EMPTY for local development. Control Plane's
# run-control-plane.sh generates the value into that plane's 0600 secrets
# store, and both launchers read it from there — scripts/compose.sh for this
# plane alone, build-verevon-services.sh for the orchestrated bring-up. One
# canonical local value, so there is no second copy to drift on the next
# rotation. A drifted copy would be silent: the read 403s and fetch_org_limits
# fails open, so the ceiling just stops applying.
#
# Setting it here still works and deliberately wins (this file is loaded after
# Control's), which is the escape hatch for pointing at a different org-core —
# but then it is yours to keep in sync.
MODEL_GATEWAY_ORG_CORE_SERVICE_TOKEN=
# Independent high-entropy secret for opaque managed-run start identities.
# Never reuse a user token or place public client idempotency keys in Session Core.
MODEL_GATEWAY_MANAGED_START_KEY_SECRET=replace-with-random-32-plus-byte-secret
# MCP OAuth 2.1 + DCR (e.g. Visma Net). Shared between model-gateway and
# capability-core — must be identical in both; generate with `openssl rand -hex 32`.
MCP_OAUTH_SERVICE_TOKEN=replace-with-random-shared-secret
# capability-core only: AES-256-GCM key for mcp_oauth_tokens at rest. Base64,
# must decode to exactly 32 bytes; generate with `openssl rand -base64 32`.
MCP_TOKEN_ENCRYPTION_KEY=replace-with-base64-32-byte-key
# One credential, two audiences: session-core mints aud=letta-bridge for memory
# and aud=inference-core for Dreaming's memory extraction. Auth Core's registry
# entry must grant both, with `inference:invoke` scoped to inference-core only.
SESSION_CORE_SERVICE_ID=session-core
SESSION_CORE_SERVICE_API_KEY=replace-with-auth-core-session-core-credential
# Session-core only: AES-256-GCM key for encrypted approval continuation
# descriptors. Base64, exactly 32 decoded bytes; generate with
# `openssl rand -base64 32`.
SESSION_CORE_CONTINUATION_DESCRIPTOR_KEY=replace-with-base64-32-byte-key
# Scheduled-run authority remains disabled until Control has registered the
# two *distinct* service credentials below. The public key is the same
# verification material used by Capability Core, Orchestrator Core, and
# Session Core; never put a Control signing/private key in this file.
#
# Capability Core -> Control: capability-core, spaces:schedule:reauthorize
# Orchestrator Core -> Control: orchestrator-core, spaces:schedule:execute
# Leave these blank in an unprovisioned dev stack: each scheduled-run hop then
# fails closed rather than using a standing or cross-service credential.
CONTROL_USER_CORE_URL=
CONTROL_SPACE_DECISION_KEY_ID=
CONTROL_SPACE_DECISION_PUBLIC_KEY_BASE64=
CAPABILITY_CORE_CONTROL_SCHEDULE_SERVICE_TOKEN=
ORCHESTRATOR_CORE_CONTROL_SCHEDULE_SERVICE_TOKEN=
ORCHESTRATOR_CORE_CONTROL_SCHEDULE_STEP_SERVICE_TOKEN=
# Governed tickets.create adapter. These are exact source-level bindings for
# Execution Core's server-resolved model-action view and Conversation Core
# owner operation. Leave blank in dev until the complete authenticated
# Control -> Execution -> Conversation route is provisioned; partial values
# keep the adapter disabled and must not be replaced with shared credentials.
CONTROL_PLANE_USER_CORE_URL=
EXECUTION_CORE_CONTROL_RUN_ACTION_TOKEN=
CONVERSATION_CORE_AGENT_ACTION_URL=
CONVERSATION_EXECUTION_CORE_SERVICE_TOKEN=
# Optional, view-only Control token. If set, all four required bindings above
# must also be present; otherwise startup remains fail-closed.
EXECUTION_CORE_CONTROL_MODEL_ACTION_VIEW_TOKEN=
# Development-only transport exception. Keep false for Docker/private hosts;
# true permits plaintext only when both ticket endpoints are IP-loopback.
EXECUTION_CORE_ALLOW_INSECURE_TICKET_LOOPBACK=false
# Dreaming LLM memory extraction. Set DREAMING_LLM_EXTRACTION=0 to run the
# deterministic phrase matcher alone.
DREAMING_LLM_EXTRACTION=1
DREAMING_LLM_MODEL=claude-haiku-4-5
EXECUTION_CORE_SERVICE_ID=execution-core
EXECUTION_CORE_SERVICE_API_KEY=replace-with-auth-core-execution-core-credential
# Capability policy evidence. Generate one Ed25519 keypair per deployment;
# give capability-core the base64 seed/private key and execution-core only the
# matching base64 raw 32-byte public key. Production compose requires both.
CAPABILITY_CORE_DECISION_SIGNING_KEY=replace-with-base64-ed25519-seed
CAPABILITY_CORE_DECISION_SIGNING_KID=capability-decision-v1
EXECUTION_CORE_CAPABILITY_DECISION_PUBLIC_KEY=replace-with-base64-ed25519-public-key
INGESTION_SERVICE_ID=model-execution
MODEL_EXECUTION_SERVICE_API_KEY=replace-with-auth-core-model-execution-credential
# Dedicated finetune-poller credential — deliberately NOT model-gateway's
# session-core credential above (that one is retentionByAudience=zdr, correct
# for terminalize/heartbeat which write no durable content). The poller's
# UpdateJobStatus writes ARE durable (cost, model id, deployment name), so
# Auth Core's registry grants this principal persistent retention instead.
FINETUNE_POLLER_SERVICE_ID=model-gateway-finetune-poller
FINETUNE_POLLER_SERVICE_API_KEY=replace-with-auth-core-finetune-poller-credential

# Signs the provider-write attestation integration-corev2 requires on a write
# action. Base64 standard-encoded 32-byte Ed25519 seed (not Go's 64-byte
# seed||pub form — this key's only consumer is execution-core's own Rust
# signer). The matching public key is registered under issuer
# "model-execution" in integration-corev2's own
# INTEGRATION_PROVIDER_WRITE_ATTESTATION_KEYS_JSON. Provisioned by
# scripts/bootstrap_runtime_environment.sh.
EXECUTION_CORE_PROVIDER_WRITE_ATTESTATION_PRIVATE_KEY=
EXECUTION_CORE_PROVIDER_WRITE_ATTESTATION_KEY_ID=model-execution-provider-write-v1
# Populated only during a key rotation (scripts/bootstrap_runtime_environment.sh
# --rotate-model-execution-attestation-key=stage|promote|prune); empty the
# rest of the time. See docs/ATTESTATION_KEY_ROTATION.md for the runbook.
EXECUTION_CORE_PROVIDER_WRITE_ATTESTATION_PRIVATE_KEY_NEXT=

# Post-approval continuation dispatcher (approval_delivery_worker): claims and
# resumes HITL-granted approvals whose durable delivery lease is due. Orgs are
# auto-discovered from org-core's internal directory (org:read:any) by
# default; ORG_IDS below is only an explicit override for staged rollout.
ORG_CORE_URL=http://org-core:8080
# Shared with org-core's ORG_CORE_SERVICE_CREDENTIALS (Control Plane) under
# principal "execution-core", scope org:read:any. Generated independently per
# plane today, same as its siblings SESSION_ORG_CORE_SERVICE_TOKEN /
# INTEGRATION_ORG_CORE_SERVICE_TOKEN — reconcile both sides to the same value
# manually until the credential-rollout ritual runs.
EXECUTION_ORG_CORE_SERVICE_TOKEN=
EXECUTION_CORE_APPROVAL_DELIVERY_ORG_IDS=
EXECUTION_CORE_APPROVAL_DELIVERY_POLL_SECONDS=15

# Auth Core's service-principal registry must independently grant the following
# minimum per-audience scopes. Production Control Plane loads that registry
# from its private PLANE_SERVICE_PRINCIPALS_FILE; raw JSON is local-development/
# test only. Merge these entries with the existing registry; do not replace its
# other principals and do not place registry content or credentials here:
#
#   model-gateway  -> aud=session-core: session:terminalize, session:heartbeat
#   execution-core -> aud=session-core: session:terminalize, session:heartbeat,
#                      session:scheduled-step and
#                      session:scheduled-step-authority (only when the
#                      scheduled-step lane is explicitly enabled and audited)
#   capability-core -> aud=session-core: session:read, session:skills:write,
#                      session:schedule-prepare (persistent; scheduled-run
#                      preparation must not reuse a generic read credential)
#   orchestrator-core -> aud=session-core: session:write,
#                        session:runs:system-owner (persistent; scheduled runs
#                        create service-owned runs), and aud=execution-core:
#                        model:schedule:step (persistent, dedicated ingress)
#   session-core   -> aud=letta-bridge: memory:read, memory:write (only if the
#                     optional memory bridge is enabled)
#   session-core   -> aud=inference-core: inference:invoke (only if Dreaming's
#                     LLM memory extraction is enabled). retentionByAudience
#                     must be `persistent`: the call's whole product is durable
#                     agent_memory rows, so a `zdr` claim would be a lie.
#   model-gateway-finetune-poller -> aud=session-core: session:finetune:poll.
#                     retentionByAudience must be `persistent`, unlike the
#                     plain `model-gateway` principal above: this poller's
#                     ListActiveJobs/UpdateJobStatus writes are durable
#                     fine-tune job cost/deployment state, not a zdr-safe
#                     terminalize/heartbeat ping. A separate principal (rather
#                     than adding this scope to `model-gateway`) exists solely
#                     because retentionByAudience is keyed per-principal, not
#                     per-scope — it cannot differ by scope within one entry.
#
# The Model Gateway and Execution Core entries need separate service
# credentials. They cannot receive a broad session:* scope, cannot mint any
# other audience, and cannot use caller-provided tenant headers as authority.
# Do not place raw Letta or provider credentials in Model Plane registry
# records.
