# ==============================================
# SSO Environment Configuration Template
# ==============================================
# Copy this file to .env in your backend directory
# and fill in your actual SSO provider credentials

# ==============================================
# Core SSO Settings
# ==============================================
SSO_ENABLED=true
SSO_ORG_PROVISIONING_DISABLED=false
SSO_DEFAULT_ROLE=member

# ==============================================
# Microsoft Entra ID (Azure AD) Configuration
# ==============================================
# Get these values from Azure Portal → App registrations
MICROSOFT_CLIENT_ID=your-azure-client-id-here
MICROSOFT_CLIENT_SECRET=your-azure-client-secret-here
MICROSOFT_TENANT_ID=common  # Use 'common' for multi-tenant or your specific tenant ID

# Scopes - adjust based on your needs
MICROSOFT_SCOPE="openid profile email User.Read"

# ==============================================
# Google Workspace Configuration
# ==============================================
# Get these from Google Cloud Console → Credentials
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# ==============================================
# OIDC Generic Provider (Optional)
# ==============================================
OIDC_PROVIDER_ENABLED=false
OIDC_LOGIN_PAGE=/sign-in
OIDC_CONSENT_PAGE=/consent
OIDC_ALLOW_DYNAMIC_REGISTRATION=false
OIDC_USE_JWT_PLUGIN=false

# ==============================================
# Development Settings
# ==============================================
# Enable debug logging for troubleshooting
DEBUG_SSO=true
LOG_LEVEL=debug

# ==============================================
# Production Security Notes
# ==============================================
# 🚨 IMPORTANT: For production deployment:
#
# 1. Use secure secret management (Azure Key Vault, AWS Secrets Manager)
# 2. Rotate client secrets every 12 months
# 3. Use organization-specific tenant IDs (not 'common')
# 4. Configure trusted domains in your SSO providers
# 5. Enable audit logging and monitoring
#
# 🔗 Setup Guide: /docs/SSO_SETUP_GUIDE.md

# ==============================================
# Redirect URIs for Provider Configuration
# ==============================================
# Add these URIs to your SSO provider settings:
#
# Development:
# - https://localhost:3001/api/auth/callback/microsoft
# - https://localhost:3001/api/auth/callback/google
#
# Production:
# - https://tools.coresystem.com/api/auth/callback/microsoft
# - https://tools.coresystem.com/api/auth/callback/google
