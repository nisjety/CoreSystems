# ==============================================
# Auth Service Configuration - TEMPLATE
# Copy this file to .env and fill in the values
# ==============================================

# Server Configuration
NODE_ENV=development
PORT=3011

# Database Configuration
# For local: postgres://aquatiq:password@localhost:5432/auth_service
# For Docker: postgres://aquatiq:password@aquatiq-postgres-local:5432/auth_service
DATABASE_URL=postgres://aquatiq:CHANGE-ME@localhost:5432/auth_service?sslmode=disable

# Dragonfly cache configuration. Dragonfly speaks the Redis protocol, so the
# URI scheme remains redis://.
# For local: redis://:password@localhost:6380/3
# For Docker: redis://:password@controlplane-dragonfly:6379/3
DRAGONFLY_URL=redis://:CHANGE-ME@localhost:6380/3

# NATS Configuration
# For local: nats://localhost:4222
# For Docker: nats://aquatiq-nats-local:4222
NATS_URL=nats://localhost:4222
NATS_TOKEN=nats
VELION_NATS_URL=nats://localhost:4222
VELION_NATS_TOKEN=CHANGE-ME

# User Service Integration
USER_SERVICE_GRPC_URL="localhost:50012"
USER_SERVICE_API_KEY="your-internal-api-key"

# Internal Service-to-Service Authentication
INTERNAL_SERVICE_IDS="admin-service,user-core"
INTERNAL_SERVICE_SECRET="your-secure-internal-service-secret"
INTERNAL_API_KEY="your-secure-internal-service-secret"
# Dedicated read-only caller credential for user-core membership decisions.
# Use a unique random 32+ character value; do not reuse INTERNAL_API_KEY.
USER_CORE_MEMBERSHIP_SERVICE_TOKEN=""

# Data Plane authorization-decision caller (service-principal only).
# Retrieval mints a short-lived bearer with:
#   POST /api/control-policy/internal-token
#   X-Service-Id: retrieval-engine
#   X-Service-Api-Key: <the registry credential below>
#   {"orgId":"<verified request org>","scopes":["data:authorization:decide"],
#    "reason":"authorize retrieval request"}
# It then calls /api/v1/internal/authorization/data-plane/decision with only
# Authorization: Bearer <token>. The signed org_id must match the decision
# request orgId. Tokens carry aud=control-policy and
# sub=service_id=service:retrieval-engine.
DATA_PLANE_POLICY_AUTH_AUDIENCE="control-policy"
DATA_PLANE_POLICY_CALLER_SERVICE_ID="retrieval-engine"
PLANE_TOKEN_TTL_CONTROL_POLICY_SECONDS=300
# Add conversation-core as a separately credentialed principal when Inbox
# provider actions are enabled: audience ingestion, allowAnyOrg true with
# orgIds=[], scopes integration:read and integration:write. Runtime tokens
# remain org-bound.
PLANE_SERVICE_PRINCIPALS_JSON='{"retrieval-engine":{"credential":"CHANGE-ME-RETRIEVAL-CREDENTIAL","audiences":["control-policy"],"orgIds":["CHANGE-ME-ORG-ID"],"scopes":["data:authorization:decide"]}}'

# Exact, non-interchangeable Model service audiences. Auth Core refuses to
# start when any configured value differs from the receiving service's name.
MODEL_PLANE_AUTH_AUDIENCE="model-gateway"
SESSION_CORE_AUTH_AUDIENCE="session-core"
INFERENCE_CORE_AUTH_AUDIENCE="inference-core"
EXECUTION_CORE_AUTH_AUDIENCE="execution-core"
COST_CORE_AUTH_AUDIENCE="cost-core"
CAPABILITY_CORE_AUTH_AUDIENCE="capability-core"
LETTA_BRIDGE_AUTH_AUDIENCE="letta-bridge"
BROWSER_BROKER_AUTH_AUDIENCE="browser-broker"
SANDBOX_MANAGER_AUTH_AUDIENCE="sandbox-manager"
BRIDGE_CORE_AUTH_AUDIENCE="bridge-core"

# Delegated credentials are short-lived and always carry issuer-selected
# `zdr=true`; callers cannot request a weaker retention posture.
PLANE_TOKEN_TTL_SESSION_CORE_SECONDS=300
PLANE_TOKEN_TTL_INFERENCE_CORE_SECONDS=300
PLANE_TOKEN_TTL_EXECUTION_CORE_SECONDS=300
PLANE_TOKEN_TTL_COST_CORE_SECONDS=300
PLANE_TOKEN_TTL_CAPABILITY_CORE_SECONDS=300
PLANE_TOKEN_TTL_LETTA_BRIDGE_SECONDS=300
PLANE_TOKEN_TTL_BROWSER_BROKER_SECONDS=300
PLANE_TOKEN_TTL_SANDBOX_MANAGER_SECONDS=300
PLANE_TOKEN_TTL_BRIDGE_CORE_SECONDS=300

# Email Configuration (Resend)
RESEND_API_KEY="re_CHANGE-ME"
RESEND_FROM_EMAIL="noreply@CHANGE-ME.com"
RESEND_FROM_NAME="Your App"
RESEND_SUPPORT_EMAIL="support@CHANGE-ME.com"

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID="AC-CHANGE-ME"
TWILIO_VERIFY_SERVICE_SID="VA-CHANGE-ME"
TWILIO_AUTH_TOKEN="CHANGE-ME"

# Security
BETTER_AUTH_SECRET="CHANGE-ME"
# Use the public frontend origin when Velion proxies /api/auth/* to auth-core.
BETTER_AUTH_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"
TOKEN_ENCRYPTION_KEY="CHANGE-ME"
DISPOSABLE_EMAIL_BLOCKLIST_ENABLED="true"
DISPOSABLE_EMAIL_DOMAINS_FILE="../config/security/disposable-email-domains.txt"

# Primary auth methods
EMAIL_PASSWORD_ENABLED="true"
AUTO_SIGNIN_AFTER_SIGNUP="false"
REQUIRE_EMAIL_VERIFICATION="false"

# Signup captcha (Better Auth captcha plugin)
CAPTCHA_ENABLED=false
CAPTCHA_PROVIDER=cloudflare-turnstile
CAPTCHA_EXPECTED_ACTION=signup
CAPTCHA_ALLOWED_HOSTNAMES=localhost
TURNSTILE_SECRET_KEY=

# Phone/SMS verification (Better Auth phone-number plugin)
PHONE_AUTH_ENABLED=true
PHONE_OTP_ALLOWED_ATTEMPTS=3
PHONE_REQUIRE_VERIFICATION=true
PHONE_SIGNUP_ON_VERIFICATION=false

# Session & Cookie Configuration
COOKIE_PREFIX=idknuten
SESSION_COOKIE_NAME=sid
SESSION_DATA_COOKIE_NAME="sdata"
NO_REMEMBER_COOKIE_NAME="no_remember"
COOKIE_SAME_SITE=lax

# Account Management
ALLOW_UNLINKING_ALL="false"

# Two-Factor Authentication
TOTP_ISSUER=ID-Knuten
TOTP_DIGITS=6
TOTP_PERIOD=30

# OAuth Providers
GOOGLE_CLIENT_ID="CHANGE-ME"
GOOGLE_CLIENT_SECRET="CHANGE-ME"

# Enterprise Features
ORGANIZATION_ENABLED=true
SSO_ENABLED="true"
API_KEY_ENABLED="true"
