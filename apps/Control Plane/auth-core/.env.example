# ==============================================
# Auth Service Configuration - TEMPLATE
# Copy this file to .env and fill in the values
# ==============================================

# Server Configuration
NODE_ENV=development
PORT=3011

# Database Configuration
# For local: postgres://coresystem:password@localhost:5432/auth_service
# For Docker: postgres://coresystem:password@coresystem-postgres-local:5432/auth_service
DATABASE_URL=postgres://coresystem:CHANGE-ME@localhost:5432/auth_service?sslmode=disable

# Dragonfly cache configuration. Dragonfly speaks the Redis protocol, so the
# URI scheme remains redis://.
# For local: redis://:password@localhost:6380/3
# For Docker: redis://:password@controlplane-dragonfly:6379/3
DRAGONFLY_URL=redis://:CHANGE-ME@localhost:6380/3

# NATS Configuration
# For local: nats://localhost:4222
# For Docker: nats://coresystem-nats-local:4222
NATS_URL=nats://localhost:4222
NATS_USER=auth-core-control
NATS_PASSWORD=
VEREVON_NATS_URL=nats://localhost:4222
NATS_SHARED_TOKEN=

# User Service Integration
USER_SERVICE_GRPC_URL="localhost:50012"
USER_SERVICE_API_KEY="your-internal-api-key"

# Internal service principals. Direct JSON is development/test only;
# production mounts the registry through AUTH_INTERNAL_SERVICE_CREDENTIALS_FILE.
AUTH_INTERNAL_SERVICE_CREDENTIALS_FILE=""
AUTH_INTERNAL_SERVICE_CREDENTIALS='[{"credentialId":"user-core-primary","principal":"user-core","audience":"auth-core-internal","token":"REPLACE-WITH-UNIQUE-32-PLUS-CHARACTER-TOKEN","scopes":["oauth:token:read","oauth:token:refresh","nats:authenticate","auth:admin"]}]'

# Auth Core's method-scoped client identity for User Core gRPC.
USER_CORE_GRPC_CLIENT_CREDENTIAL_FILE=""
USER_CORE_GRPC_CLIENT_CREDENTIAL='{"credentialId":"auth-core-primary","principal":"auth-core","audience":"user-core-grpc","token":"REPLACE-WITH-A-DIFFERENT-32-PLUS-CHARACTER-TOKEN"}'
USER_CORE_GRPC_TLS_CA_FILE=""

# Production must mount a fixed-audience, scoped gRPC registry file. Direct JSON
# is accepted only in development/test. Rotation uses two unique credentialId
# entries for one principal during overlap, followed by retirement of the old ID.
AUTH_GRPC_SERVICE_CREDENTIALS_FILE=""
AUTH_GRPC_SERVICE_CREDENTIALS='[{"credentialId":"verevon-gateway-primary","principal":"verevon-gateway","audience":"auth-core","token":"REPLACE-WITH-UNIQUE-32-PLUS-CHARACTER-TOKEN","scopes":["auth:token:validate","auth:user:read"]}]'
# Dedicated read-only caller credential for user-core membership decisions.
# Use a unique random 32+ character value; do not reuse INTERNAL_API_KEY.
USER_CORE_MEMBERSHIP_SERVICE_TOKEN=""
# Dedicated read-only caller credential for the Application operator's
# Auth-canonical membership list. Must differ from every other service token.
APPLICATION_RECONCILER_AUTH_TOKEN=""

# Data Plane authorization-decision caller (service-principal only).
# Retrieval mints a short-lived bearer with:
#   POST /api/control-policy/internal-token
#   X-Service-Id: retrieval-engine
#   X-Service-Api-Key: <the registry credential below>
#   {"orgId":"<verified request org>","scopes":["data:authorization:decide"],
#    "reason":"authorize retrieval request"}
# It then calls /api/v1/internal/authorization/data-plane/decision with only
# Authorization: Bearer <token>. The signed org_id must match the decision
# request orgId. Tokens carry aud=control-policy and
# sub=service_id=service:retrieval-engine.
DATA_PLANE_POLICY_AUTH_AUDIENCE="control-policy"
DATA_PLANE_POLICY_CALLER_SERVICE_ID="retrieval-engine"
PLANE_TOKEN_TTL_CONTROL_POLICY_SECONDS=300
# Retrieval reuses one deployment credential to request two non-interchangeable
# short-lived tokens. Per-audience scope maps prevent its policy authority from
# crossing into inference (or vice versa). Graph Index has a separate
# credential and only inference:invoke. allowAnyOrg authorizes these platform
# services to request a token for an input tenant; every issued token remains
# cryptographically bound to exactly that requested org. Add conversation-core
# as a separately credentialed principal when Inbox provider actions are
# enabled.
#
# Space retrieval binding is deliberately absent from every interactive token,
# including organization owners. When the Application-owned Space provisioning
# worker is deployed, register a separate `application-space-binder` principal
# for the `data-plane` audience with only `data:space-binding:write`, explicit
# production `orgIds`, and an audience map containing only that same scope.
# Never add this scope to `plane-token-scopes.ts`, the verevon gateway, or a
# general-purpose application service credential.
# Local Compose fallback only. Production omits this variable and supplies an
# absolute host-side PLANE_SERVICE_PRINCIPALS_FILE to the production override;
# configuring both sources is rejected. The production/staging file must use
# explicit `orgIds`; `allowAnyOrg` is rejected outside exact development/test.
PLANE_SERVICE_PRINCIPALS_JSON='{"retrieval-engine":{"credential":"CHANGE-ME-RETRIEVAL-CREDENTIAL","audiences":["control-policy","inference-core"],"orgIds":[],"allowAnyOrg":true,"scopes":["data:authorization:decide","inference:invoke"],"scopesByAudience":{"control-policy":["data:authorization:decide"],"inference-core":["inference:invoke"]}},"graph-index":{"credential":"CHANGE-ME-GRAPH-INDEX-CREDENTIAL","audiences":["inference-core"],"orgIds":[],"allowAnyOrg":true,"scopes":["inference:invoke"],"scopesByAudience":{"inference-core":["inference:invoke"]}}}'

# Exact, non-interchangeable Model service audiences. Auth Core refuses to
# start when any configured value differs from the receiving service's name.
MODEL_PLANE_AUTH_AUDIENCE="model-gateway"
SESSION_CORE_AUTH_AUDIENCE="session-core"
INFERENCE_CORE_AUTH_AUDIENCE="inference-core"
EXECUTION_CORE_AUTH_AUDIENCE="execution-core"
COST_CORE_AUTH_AUDIENCE="cost-core"
CAPABILITY_CORE_AUTH_AUDIENCE="capability-core"
LETTA_BRIDGE_AUTH_AUDIENCE="letta-bridge"
BROWSER_BROKER_AUTH_AUDIENCE="browser-broker"
SANDBOX_MANAGER_AUTH_AUDIENCE="sandbox-manager"
BRIDGE_CORE_AUTH_AUDIENCE="bridge-core"

# Delegated credentials are short-lived. Interactive (user) tokens default to
# issuer-computed `zdr=false` (normal retention) — Zero Data Retention is an
# OPT-IN, PAID, plan-gated add-on, never the standard. The effective posture
# is resolved live, per org, at token-mint time against org-core (see
# interactive-retention-policy.ts): `zdr=true` only when BOTH (1) the org's
# self-serve settings toggle stored `zdr:true`
# (`organizations.metadata.interactiveRetention.zdr`, set via org-core's
# `PATCH /api/v1/organizations/:id/settings`) AND (2) org-core's own
# server-computed `feature.zero_data_retention` entitlement for the org's
# current plan is `true`. Any org-core lookup failure/timeout/missing data
# fails closed to `zdr=false`; it never blocks token issuance and never fails
# open to `zdr=true`. No env var configures this — request bodies, headers,
# frontend state, and service credentials cannot select or influence it.
# ORG_SERVICE_URL (above) is the only configuration this lookup needs.
#
# A service principal may use non-ZDR processing only when its registry entry
# has an exact `retentionByAudience` value of `persistent`; request headers and
# bodies never select or downgrade retention posture.
PLANE_TOKEN_TTL_SESSION_CORE_SECONDS=300
PLANE_TOKEN_TTL_INFERENCE_CORE_SECONDS=300
PLANE_TOKEN_TTL_EXECUTION_CORE_SECONDS=300
PLANE_TOKEN_TTL_COST_CORE_SECONDS=300
PLANE_TOKEN_TTL_CAPABILITY_CORE_SECONDS=300
PLANE_TOKEN_TTL_LETTA_BRIDGE_SECONDS=300
PLANE_TOKEN_TTL_BROWSER_BROKER_SECONDS=300
PLANE_TOKEN_TTL_SANDBOX_MANAGER_SECONDS=300
PLANE_TOKEN_TTL_BRIDGE_CORE_SECONDS=300

# Email Configuration (Resend)
RESEND_API_KEY="re_CHANGE-ME"
RESEND_FROM_EMAIL="noreply@CHANGE-ME.com"
RESEND_FROM_NAME="Your App"
RESEND_SUPPORT_EMAIL="support@CHANGE-ME.com"

# SMS Configuration (Twilio)
TWILIO_ACCOUNT_SID="AC-CHANGE-ME"
TWILIO_VERIFY_SERVICE_SID="VA-CHANGE-ME"
TWILIO_AUTH_TOKEN="CHANGE-ME"

# Security
BETTER_AUTH_SECRET="CHANGE-ME"
# Use the public frontend origin when Verevon proxies /api/auth/* to auth-core.
BETTER_AUTH_URL="http://localhost:3000"
FRONTEND_URL="http://localhost:3000"
BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000"
TOKEN_ENCRYPTION_KEY="CHANGE-ME"
DISPOSABLE_EMAIL_BLOCKLIST_ENABLED="true"
DISPOSABLE_EMAIL_DOMAINS_FILE="../config/security/disposable-email-domains.txt"

# Primary auth methods
EMAIL_PASSWORD_ENABLED="true"
AUTO_SIGNIN_AFTER_SIGNUP="false"
REQUIRE_EMAIL_VERIFICATION="false"

# Signup captcha (Better Auth captcha plugin)
CAPTCHA_ENABLED=false
CAPTCHA_PROVIDER=cloudflare-turnstile
CAPTCHA_EXPECTED_ACTION=signup
CAPTCHA_ALLOWED_HOSTNAMES=localhost
TURNSTILE_SECRET_KEY=

# Phone/SMS verification (Better Auth phone-number plugin)
PHONE_AUTH_ENABLED=true
PHONE_OTP_ALLOWED_ATTEMPTS=3
PHONE_REQUIRE_VERIFICATION=true
PHONE_SIGNUP_ON_VERIFICATION=false

# Session & Cookie Configuration
COOKIE_PREFIX=idknuten
SESSION_COOKIE_NAME=sid
SESSION_DATA_COOKIE_NAME="sdata"
NO_REMEMBER_COOKIE_NAME="no_remember"
COOKIE_SAME_SITE=lax
# Session cookie-cache: keep DISABLED. When enabled, the signed `sdata` cookie
# caches session data (incl. activeOrganizationId) for SESSION_COOKIE_CACHE_MAX_AGE.
# Better Auth's set-active updates secondaryStorage but does not reliably refresh
# that client cookie, so the cache goes stale — during onboarding the session keeps
# reporting no active org, and /api/:audience/token fails closed (gateway 503 on
# graph-preview / start-website-ingest / start-connect-session, navbar 401). Sessions
# live in secondaryStorage (Dragonfly), so disabling only costs a fast per-request
# read and makes get-session authoritative. Re-enable only with a short max-age AND
# a set-active cache-refresh fix.
SESSION_COOKIE_CACHE_ENABLED="false"
SESSION_COOKIE_CACHE_MAX_AGE=300

# Account Management
ALLOW_UNLINKING_ALL="false"

# Two-Factor Authentication
TOTP_ISSUER=ID-Knuten
TOTP_DIGITS=6
TOTP_PERIOD=30

# OAuth Providers
GOOGLE_CLIENT_ID="CHANGE-ME"
GOOGLE_CLIENT_SECRET="CHANGE-ME"

# Enterprise Features
ORGANIZATION_ENABLED=true
SSO_ENABLED="true"
API_KEY_ENABLED="true"
