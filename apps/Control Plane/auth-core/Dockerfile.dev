# syntax=docker/dockerfile:1.7
# Dockerfile.dev for Auth Service
FROM node:22.23.1-alpine3.23@sha256:8516dce0483394d5708d4b2ee6cacb79fb1d617ea4e2787c2120bcca92ce372e

# Jobbmappe inne i containeren
WORKDIR /app

# Keep the development toolchain aligned with the locked production build.
RUN corepack enable && corepack prepare pnpm@11.3.0 --activate

# Kopier kun manifest først for cache av node_modules-laget
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY patches ./patches

# Reproduce the checked-in dependency graph in development too.
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile --loglevel=error

# Standard dev-port
ENV PORT=3011
EXPOSE 3011

# Default kommando – overrides i docker-compose
CMD ["pnpm", "run", "start:dev"]
