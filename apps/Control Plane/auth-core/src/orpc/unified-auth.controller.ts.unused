import { Controller, All, Req, Res } from '@nestjs/common';
import { ApiTags, ApiOperation, ApiResponse } from '@nestjs/swagger';
import type { Request, Response } from 'express';
import { RPCHandler } from '@orpc/server/node';
import { orpcRouter } from '../auth/orpc-router';

interface ErrorWithStatus extends Error {
  status?: number;
}

@ApiTags('Unified Auth API')
@Controller('api/unified')
export class UnifiedAuthController {
  private handler = new RPCHandler(orpcRouter, {
    plugins: [],
  });

  @All('*')
  @ApiOperation({
    summary: 'Unified Better Auth + oRPC endpoints',
    description:
      'Combined authentication endpoints with Better Auth security and oRPC type safety',
  })
  @ApiResponse({
    status: 200,
    description: 'Operation successful',
    schema: {
      type: 'object',
      properties: {
        success: { type: 'boolean' },
        data: { type: 'object' },
        message: { type: 'string' },
      },
    },
  })
  @ApiResponse({
    status: 401,
    description: 'Unauthorized',
    schema: {
      type: 'object',
      properties: {
        error: { type: 'string' },
        message: { type: 'string' },
      },
    },
  })
  async handle(@Req() request: Request, @Res() response: Response) {
    try {
      console.log(`🔄 Unified Auth ${request.method} ${request.url}`);

      // Enhanced security headers
      response.setHeader('X-Content-Type-Options', 'nosniff');
      response.setHeader('X-Frame-Options', 'DENY');
      response.setHeader('X-XSS-Protection', '1; mode=block');
      response.setHeader('Referrer-Policy', 'strict-origin-when-cross-origin');

      // Extract headers for Better Auth context
      const headers = {
        cookie: request.get('cookie') || '',
        authorization: request.get('authorization') || '',
        'user-agent': request.get('user-agent') || '',
        'x-forwarded-for': request.get('x-forwarded-for') || '',
        'x-real-ip': request.get('x-real-ip') || '',
      };

      // Enhanced context with security features
      const context = {
        headers,
        setHeader: (name: string, value: string | string[]) => {
          if (Array.isArray(value)) {
            value.forEach((v) => response.append(name, v));
          } else {
            response.set(name, value);
          }
        },
        ip: request.ip || request.socket.remoteAddress || 'unknown',
        userAgent: request.get('user-agent') || 'unknown',
        timestamp: new Date().toISOString(),
      };

      const { matched } = await this.handler.handle(request, response, {
        prefix: '/api/unified',
        context,
      });

      if (matched) {
        // Response is already handled by oRPC
        return;
      }

      // If no procedure was matched, return 404
      response.status(404).json({
        error: 'Procedure not found',
        path: request.path,
        availableEndpoints: [
          'POST /api/unified/auth.signIn',
          'POST /api/unified/auth.signUp',
          'POST /api/unified/auth.signOut',
          'GET /api/unified/auth.getSession',
          'GET /api/unified/profile.getProfile',
          'POST /api/unified/profile.updateProfile',
          'GET /api/unified/consent.get',
          'POST /api/unified/consent.update',
          'POST /api/unified/consent.withdraw',
        ],
      });
    } catch (error: any) {
      console.error('❌ Unified Auth Handler Error:', error);

      // Enhanced error response with security considerations
      const isDevelopment = process.env.NODE_ENV === 'development';
      const statusCode = (error as ErrorWithStatus)?.status || 500;

      response.status(statusCode).json({
        error: 'Request processing failed',
        message: isDevelopment
          ? (error as Error)?.message
          : 'Something went wrong',
        timestamp: new Date().toISOString(),
        ...(isDevelopment && { stack: (error as Error)?.stack }),
      });
    }
  }
}
