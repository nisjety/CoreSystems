import {
  Controller,
  All,
  Param,
  Req,
  Res,
  Logger,
  HttpException,
  HttpStatus,
} from '@nestjs/common';
import type { Request, Response } from 'express';

@Controller('api/auth')
export class ConsolidatedAuthController {
  private readonly logger = new Logger(ConsolidatedAuthController.name);

  @All('*path')
  handleUnifiedAuth(
    @Param('path') path: string,
    @Req() req: Request,
    @Res() res: Response,
  ) {
    this.logger.log(`🔄 Unified Auth ${req.method} /api/auth/${path}`);

    try {
      // Set comprehensive security headers first
      this.setSecurityHeaders(res);

      const procedurePath = this.mapToORPCPath(path);
      this.logger.debug(`🗺️ Path mapping: /${path} -> /${procedurePath}`);

      // Create context for oRPC with enhanced security
      const context = this.createSecureContext(req, res);

      // Simple direct procedure mapping
      const procedureMap: Record<string, string> = {
        'auth/signIn': 'signIn',
        'auth/signUp': 'signUp',
        'auth/signOut': 'signOut',
        'auth/getSession': 'getSession',
        'profile/getProfile': 'getProfile',
        'profile/updateProfile': 'updateProfile',
        'consent/update': 'updateConsent',
        'consent/withdraw': 'withdrawConsent',
        'consent/get': 'getConsent',
      };

      const mappedProcedure = procedureMap[procedurePath];
      if (!mappedProcedure) {
        this.logger.error(`❌ Procedure not found: ${procedurePath}`);
        return res.status(404).json({
          error: 'Procedure not found',
          message: `Procedure ${procedurePath} not found`,
          code: 'PROCEDURE_NOT_FOUND',
          timestamp: new Date().toISOString(),
        });
      }

      // Validate request based on procedure type
      this.validateRequest(procedurePath, req);

      // TODO: Call actual oRPC procedure here instead of test response
      // For now, return test response to verify structure
      const result = {
        success: true,
        procedure: mappedProcedure,
        originalPath: procedurePath,
        // eslint-disable-next-line @typescript-eslint/no-unsafe-assignment
        input: req.body,
        message: `Successfully mapped ${procedurePath} to ${mappedProcedure}`,
        timestamp: new Date().toISOString(),
        context: {
          hasHeaders: !!context.headers,
          hasSetHeader: typeof context.setHeader === 'function',
          securityHeaders: true,
        },
      };

      this.logger.log(`✅ Procedure completed successfully for /${path}`);
      return res.json(result);
    } catch (error) {
      this.logger.error(
        `❌ Error in auth endpoint /${path}:`,
        (error as Error).message,
      );
      const statusCode =
        error instanceof HttpException
          ? error.getStatus()
          : HttpStatus.INTERNAL_SERVER_ERROR;
      const message =
        error instanceof HttpException
          ? error.message
          : 'Internal server error';
      res.status(statusCode).json({
        error: message,
        statusCode,
        timestamp: new Date().toISOString(),
        path: `/api/auth/${path}`,
      });
    }
  }

  private setSecurityHeaders(res: Response): void {
    // Comprehensive security headers
    res.setHeader('X-Content-Type-Options', 'nosniff');
    res.setHeader('X-Frame-Options', 'DENY');
    res.setHeader('X-XSS-Protection', '1; mode=block');
    res.setHeader('Referrer-Policy', 'strict-origin-when-cross-origin');
    res.setHeader(
      'Permissions-Policy',
      'camera=(), microphone=(), geolocation=()',
    );
    res.setHeader(
      'Strict-Transport-Security',
      'max-age=31536000; includeSubDomains',
    );
    res.setHeader(
      'Cache-Control',
      'no-store, no-cache, must-revalidate, proxy-revalidate',
    );
    res.setHeader('Pragma', 'no-cache');
    res.setHeader('Expires', '0');
  }

  private validateRequest(procedurePath: string, req: Request): void {
    // Validate required fields based on procedure
    if (procedurePath === 'auth/signIn') {
      // eslint-disable-next-line @typescript-eslint/no-unsafe-member-access
      if (!req.body?.email || !req.body?.password) {
        throw new HttpException(
          'Email and password are required',
          HttpStatus.BAD_REQUEST,
        );
      }
      if (
        // eslint-disable-next-line @typescript-eslint/no-unsafe-member-access
        typeof req.body.email !== 'string' ||
        // eslint-disable-next-line @typescript-eslint/no-unsafe-member-access
        typeof req.body.password !== 'string'
      ) {
        throw new HttpException(
          'Invalid email or password format',
          HttpStatus.BAD_REQUEST,
        );
      }
    }

    if (procedurePath === 'auth/signUp') {
      // eslint-disable-next-line @typescript-eslint/no-unsafe-member-access
      if (!req.body?.email || !req.body?.password || !req.body?.name) {
        throw new HttpException(
          'Name, email and password are required',
          HttpStatus.BAD_REQUEST,
        );
      }
      // eslint-disable-next-line @typescript-eslint/no-unsafe-member-access
      if (req.body.password.length < 8) {
        throw new HttpException(
          'Password must be at least 8 characters',
          HttpStatus.BAD_REQUEST,
        );
      }
    }

    // Validate email format for auth procedures
    // eslint-disable-next-line @typescript-eslint/no-unsafe-member-access
    if (procedurePath.startsWith('auth/') && req.body?.email) {
      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      // eslint-disable-next-line @typescript-eslint/no-unsafe-member-access, @typescript-eslint/no-unsafe-argument
      if (!emailRegex.test(req.body.email)) {
        throw new HttpException('Invalid email format', HttpStatus.BAD_REQUEST);
      }
    }
  }

  private createSecureContext(req: Request, res: Response) {
    const headers = new Headers();

    // Copy relevant headers with security validation
    if (req.get('cookie')) {
      headers.set('cookie', req.get('cookie')!);
    }
    if (req.get('authorization')) {
      headers.set('authorization', req.get('authorization')!);
    }
    if (req.get('user-agent')) {
      headers.set('user-agent', req.get('user-agent')!);
    }
    if (req.get('x-forwarded-for')) {
      headers.set('x-forwarded-for', req.get('x-forwarded-for')!);
    }

    // Add client IP tracking for security
    const clientIP = req.ip || req.connection.remoteAddress || 'unknown';

    return {
      headers,
      setHeader: (name: string, value: string) => {
        res.setHeader(name, value);
      },
      req,
      res,
      clientIP,
      timestamp: new Date().toISOString(),
    };
  }

  private mapToORPCPath(unifiedPath: string): string {
    const pathMappings: Record<string, string> = {
      signIn: 'auth/signIn',
      signUp: 'auth/signUp',
      signOut: 'auth/signOut',
      getSession: 'auth/getSession',
      getProfile: 'profile/getProfile',
      updateProfile: 'profile/updateProfile',
      giveConsent: 'consent/update',
      revokeConsent: 'consent/withdraw',
      getConsents: 'consent/get',
    };
    return pathMappings[unifiedPath] || unifiedPath;
  }
}
