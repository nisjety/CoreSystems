# ==============================================
# User Service Configuration - TEMPLATE
# Copy this file to .env and fill in the values
# ==============================================

# Server Configuration
HTTP_PORT=3012
GRPC_PORT=50012
ENVIRONMENT=development

# Database Configuration
# For local: postgres://aquatiq:password@localhost:5432/user_service
# For Docker: postgres://aquatiq:password@aquatiq-postgres-local:5432/user_service
DATABASE_URL=postgres://aquatiq:CHANGE-ME@localhost:5432/user_service?sslmode=disable

# Dragonfly cache configuration
DRAGONFLY_ENABLED=true
DRAGONFLY_HOST=localhost
DRAGONFLY_PORT=6380
DRAGONFLY_PASSWORD=CHANGE-ME
DRAGONFLY_DB=2

# NATS Configuration
# For local: nats://localhost:4222
# For Docker: nats://aquatiq-nats-local:4222
NATS_URL=nats://localhost:4222
NATS_USER=user-core-control
NATS_PASSWORD=
VELION_NATS_URL=nats://localhost:4222
NATS_SHARED_TOKEN=

# Security
JWT_SECRET=CHANGE-ME
# Direct JSON is development/test only. Production mounts the two exact JSON
# objects through *_FILE. Tokens must be unique, non-placeholder, and 32+ chars.
USER_CORE_GRPC_SERVICE_CREDENTIALS_FILE=
USER_CORE_GRPC_SERVICE_CREDENTIALS='[{"credentialId":"auth-core-primary","principal":"auth-core","audience":"user-core-grpc","token":"REPLACE-WITH-UNIQUE-32-PLUS-CHARACTER-TOKEN","methods":["/user.v1.UserService/CreateUser","/user.v1.UserService/UpdateUser","/user.v1.UserService/GetUserByEmail","/user.v1.UserService/CreateSession","/user.v1.UserService/GetUser","/user.v1.UserService/DeleteUser","/user.v1.UserService/HealthCheck"]}]'
USER_CORE_GRPC_TLS_CERT_FILE=
USER_CORE_GRPC_TLS_KEY_FILE=
USER_AUTH_INTERNAL_CLIENT_CREDENTIAL_FILE=
USER_AUTH_INTERNAL_CLIENT_CREDENTIAL='{"credentialId":"user-core-primary","principal":"user-core","audience":"auth-core-internal","token":"REPLACE-WITH-A-DIFFERENT-32-PLUS-CHARACTER-TOKEN"}'

# Service URLs
# For local: http://localhost:3011
# For Docker: http://auth-core:3011
BETTER_AUTH_URL=http://localhost:3011

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Session Configuration
SESSION_EXPIRE_SECONDS=86400
SESSION_MAX_PER_USER=10

# Database Connection Pool
DATABASE_MAX_CONNECTIONS=25
DATABASE_MIN_CONNECTIONS=5

# Internal service URLs
AUTH_SERVICE_URL=http://localhost:3011
ORG_SERVICE_URL=http://localhost:8080
# Must exactly match Auth Core and be unique to canonical membership decisions.
USER_CORE_MEMBERSHIP_SERVICE_TOKEN=
