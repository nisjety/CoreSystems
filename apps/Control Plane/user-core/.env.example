# ==============================================
# User Service Configuration - TEMPLATE
# Copy this file to .env and fill in the values
# ==============================================

# Server Configuration
HTTP_PORT=3012
GRPC_PORT=50012
ENVIRONMENT=development

# Database Configuration
# For local: postgres://coresystem:password@localhost:5432/user_service
# For Docker: postgres://coresystem:password@coresystem-postgres-local:5432/user_service
DATABASE_URL=postgres://coresystem:CHANGE-ME@localhost:5432/user_service?sslmode=disable

# Dragonfly cache configuration
DRAGONFLY_ENABLED=true
DRAGONFLY_HOST=localhost
DRAGONFLY_PORT=6380
DRAGONFLY_PASSWORD=CHANGE-ME
DRAGONFLY_DB=2

# NATS Configuration
# For local: nats://localhost:4222
# For Docker: nats://coresystem-nats-local:4222
NATS_URL=nats://localhost:4222
NATS_USER=user-core-control
NATS_PASSWORD=
VEREVON_NATS_URL=nats://localhost:4222
NATS_SHARED_TOKEN=

# Security
JWT_SECRET=CHANGE-ME
# Direct JSON is development/test only. Production mounts the two exact JSON
# objects through *_FILE. Tokens must be unique, non-placeholder, and 32+ chars.
USER_CORE_GRPC_SERVICE_CREDENTIALS_FILE=
USER_CORE_GRPC_SERVICE_CREDENTIALS='[{"credentialId":"auth-core-primary","principal":"auth-core","audience":"user-core-grpc","token":"REPLACE-WITH-UNIQUE-32-PLUS-CHARACTER-TOKEN","methods":["/user.v1.UserService/CreateUser","/user.v1.UserService/UpdateUser","/user.v1.UserService/GetUserByEmail","/user.v1.UserService/CreateSession","/user.v1.UserService/GetUser","/user.v1.UserService/DeleteUser","/user.v1.UserService/HealthCheck"]}]'
USER_CORE_GRPC_TLS_CERT_FILE=
USER_CORE_GRPC_TLS_KEY_FILE=
USER_AUTH_INTERNAL_CLIENT_CREDENTIAL_FILE=
USER_AUTH_INTERNAL_CLIENT_CREDENTIAL='{"credentialId":"user-core-primary","principal":"user-core","audience":"auth-core-internal","token":"REPLACE-WITH-A-DIFFERENT-32-PLUS-CHARACTER-TOKEN"}'

# Service URLs
# For local: http://localhost:3011
# For Docker: http://auth-core:3011
BETTER_AUTH_URL=http://localhost:3011

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Session Configuration
SESSION_EXPIRE_SECONDS=86400
SESSION_MAX_PER_USER=10

# Database Connection Pool
DATABASE_MAX_CONNECTIONS=25
DATABASE_MIN_CONNECTIONS=5

# Internal service URLs
AUTH_SERVICE_URL=http://localhost:3011
ORG_SERVICE_URL=http://localhost:8080
# Must exactly match Auth Core and be unique to canonical membership decisions.
USER_CORE_MEMBERSHIP_SERVICE_TOKEN=

# Control resolves a Model run's immutable, content-free authority only through
# this dedicated Session Core audience/scope. Leave both unset in an unprovisioned
# development stack: /run-action-decision then stays fail-closed. Never reuse a
# browser, gateway, execution, or broad Model service credential here.
SESSION_CORE_RUN_AUTHORITY_ADDR=
CONTROL_SESSION_CORE_RUN_AUTHORITY_BEARER=
# Authenticated TLS is required for the credentialed Control → Session Core
# authority RPC. The platform trust store is used by default; supply a private
# deployment CA/server name when needed. HTTP/insecure gRPC is permitted only
# for an explicit 127.0.0.1 or ::1 development target, never a Docker service.
SESSION_CORE_RUN_AUTHORITY_TLS_CA_FILE=
SESSION_CORE_RUN_AUTHORITY_TLS_SERVER_NAME=
CONTROL_ALLOW_INSECURE_SESSION_RUN_AUTHORITY_LOOPBACK=false

# Conversation Core's effect-time current-authority check is an independent
# service credential. Register its exact value as principal "conversation-core"
# with only "spaces:agent-action:current-authority" in
# USER_CORE_SERVICE_CREDENTIALS. It must differ from the execution-core,
# gateway, signer, and all other service credentials. Leave it unset in an
# unprovisioned dev stack; the Model ticket effect remains fail-closed.
CONVERSATION_CONTROL_RUN_ACTION_AUTHORITY_TOKEN=
