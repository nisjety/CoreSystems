# ==============================================
# Shared secrets and credentials (local development template)
# Copy to .env and replace values for your environment.
# ==============================================

# Database
DB_USER=aquatiq
DB_PASSWORD=change-me-db-password
AI_DB_USER=postgres
AI_DB_PASSWORD=change-me-ai-db-password

# Redis
REDIS_PASSWORD=change-me-redis-password

# NATS
NATS_TOKEN=nats
VELION_NATS_URL=nats://velion-nats:4222
VELION_NATS_TOKEN=change-me-velion-nats-token

# Auth / Internal security
JWT_SECRET=change-me-jwt-secret
BETTER_AUTH_SECRET=change-me-better-auth-secret
INTERNAL_SERVICE_SECRET=change-me-internal-service-secret
INTERNAL_API_KEY=change-me-internal-service-secret

# Convex
CONVEX_INSTANCE_SECRET=change-me-convex-instance-secret

# Temporal
TEMPORAL_DB_USER=temporal
TEMPORAL_DB_PASSWORD=change-me-temporal-db-password
TEMPORAL_DB_NAME=temporal
