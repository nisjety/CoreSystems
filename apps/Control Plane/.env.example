# ==============================================
# Shared secrets and credentials (local development template)
# Copy to .env, generate every required value, and keep the file untracked.
# ==============================================

# Required image provenance for Compose builds.
SOURCE_REVISION=
BUILD_DATE=

# Database
DB_USER=aquatiq
DB_PASSWORD=
AI_DB_USER=postgres
AI_DB_PASSWORD=

# Dragonfly
DRAGONFLY_PASSWORD=

# Plane-local NATS principals. Generate a distinct 32+ character random value
# for every entry. NATS_TOKEN is migration/dev fallback only and is not wired by
# the release compose path.
AUTH_NATS_PASSWORD=
USER_NATS_PASSWORD=
ORG_NATS_PASSWORD=
BILLING_NATS_PASSWORD=
SESSION_NATS_PASSWORD=
AUDIT_CONTROL_NATS_PASSWORD=
CONTROL_NATS_PROVISIONER_PASSWORD=
AUTH_SHARED_NATS_PASSWORD=
USER_SHARED_NATS_PASSWORD=
ORG_SHARED_NATS_PASSWORD=
BILLING_SHARED_NATS_PASSWORD=
SESSION_SHARED_NATS_PASSWORD=
CONTROL_SHARED_BRIDGE_PASSWORD=
CONTROL_SHARED_NATS_PROVISIONER_PASSWORD=
APPLICATION_CONVEX_CONTROL_NATS_PASSWORD=
DOCUMENTS_GDPR_NATS_PASSWORD=
APPLICATION_CONVEX_CONTROL_PROJECTION_KEY=
CONVEX_INTERNAL_SERVICE_KEY=
CONVEX_RECONCILIATION_KEY=
MODEL_NATS_RUNTIME_PASSWORD=
MODEL_GATEWAY_NATS_PASSWORD=
MODEL_SESSION_CORE_NATS_PASSWORD=
AUDIT_MODEL_NATS_PASSWORD=
MODEL_NATS_PROVISIONER_PASSWORD=
APPLICATION_CONVEX_MODEL_NATS_PASSWORD=
APPLICATION_INSIGHT_MODEL_NATS_PASSWORD=
APPLICATION_CONVERSATION_NATS_PASSWORD=
APPLICATION_SOCIAL_NATS_PASSWORD=
APPLICATION_INSIGHT_NATS_PASSWORD=
APPLICATION_LEADS_NATS_PASSWORD=
APPLICATION_NOTIFICATION_NATS_PASSWORD=
AUDIT_APPLICATION_NATS_PASSWORD=
APPLICATION_NATS_PROVISIONER_PASSWORD=
NATS_TOKEN=
# Legacy token is held only by the temporary compatibility bridge. Control
# runtime services use scoped user/password credentials on control-shared-nats.
VELION_NATS_URL=nats://velion-nats:4222
VELION_NATS_TOKEN=
# Observability (required when the default Grafana service is enabled)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ANONYMOUS_ENABLED=false

# Auth / Internal security
JWT_SECRET=
BETTER_AUTH_SECRET=
# Browser-facing Velion origin used for auth redirects, provider callbacks, and
# invitation links. Production overrides still require explicit canonical URLs.
VELION_PUBLIC_ORIGIN=http://localhost:5173
# Production overlay inputs. Set all three to the externally reachable HTTPS
# origin(s); the release Compose intentionally has no localhost fallback.
BETTER_AUTH_URL=
FRONTEND_URL=
BETTER_AUTH_TRUSTED_ORIGINS=
# Production Auth runtime inputs. Secret-manager integrations should materialize
# the three files atomically before rendering docker-compose.production.yml.
AUTH_DATABASE_URL=
AUTH_DRAGONFLY_URL=
TOKEN_ENCRYPTION_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=
AUTH_GRPC_SERVICE_CREDENTIALS_FILE=
AUTH_INTERNAL_SERVICE_CREDENTIALS_FILE=
USER_CORE_GRPC_CLIENT_CREDENTIAL_FILE=
USER_CORE_GRPC_SERVICE_CREDENTIALS_FILE=
USER_CORE_GRPC_TLS_CA_FILE=
USER_CORE_GRPC_TLS_CERT_FILE=
USER_CORE_GRPC_TLS_KEY_FILE=
USER_AUTH_INTERNAL_CLIENT_CREDENTIAL_FILE=
CONVEX_AUTH_PRIVATE_KEY_FILE=
CONVEX_AUTH_PUBLIC_KEY_FILE=
INTERNAL_SERVICE_SECRET=
INTERNAL_API_KEY=
# JSON object of Control-issued service principals, audiences and scopes. For
# conversation provider actions, provision a "conversation-core" principal
# with audience "ingestion", integration:read/integration:write scopes, and
# allowAnyOrg=true with orgIds=[]. Its credential must exactly match the
# Application Plane's
# CONVERSATION_INTEGRATION_SERVICE_API_KEY and must not be reused elsewhere.
PLANE_SERVICE_PRINCIPALS_JSON=
# Dedicated audience/scope-bound credential used only by Velion gateway when
# delegating a verified user to Control Plane session-core. Generate separately.
SESSION_CORE_SERVICE_TOKEN=
# Dedicated Auth gRPC principals. The gateway may mutate/read its own auth
# session contract; retrieval may only validate bearer sessions.
GATEWAY_AUTH_GRPC_SERVICE_TOKEN=
RETRIEVAL_AUTH_GRPC_SERVICE_TOKEN=
AUTH_USER_CORE_GRPC_SERVICE_TOKEN=
USER_AUTH_INTERNAL_SERVICE_TOKEN=
QUARRY_AUTH_INTERNAL_SERVICE_TOKEN=
GATEWAY_ORG_CORE_SERVICE_TOKEN=
GATEWAY_BILLING_CORE_SERVICE_TOKEN=
GATEWAY_AUDIT_CORE_SERVICE_TOKEN=
AUTH_ORG_CORE_SERVICE_TOKEN=
AUTH_BILLING_CORE_SERVICE_TOKEN=
BILLING_ORG_CORE_SERVICE_TOKEN=
SESSION_ORG_CORE_SERVICE_TOKEN=
SESSION_BILLING_CORE_SERVICE_TOKEN=
INTEGRATION_ORG_CORE_SERVICE_TOKEN=
INTEGRATION_BILLING_CORE_SERVICE_TOKEN=
INTEGRATION_AUDIT_CORE_SERVICE_TOKEN=
USER_CORE_GATEWAY_TOKEN=
USER_CORE_SESSION_TOKEN=
USER_CORE_ORG_TOKEN=
USER_CORE_AUTH_TOKEN=
# Distinct 32+ character credential used only for the Auth Core canonical
# membership decision endpoint called by user-core.
USER_CORE_MEMBERSHIP_SERVICE_TOKEN=
# Dedicated read-only Auth membership-list credential for the manual
# Application projection reconciler. Never reuse a generic internal key.
APPLICATION_RECONCILER_AUTH_TOKEN=
USER_CORE_DOCUMENTS_TOKEN=
USER_CORE_RETRIEVAL_TOKEN=
DISPOSABLE_EMAIL_BLOCKLIST_ENABLED=true
DISPOSABLE_EMAIL_DOMAINS_FILE=/app/config/security/disposable-email-domains.txt
NVD_FEED_CACHE_PATH=config/security/nvd
MISP_BASE_URL=
MISP_API_KEY=
OPENCTI_URL=
OPENCTI_TOKEN=

# Convex
CONVEX_INSTANCE_SECRET=

# Temporal
TEMPORAL_DB_USER=temporal
TEMPORAL_DB_PASSWORD=
TEMPORAL_DB_NAME=temporal
