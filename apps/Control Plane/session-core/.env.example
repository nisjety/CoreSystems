# Session Core Configuration
# Copy to .env for a local run and fill all credentials from the secret
# manager. The service fails closed on missing scoped tokens.

SERVER_HTTP_PORT=3017
SERVER_GRPC_PORT=50017
ENVIRONMENT=development

DATABASE_HOST=controlplane-postgres
DATABASE_PORT=5432
DATABASE_USER=aquatiq
DATABASE_PASSWORD=CHANGE_ME_database_password
DATABASE_NAME=session_core
DATABASE_SSL_MODE=disable
DATABASE_MAX_CONNS=20

DRAGONFLY_ADDR=controlplane-dragonfly:6379
DRAGONFLY_PASSWORD=CHANGE_ME_dragonfly_password
DRAGONFLY_DB=1

NATS_LOCAL_URL=nats://controlplane-nats:4222
NATS_USER=session-core-control
NATS_PASSWORD=CHANGE_ME_session_control_nats_password_32_chars
NATS_ALLOW_TOKEN_FALLBACK=0
NATS_SHARED_URL=nats://control-shared-nats:4222
NATS_SHARED_USER=session-core-shared
NATS_SHARED_PASSWORD=CHANGE_ME_session_shared_nats_password_32_chars
NATS_SHARED_ALLOW_TOKEN_FALLBACK=0

# One exact audience/scope-bound gateway principal.
SESSION_CORE_SERVICE_CREDENTIALS='[{"principal":"velion-gateway","audience":"session-core","token":"CHANGE_ME_gateway_session_token_32_chars","scopes":["sessions:read","sessions:write"]}]'
USER_CORE_SERVICE_TOKEN=CHANGE_ME_session_to_user_token_32_chars
ORG_CORE_SERVICE_TOKEN=CHANGE_ME_session_to_org_token_32_chars
BILLING_CORE_SERVICE_TOKEN=CHANGE_ME_session_to_billing_token_32_chars
ORG_CORE_URL=http://org-core:8080
USER_CORE_URL=http://user-core:3012
BILLING_CORE_URL=http://billing-core:3014
CONVEX_URL=
CONVEX_SERVICE_KEY=
MODEL_PLANE_V2_ROLLOUT_PCT=0
LOGGING_LEVEL=info
LOGGING_FORMAT=json
