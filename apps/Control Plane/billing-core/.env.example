# ==============================================
# Billing Core Configuration - TEMPLATE
# Copy this file to .env and fill in values
# ==============================================

HTTP_PORT=3014
GRPC_PORT=50013
ENVIRONMENT=development

# For local: postgres://aquatiq:password@localhost:5433/postgres
# For Docker: postgres://aquatiq:password@controlplane-postgres:5432/postgres
DATABASE_URL=postgres://aquatiq:CHANGE-ME@localhost:5433/billing_service?sslmode=disable

# For local: nats://localhost:4223
# For Docker: nats://controlplane-nats:4222
NATS_URL=nats://localhost:4223
NATS_TOKEN=nats
VELION_NATS_URL=nats://localhost:4222
VELION_NATS_TOKEN=CHANGE-ME

SERVICE_NAME=billing-core

# Adapter settings. Options: nexi | hyperswitch | stripe.
PAYMENT_PROVIDER=nexi
ADAPTER_TIMEOUT_SECONDS=10
RETRY_POLL_SECONDS=5
RETRY_BATCH_SIZE=50
RETRY_MAX_ATTEMPTS=8
RETRY_BACKOFF_SECONDS=5

# Nexi Checkout (default provider — Nets/Nexi Group Nordic acquirer)
# https://developer.nexigroup.com/nexi-checkout/en-EU/api/
# Base + checkout.js default to TEST; for live use https://api.dibspayment.eu
# and https://checkout.dibspayment.eu/v1/checkout.js?v=1
NEXI_BASE_URL=https://test.api.dibspayment.eu
NEXI_CHECKOUT_JS_URL=https://test.checkout.dibspayment.eu/v1/checkout.js?v=1
# Server secret API key — raw Authorization value, NO Bearer scheme (from portal)
NEXI_SECRET_API_KEY=
# Public checkout key for the browser Checkout JS SDK
NEXI_CHECKOUT_KEY=
# Publicly-reachable webhook URL + shared secret Nexi echoes back (handler
# fails closed until the secret is set)
NEXI_WEBHOOK_URL=
NEXI_WEBHOOK_AUTHORIZATION=
NEXI_TERMS_URL=

# Stripe (fallback/reference only)
STRIPE_BASE_URL=https://api.stripe.com
STRIPE_API_KEY=

# Hyperswitch (fallback)
HYPERSWITCH_BASE_URL=https://sandbox.hyperswitch.io
HYPERSWITCH_API_KEY=
HYPERSWITCH_PUBLISHABLE_KEY=
HYPERSWITCH_PROFILE_ID=
HYPERSWITCH_CLIENT_URL=https://beta.hyperswitch.io/v1/HyperLoader.js
HYPERSWITCH_BACKEND_URL=https://sandbox.hyperswitch.io

# Lago
LAGO_BASE_URL=http://localhost:3001
LAGO_API_KEY=

# Dragonfly Cache Configuration
DRAGONFLY_ENABLED=true
DRAGONFLY_HOST=localhost
DRAGONFLY_PORT=6380
DRAGONFLY_PASSWORD=CHANGE-ME
DRAGONFLY_DB=5
