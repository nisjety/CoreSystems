# ==============================================
# Organization Service Configuration - TEMPLATE
# Copy this file to .env and fill in the values
# ==============================================

# Server Configuration
HTTP_PORT=8080
GRPC_PORT=9090
METRICS_PORT=9091
ENVIRONMENT=development

# Database Configuration
# For local: postgres://aquatiq:password@localhost:5432/org_core
# For Docker: postgres://aquatiq:password@controlplane-postgres:5432/org_core
#
# Transit security (sslmode):
#   PRODUCTION / managed Postgres MUST use TLS: sslmode=require (or stricter
#   verify-ca / verify-full). If the DSN below omits sslmode, org-core appends
#   one automatically: "require" for remote/managed hosts, "disable" only for
#   local/docker hosts (localhost, controlplane-postgres, postgres, db).
#   Override the chosen mode explicitly with DB_SSLMODE. An sslmode already in
#   the DSN always wins. Local docker Postgres terminates plaintext on the
#   container network, so sslmode=disable is correct there.
DATABASE_URL=postgres://aquatiq:CHANGE-ME@localhost:5432/org_core?sslmode=disable
# DB_SSLMODE=require   # uncomment in prod when the DSN does not carry sslmode
#
# Tenant-isolation RLS backstop (migration 008 — DELIVERED BUT GATED, off by
# default). To enable after DB validation, set the database-level GUC first:
#   ALTER DATABASE <org_core_db> SET app.org_rls_enabled = 'true';
# then redeploy so migration 008 applies the policies. See
# migrations/008_rls_tenant_isolation.up.sql for the full rationale.

# NATS Configuration
# For local: nats://localhost:4222
# For Docker: nats://controlplane-nats:4222
NATS_URL=nats://localhost:4222
NATS_USER=org-core-control
NATS_PASSWORD=
VELION_NATS_URL=nats://localhost:4222
NATS_SHARED_TOKEN=

# Service URLs
# For local: http://localhost:3011
# For Docker: http://auth-core:3011
AUTH_SERVICE_URL=http://localhost:3011
USER_SERVICE_URL=http://localhost:3012

# Service Identification
SERVICE_NAME=org-core

# Internal service authentication (shared across control-plane services)
INTERNAL_SERVICE_SECRET=change-me-internal-service-secret
INTERNAL_API_KEY=change-me-internal-service-secret

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json

# Policy & Entitlements
ENABLE_POLICY_MIDDLEWARE=true
ENABLE_QUOTA_ENFORCEMENT=true

# Dragonfly Cache Configuration
DRAGONFLY_ENABLED=true
DRAGONFLY_HOST=localhost
DRAGONFLY_PORT=6380
DRAGONFLY_PASSWORD=CHANGE-ME
DRAGONFLY_DB=3
