# Audit Core Configuration
# Copy to .env for a local run and fill every credential from the secret
# manager. Runtime token fallback is deliberately disabled.

HTTP_PORT=8187
METRICS_PORT=9091
DATABASE_URL=postgres://coresystem:CHANGE_ME@controlplane-postgres:5432/audit_service?sslmode=disable

NATS_URL=nats://controlplane-nats:4222
NATS_USER=audit-core-control
NATS_PASSWORD=CHANGE_ME_audit_control_nats_password_32_chars
AUDIT_ALLOW_NATS_TOKEN_FALLBACK=0
# Must include verevon-gateway/audit:read:self and integration-corev2/audit:write
# pinned to ingestion. Use unique 32+ byte tokens in each entry.
AUDIT_CORE_SERVICE_CREDENTIALS='[{"principal":"verevon-gateway","audience":"audit-core","token":"CHANGE_ME_gateway_audit_token_32_chars","scopes":["audit:read:self"]},{"principal":"integration-corev2","audience":"audit-core","token":"CHANGE_ME_ingestion_audit_token_32_chars","scopes":["audit:write"],"planes":["ingestion"]}]'
# JSON array of named model/application buses; leave [] until provisioned.
AUDIT_EXTRA_NATS_BUSES=[]
AUDIT_RETENTION_DAYS=365
# Per-org tamper-evident hash chain over new audit rows. Only the literal 1
# enables it; leave 0 until the chain evidence has been captured. Switching it
# back to 0 is safe: rows written meanwhile are chained at the next boot with it on.
AUDIT_CHAIN_ENABLED=0
# Ed25519 keypair that signs head attestations and retention checkpoints. Both
# halves are generated together by scripts/run-control-plane.sh (a 32-byte seed
# and its 32-byte public key, base64url without padding; standard base64 is
# also accepted); never hand-edit them. Boot fails when the chain is on,
# ENVIRONMENT=production and the private key is missing. AUDIT_CHAIN_VERIFY_KEYS
# lists retired public keys still needed to verify old checkpoints, as
# comma-separated key_id:public_key pairs.
AUDIT_CHAIN_KEY_ID=
AUDIT_CHAIN_PRIVATE_KEY_BASE64=
AUDIT_CHAIN_PUBLIC_KEY_BASE64=
AUDIT_CHAIN_VERIFY_KEYS=
# How often the head of every org chain is signed (a Go duration).
AUDIT_CHAIN_ATTEST_INTERVAL=60s
# Retention of chained rows. Until AUDIT_CHAIN_PRUNE_ENABLED is 1, Purge skips
# chained rows, so enabling the chain never loses data. AUDIT_CHAIN_PRUNE_DRYRUN=1
# verifies and logs what a purge would delete, and deletes nothing.
AUDIT_CHAIN_PRUNE_ENABLED=0
AUDIT_CHAIN_PRUNE_DRYRUN=0
