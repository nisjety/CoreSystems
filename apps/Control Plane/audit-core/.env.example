# Audit Core Configuration
# Copy to .env for a local run and fill every credential from the secret
# manager. Runtime token fallback is deliberately disabled.

HTTP_PORT=8187
METRICS_PORT=9091
DATABASE_URL=postgres://aquatiq:CHANGE_ME@controlplane-postgres:5432/audit_service?sslmode=disable

NATS_URL=nats://controlplane-nats:4222
NATS_USER=audit-core-control
NATS_PASSWORD=CHANGE_ME_audit_control_nats_password_32_chars
AUDIT_ALLOW_NATS_TOKEN_FALLBACK=0
# Must include velion-gateway/audit:read:self and integration-corev2/audit:write
# pinned to ingestion. Use unique 32+ byte tokens in each entry.
AUDIT_CORE_SERVICE_CREDENTIALS='[{"principal":"velion-gateway","audience":"audit-core","token":"CHANGE_ME_gateway_audit_token_32_chars","scopes":["audit:read:self"]},{"principal":"integration-corev2","audience":"audit-core","token":"CHANGE_ME_ingestion_audit_token_32_chars","scopes":["audit:write"],"planes":["ingestion"]}]'
# JSON array of named model/application buses; leave [] until provisioned.
AUDIT_EXTRA_NATS_BUSES=[]
AUDIT_RETENTION_DAYS=365
