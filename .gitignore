# CoreSystem root .gitignore — one repo covers all 6 planes + velion frontend.
# Exclude large build artefacts, dependency dirs, and runtime state. Keep
# tracked: source, docs, compose files, Dockerfiles, env templates.

# ──────────────────────────────────────────────────────────────────────
# Build artefacts
# ──────────────────────────────────────────────────────────────────────
# Rust
target/
**/target/
*.rlib
*.rmeta

# Go
bin/
**/bin/
**/dist/

# Next.js / Node
.next/
**/.next/
out/
**/out/
**/node_modules/

# Python
__pycache__/
**/__pycache__/
**/.pytest_cache/
**/*.egg-info/
**/.venv/
.venv/
*.pyc
*.pyo

# Generated proto / SDK output
**/gen/cpp/
**/gen/python/_pb2*.py

# ──────────────────────────────────────────────────────────────────────
# Editor / OS
# ──────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.example.json

# ──────────────────────────────────────────────────────────────────────
# Secrets and local env
# ──────────────────────────────────────────────────────────────────────
# Catch every .env variant (including .env.production, .env.staging,
# .env.external-services, .env.zammad — these have been observed to
# contain real DB passwords + integration secrets in this tree). Also
# catch service-named *.env files (apps/Control Plane/lago.env carries
# real openssl-generated keys per its own header).
.env
.env.*
*.env
**/.env
**/.env.*
**/*.env
# Track explicitly named template/example/docker variants only.
!**/.env.example
!**/.env.template
!**/.env.docker
!**/.env.sso.template
!**/.env.zammad.example
!**/*.env.example
!**/*.env.template
!**/*.env.docker
# Specific known-secret files (defence-in-depth in case the pattern
# above ever loosens by accident).
**/lago.env
**/.env.external-services
!**/.env.docker
!**/.env.template

# ──────────────────────────────────────────────────────────────────────
# Logs and runtime state
# ──────────────────────────────────────────────────────────────────────
*.log
logs/
**/logs/
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*

# ──────────────────────────────────────────────────────────────────────
# Coverage and test output
# ──────────────────────────────────────────────────────────────────────
coverage/
**/coverage/
.nyc_output/
**/.nyc_output/
*.lcov

# ──────────────────────────────────────────────────────────────────────
# Local caches
# ──────────────────────────────────────────────────────────────────────
.pnpm-store/
**/.pnpm-store/
.turbo/
**/.turbo/
.cache/
**/.cache/

# ──────────────────────────────────────────────────────────────────────
# Legacy nested-repo backups (created on 2026-05-20 when CoreSystem
# absorbed Model Plane + Quarry-v2 into a single root repository). Kept
# on disk in case the pre-root history is ever needed; not part of the
# unified repo.
# ──────────────────────────────────────────────────────────────────────
.git.preroot-backup/
**/.git.preroot-backup/

# ──────────────────────────────────────────────────────────────────────
# Sandbox / scratch
# ──────────────────────────────────────────────────────────────────────
/tmp/
.scratch/
