+    assert_eq!(status, 400, "{body}");
+    assert_eq!(body["error"]["details"]["field"], "kind");
+    let (status, body) = edge.list_raw(&org_a(), "?run_id=not-a-run").await;
+    assert_eq!(status, 400, "{body}");
+    assert_eq!(body["error"]["details"]["field"], "run_id");
+    edge.stop().await;
+
+    // The filter reads the durable index: a restarted edge answers the same.
+    let restarted = Edge::start(&root).await;
+    let again = restarted.list(&org_a(), &format!("?run_id={run_id}")).await;
+    assert_eq!(ids(&again), ids(&of_run));
+    restarted.stop().await;
+    let _ = std::fs::remove_dir_all(&root);
+}
diff --git a/apps/Ingestion Plane/Quarry-v2/crates/quarry-edge/tests/change_diff_route.rs b/apps/Ingestion Plane/Quarry-v2/crates/quarry-edge/tests/change_diff_route.rs
new file mode 100644
index 000000000..de04ffbce
--- /dev/null
+++ b/apps/Ingestion Plane/Quarry-v2/crates/quarry-edge/tests/change_diff_route.rs	
@@ -0,0 +1,86 @@
+//! INNH-4: `GET /v1/change/diff` through the real router and real RS256 tokens.
+//!
+//! The handler is gated three ways before it touches the baseline store: the switch
+//! (`QUARRY_EDGE__CHANGE_TEXT_DIFF`, 501 when off), the caller's ZDR posture (403) and the query
+//! (400). This harness wires no baseline store, so what is proved here is the gate order and the
+//! answers; the read logic behind it is covered against an in-memory store in
+//! `change_diff.rs`.
+//!
+//! One test, because it flips a process-wide environment variable.
+#![cfg(feature = "postgres-queue")]
+
+mod support;
+#[path = "support/zdr_harness.rs"]
+mod zdr_harness;
+
+use serde_json::Value;
+
+use zdr_harness::{user_in_standard_org, user_in_zdr_org, Harness};
+
+const FLAG: &str = "QUARRY_EDGE__CHANGE_TEXT_DIFF";
+const ROUTE: &str = "/v1/change/diff";
+
+async fn answer(harness: &Harness, bearer: &str, query: &str) -> (u16, Value) {
+    let response = harness.get(bearer, &format!("{ROUTE}{query}")).await;
+    let status = response.status().as_u16();
+    (status, response.json().await.unwrap_or(Value::Null))
+}
+
+fn message(payload: &Value) -> String {
+    payload["error"]["message"]
+        .as_str()
+        .unwrap_or_default()
+        .to_string()
+}
+
+#[tokio::test]
+async fn the_route_is_off_by_default_then_gates_zdr_and_the_query() {
+    let harness = Harness::start().await;
+    let standard = user_in_standard_org();
+    let zdr = user_in_zdr_org();
+
+    // Off (unset): 501 for everyone, naming the switch; a ZDR caller gets the same answer.
+    std::env::remove_var(FLAG);
+    for bearer in [&standard, &zdr] {
+        let (status, payload) = answer(&harness, bearer, "?url=https://example.com/pricing").await;
+        assert_eq!(status, 501, "{payload}");
+        assert!(
+            message(&payload).contains(FLAG),
+            "the 501 names the switch: {payload}"
+        );
+    }
+    std::env::set_var(FLAG, "0");
+    let (status, _) = answer(&harness, &standard, "?url=https://example.com/pricing").await;
+    assert_eq!(status, 501, "0 is off");
+
+    // On: a ZDR caller is refused before anything else, whatever the query.
+    std::env::set_var(FLAG, "1");
+    for query in ["?url=https://example.com/pricing", "", "?diff_id=diff_1"] {
+        let (status, payload) = answer(&harness, &zdr, query).await;
+        assert_eq!(status, 403, "{query}: {payload}");
+        assert!(
+            message(&payload).contains("Zero Data Retention"),
+            "{payload}"
+        );
+    }
+
+    // On, a standard caller: the query is checked (400) before the store is asked.
+    for query in [
+        "",
+        "?from=bln_1&to=bln_2",
+        "?url=https://example.com/pricing&from=bln_1",
+        "?diff_id=diff_1&from=bln_1&to=bln_2",
+        "?url=https://example.com/pricing&include=html",
+        "?url=not-a-url",
+    ] {
+        let (status, payload) = answer(&harness, &standard, query).await;
+        assert_eq!(status, 400, "{query}: {payload}");
+    }
+    // A valid query reaches the store check, and this harness has none: 501 with its own text.
+    let (status, payload) = answer(&harness, &standard, "?url=https://example.com/pricing").await;
+    assert_eq!(status, 501, "{payload}");
+    assert!(message(&payload).contains("DATABASE_URL"), "{payload}");
+    assert!(!message(&payload).contains(FLAG), "{payload}");
+
+    std::env::remove_var(FLAG);
+}
diff --git a/apps/Ingestion Plane/Quarry-v2/crates/quarry-edge/tests/crawl_options_off.rs b/apps/Ingestion Plane/Quarry-v2/crates/quarry-edge/tests/crawl_options_off.rs
new file mode 100644
index 000000000..e68611f47
--- /dev/null
+++ b/apps/Ingestion Plane/Quarry-v2/crates/quarry-edge/tests/crawl_options_off.rs	
@@ -0,0 +1,188 @@
+//! The two INNH-6 features with their flags off, the default.
+//!
+//! `QUARRY_EDGE__CRAWL_SITEMAP` and `QUARRY_EDGE__CRAWL_SCRAPE_OPTIONS` are removed from
+//! the environment by every test here. With them off:
+//!
+//! - the handoff answers the 400 `unsupported_option` it always did, and hands nothing on;
+//! - `POST /v1/internal/crawl/sitemap` is a 501;
+//! - `run_page` ignores a `scrape` field: the page is cleaned as before and the response
+//!   has no `scrape_applied`, which is how an orchestrator learns the options were not applied.
+
+use std::{
+    net::SocketAddr,
+    sync::{Arc, Mutex},
+};
+
+use axum::{extract::State, routing::post, Json, Router};
+use hmac::{Hmac, Mac};
+use quarry_edge::{internal_auth::InternalSigner, state::AppState};
+use quarry_runtime::EventSink;
+use serde_json::{json, Value};
+use sha2::Sha256;
+use tokio::sync::mpsc;
+
+mod support;
+
+use support::fixture_site::{FixtureSiteDriver, FIXTURE_A};
+
+const RUNTIME_TOKEN: &str = "crawl-options-off-runtime-token";
+const INTERNAL_SECRET: &str = "crawl-options-off-internal-secret-0123456789";
+const ORG: &str = "org_crawl_options_off";
+const TEST_BEARER: &str = "crawl-options-off-dev-token";
+
+type HmacSha256 = Hmac<Sha256>;
+type Recorded = Arc<Mutex<Vec<Value>>>;
+
+fn clear_flags() {
+    std::env::remove_var("QUARRY_EDGE__CRAWL_SITEMAP");
+    std::env::remove_var("QUARRY_EDGE__CRAWL_SCRAPE_OPTIONS");
+    std::env::set_var("QUARRY_EDGE__RUNTIME_AUTH_TOKEN", RUNTIME_TOKEN);
+    std::env::set_var("QUARRY_EDGE_AUTH_DEV_BYPASS", "1");
+}
+
+async fn spawn_control() -> (String, Recorded) {
+    async fn create_job(State(recorded): State<Recorded>, Json(body): Json<Value>) -> Json<Value> {
+        recorded.lock().unwrap().push(body);
+        Json(json!({ "data": { "id": "job_stub", "run_id": null } }))
+    }
+    let recorded: Recorded = Arc::default();
+    let app = Router::new()
+        .route("/v1/jobs", post(create_job))
+        .with_state(recorded.clone());
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let addr = listener.local_addr().unwrap();
+    tokio::spawn(async move { axum::serve(listener, app).await.unwrap() });
+    (format!("http://{addr}"), recorded)
+}
+
+async fn spawn_edge(control_url: String) -> SocketAddr {
+    clear_flags();
+    let (tx, mut rx) = mpsc::channel(64);
+    tokio::spawn(async move { while rx.recv().await.is_some() {} });
+    let driver = Arc::new(FixtureSiteDriver::standard_site());
+    let state = AppState {
+        control_base_url: control_url,
+        internal_signer: Some(Arc::new(InternalSigner::new(INTERNAL_SECRET).unwrap())),
+        ..support::base_state(driver, EventSink::new(tx))
+    };
+    let app = quarry_edge::routes::router(state);
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let addr = listener.local_addr().unwrap();
+    tokio::spawn(async move { axum::serve(listener, app).await.unwrap() });
+    addr
+}
+
+async fn crawl(addr: SocketAddr, body: Value) -> (u16, Value) {
+    let response = reqwest::Client::new()
+        .post(format!("http://{addr}/v1/crawl"))
+        .bearer_auth(TEST_BEARER)
+        .json(&body)
+        .send()
+        .await
+        .unwrap();
+    let status = response.status().as_u16();
+    (status, response.json().await.unwrap())
+}
+
+fn run_sig(org: &str, url: &str) -> String {
+    let mut mac = HmacSha256::new_from_slice(INTERNAL_SECRET.as_bytes()).unwrap();
+    mac.update(format!("{org}\n{url}").as_bytes());
+    format!("{:x}", mac.finalize().into_bytes())
+}
+
+async fn internal(addr: SocketAddr, path: &str, url: &str, mut body: Value) -> (u16, Value) {
+    body["url"] = json!(url);
+    body["org_id"] = json!(ORG);
+    let response = reqwest::Client::new()
+        .post(format!("http://{addr}{path}"))
+        .bearer_auth(RUNTIME_TOKEN)
+        .header("x-quarry-run-sig", run_sig(ORG, url))
+        .json(&body)
+        .send()
+        .await
+        .unwrap();
+    let status = response.status().as_u16();
+    (status, response.json().await.unwrap())
+}
+
+#[tokio::test]
+async fn the_handoff_keeps_its_400_for_both_options() {
+    let (control, recorded) = spawn_control().await;
+    let addr = spawn_edge(control).await;
+    for (key, value) in [
+        ("sitemap", json!("include")),
+        ("sitemap", json!("only")),
+        ("scrape_options", json!({ "exclude_tags": ["nav"] })),
+        ("scrapeOptions", json!({})),
+    ] {
+        let mut body = json!({ "url": "https://example.com/" });
+        body[key] = value;
+        let (status, response) = crawl(addr, body).await;
+        assert_eq!(status, 400, "{key}: {response}");
+        let fields = response["error"]["details"]["fields"].as_array().unwrap();
+        assert_eq!(fields.len(), 1, "{response}");
+        assert_eq!(fields[0]["path"], key);
+        assert_eq!(fields[0]["code"], "unsupported_option");
+    }
+    // The values that always worked still work.
+    let (status, response) = crawl(
+        addr,
+        json!({ "url": "https://example.com/", "sitemap": "skip" }),
+    )
+    .await;
+    assert_eq!(status, 200, "{response}");
+    assert!(
+        recorded.lock().unwrap().len() == 1,
+        "only the accepted request was handed off"
+    );
+}
+
+#[tokio::test]
+async fn the_sitemap_route_is_a_501() {
+    let (control, _recorded) = spawn_control().await;
+    let addr = spawn_edge(control).await;
+    let (status, body) = internal(
+        addr,
+        "/v1/internal/crawl/sitemap",
+        &format!("{FIXTURE_A}/"),
+        json!({ "crawl": { "v": 1, "scope_mode": "enforce" } }),
+    )
+    .await;
+    assert_eq!(status, 501, "{body}");
+    assert_eq!(body["error"]["code"], "UNSUPPORTED");
+}
+
+#[tokio::test]
+async fn run_page_ignores_scrape_and_does_not_echo_it() {
+    let (control, _recorded) = spawn_control().await;
+    let addr = spawn_edge(control).await;
+    let url = format!("{FIXTURE_A}/docs/a");
+    let (status, plain) = internal(addr, "/v1/internal/run_page", &url, json!({})).await;
+    assert_eq!(status, 200, "{plain}");
+    let (status, with_scrape) = internal(
+        addr,
+        "/v1/internal/run_page",
+        &url,
+        json!({ "scrape": { "exclude_tags": ["a"], "only_main_content": false, "extractor": "clean_full" } }),
+    )
+    .await;
+    assert_eq!(status, 200, "{with_scrape}");
+    assert!(
+        with_scrape.get("scrape_applied").is_none(),
+        "the options were not applied: {with_scrape}"
+    );
+    assert_eq!(plain["fingerprint"], with_scrape["fingerprint"]);
+    assert_eq!(
+        plain["excerpt"], with_scrape["excerpt"],
+        "the page was cleaned as before"
+    );
+    // Even an invalid scrape is ignored, not a 400: with the flag off the field does not exist.
+    let (status, body) = internal(
+        addr,
+        "/v1/internal/run_page",
+        &url,
+        json!({ "scrape": { "actions": [] } }),
+    )
+    .await;
+    assert_eq!(status, 200, "{body}");
+}
diff --git a/apps/Ingestion Plane/Quarry-v2/crates/quarry-edge/tests/crawl_options_on.rs b/apps/Ingestion Plane/Quarry-v2/crates/quarry-edge/tests/crawl_options_on.rs
