+        content:
+          application/json:
+            schema:
+              type: object
+              additionalProperties: false
+              required: [allowed_domains, budget]
+              properties:
+                allowed_domains:
+                  type: array
+                  minItems: 1
+                  maxItems: 32
+                  items:
+                    type: string
+                    maxLength: 253
+                budget:
+                  type: object
+                  additionalProperties: false
+                  required: [micro_usd, max_steps, max_runtime_s]
+                  properties:
