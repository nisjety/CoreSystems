+        let object = (any.type_url == RUN_TRACE_PAYLOAD_TYPE_URL)
+            .then(|| serde_json::from_slice::<Value>(&any.value).ok())
+            .flatten()
+            .filter(Value::is_object);
+        object.unwrap_or_else(|| json!({ "type_url": any.type_url }))
+    });
