+            "$id": "x",
+            "$comment": "c",
+            "type": "object",
+            "title": "T",
+            "description": "d",
+            "required": ["name"],
+            "additionalProperties": false,
+            "properties": {
+                "$id": { "type": "string", "$comment": "dropped" },
