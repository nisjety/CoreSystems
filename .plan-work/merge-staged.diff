+
+func (m *memWebhooks) CountByOrg(orgID string) int {
+	if orgID == "" {
+		return 0
+	}
+	m.mu.RLock()
+	defer m.mu.RUnlock()
+	n := 0
+	for _, it := range m.items {
+		if it.OrgID == orgID {
+			n++
+		}
+	}
+	return n
+}
