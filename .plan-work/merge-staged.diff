+func extRunOn(t *testing.T, store Repository, root *Grant, key string) (*Grant, *Grant) {
+	t.Helper()
+	run, err := store.Derive(ctx, deriveParams(root, key))
+	if err != nil {
+		t.Fatalf("derive run %s: %v", key, err)
+	}
+	return root, run
