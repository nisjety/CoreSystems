+        assert!(!service_route_switched_off(&svc, "POST", "/v1/ai/documents/layout", &layout_on));
+        assert!(service_route_switched_off(&svc, "POST", "/v1/ai/language/pii", &layout_on));
+        // A switch value that is not a literal stays off.
