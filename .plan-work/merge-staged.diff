+) -> Response {
+    let request_id = crate::request_id::current();
+    let result = async {
+        gate(webhook_subscriptions_enabled(), &claims, Access::Other)?;
+        require_id(&id, "whk_")?;
+        let reply = call(
+            &state,
+            &claims,
+            Access::Other,
+            reqwest::Method::GET,
+            &format!("/v1/webhook-subscriptions/{id}"),
+            &[],
+            None,
