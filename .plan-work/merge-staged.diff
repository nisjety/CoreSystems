+    ScheduledCron,
+    /// A capability-core routine.
+    Routine,
+    /// Background review.
+    BackgroundReview,
+    /// Dreaming.
+    Dreaming,
+    /// A `mail_task`.
+    MailTask,
+    /// A service calling the route directly.
+    DirectService,
+}
