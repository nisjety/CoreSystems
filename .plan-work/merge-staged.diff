index 000000000..29d972daa
--- /dev/null
+++ b/apps/Model Plane/rust/services/execution-core/tests/routing_probe.rs	
@@ -0,0 +1,173 @@
+//! WS11.S6 live routing probe: does the connector-first guidance move the model's FIRST
+//! non-discovery tool choice toward a connected-account tool?
+//!
+//! `#[ignore]`d: it needs a live inference-core and spends real model calls. Run it from the
+//! stack session, once with the guidance off and once on, and compare the two tables:
+//!
+//! ```bash
+//! INFERENCE_CORE_URL=http://inference-core:9092 \
+//! E2E_INFERENCE_BEARER=<short-lived-aud-inference-core-user-token> \
+//! E2E_ORG_ID=org_real \
+//! ROUTING_PROBE_MODEL=<model id> ROUTING_PROBE_PROVIDER=<provider hint> \
+//! ROUTING_PROBE_SAMPLES=5 \
+//! cargo test -p execution-core --test routing_probe -- --ignored --nocapture
+//! ```
+//!
+//! The probe sets the guidance explicitly through `routing_probe_inputs`, so one process
+//! produces both columns. The 90 percent gate on connector-solvable prompts is the plan's
+//! PLACEHOLDER: it is enforced only when `ROUTING_PROBE_MIN_PCT` is set, otherwise the table is
+//! printed and the run passes.
+//!
+//! The always-on test below pins the probe table itself, so a prompt cannot be edited into a
+//! case the offered set cannot answer.
+
+use execution_core::runtime_loop::agent::routing_probe_inputs;
+use mp_contracts::model_plane::v1::inference_core_client::InferenceCoreClient;
+use mp_contracts::model_plane::v1::{ChatMessage, InferRequest};
+
+/// The offered set of the probe: a connector pair next to the web and browser tools.
+const OFFERED: &[&str] = &[
+    "list_provider_actions",
+    "execute_provider_action",
+    "web_search",
+    "web_fetch",
+    // `browser_agent` is not a chat-offered tool today (it stays dormant, spec D6); the parent
+    // loop's browser tool stands in for the browser route.
+    "browser.observe",
+];
+
+/// Tool name to the counter's class label, the same mapping as `execution_routing_first_tool_total`.
+fn class_of(tool: &str) -> &'static str {
+    match tool {
+        "execute_provider_action" | "read_provider_action" => "connector",
+        "browser_agent" | "browser.observe" | "browser.act" => "browser",
+        "web_search" | "web_fetch" | "fetch_url" | "web.search" | "web.read" => "web",
+        _ => "other",
+    }
+}
+
+struct Probe {
+    prompt: &'static str,
+    /// The class a correct first non-discovery choice has.
+    expect: &'static str,
+}
+
+/// Connector-solvable prompts (the user's own connected accounts) and public-web prompts (where
+/// the web tool is the right answer, so the guidance must not over-route to a connector).
+fn probes() -> Vec<Probe> {
+    vec![
+        Probe { prompt: "Post 'We open at 9 tomorrow' on our Facebook Page.", expect: "connector" },
+        Probe { prompt: "List my latest ad campaigns and their spend.", expect: "connector" },
+        Probe { prompt: "Send a WhatsApp message to my last customer saying the order shipped.", expect: "connector" },
+        Probe { prompt: "Create a GitHub issue titled 'Login page 500s' in our repo.", expect: "connector" },
+        Probe { prompt: "What did Equinor announce in their latest quarterly report?", expect: "web" },
+        Probe { prompt: "Find the opening hours of Oslo Central Station on the web.", expect: "web" },
+    ]
+}
+
+#[test]
+fn the_probe_table_only_asks_what_the_offered_set_can_answer() {
+    assert!(OFFERED.contains(&"list_provider_actions") && OFFERED.contains(&"web_search"));
+    let probes = probes();
+    assert!(probes.iter().any(|probe| probe.expect == "connector"));
+    assert!(probes.iter().any(|probe| probe.expect == "web"));
+    for probe in &probes {
+        assert!(["connector", "web", "browser"].contains(&probe.expect));
+        assert!(!probe.prompt.is_empty());
+    }
+    // The guidance text only differs when it is on, and names only offered tools.
+    let (off, tools) = routing_probe_inputs(OFFERED, false);
+    let (on, _) = routing_probe_inputs(OFFERED, true);
+    assert!(on.len() > off.len() && on.starts_with(&off));
+    assert_eq!(tools.len(), OFFERED.len(), "every probe tool has a definition");
+}
+
+#[tokio::test]
+#[ignore = "requires a live inference-core and spends real model calls; see file header"]
+async fn connector_first_guidance_moves_the_first_tool_choice() {
+    let url = std::env::var("INFERENCE_CORE_URL").expect("INFERENCE_CORE_URL");
+    let bearer = std::env::var("E2E_INFERENCE_BEARER").expect("E2E_INFERENCE_BEARER");
+    let org_id = std::env::var("E2E_ORG_ID").expect("E2E_ORG_ID");
+    let model = std::env::var("ROUTING_PROBE_MODEL").unwrap_or_default();
+    let provider_hint = std::env::var("ROUTING_PROBE_PROVIDER").unwrap_or_default();
+    let samples: usize = std::env::var("ROUTING_PROBE_SAMPLES")
+        .ok()
+        .and_then(|v| v.parse().ok())
+        .unwrap_or(5);
+    let min_pct: Option<f64> = std::env::var("ROUTING_PROBE_MIN_PCT")
+        .ok()
+        .and_then(|v| v.parse().ok());
+
+    let mut client = InferenceCoreClient::connect(url)
+        .await
+        .expect("inference-core is reachable at INFERENCE_CORE_URL");
+
+    // [guidance off, guidance on] -> (correct, total) over the connector-solvable prompts.
+    let mut score = [(0usize, 0usize); 2];
+    for (column, guidance) in [false, true].into_iter().enumerate() {
+        let (system, tools) = routing_probe_inputs(OFFERED, guidance);
+        for probe in probes() {
+            let mut picked = Vec::new();
+            for sample in 0..samples {
+                let mut request = tonic::Request::new(InferRequest {
+                    request_id: format!("routing-probe-{column}-{sample}"),
+                    org_id: org_id.clone(),
+                    model: model.clone(),
+                    provider_hint: provider_hint.clone(),
+                    messages: vec![
+                        ChatMessage {
+                            role: "system".to_owned(),
+                            content: system.clone(),
+                            ..Default::default()
+                        },
+                        ChatMessage {
+                            role: "user".to_owned(),
+                            content: probe.prompt.to_owned(),
+                            ..Default::default()
+                        },
+                    ],
+                    temperature: 0.7,
+                    max_tokens: 512,
+                    tools: tools.clone(),
+                    tool_choice: "auto".to_owned(),
+                    ..Default::default()
+                });
+                request.metadata_mut().insert(
+                    "authorization",
+                    format!("Bearer {bearer}").parse().expect("valid bearer"),
+                );
+                let reply = client.infer(request).await.expect("inference round").into_inner();
+                // The first non-discovery call of the round, as the loop's counter would see it.
+                let first = reply
+                    .tool_calls
+                    .iter()
+                    .map(|call| call.name.as_str())
+                    .find(|name| *name != "list_provider_actions")
+                    .map_or("none", class_of);
+                picked.push(first);
+            }
+            let correct = picked.iter().filter(|class| **class == probe.expect).count();
+            eprintln!(
+                "guidance={guidance:<5} expect={:<9} {correct}/{samples}  {:?}  | {}",
+                probe.expect, picked, probe.prompt
+            );
+            if probe.expect == "connector" {
+                score[column].0 += correct;
+                score[column].1 += samples;
+            }
+        }
+    }
+    let pct = |(correct, total): (usize, usize)| 100.0 * correct as f64 / total.max(1) as f64;
+    eprintln!(
+        "connector-solvable first-choice compliance: guidance off {:.0}% | guidance on {:.0}%",
+        pct(score[0]),
+        pct(score[1])
+    );
+    if let Some(min) = min_pct {
+        assert!(
+            pct(score[1]) >= min,
+            "guidance-on compliance {:.0}% is below the {min}% gate",
+            pct(score[1])
+        );
+    }
+}
diff --git a/apps/Model Plane/rust/services/execution-core/tests/support/fake_quarry.rs b/apps/Model Plane/rust/services/execution-core/tests/support/fake_quarry.rs
new file mode 100644
index 000000000..cefd741fd
--- /dev/null
+++ b/apps/Model Plane/rust/services/execution-core/tests/support/fake_quarry.rs	
@@ -0,0 +1,411 @@
+//! A fake quarry-edge `/v1/agent/*` on `127.0.0.1:0`, driven through the real
+//! `QuarryAgentClient`. It records every request body and header it receives and
+//! replays scripted step responses.
+
+use std::collections::VecDeque;
+use std::sync::{Arc, Mutex};
+
+use axum::extract::{Path, Query, State};
+use axum::http::{HeaderMap, StatusCode};
+use axum::response::IntoResponse;
+use axum::routing::{delete, get, post};
+use axum::{Json, Router};
+use execution_core::quarry_agent::QuarryAgentClient;
+use serde_json::{json, Value};
+
+/// One scripted answer to `POST /v1/agent/runs/:id/step`.
+#[derive(Debug, Clone)]
+pub enum StepScript {
+    /// 200 with this observation (the envelope `data`).
+    Observation(Value),
+    /// A non-2xx answer with this JSON body (a Quarry error envelope).
+    Error { status: u16, body: Value },
+}
+
+#[derive(Default)]
+struct Inner {
+    start: Option<(u16, Value)>,
+    steps: VecDeque<StepScript>,
+    start_requests: Vec<Value>,
+    step_requests: Vec<Value>,
+    step_headers: Vec<Vec<(String, String)>>,
+    start_headers: Vec<Vec<(String, String)>>,
+    close_headers: Vec<Vec<(String, String)>>,
+    closed: u32,
+    step_counter: u32,
+    /// WS8.G: the run id in the path of each step request.
+    step_paths: Vec<String>,
+    /// WS8.G: a scripted error for `POST .../attach`.
+    attach_error: Option<(u16, Value)>,
+    /// WS8.G: `(run_id, body, headers)` of each attach request.
+    attach_requests: Vec<(String, Value, Vec<(String, String)>)>,
+    /// WS8.G: `(run_id, attach_id, disposition)` of each release.
+    releases: Vec<(String, String, String)>,
+    /// WS8.G: `(run_id, grant_id)` of each tab listing.
+    tab_queries: Vec<(String, String)>,
+    /// WS8.J: `(run_id, tab_id, body, headers)` of each mark request.
+    mark_requests: Vec<(String, String, Value, Vec<(String, String)>)>,
+    /// WS8.J: make the mark route answer with this error.
+    mark_error: Option<(u16, Value)>,
+    /// WS8.J: `mark` and `release` calls in arrival order.
+    call_order: Vec<String>,
+}
+
+type Shared = Arc<Mutex<Inner>>;
+
+pub struct FakeQuarry {
+    base_url: String,
+    inner: Shared,
+    task: tokio::task::JoinHandle<()>,
+}
+
+impl Drop for FakeQuarry {
+    fn drop(&mut self) {
+        self.task.abort();
+    }
+}
+
+impl FakeQuarry {
+    /// Bind `127.0.0.1:0` and serve.
+    pub async fn start() -> Self {
+        let inner: Shared = Arc::new(Mutex::new(Inner::default()));
+        let app = Router::new()
+            .route("/v1/agent/runs", post(start_run))
+            .route("/v1/agent/runs/:run_id/step", post(step))
+            .route("/v1/agent/runs/:run_id", delete(close_run))
+            .route("/v1/agent/runs/:run_id/attach", post(attach_run))
+            .route("/v1/agent/runs/:run_id/attach/:attach_id", delete(release_attach))
+            .route("/v1/agent/runs/:run_id/tabs", get(list_tabs))
+            .route("/v1/agent/runs/:run_id/tabs/:tab_id/mark", post(mark_tab))
+            .with_state(inner.clone());
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0")
+            .await
+            .expect("bind loopback");
+        let base_url = format!("http://{}", listener.local_addr().expect("local addr"));
+        let task = tokio::spawn(async move {
+            let _ = axum::serve(listener, app).await;
+        });
+        Self {
+            base_url,
+            inner,
+            task,
+        }
+    }
+
+    pub fn base_url(&self) -> &str {
+        &self.base_url
+    }
+
+    /// The real client, pointed at this server with a static test token.
+    pub fn client(&self) -> QuarryAgentClient {
+        QuarryAgentClient::new(self.base_url.clone(), "test-token").expect("client")
+    }
+
+    /// Make `POST /v1/agent/runs` answer with this error instead of a run.
+    pub fn fail_start(&self, status: u16, body: Value) {
+        self.inner.lock().expect("lock").start = Some((status, body));
+    }
+
+    pub fn push(&self, script: StepScript) -> &Self {
+        self.inner.lock().expect("lock").steps.push_back(script);
+        self
+    }
+
+    /// A 200 observation of `url` with `text` and these `(ref, role, name, text)`
+    /// snapshot targets, snapshot `snap-N` at generation N.
+    pub fn push_page(&self, url: &str, title: &str, text: &str, targets: &[(&str, &str, &str, &str)]) -> &Self {
+        let mut guard = self.inner.lock().expect("lock");
+        guard.step_counter += 1;
+        let n = guard.step_counter;
+        let targets: Vec<Value> = targets
+            .iter()
+            .map(|(r, role, name, text)| json!({"ref_id": r, "role": role, "name": name, "text": text}))
+            .collect();
+        guard.steps.push_back(StepScript::Observation(json!({
+            "run_id": "run_fake",
+            "step": n,
+            "url": url,
+            "title": title,
+            "snapshot": {"snapshot_id": format!("snap-{n}"), "generation": n, "targets": targets},
+            "dom_summary": {"node_count": 10, "text_snippet": text},
+        })));
+        self
+    }
+
+    /// WS12.S4: like [`Self::push_page`] (no targets) with Quarry's redaction
+    /// stamp as its `RedactionStamp` serialises it.
+    pub fn push_stamped_page(&self, url: &str, title: &str, text: &str, rule_version: &str) -> &Self {
+        let mut guard = self.inner.lock().expect("lock");
+        guard.step_counter += 1;
+        let n = guard.step_counter;
+        guard.steps.push_back(StepScript::Observation(json!({
+            "run_id": "run_fake",
+            "step": n,
+            "url": url,
+            "title": title,
+            "snapshot": {"snapshot_id": format!("snap-{n}"), "generation": n, "targets": []},
+            "dom_summary": {"node_count": 10, "text_snippet": text},
+            "redaction": {
+                "rule_version": rule_version, "profile": "live", "mode": "enforce",
+                "values_masked": 0, "by_rule": {}, "probe": "ok", "probe_ms": 1,
+                "screenshot": "none", "mask_ms": 0, "oopif_frames": 0, "rects": 0
+            },
+        })));
+        self
+    }
+
+    pub fn push_error(&self, status: u16, body: Value) -> &Self {
+        self.push(StepScript::Error { status, body })
+    }
+
+    pub fn start_requests(&self) -> Vec<Value> {
+        self.inner.lock().expect("lock").start_requests.clone()
+    }
+
+    /// Every step request body, in arrival order.
+    pub fn step_requests(&self) -> Vec<Value> {
+        self.inner.lock().expect("lock").step_requests.clone()
+    }
+
+    /// The headers (lower-cased names) of each step request.
+    pub fn step_headers(&self) -> Vec<Vec<(String, String)>> {
+        self.inner.lock().expect("lock").step_headers.clone()
+    }
+
+    /// The headers (lower-cased names) of each start request.
+    pub fn start_headers(&self) -> Vec<Vec<(String, String)>> {
+        self.inner.lock().expect("lock").start_headers.clone()
+    }
+
+    /// The headers (lower-cased names) of each release request.
+    pub fn close_headers(&self) -> Vec<Vec<(String, String)>> {
+        self.inner.lock().expect("lock").close_headers.clone()
+    }
+
+    /// How many times the run was released.
+    pub fn closed_runs(&self) -> u32 {
+        self.inner.lock().expect("lock").closed
+    }
+
+    /// WS8.G: the run id each step went to, in order.
+    pub fn step_paths(&self) -> Vec<String> {
+        self.inner.lock().expect("lock").step_paths.clone()
+    }
+
+    /// WS8.G: make `POST .../attach` answer with this error.
+    pub fn fail_attach(&self, status: u16, body: Value) {
+        self.inner.lock().expect("lock").attach_error = Some((status, body));
+    }
+
+    /// WS8.G: every attach request, `(run_id, body, headers)`.
+    pub fn attach_requests(&self) -> Vec<(String, Value, Vec<(String, String)>)> {
+        self.inner.lock().expect("lock").attach_requests.clone()
+    }
+
+    /// WS8.G: every release, `(run_id, attach_id, disposition)`.
+    pub fn releases(&self) -> Vec<(String, String, String)> {
+        self.inner.lock().expect("lock").releases.clone()
+    }
+
+    /// WS8.J: every tab mark, `(run_id, tab_id, body, headers)`.
+    pub fn marks(&self) -> Vec<(String, String, Value, Vec<(String, String)>)> {
+        self.inner.lock().expect("lock").mark_requests.clone()
+    }
+
+    /// WS8.J: make `POST .../tabs/:tab_id/mark` answer with this error.
+    pub fn fail_mark(&self, status: u16, body: Value) {
+        self.inner.lock().expect("lock").mark_error = Some((status, body));
+    }
+
+    /// WS8.J: `mark` and `release` in the order Quarry received them.
+    pub fn call_order(&self) -> Vec<String> {
+        self.inner.lock().expect("lock").call_order.clone()
+    }
+
+    /// WS8.G: a 409 `USER_TOOK_OVER` exactly as Quarry's delegate lane writes it.
+    pub fn push_took_over(&self) -> &Self {
+        self.push_error(
+            409,
+            json!({"data": null, "meta": {"request_id": "r"}, "error": {
+                "code": "USER_TOOK_OVER",
+                "message": "the person using the browser has taken control of this tab; this action was not run",
+                "retryable": false,
+                "details": {"scope": "tab", "tab_id": "tab_fake", "tab_epoch": 2, "control_epoch": 3}
+            }}),
+        )
+    }
+}
+
+fn envelope(data: Value) -> Value {
+    json!({"data": data, "meta": {}, "error": null})
+}
+
+fn header_pairs(headers: &HeaderMap) -> Vec<(String, String)> {
+    headers
+        .iter()
+        .map(|(name, value)| {
+            (
+                name.as_str().to_owned(),
+                value.to_str().unwrap_or_default().to_owned(),
+            )
+        })
+        .collect()
+}
+
+async fn start_run(
+    State(inner): State<Shared>,
+    headers: HeaderMap,
+    Json(body): Json<Value>,
+) -> impl IntoResponse {
+    let mut guard = inner.lock().expect("lock");
+    guard.start_requests.push(body);
+    guard.start_headers.push(header_pairs(&headers));
+    if let Some((status, body)) = guard.start.clone() {
+        return (
+            StatusCode::from_u16(status).expect("status"),
+            Json(body),
+        );
+    }
+    (
+        StatusCode::OK,
+        Json(envelope(json!({"run_id": "run_fake", "lease_id": "lease_fake"}))),
+    )
+}
+
+async fn step(
+    State(inner): State<Shared>,
+    Path(run_id): Path<String>,
+    headers: HeaderMap,
+    Json(body): Json<Value>,
+) -> impl IntoResponse {
+    let mut guard = inner.lock().expect("lock");
+    guard.step_paths.push(run_id);
+    guard.step_requests.push(body);
+    guard.step_headers.push(
+        headers
+            .iter()
+            .map(|(name, value)| {
+                (
+                    name.as_str().to_owned(),
+                    value.to_str().unwrap_or_default().to_owned(),
+                )
+            })
+            .collect(),
+    );
+    match guard.steps.pop_front() {
+        Some(StepScript::Observation(observation)) => {
+            (StatusCode::OK, Json(envelope(observation)))
+        }
+        Some(StepScript::Error { status, body }) => (
+            StatusCode::from_u16(status).expect("status"),
+            Json(body),
+        ),
+        None => (
+            StatusCode::INTERNAL_SERVER_ERROR,
+            Json(json!({"error": {"code": "FAKE_QUARRY_SCRIPT_EXHAUSTED", "message": "no scripted step"}})),
+        ),
+    }
+}
+
+async fn close_run(
+    State(inner): State<Shared>,
+    Path(_run_id): Path<String>,
+    headers: HeaderMap,
+) -> StatusCode {
+    let mut guard = inner.lock().expect("lock");
+    guard.closed += 1;
+    guard.close_headers.push(header_pairs(&headers));
+    StatusCode::OK
+}
+
+async fn attach_run(
+    State(inner): State<Shared>,
+    Path(run_id): Path<String>,
+    headers: HeaderMap,
+    Json(body): Json<Value>,
+) -> impl IntoResponse {
+    let mut guard = inner.lock().expect("lock");
+    guard
+        .attach_requests
+        .push((run_id, body, header_pairs(&headers)));
+    if let Some((status, body)) = guard.attach_error.clone() {
+        return (StatusCode::from_u16(status).expect("status"), Json(body));
+    }
+    (
+        StatusCode::OK,
+        Json(envelope(json!({
+            "attach_id": "att_fake",
+            "tab_id": "tab_fake",
+            "tab_epoch": 1,
+            "control_epoch": 2,
+            "opened_by": "agent",
+            "holder": "agent",
+            "allowed_domains": ["example.com"],
+        }))),
+    )
+}
+
+#[derive(serde::Deserialize)]
+struct ReleaseQuery {
+    disposition: Option<String>,
+}
+
+async fn release_attach(
+    State(inner): State<Shared>,
+    Path((run_id, attach_id)): Path<(String, String)>,
+    Query(query): Query<ReleaseQuery>,
+) -> impl IntoResponse {
+    let disposition = query.disposition.unwrap_or_else(|| "release".to_owned());
+    let state = if disposition == "abort" { "aborted" } else { "released" };
+    let mut guard = inner.lock().expect("lock");
+    guard.call_order.push("release".to_owned());
+    guard
+        .releases
+        .push((run_id, attach_id.clone(), disposition));
+    drop(guard);
+    (
+        StatusCode::OK,
+        Json(envelope(json!({"attach_id": attach_id, "state": state}))),
+    )
+}
+
+async fn mark_tab(
+    State(inner): State<Shared>,
+    Path((run_id, tab_id)): Path<(String, String)>,
+    headers: HeaderMap,
+    Json(body): Json<Value>,
+) -> impl IntoResponse {
+    let mut guard = inner.lock().expect("lock");
+    guard.call_order.push("mark".to_owned());
+    guard
+        .mark_requests
+        .push((run_id, tab_id.clone(), body.clone(), header_pairs(&headers)));
+    if let Some((status, body)) = guard.mark_error.clone() {
+        return (StatusCode::from_u16(status).expect("status"), Json(body));
+    }
+    (
+        StatusCode::OK,
+        Json(envelope(json!({"tabId": tab_id, "mark": body["mark"]}))),
+    )
+}
+
+#[derive(serde::Deserialize)]
+struct TabsQuery {
+    grant_id: Option<String>,
+}
+
+async fn list_tabs(
+    State(inner): State<Shared>,
+    Path(run_id): Path<String>,
+    Query(query): Query<TabsQuery>,
+) -> impl IntoResponse {
+    inner
+        .lock()
+        .expect("lock")
+        .tab_queries
+        .push((run_id, query.grant_id.unwrap_or_default()));
+    (
+        StatusCode::OK,
+        Json(envelope(json!({"tabs": [{"tabId": "tab_fake", "title": null, "url": null, "active": false}]}))),
+    )
+}
