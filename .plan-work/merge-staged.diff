+//! INNH-1 U3: the AI formats with the committed default, the switch OFF.
+//!
+//! Nothing here sets `QUARRY_EDGE__AI_FORMATS`: this binary is what every stack
+//! that has not opted in runs. Even with a Model Plane URL and a credential
+//! configured, an AI format is a 400 `feature_disabled` at its own index, nothing
+//! is fetched and no model is called. The stream refusal does not depend on the
+//! switch. `tests/ai_formats.rs` runs the same router with the switch on.
+
+use std::net::SocketAddr;
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::sync::{Arc, Once};
+
+use async_trait::async_trait;
+use quarry_core::output::DriverKind;
+use quarry_core::QuarryResult;
+use quarry_edge::state::AppState;
+use quarry_runtime::driver::Driver;
+use quarry_runtime::fetch::FetchResponse;
+use quarry_runtime::EventSink;
+use serde_json::{json, Value};
+use tokio::sync::mpsc;
+use url::Url;
+
+mod support;
+
+#[path = "support/ai_model_double.rs"]
+mod ai_model_double;
+
+use ai_model_double::{standard, Double};
+
+const TEST_BEARER: &str = "ai-formats-off-dev-token";
+const PAGE: &str = "<html><head><title>Page</title></head><body><main><h1>Heading</h1><p>Some body text for the switch-off test page, long enough to be extracted as its main content.</p></main></body></html>";
+
+struct PageDriver {
+    fetches: Arc<AtomicUsize>,
+}
+
+#[async_trait]
+impl Driver for PageDriver {
+    fn kind(&self) -> DriverKind {
+        DriverKind::Static
+    }
+
+    async fn fetch(&self, url: &Url) -> QuarryResult<FetchResponse> {
+        self.fetches.fetch_add(1, Ordering::SeqCst);
+        Ok(FetchResponse {
+            status: 200,
+            final_url: url.clone(),
+            headers: vec![("content-type".into(), "text/html; charset=utf-8".into())],
+            body: PAGE.as_bytes().to_vec(),
+            duration_ms: 2,
+            served_by: DriverKind::Static,
+            captures: None,
+        })
+    }
+}
+
+struct Edge {
+    addr: SocketAddr,
+    fetches: Arc<AtomicUsize>,
+}
+
+/// An edge that has a model URL and a dev credential, as a stack that is set up
+/// for the Model Plane but has not turned the formats on.
+async fn spawn_edge(double: &Double) -> Edge {
+    static ONCE: Once = Once::new();
+    ONCE.call_once(|| {
+        std::env::remove_var("QUARRY_EDGE__AI_FORMATS");
+        std::env::set_var("QUARRY_EDGE_AUTH_DEV_BYPASS", "1");
+    });
+    let (tx, mut rx) = mpsc::channel(256);
+    tokio::spawn(async move { while rx.recv().await.is_some() {} });
+    let fetches = Arc::new(AtomicUsize::new(0));
+    let state = AppState {
+        model_plane_url: Some(double.uri.clone()),
+        model_plane_token: Some("model-dev-token".to_owned()),
+        #[cfg(feature = "browser-agent")]
+        agent_driver: support::governed_agent_driver(),
+        ..support::base_state(
+            Arc::new(PageDriver {
+                fetches: fetches.clone(),
+            }),
+            EventSink::new(tx),
+        )
+    };
+    let app = quarry_edge::routes::router(state);
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let addr = listener.local_addr().unwrap();
+    tokio::spawn(async move {
+        axum::serve(listener, app).await.unwrap();
+    });
+    Edge { addr, fetches }
+}
+
+async fn post(edge: &Edge, path: &str, body: Value) -> (u16, String) {
+    let response = reqwest::Client::new()
+        .post(format!("http://{}{path}", edge.addr))
+        .bearer_auth(TEST_BEARER)
+        .json(&body)
+        .send()
+        .await
+        .unwrap();
+    (response.status().as_u16(), response.text().await.unwrap())
+}
+
+fn schema() -> Value {
+    json!({ "type": "object", "properties": { "title": { "type": "string" } } })
+}
+
+#[tokio::test]
+async fn every_ai_format_is_a_400_feature_disabled_at_its_own_index() {
+    let model = ai_model_double::start(standard).await;
+    let edge = spawn_edge(&model).await;
+    for (formats, path) in [
+        (
+            json!(["markdown", { "type": "json", "schema": schema() }]),
+            "formats[1]",
+        ),
+        (json!(["markdown", "summary"]), "formats[1]"),
+        (
+            json!(["markdown", { "type": "summary", "max_chars": 300 }]),
+            "formats[1]",
+        ),
+        (
+            json!([{ "type": "question", "question": "What?" }]),
+            "formats[0]",
+        ),
+        (
+            json!(["html", "markdown", { "type": "highlights", "query": "x" }]),
+            "formats[2]",
+        ),
+    ] {
+        let (status, text) = post(
+            &edge,
+            "/v1/scrape",
+            json!({ "url": "https://www.example.com/", "formats": formats }),
+        )
+        .await;
+        assert_eq!(status, 400, "{text}");
+        let body: Value = serde_json::from_str(&text).unwrap();
+        let fields = body["error"]["details"]["fields"]
+            .as_array()
+            .expect("fields");
+        assert!(
+            fields
+                .iter()
+                .any(|field| field["path"] == path && field["code"] == "feature_disabled"),
+            "no feature_disabled at {path}: {text}"
+        );
+        assert!(
+            !text.contains("reserved_format"),
+            "the old code is gone: {text}"
+        );
+    }
+    assert_eq!(
+        edge.fetches.load(Ordering::SeqCst),
+        0,
+        "nothing was fetched"
+    );
+    assert_eq!(model.calls(), 0, "no model was called");
+}
+
+#[tokio::test]
+async fn a_scrape_without_ai_formats_is_unchanged() {
+    let model = ai_model_double::start(standard).await;
+    let edge = spawn_edge(&model).await;
+    let (status, text) = post(
+        &edge,
+        "/v1/scrape",
+        json!({ "url": "https://www.example.com/", "formats": ["markdown", "html"] }),
+    )
+    .await;
+    assert_eq!(status, 200, "{text}");
+    let body: Value = serde_json::from_str(&text).unwrap();
+    for key in ["json", "summary", "answer", "highlights", "ai"] {
+        assert!(body["data"].get(key).is_none(), "`{key}` on a plain scrape");
+    }
+    assert!(body["data"]["markdown"].as_str().is_some());
+    assert_eq!(model.calls(), 0);
+}
+
+#[tokio::test]
+async fn the_stream_refusal_does_not_depend_on_the_switch() {
+    let model = ai_model_double::start(standard).await;
+    let edge = spawn_edge(&model).await;
+    let (status, text) = post(
+        &edge,
+        "/v1/scrape/stream",
+        json!({ "url": "https://www.example.com/", "formats": ["summary"] }),
+    )
+    .await;
+    assert_eq!(
+        status, 200,
+        "an SSE stream answers 200 and carries the error as an event"
+    );
+    assert!(
+        text.contains("event: error") && text.contains("unsupported_in_stream"),
+        "{text}"
+    );
+    assert_eq!(edge.fetches.load(Ordering::SeqCst), 0);
+}
diff --git a/apps/Ingestion Plane/Quarry-v2/crates/quarry-edge/tests/ai_formats_real_token.rs b/apps/Ingestion Plane/Quarry-v2/crates/quarry-edge/tests/ai_formats_real_token.rs
new file mode 100644
index 000000000..2a55bc82a
--- /dev/null
+++ b/apps/Ingestion Plane/Quarry-v2/crates/quarry-edge/tests/ai_formats_real_token.rs	
@@ -0,0 +1,191 @@
+//! INNH-1 U3: who may use the AI formats of `POST /v1/scrape`, on real tokens,
+//! and how a ZDR organisation's token floor reaches them.
+//!
+//! Beside `zdr_claim_floor.rs`, on its real-auth harness (`support/zdr_harness.rs`):
+//! no dev bypass, every request runs the real `require_auth` against a JWKS
+//! endpoint, and the claim sets are the golden Auth Core minted. `tests/ai_formats.rs`
+//! runs on the dev bypass, whose stub identity is a plain user with no `zdr` claim and
+//! no scopes, so it cannot show what a service principal or a ZDR organisation gets.
+//!
+//! These run in a normal `cargo test` (they need no stack and no Chromium). The
+//! switch is turned on before the first request; the model is a strict double of
+//! the gateway's chat route, and the edge's state carries its URL and a dev
+//! credential (what `main.rs` sets only under the dev bypass; here the state is
+//! built directly).
+
+mod support;
+
+#[path = "support/zdr_harness.rs"]
+mod zdr_harness;
+
+#[path = "support/ai_model_double.rs"]
+mod ai_model_double;
+
+use std::sync::Once;
+
+use ai_model_double::{chat, Double, Seen};
+use serde_json::{json, Value};
+use zdr_harness::{
+    golden_token, token_with_scopes, user_in_standard_org, user_in_zdr_org, Harness,
+};
+
+const REFUSED: &str = "extract_ai_scope_required";
+const SCOPE_EXTRACT_AI: &str = "extract:ai";
+
+fn enable() {
+    static ONCE: Once = Once::new();
+    ONCE.call_once(|| std::env::set_var("QUARRY_EDGE__AI_FORMATS", "on"));
+}
+
+fn model_script(seen: &Seen) -> ai_model_double::Reply {
+    match seen.task.as_str() {
+        "summarize" => chat("A short summary of the page.", 100, 8),
+        _ => chat("{}", 10, 1),
+    }
+}
+
+async fn start(double: &Double) -> Harness {
+    enable();
+    let url = double.uri.clone();
+    Harness::start_with(move |mut state| {
+        state.model_plane_url = Some(url);
+        state.model_plane_token = Some("model-dev-token".to_owned());
+        state
+    })
+    .await
+}
+
+async fn post(harness: &Harness, bearer: &str, body: Value) -> (u16, Value) {
+    let response = harness.post(bearer, "/v1/scrape", body).await;
+    let status = response.status().as_u16();
+    let text = response.text().await.expect("a response body");
+    (
+        status,
+        serde_json::from_str(&text).unwrap_or(Value::String(text)),
+    )
+}
+
+fn body() -> Value {
+    json!({
+        "url": "https://www.example.com/",
+        "formats": ["markdown", "summary"],
+    })
+}
+
+fn labelled(mut body: Value, label: &str) -> Value {
+    body["initiated_by"] = json!(label);
+    body
+}
+
+#[tokio::test]
+async fn a_zdr_org_user_gets_every_format_skipped_even_when_the_body_says_zdr_false() {
+    let model = ai_model_double::start(model_script).await;
+    let harness = start(&model).await;
+
+    let mut request = body();
+    request["zdr"] = json!(false);
+    let (status, zdr) = post(&harness, &user_in_zdr_org(), request.clone()).await;
+    assert_eq!(status, 200, "{zdr}");
+    assert_eq!(zdr["data"]["ai"]["summary"]["status"], "skipped", "{zdr}");
+    assert_eq!(
+        zdr["data"]["ai"]["summary"]["code"], "ZDR_UNAVAILABLE",
+        "{zdr}"
+    );
+    assert!(zdr["data"].get("summary").is_none());
+    assert_eq!(
+        zdr["data"]["effective_options"]["zdr"], true,
+        "the token floor held"
+    );
+    assert_eq!(model.calls(), 0, "no page text left for a model");
+
+    // The same body from an organisation without the floor is served.
+    let (status, standard) = post(&harness, &user_in_standard_org(), request).await;
+    assert_eq!(status, 200, "{standard}");
+    assert_eq!(
+        standard["data"]["ai"]["summary"]["status"], "ok",
+        "{standard}"
+    );
+    assert_eq!(standard["data"]["summary"], "A short summary of the page.");
+    assert_eq!(model.calls(), 1);
+    model.assert_clean();
+}
+
+#[tokio::test]
+async fn a_service_principal_needs_extract_ai_and_the_other_scope_does_not_stand_in() {
+    let model = ai_model_double::start(model_script).await;
+    let harness = start(&model).await;
+
+    // Both golden service principals reach /v1/scrape; neither holds extract:ai.
+    for case in ["service_model_gateway", "service_execution_core"] {
+        let (status, refused) = post(&harness, &golden_token(case), body()).await;
+        assert_eq!(status, 403, "{case}: {refused}");
+        assert_eq!(
+            refused["error"]["details"]["reason"], REFUSED,
+            "{case}: {refused}"
+        );
+        assert_eq!(refused["error"]["details"]["field"], "formats[1]", "{case}");
+    }
+    // scrape:interact is the scope of actions, not of this.
+    let interact = token_with_scopes("service_execution_core", &["scrape:interact"]);
+    let (status, refused) = post(&harness, &interact, body()).await;
+    assert_eq!(status, 403, "{refused}");
+    assert_eq!(model.calls(), 0);
+
+    // A scrape with no AI format is not touched by the scope.
+    let (status, plain) = post(
+        &harness,
+        &golden_token("service_execution_core"),
+        json!({ "url": "https://www.example.com/", "formats": ["markdown"] }),
+    )
+    .await;
+    assert_eq!(status, 200, "{plain}");
+
+    // With the scope the same body is served.
+    let granted = token_with_scopes("service_execution_core", &[SCOPE_EXTRACT_AI]);
+    let (status, served) = post(&harness, &granted, body()).await;
+    assert_eq!(status, 200, "{served}");
+    assert_eq!(served["data"]["ai"]["summary"]["status"], "ok", "{served}");
+    assert_eq!(model.calls(), 1);
+    model.assert_clean();
+}
+
+#[tokio::test]
+async fn the_agent_label_is_refused_for_a_user_and_for_a_service_that_holds_the_scope() {
+    let model = ai_model_double::start(model_script).await;
+    let harness = start(&model).await;
+
+    let (status, refused) =
+        post(&harness, &user_in_standard_org(), labelled(body(), "agent")).await;
+    assert_eq!(status, 403, "{refused}");
+    assert_eq!(refused["error"]["details"]["reason"], REFUSED);
+
+    let granted = token_with_scopes("service_execution_core", &[SCOPE_EXTRACT_AI]);
+    let (status, refused) = post(&harness, &granted, labelled(body(), "agent")).await;
+    assert_eq!(status, 403, "the scope does not lift the label: {refused}");
+    assert_eq!(refused["error"]["details"]["reason"], REFUSED);
+
+    // The same user body without the label is served; an unknown label is ignored.
+    for label in [None, Some("somebody")] {
+        let request = match label {
+            Some(label) => labelled(body(), label),
+            None => body(),
+        };
+        let (status, served) = post(&harness, &user_in_standard_org(), request).await;
+        assert_eq!(status, 200, "{served}");
+        assert_eq!(served["data"]["ai"]["summary"]["status"], "ok");
+    }
+    assert_eq!(
+        model.calls(),
+        2,
+        "only the two served requests reached the model"
+    );
+}
+
+#[tokio::test]
+async fn a_token_that_does_not_verify_never_reaches_the_ai_gate() {
+    let model = ai_model_double::start(model_script).await;
+    let harness = start(&model).await;
+    let (status, _) = post(&harness, "not-a-signed-token", body()).await;
+    assert_eq!(status, 401);
+    assert_eq!(model.calls(), 0);
+}
diff --git a/apps/Ingestion Plane/Quarry-v2/crates/quarry-edge/tests/answer_provider_status.rs b/apps/Ingestion Plane/Quarry-v2/crates/quarry-edge/tests/answer_provider_status.rs
new file mode 100644
index 000000000..d164dcb5d
--- /dev/null
+++ b/apps/Ingestion Plane/Quarry-v2/crates/quarry-edge/tests/answer_provider_status.rs	
@@ -0,0 +1,705 @@
+//! INNH-8a: answer synthesis says why it is unavailable.
+//!
+//! `POST /v1/answer`, `POST /v1/answer/stream` and `include_answer` on `POST /v1/search`, through
+//! the real router. Four things are pinned:
+//!
+//! - a pipeline that is not wired answers 501 with the FIRST closed gate as `reason` and a hint
+//!   that names the switch, and `include_answer` names the same reason as `answer_reason`
+//!   instead of a silent `answer: null`;
+//! - a pipeline that is wired but whose Model Plane call is refused is a 503 with
+//!   `model_plane_auth_refused` (never a 403 on the caller), whether Auth Core refused the mint or
+//!   the gateway answered 403, and a Model Plane that fails keeps its 502 and gains a reason;
+//! - `include_answer` is metered like `/v1/answer` (one `quarry.answer.synth`, never on a cache
+//!   hit, a refusal, a failure or a ZDR request) and is skipped under ZDR with no model call;
+//! - a failed synthesis is never cached (needs Redis; skipped without one, like
+//!   `tests/cache_policy.rs`, unless `REQUIRE_CONTRACT` is set).
+//!
+//! The model is a wiremock double of the gateway's `POST /v1/invoke`; the edge runs on the auth
+//! dev bypass. Result pages are unreachable on purpose: the pipeline falls back to the search
+//! snippet, which is enough to make a source.
+
+use std::net::SocketAddr;
+use std::sync::atomic::{AtomicUsize, Ordering};
+use std::sync::{Arc, Mutex, Once};
+use std::time::Duration;
+
+use async_trait::async_trait;
+use quarry_core::error::{ErrorCode, QuarryError};
+use quarry_core::output::DriverKind;
+use quarry_core::QuarryResult;
+use quarry_edge::answer_status::AnswerPipelineStatus;
+use quarry_edge::state::AppState;
+use quarry_runtime::answer::{AnswerPipeline, SimpleHttpMarkdownFetcher};
+use quarry_runtime::driver::Driver;
+use quarry_runtime::fetch::FetchResponse;
+use quarry_runtime::mp_client::ModelPlaneClient;
+use quarry_runtime::serp::{SearchOptions, SearchProvider, SearchResult};
+use quarry_runtime::service_tokens::{ServiceBearer, ServiceTokenProvider, ServiceTokenRequest};
+use quarry_runtime::{usage_metrics, EventSink, UsageEvent, UsageMeter};
+use serde_json::{json, Value};
+use tokio::sync::mpsc;
+use url::Url;
+use wiremock::matchers::{method, path};
+use wiremock::{Mock, MockServer, ResponseTemplate};
+
+mod support;
+
+const BEARER: &str = "answer-status-dev-token";
+const PROVIDER_TEXT: &str = "gateway text that must not reach the caller";
+
+fn init() {
+    static ONCE: Once = Once::new();
+    ONCE.call_once(|| {
+        std::env::set_var("QUARRY_EDGE_AUTH_DEV_BYPASS", "1");
+    });
+}
+
+// ---- doubles --------------------------------------------------------------
+
+/// A SERP double. Two results with snippets, or none; counts its calls.
+struct FakeSearch {
+    calls: AtomicUsize,
+    empty: bool,
+}
+
+impl FakeSearch {
+    fn new(empty: bool) -> Arc<Self> {
+        Arc::new(Self {
+            calls: AtomicUsize::new(0),
+            empty,
+        })
+    }
+
+    fn calls(&self) -> usize {
+        self.calls.load(Ordering::SeqCst)
+    }
+}
+
+#[async_trait]
+impl SearchProvider for FakeSearch {
+    async fn search(&self, _query: &str, _opts: &SearchOptions) -> QuarryResult<Vec<SearchResult>> {
+        self.calls.fetch_add(1, Ordering::SeqCst);
+        if self.empty {
+            return Ok(Vec::new());
+        }
+        // Port 9 refuses the connection, so the page fetch fails fast and the snippet stands in.
+        Ok((1..=2)
+            .map(|rank| SearchResult {
+                url: format!("http://127.0.0.1:9/page-{rank}"),
+                title: Some(format!("Page {rank}")),
+                snippet: Some(
+                    "Oslo is the capital of Norway and its largest city, with about 700000 people."
+                        .into(),
+                ),
+                rank,
+                provider: "fake".into(),
+                ..Default::default()
+            })
+            .collect())
+    }
+
+    fn name(&self) -> &str {
+        "fake"
+    }
+}
+
+#[derive(Default)]
+struct RecordingMeter {
+    events: Mutex<Vec<UsageEvent>>,
+}
+
+#[async_trait]
+impl UsageMeter for RecordingMeter {
+    async fn meter(&self, event: UsageEvent) {
+        self.events.lock().unwrap().push(event);
+    }
+}
+
+/// The edge never fetches a page through its own driver on these routes.
+struct NoPageDriver;
+
+#[async_trait]
+impl Driver for NoPageDriver {
+    fn kind(&self) -> DriverKind {
+        DriverKind::Static
+    }
+
+    async fn fetch(&self, _url: &Url) -> QuarryResult<FetchResponse> {
+        Err(QuarryError::new(
+            ErrorCode::DriverFailed,
+            "no page fetches here",
+        ))
+    }
+}
+
+/// Auth Core refusing to mint the edge's Model Plane token (the registry has no grant yet).
+struct RefusingMint;
+
+#[async_trait]
+impl ServiceTokenProvider for RefusingMint {
+    async fn token_for_org(
+        &self,
+        _org_id: &str,
+        _request: &ServiceTokenRequest,
+        _force_refresh: bool,
+    ) -> QuarryResult<ServiceBearer> {
+        Err(QuarryError::new(
+            ErrorCode::Forbidden,
+            format!("Auth Core service-token request returned 403 ({PROVIDER_TEXT})"),
+        ))
+    }
+
+    async fn invalidate(&self, _org_id: &str, _request: &ServiceTokenRequest) {}
+}
+
+// ---- the edge -------------------------------------------------------------
+
+#[derive(Clone, Copy)]
+enum Mp {
+    /// The gateway answers the invoke call.
+    Answers,
+    /// The gateway answers with this status.
+    Status(u16),
+    /// Auth Core refuses the mint, so no call is made.
+    MintRefused,
+}
+
+enum Mode {
+    /// No pipeline; the boot status says which gate is closed.
+    Closed(AnswerPipelineStatus),
+    /// A wired pipeline over a model double.
+    Wired {
+        mp: Mp,
+        pipeline_sees_no_sources: bool,
+    },
+}
+
+struct Edge {
+    addr: SocketAddr,
+    usage: Arc<RecordingMeter>,
+    route_search: Arc<FakeSearch>,
+    pipeline_search: Arc<FakeSearch>,
+    mp: MockServer,
+}
+
+impl Edge {
+    async fn start(mode: Mode) -> Self {
+        Self::start_with_redis(mode, None).await
+    }
+
+    async fn start_with_redis(mode: Mode, redis: Option<redis::aio::ConnectionManager>) -> Self {
+        init();
+        let mp = MockServer::start().await;
+        let route_search = FakeSearch::new(false);
+        let (answer_pipeline, answer_status, pipeline_search) = match mode {
+            Mode::Closed(status) => (None, status, FakeSearch::new(false)),
+            Mode::Wired {
+                mp: behaviour,
+                pipeline_sees_no_sources,
+            } => {
+                match behaviour {
+                    Mp::Answers => mount_answer(&mp).await,
+                    Mp::Status(code) => {
+                        Mock::given(method("POST"))
+                            .and(path("/v1/invoke"))
+                            .respond_with(
+                                ResponseTemplate::new(code).set_body_string(PROVIDER_TEXT),
+                            )
+                            .mount(&mp)
+                            .await
+                    }
+                    Mp::MintRefused => {}
+                }
+                let mut client = ModelPlaneClient::new(&mp.uri()).expect("model plane client");
+                client = match behaviour {
+                    Mp::MintRefused => client.with_token_provider(Arc::new(RefusingMint)),
+                    _ => client.with_bearer_token("model-dev-token"),
+                };
+                let pipeline_search = FakeSearch::new(pipeline_sees_no_sources);
+                let pipeline = AnswerPipeline::new(
+                    pipeline_search.clone(),
+                    Arc::new(SimpleHttpMarkdownFetcher::new()),
+                    quarry_runtime::ai_formats::AiFormatRunner::new(Arc::new(client)),
+                );
+                (
+                    Some(Arc::new(pipeline)),
+                    AnswerPipelineStatus::Ready,
+                    pipeline_search,
+                )
+            }
+        };
+        let usage = Arc::new(RecordingMeter::default());
+        let (tx, mut rx) = mpsc::channel(256);
+        tokio::spawn(async move { while rx.recv().await.is_some() {} });
+        let state = AppState {
+            search: Some(route_search.clone()),
+            usage: usage.clone(),
+            answer_pipeline,
+            answer_status,
+            redis,
+            #[cfg(feature = "browser-agent")]
+            agent_driver: support::governed_agent_driver(),
+            ..support::base_state(Arc::new(NoPageDriver), EventSink::new(tx))
+        };
+        let app = quarry_edge::routes::router(state);
+        let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let addr = listener.local_addr().unwrap();
+        tokio::spawn(async move {
+            axum::serve(listener, app).await.unwrap();
+        });
+        Self {
+            addr,
+            usage,
+            route_search,
+            pipeline_search,
+            mp,
+        }
+    }
+
+    async fn post(&self, route: &str, body: Value) -> (u16, Value) {
+        let response = reqwest::Client::new()
+            .post(format!("http://{}{route}", self.addr))
+            .bearer_auth(BEARER)
+            .json(&body)
+            .send()
+            .await
+            .expect("request reaches the edge");
+        let status = response.status().as_u16();
+        let text = response.text().await.unwrap();
+        (
+            status,
+            serde_json::from_str(&text).unwrap_or(Value::String(text)),
+        )
+    }
+
+    fn metered(&self, metric: &str) -> Vec<UsageEvent> {
+        self.usage
+            .events
+            .lock()
+            .unwrap()
+            .iter()
+            .filter(|event| event.metric == metric)
+            .cloned()
+            .collect()
+    }
+
+    async fn model_calls(&self) -> usize {
+        self.mp.received_requests().await.unwrap_or_default().len()
+    }
+}
