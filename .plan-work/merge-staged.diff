+/// `on`, `1` or `true` (any case) turn a flag on. Anything else, including a typo, is off.
+fn flag_is_on(value: Option<String>) -> bool {
+    matches!(
+        value.as_deref().map(|v| v.trim().to_ascii_lowercase()).as_deref(),
+        Some("on" | "1" | "true")
+    )
+}
