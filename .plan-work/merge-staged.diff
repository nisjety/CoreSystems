+	_, _, routed, _ := stores(pool)
+	if n, err := routed.RevokeByKey(ctx, "key_durable", KeyRevokedReason); err != nil || n != 1 {
+		t.Fatalf("a fresh Routed (empty memory) revoked %d, %v; want the 1 durable grant", n, err)
+	}
