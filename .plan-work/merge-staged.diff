+            // Another key of the same owner.
+            key_grant("g-key2", |f| {
+                f.insert("key_id".into(), json!("key-2"));
+            }),
+            // A person's grant: the owner, no key.
+            key_grant("g-person", |f| {
+                f.remove("key_id");
+            }),
+            // Another owner's grant for a key of the same id (a swapped owner).
+            key_grant("g-owner", |f| {
