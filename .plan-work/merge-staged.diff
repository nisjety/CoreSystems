diff --git a/apps/Ingestion Plane/Quarry-v2/services/quarry-orchestrator/internal/activities/crawl_sitemap.go b/apps/Ingestion Plane/Quarry-v2/services/quarry-orchestrator/internal/activities/crawl_sitemap.go
