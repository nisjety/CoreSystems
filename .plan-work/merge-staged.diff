+        assert_eq!(out.urls, vec!["https://e.test/ok"]);
+        assert_eq!(out.skipped.robots_disallowed, 1);
+        let none = select(&scope, &url("https://e.test/"), &locs, None, 10);
+        assert_eq!(none.urls.len(), 2, "no lookup: robots is not consulted");
+    }
