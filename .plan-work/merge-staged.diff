+    impl FixedUsagePlanner {
+        fn new(tokens: u32) -> Self {
+            Self {
+                tokens,
+                calls: std::sync::atomic::AtomicU32::new(0),
+            }
+        }
+
+        fn calls(&self) -> u32 {
+            self.calls.load(std::sync::atomic::Ordering::SeqCst)
