+    assert_eq!(refused.summary, "browser-agent attach failed: 409 CONFLICT (attach_exists)");
+    assert!(quarry.releases().is_empty());
+    assert!(quarry.step_requests().is_empty());
+    assert!(quarry.start_requests().is_empty());
