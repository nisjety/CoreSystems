+        let a = hash(json_with(json!({ "type": "object", "properties": { "x": { "type": "string" }, "y": { "type": "integer" } } })));
+        let reordered = hash(json_with(json!({ "properties": { "y": { "type": "integer" }, "x": { "type": "string" } }, "type": "object" })));
+        assert_eq!(a, reordered);
