+// maxKeyIDBytes bounds a key id (Auth Core's Better Auth key id).
+const maxKeyIDBytes = 128
+
+// ValidKeyID reports a bounded, printable (0x21-0x7e) key id.
+func ValidKeyID(id string) bool {
+	if id == "" || len(id) > maxKeyIDBytes {
