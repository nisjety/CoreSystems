+        Some(&planner as &dyn ActionPlanner),
+        None,
+        None,
+    )
+    .await;
+
+    assert_eq!(
+        result.resource_limit,
+        Some(BrowserResourceLimit::QuarryBudget(BudgetDimension::Steps))
