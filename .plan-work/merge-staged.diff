+func newSubServer(t *testing.T, maxPerOrg int) (http.Handler, store.DB) {
+	t.Helper()
+	db := store.NewMemory()
+	r := chi.NewRouter()
+	r.Use(httpx.RequestID)
+	MountWebhookSubscriptions(r, db, WebhookSubscriptionOptions{Vet: testGuardVetter(), MaxPerOrg: maxPerOrg})
+	return r, db
