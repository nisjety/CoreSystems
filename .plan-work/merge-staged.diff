+        Some(&planner as &dyn ActionPlanner),
+        None,
+        None,
+    )
+    .await;
+    assert_ne!(plan_error.status, PlanStatus::Completed, "{}", plan_error.summary);
+    assert_eq!(release(&quarry), ["abort"]);
