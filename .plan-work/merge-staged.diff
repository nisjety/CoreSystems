+            web_policy: None,
+            sub: "user_1".into(),
+            iss: "auth-core".into(),
+            exp: i64::MAX,
+            org_id: "org_a".into(),
+            user_id: "user_1".into(),
+            principal_type: Some("user".into()),
+            service_id: None,
+            nbf: None,
+            aud: None,
+            scopes: Vec::new(),
+            zdr,
+            key_id: None,
+            acting_user_id: None,
+        }
+    }
+
+    fn service() -> Claims {
+        Claims {
+            principal_type: Some("service".into()),
+            service_id: Some("service:model-gateway".into()),
+            sub: "service:model-gateway".into(),
+            user_id: "service:model-gateway".into(),
+            ..user(None)
