+        assert!(is_an_edge_setting("QUARRY_EDGE__MODEL_PLANE_TOKEN"));
+        assert!(!is_an_edge_setting("QUARRY_EDGE__EXTRACT_SCHEMA_ENABLED"));
+        assert_eq!(
+            env_names_in("set QUARRY_EDGE__MODEL_PLANE_URL, then QUARRY_EDGE__NOPE_ ."),
