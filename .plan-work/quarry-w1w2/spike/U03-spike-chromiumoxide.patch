+    // ---- WS8.A spike (throwaway, scratch worktree only, never merged) ----
+    // Each test prints one `SPIKE ...` line on stderr. They are ignored and
+    // gated on CHROMIUMOXIDE_TEST=1 (live_enabled). They assert nothing about
+    // the target design: the spike measures what the driver does today.
+
+    async fn spike_active_tab(driver: &ChromiumoxideDriver, session: &BrowserSession) -> Option<String> {
+        driver
+            .list_tabs(session)
+            .await
+            .expect("list tabs")
+            .into_iter()
+            .find(|tab| tab.active)
+            .map(|tab| tab.tab_id)
+    }
+
+    async fn spike_tab_page(driver: &ChromiumoxideDriver, session: &BrowserSession, tab_id: &str) -> Page {
+        let key = ChromiumoxideDriver::session_key(session);
+        let pages = driver.pages.lock().await;
+        pages
+            .get(&key)
+            .and_then(|session_pages| session_pages.tabs.iter().find(|tab| tab.tab_id == tab_id))
+            .map(|tab| tab.page.clone())
+            .expect("tab page")
+    }
+
+    /// Opening a second tab: does the active tab move? Expected today: yes,
+    /// because open_tab_page sets active_tab_id to the new tab.
+    #[tokio::test]
+    #[ignore = "WS8.A spike: needs Chromium; prints whether new_tab moves the active tab"]
+    async fn background_tab_does_not_change_active_tab() {
+        if !live_enabled() {
+            return;
+        }
+        let driver = live_driver();
+        let session = live_session(&driver, "spike-background-active").await;
+        let first = driver.new_tab(&session, None).await.expect("first tab");
+        let before = spike_active_tab(&driver, &session).await;
+        let second = driver.new_tab(&session, None).await.expect("second tab");
+        let after = spike_active_tab(&driver, &session).await;
+        eprintln!(
+            "SPIKE background_tab first={} second={} active_before={before:?} active_after={after:?} active_changed={}",
+            first.tab_id,
+            second.tab_id,
+            before != after
+        );
+        driver.release(session).await.expect("release");
+    }
+
+    /// Pin approximation with today's API: the only tab addressing is
+    /// select_tab, so a "pinned" tab is reachable only by making it active.
+    #[tokio::test]
+    #[ignore = "WS8.A spike: needs Chromium; shows actions reach only the active tab"]
+    async fn pinned_session_acts_on_pinned_tab_while_other_tab_is_active() {
+        if !live_enabled() {
+            return;
+        }
+        let driver = live_driver();
+        let session = live_session(&driver, "spike-pinned-tab").await;
+        let pinned = driver.new_tab(&session, None).await.expect("pinned tab");
+        let other = driver.new_tab(&session, None).await.expect("other tab");
+        driver
+            .select_tab(&session, &pinned.tab_id)
+            .await
+            .expect("select pinned");
+        let page = spike_tab_page(&driver, &session, &pinned.tab_id).await;
+        page.set_content("<html><body><p id=\"pin\">pinned</p></body></html>")
+            .await
+            .expect("inject pinned marker");
+        driver
+            .select_tab(&session, &other.tab_id)
+            .await
+            .expect("select other");
+        let active = spike_active_tab(&driver, &session).await;
+        let marker = eval_string(
+            &driver,
+            &session,
+            "document.getElementById('pin') ? 'pinned' : 'other'",
+        )
+        .await;
+        eprintln!(
+            "SPIKE pinned_tab active={active:?} other={} active_page_marker={marker} reaches_pinned_without_select={}",
+            other.tab_id,
+            marker == "pinned"
+        );
+        driver.release(session).await.expect("release");
+    }
