+    /// Per-tab policy: configure_egress_policy takes a session only, and the
+    /// network guard reads the policy by session key. Records tab count and
+    /// the API shape; the F3 block count is measured in the stack lane, not here.
+    #[tokio::test]
+    #[ignore = "WS8.A spike: needs Chromium; records that the egress policy is session-scoped"]
+    async fn per_tab_policy_blocks_in_agent_tab_only() {
+        if !live_enabled() {
+            return;
+        }
+        let driver = live_driver();
+        let session = live_session(&driver, "spike-per-tab-policy").await;
+        let agent_tab = driver.new_tab(&session, None).await.expect("agent tab");
+        let human_tab = driver.new_tab(&session, None).await.expect("human tab");
+        let tabs = driver.list_tabs(&session).await.expect("list tabs").len();
+        eprintln!(
+            "SPIKE per_tab_policy api_scope=session tabs={tabs} agent_tab={} human_tab={} per_tab_policy_expressible=false",
+            agent_tab.tab_id, human_tab.tab_id
+        );
+        driver.release(session).await.expect("release");
+    }
