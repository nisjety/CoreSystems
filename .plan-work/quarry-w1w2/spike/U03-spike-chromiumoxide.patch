+    /// Background throttling: a non-active tab, counting timer ticks for two
+    /// seconds. Unthrottled is roughly 20 ticks at 100 ms.
+    #[tokio::test]
+    #[ignore = "WS8.A spike: needs Chromium; counts timer ticks in a background tab"]
+    async fn background_tab_is_not_throttled() {
+        if !live_enabled() {
+            return;
+        }
+        let driver = live_driver();
+        let session = live_session(&driver, "spike-background-throttle").await;
+        let background = driver.new_tab(&session, None).await.expect("background tab");
+        let _foreground = driver.new_tab(&session, None).await.expect("foreground tab");
+        let page = spike_tab_page(&driver, &session, &background.tab_id).await;
+        page.set_content(
+            "<html><body><script>window.__ticks = 0; setInterval(function () { window.__ticks++; }, 100);</script></body></html>",
+        )
+        .await
+        .expect("inject ticker");
+        tokio::time::sleep(Duration::from_secs(2)).await;
+        let visibility = page
+            .evaluate("document.visibilityState")
+            .await
+            .expect("visibility")
+            .into_value::<String>()
+            .expect("visibility string");
+        let ticks = page
+            .evaluate("window.__ticks")
+            .await
+            .expect("ticks")
+            .into_value::<i64>()
+            .expect("tick number");
+        eprintln!("SPIKE background_throttle visibility={visibility} ticks_in_2s={ticks} unthrottled_expected_about=20");
+        driver.release(session).await.expect("release");
+    }
