# Evidence-only flag file for qv2e-edge. Baseline = the committed compose defaults of
# apps/Ingestion Plane/docker-compose.yml at quarryv2-next. Every change made during the
# session is logged in flags-log.md with the time it was made and the time it was reverted.
ENVIRONMENT=dev
QUARRY_EDGE_AUTH_DEV_BYPASS=1
QUARRY_EDGE__CROSS_PLANE_AUTH_DEV_BYPASS=0
QUARRY_EDGE__DRAIN_DEADLINE_S=30
QUARRY_EDGE__SCRAPE_REQUEST_VALIDATION=lenient
QUARRY_EDGE__SCRAPE_INLINE_MAX_BYTES=1048576
QUARRY_EDGE__SCRAPE_OPTIONS_ENABLED=1
QUARRY_EDGE__SCRAPE_CAPTURE=off
QUARRY_EDGE__SCRAPE_ACTIONS=off
QUARRY_EDGE__CRAWL_ROBOTS=observe
QUARRY_EDGE__ROBOTS_UNREACHABLE=disallow
QUARRY_EDGE__SCRAPE_CAPTURE_INLINE_MAX_BYTES=6291456
QUARRY_BROWSER_SETTLE_MS=3500
QUARRY_SCRAPE_HEAVY_PERMITS=1
QUARRY_BROWSER_NO_SANDBOX=0
QUARRY_EDGE__ARTIFACT_BACKEND=memory
QUARRY_EDGE__MODEL_PLANE_URL=
QUARRY_EDGE__AUTOPROMPT=0
QUARRY_EDGE__SEMANTIC_RERANK=0
QUARRY_EDGE__LLM_CLASSIFY_INTENT=0
QUARRY_EDGE__PAGE_TITLE_ENRICH=0
QUARRY_EDGE__ZERO_SAAS_SEARCH=1
QUARRY_EDGE__BUDGET_ENFORCEMENT=shadow
QUARRY_EDGE__POOL_ORG_MAX_PERMITS=0
QUARRY_EDGE__CACHE_TTL_SECS=300
QUARRY_EDGE__FETCH_TIMEOUT_S=30
QUARRY_EDGE__CANARY_PCT=100
QUARRY_EDGE__PROFILE_ENCRYPTION=off
QUARRY_EDGE__PROFILE_OWNER_ENFORCE=observe
QUARRY_EDGE__BROWSER_GRANT_VALIDATOR_GRPC_URL=
