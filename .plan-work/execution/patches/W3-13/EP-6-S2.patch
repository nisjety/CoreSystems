+		writeTypedError(w, http.StatusInternalServerError, "run_now_unavailable", "the schedule could not be run now")
+		return
+	}
+	if refusal != nil {
+		writeTypedError(w, refusal.HTTPStatus, refusal.Code, refusal.Message)
+		return
+	}
