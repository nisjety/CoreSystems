+        for bad in ["", ".", "..", "cron_1/fires", "cron_1?creator=x", "cron 1", "cron_1#x"] {
+            let (status, _) = cron_run_path(bad).unwrap_err();
+            assert_eq!(status, axum::http::StatusCode::BAD_REQUEST, "{bad:?}");
