+            tool_name: name.to_owned(),
+            capability_id: "cap.mcp_tool.abc".to_owned(),
+            capability_version: "v1".to_owned(),
+            side_effect_class: class.to_owned(),
+            approval_floor: floor.to_owned(),
+            tool_digest: "d".repeat(64),
