diff --git a/apps/Control Plane/org-core/internal/retention/repository.go b/apps/Control Plane/org-core/internal/retention/repository.go
new file mode 100644
index 000000000..82e207551
--- /dev/null
+++ b/apps/Control Plane/org-core/internal/retention/repository.go	
@@ -0,0 +1,492 @@
+package retention
+
+import (
+	"context"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"time"
+
+	"github.com/I-Dacosta/AquatiqCMS/apps/org-core/internal/database"
+	"github.com/jackc/pgx/v5"
+	"github.com/jackc/pgx/v5/pgconn"
+)
+
+// Repository stores the policy, the holds, their history and the audit intent.
+// Every write and read runs inside WithOrgScope, so the row-level security of
+// migration 031 is a second tenant filter behind the org_id predicates; only the
+// outbox publisher runs on the owner pool, as the other org-core outboxes do.
+type Repository struct {
+	db *database.DB
+}
+
+func NewRepository(db *database.DB) *Repository {
+	return &Repository{db: db}
+}
+
+// postgresForeignKeyViolation is SQLSTATE 23503.
+const postgresForeignKeyViolation = "23503"
+
+func (r *Repository) ready() error {
+	if r == nil || r.db == nil {
+		return errors.New("retention repository not configured")
+	}
+	return nil
+}
+
+// GetPolicy returns the organisation's policy; revision 0 and keep when none was
+// ever written.
+func (r *Repository) GetPolicy(ctx context.Context, orgID string) (*Policy, error) {
+	if err := r.ready(); err != nil {
+		return nil, err
+	}
+	var policy *Policy
+	err := r.db.WithOrgScope(ctx, orgID, func(tx pgx.Tx) error {
+		loaded, err := loadPolicy(ctx, tx, orgID, false)
+		policy = loaded
+		return err
+	})
+	if err != nil {
+		return nil, err
+	}
+	return policy, nil
+}
+
+// loadPolicy reads the policy row, FOR UPDATE when a writer is about to replace it,
+// so two writers with one expected revision cannot both win.
+func loadPolicy(ctx context.Context, tx pgx.Tx, orgID string, forUpdate bool) (*Policy, error) {
+	query := `SELECT thread_days, revision, updated_by, updated_at FROM org_retention_policies WHERE org_id = $1`
+	if forUpdate {
+		query += ` FOR UPDATE`
+	}
+	policy := &Policy{OrganizationID: orgID}
+	var updatedAt time.Time
+	err := tx.QueryRow(ctx, query, orgID).Scan(&policy.ThreadDays, &policy.Revision, &policy.UpdatedBy, &updatedAt)
+	if errors.Is(err, pgx.ErrNoRows) {
+		return &Policy{OrganizationID: orgID}, nil
+	}
+	if err != nil {
+		return nil, fmt.Errorf("read retention policy: %w", err)
+	}
+	policy.UpdatedAt = &updatedAt
+	return policy, nil
+}
+
+// PutPolicy replaces the window if expectedRevision is still current, and records
+// the history row and the audit intent in the same transaction.
+func (r *Repository) PutPolicy(ctx context.Context, orgID string, actor Actor, expectedRevision int64, threadDays *int) (*Policy, error) {
+	if err := r.ready(); err != nil {
+		return nil, err
+	}
+	var saved *Policy
+	err := r.db.WithOrgScope(ctx, orgID, func(tx pgx.Tx) error {
+		before, err := loadPolicy(ctx, tx, orgID, true)
+		if err != nil {
+			return err
+		}
+		if before.Revision != expectedRevision {
+			return &RevisionConflictError{Current: before.Revision}
+		}
+		next := before.Revision + 1
+		if before.Revision == 0 {
+			tag, err := tx.Exec(ctx, `
+INSERT INTO org_retention_policies (org_id, thread_days, revision, updated_by)
+VALUES ($1, $2, $3, $4)
+ON CONFLICT (org_id) DO NOTHING`, orgID, threadDays, next, actor.ID)
+			if err != nil {
+				return mapWriteError(err)
+			}
+			if tag.RowsAffected() == 0 {
+				// Another first write committed between the read and this insert.
+				latest, readErr := loadPolicy(ctx, tx, orgID, true)
+				if readErr != nil {
+					return readErr
+				}
+				return &RevisionConflictError{Current: latest.Revision}
+			}
+		} else if _, err := tx.Exec(ctx, `
+UPDATE org_retention_policies
+SET thread_days = $2, revision = $3, updated_by = $4, updated_at = NOW()
+WHERE org_id = $1`, orgID, threadDays, next, actor.ID); err != nil {
+			return mapWriteError(err)
+		}
+
+		after, err := loadPolicy(ctx, tx, orgID, false)
+		if err != nil {
+			return err
+		}
+		if err := insertHistory(ctx, tx, orgID, "policy", &next, nil, actor.ID,
+			map[string]any{"thread_days": before.ThreadDays},
+			map[string]any{"thread_days": after.ThreadDays}); err != nil {
+			return err
+		}
+		eventID := fmt.Sprintf("retention:org-core:policy:%s:%d", orgDigest(orgID), next)
+		if err := enqueueAudit(ctx, tx, eventID, orgID, actor, "retention_policy:"+orgID, orgID, map[string]any{
+			"action": "policy_set", "revision": next,
+			"thread_days_before": before.ThreadDays, "thread_days": after.ThreadDays,
+		}); err != nil {
+			return err
+		}
+		saved = after
+		return nil
+	})
+	if err != nil {
+		return nil, err
+	}
+	return saved, nil
+}
+
+const holdColumns = `id, org_id, scope, target_ref, hold_ref, created_by, created_at, released_by, released_at`
+
+func scanHold(row pgx.Row) (Hold, error) {
+	var hold Hold
+	err := row.Scan(&hold.ID, &hold.OrganizationID, &hold.Scope, &hold.TargetRef, &hold.HoldRef,
+		&hold.CreatedBy, &hold.CreatedAt, &hold.ReleasedBy, &hold.ReleasedAt)
+	return hold, err
+}
+
+// ListHolds returns every active hold, then the most recent released ones, newest
+// first within each, up to MaxListedHolds rows.
+func (r *Repository) ListHolds(ctx context.Context, orgID string) ([]Hold, error) {
+	if err := r.ready(); err != nil {
+		return nil, err
+	}
+	holds := []Hold{}
+	err := r.db.WithOrgScope(ctx, orgID, func(tx pgx.Tx) error {
+		rows, err := tx.Query(ctx, `
+SELECT `+holdColumns+`
+FROM org_legal_holds
+WHERE org_id = $1
+ORDER BY (released_at IS NULL) DESC, created_at DESC, id
+LIMIT $2`, orgID, MaxListedHolds)
+		if err != nil {
+			return fmt.Errorf("read legal holds: %w", err)
+		}
+		defer rows.Close()
+		for rows.Next() {
+			hold, err := scanHold(rows)
+			if err != nil {
+				return fmt.Errorf("scan legal hold: %w", err)
+			}
+			holds = append(holds, hold)
+		}
+		return rows.Err()
+	})
+	if err != nil {
+		return nil, err
+	}
+	return holds, nil
+}
+
+// PlaceHold inserts hold unless its target is already held, in which case the
+// active hold is returned with Existed set and nothing is written. The partial
+// unique index decides a race between two placers.
+func (r *Repository) PlaceHold(ctx context.Context, orgID string, actor Actor, hold Hold) (PlaceResult, error) {
+	if err := r.ready(); err != nil {
+		return PlaceResult{}, err
+	}
+	var result PlaceResult
+	err := r.db.WithOrgScope(ctx, orgID, func(tx pgx.Tx) error {
+		placed, err := scanHold(tx.QueryRow(ctx, `
+INSERT INTO org_legal_holds (id, org_id, scope, target_ref, hold_ref, created_by)
+VALUES ($1, $2, $3, $4, $5, $6)
+ON CONFLICT (org_id, scope, target_ref) WHERE released_at IS NULL DO NOTHING
+RETURNING `+holdColumns, hold.ID, orgID, hold.Scope, hold.TargetRef, hold.HoldRef, actor.ID))
+		if errors.Is(err, pgx.ErrNoRows) {
+			existing, readErr := scanHold(tx.QueryRow(ctx, `
+SELECT `+holdColumns+`
+FROM org_legal_holds
+WHERE org_id = $1 AND scope = $2 AND target_ref = $3 AND released_at IS NULL`, orgID, hold.Scope, hold.TargetRef))
+			if readErr != nil {
+				return fmt.Errorf("read active legal hold: %w", readErr)
+			}
+			result = PlaceResult{Hold: existing, Existed: true}
+			return nil
+		}
+		if err != nil {
+			return mapWriteError(err)
+		}
+		if err := insertHistory(ctx, tx, orgID, "hold_placed", nil, &placed.ID, actor.ID,
+			map[string]any{},
+			map[string]any{"scope": placed.Scope, "target_ref": placed.TargetRef, "hold_ref": placed.HoldRef}); err != nil {
+			return err
+		}
+		if err := enqueueAudit(ctx, tx, "retention:org-core:"+placed.ID+":placed", orgID, actor, "legal_hold:"+placed.ID, placed.ID, map[string]any{
+			"action": "hold_placed", "hold_id": placed.ID, "scope": placed.Scope, "target_ref": placed.TargetRef,
+		}); err != nil {
+			return err
+		}
+		result = PlaceResult{Hold: placed}
+		return nil
+	})
+	if err != nil {
+		return PlaceResult{}, err
+	}
+	return result, nil
+}
+
+// ReleaseHold sets the release columns of one active hold. A hold that was already
+// released is ErrHoldAlreadyReleased, an unknown one ErrHoldNotFound.
+func (r *Repository) ReleaseHold(ctx context.Context, orgID, holdID string, actor Actor) (Hold, error) {
+	if err := r.ready(); err != nil {
+		return Hold{}, err
+	}
+	var released Hold
+	err := r.db.WithOrgScope(ctx, orgID, func(tx pgx.Tx) error {
+		hold, err := scanHold(tx.QueryRow(ctx, `
+UPDATE org_legal_holds
+SET released_by = $3, released_at = NOW()
+WHERE org_id = $1 AND id = $2 AND released_at IS NULL
+RETURNING `+holdColumns, orgID, holdID, actor.ID))
+		if errors.Is(err, pgx.ErrNoRows) {
+			var exists bool
+			if err := tx.QueryRow(ctx, `SELECT EXISTS (SELECT 1 FROM org_legal_holds WHERE org_id = $1 AND id = $2)`, orgID, holdID).Scan(&exists); err != nil {
+				return fmt.Errorf("read legal hold: %w", err)
+			}
+			if exists {
+				return ErrHoldAlreadyReleased
+			}
+			return ErrHoldNotFound
+		}
+		if err != nil {
+			return fmt.Errorf("release legal hold: %w", err)
+		}
+		if err := insertHistory(ctx, tx, orgID, "hold_released", nil, &hold.ID, actor.ID,
+			map[string]any{"released": false},
+			map[string]any{"released": true, "scope": hold.Scope, "target_ref": hold.TargetRef}); err != nil {
+			return err
+		}
+		if err := enqueueAudit(ctx, tx, "retention:org-core:"+hold.ID+":released", orgID, actor, "legal_hold:"+hold.ID, hold.ID, map[string]any{
+			"action": "hold_released", "hold_id": hold.ID, "scope": hold.Scope, "target_ref": hold.TargetRef,
+		}); err != nil {
+			return err
+		}
+		released = hold
+		return nil
+	})
+	if err != nil {
+		return Hold{}, err
+	}
+	return released, nil
+}
+
+// Check reads the window, the revision and the active holds that touch threadIDs
+// in one transaction, so a hold placed in between cannot be missed against a
+// policy read before it. A missing or soft-deleted organisation is
+// ErrOrganizationNotFound: the sweeper must find no candidates there, never
+// "no hold".
+func (r *Repository) Check(ctx context.Context, orgID string, threadIDs []string) (CheckResult, error) {
+	if err := r.ready(); err != nil {
+		return CheckResult{}, err
+	}
+	result := CheckResult{OrganizationID: orgID, HeldThreadIDs: []string{}}
+	err := r.db.WithOrgScope(ctx, orgID, func(tx pgx.Tx) error {
+		var live bool
+		if err := tx.QueryRow(ctx, `SELECT EXISTS (SELECT 1 FROM organizations WHERE id = $1 AND deleted_at IS NULL)`, orgID).Scan(&live); err != nil {
+			return fmt.Errorf("read organization: %w", err)
+		}
+		if !live {
+			return ErrOrganizationNotFound
+		}
+		policy, err := loadPolicy(ctx, tx, orgID, false)
+		if err != nil {
+			return err
+		}
+		result.WindowDays = policy.ThreadDays
+		result.Revision = policy.Revision
+		if threadIDs == nil {
+			threadIDs = []string{}
+		}
+		rows, err := tx.Query(ctx, `
+SELECT scope, target_ref
+FROM org_legal_holds
+WHERE org_id = $1 AND released_at IS NULL
+  AND (scope = 'org' OR (scope = 'thread' AND target_ref = ANY($2)))
+ORDER BY target_ref`, orgID, threadIDs)
+		if err != nil {
+			return fmt.Errorf("read active legal holds: %w", err)
+		}
+		defer rows.Close()
+		for rows.Next() {
+			var scope, target string
+			if err := rows.Scan(&scope, &target); err != nil {
+				return fmt.Errorf("scan active legal hold: %w", err)
+			}
+			if scope == ScopeOrg {
+				result.OrgHeld = true
+				continue
+			}
+			result.HeldThreadIDs = append(result.HeldThreadIDs, target)
+		}
+		return rows.Err()
+	})
+	if err != nil {
+		return CheckResult{}, err
+	}
+	return result, nil
+}
+
+func insertHistory(ctx context.Context, tx pgx.Tx, orgID, kind string, revision *int64, holdID *string, actorID string, before, after map[string]any) error {
+	beforeJSON, err := json.Marshal(before)
+	if err != nil {
+		return fmt.Errorf("encode retention history: %w", err)
+	}
+	afterJSON, err := json.Marshal(after)
+	if err != nil {
+		return fmt.Errorf("encode retention history: %w", err)
+	}
+	if _, err := tx.Exec(ctx, `
+INSERT INTO org_retention_history (org_id, change_kind, revision, hold_id, actor_id, before_state, after_state)
+VALUES ($1, $2, $3, $4, $5, $6::jsonb, $7::jsonb)`, orgID, kind, revision, holdID, actorID, string(beforeJSON), string(afterJSON)); err != nil {
+		return fmt.Errorf("record retention history: %w", err)
+	}
+	return nil
+}
+
+// auditPayload is content-free by construction: the window, revision, hold id,
+// scope and target id. The hold reference has no path into it (migration 031
+// refuses a payload that carries one).
+func auditPayload(eventID, orgID string, actor Actor, subject, resourceID string, details map[string]any, occurredAt time.Time) map[string]any {
+	return map[string]any{
+		"event_id": eventID, "occurred_at": occurredAt.UTC().Format(time.RFC3339Nano),
+		"org_id": orgID, "user_id": actor.ID, "actor_role": actor.Role,
+		"plane": "control", "producer": "org-core", "event": AuditEvent,
+		"subject": subject, "resource_id": resourceID, "outcome": "ok",
+		"details": details,
+	}
+}
+
+func enqueueAudit(ctx context.Context, tx pgx.Tx, eventID, orgID string, actor Actor, subject, resourceID string, details map[string]any) error {
+	body, err := json.Marshal(auditPayload(eventID, orgID, actor, subject, resourceID, details, time.Now()))
+	if err != nil {
+		return fmt.Errorf("encode retention audit payload: %w", err)
+	}
+	if _, err := tx.Exec(ctx, `
+INSERT INTO org_retention_audit_outbox (event_id, org_id, subject, payload)
+VALUES ($1, $2, $3, $4)`, eventID, orgID, AuditSubject, body); err != nil {
+		return fmt.Errorf("record retention audit outbox: %w", err)
+	}
+	return nil
+}
+
+// orgDigest keeps a policy event id inside the outbox's 128-character bound
+// whatever the length of the organisation id.
+func orgDigest(orgID string) string {
+	sum := sha256.Sum256([]byte(orgID))
+	return hex.EncodeToString(sum[:12])
+}
+
+// ClaimAudit claims up to limit due rows on the owner pool, as the SIEM outbox does.
+func (r *Repository) ClaimAudit(ctx context.Context, limit int) ([]AuditRow, error) {
+	if err := r.ready(); err != nil {
+		return nil, err
+	}
+	tx, err := r.db.Pool.Begin(ctx)
+	if err != nil {
+		return nil, fmt.Errorf("begin retention audit outbox claim: %w", err)
+	}
+	defer func() { _ = tx.Rollback(ctx) }()
+	rows, err := tx.Query(ctx, `
+WITH claimed AS (
+  SELECT event_id
+  FROM org_retention_audit_outbox
+  WHERE published_at IS NULL
+    AND dead_lettered_at IS NULL
+    AND attempts < $2
+    AND next_attempt_at <= NOW()
+    AND (processing_at IS NULL OR processing_at < NOW() - INTERVAL '1 minute')
+  ORDER BY next_attempt_at, created_at, event_id
+  LIMIT $1
+  FOR UPDATE SKIP LOCKED
+)
+UPDATE org_retention_audit_outbox o
+SET processing_at = NOW(), updated_at = NOW()
+FROM claimed
+WHERE o.event_id = claimed.event_id
+RETURNING o.event_id, o.subject, o.payload`, limit, AuditMaxAttempts)
+	if err != nil {
+		return nil, fmt.Errorf("claim retention audit outbox: %w", err)
+	}
+	defer rows.Close()
+	claimed := make([]AuditRow, 0)
+	for rows.Next() {
+		var row AuditRow
+		var body []byte
+		if err := rows.Scan(&row.EventID, &row.Subject, &body); err != nil {
+			return nil, fmt.Errorf("scan retention audit outbox: %w", err)
+		}
+		if err := json.Unmarshal(body, &row.Payload); err != nil {
+			return nil, fmt.Errorf("decode retention audit outbox payload: %w", err)
+		}
+		claimed = append(claimed, row)
+	}
+	if err := rows.Err(); err != nil {
+		return nil, fmt.Errorf("iterate retention audit outbox: %w", err)
+	}
+	if err := tx.Commit(ctx); err != nil {
+		return nil, fmt.Errorf("commit retention audit outbox claim: %w", err)
+	}
+	return claimed, nil
+}
+
+func (r *Repository) MarkAuditPublished(ctx context.Context, eventID string) error {
+	if err := r.ready(); err != nil {
+		return err
+	}
+	result, err := r.db.Pool.Exec(ctx, `
+UPDATE org_retention_audit_outbox
+SET published_at = NOW(), processing_at = NULL, attempts = attempts + 1,
+    last_error = NULL, updated_at = NOW()
+WHERE event_id = $1 AND published_at IS NULL AND dead_lettered_at IS NULL`, eventID)
+	if err != nil {
+		return fmt.Errorf("mark retention audit published: %w", err)
+	}
+	if result.RowsAffected() != 1 {
+		return errors.New("retention audit acknowledgement did not match a pending event")
+	}
+	return nil
+}
+
+func (r *Repository) MarkAuditFailed(ctx context.Context, eventID string, publishErr error) (bool, error) {
+	if err := r.ready(); err != nil {
+		return false, err
+	}
+	message := "unknown audit publish failure"
+	if publishErr != nil {
+		message = publishErr.Error()
+	}
+	if len(message) > 2048 {
+		message = message[:2048]
+	}
+	var deadLettered bool
+	err := r.db.Pool.QueryRow(ctx, `
+UPDATE org_retention_audit_outbox
+SET attempts = attempts + 1,
+    processing_at = NULL,
+    next_attempt_at = NOW() + LEAST(
+      INTERVAL '5 minutes',
+      INTERVAL '1 second' * power(2, LEAST(attempts, 8))
+    ),
+    dead_lettered_at = CASE WHEN attempts + 1 >= $2 THEN NOW() ELSE NULL END,
+    last_error = $3,
+    updated_at = NOW()
+WHERE event_id = $1 AND published_at IS NULL AND dead_lettered_at IS NULL
+RETURNING dead_lettered_at IS NOT NULL`, eventID, AuditMaxAttempts, message).Scan(&deadLettered)
+	if err != nil {
+		if errors.Is(err, pgx.ErrNoRows) {
+			return false, errors.New("retention audit failure did not match a pending event")
+		}
+		return false, fmt.Errorf("record retention audit publish failure: %w", err)
+	}
+	return deadLettered, nil
+}
+
+func mapWriteError(err error) error {
+	var pgErr *pgconn.PgError
+	if errors.As(err, &pgErr) && pgErr.Code == postgresForeignKeyViolation {
+		return ErrOrganizationNotFound
+	}
+	return fmt.Errorf("write retention record: %w", err)
+}
diff --git a/apps/Control Plane/org-core/internal/retention/repository_postgres_test.go b/apps/Control Plane/org-core/internal/retention/repository_postgres_test.go
new file mode 100644
index 000000000..23194ce6e
--- /dev/null
+++ b/apps/Control Plane/org-core/internal/retention/repository_postgres_test.go	
@@ -0,0 +1,284 @@
+package retention
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"os"
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/I-Dacosta/AquatiqCMS/apps/org-core/internal/database"
+	"github.com/I-Dacosta/AquatiqCMS/apps/org-core/internal/testfixture"
+	"github.com/jackc/pgx/v5"
+)
+
+// openRetentionLifecycleDB connects to the disposable lifecycle Postgres (the
+// fixture the browser site repository test uses) and applies every migration.
+func openRetentionLifecycleDB(t *testing.T) (context.Context, *database.DB) {
+	t.Helper()
+	dsn := os.Getenv("CONTROL_LIFECYCLE_TEST_DATABASE_URL")
+	if dsn == "" {
+		t.Skip("CONTROL_LIFECYCLE_TEST_DATABASE_URL is not set")
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 120*time.Second)
+	t.Cleanup(cancel)
+	db, err := database.Connect(ctx, dsn)
+	if err != nil {
+		t.Fatalf("connect to disposable Postgres: %v", err)
+	}
+	t.Cleanup(db.Close)
+	if err := testfixture.VerifyLifecycleMarker(ctx, db.Pool, dsn, "org_lifecycle", os.Getenv("CONTROL_LIFECYCLE_FIXTURE_ID")); err != nil {
+		t.Fatalf("refusing unsafe lifecycle database: %v", err)
+	}
+	if err := database.RunMigrations(ctx, db, "../../migrations"); err != nil {
+		t.Fatalf("apply org-core migrations: %v", err)
+	}
+	return ctx, db
+}
+
+func seedRetentionOrganization(t *testing.T, ctx context.Context, db *database.DB, orgID string) {
+	t.Helper()
+	// Migration 010's deferred constraint trigger requires every live organization
+	// to have an active owner by COMMIT, so both rows go in one transaction.
+	tx, err := db.Pool.Begin(ctx)
+	if err != nil {
+		t.Fatalf("begin seed tx for %s: %v", orgID, err)
+	}
+	defer func() { _ = tx.Rollback(ctx) }()
+	if _, err := tx.Exec(ctx, `INSERT INTO organizations (id, name) VALUES ($1, $2)`, orgID, "Retention "+orgID); err != nil {
+		t.Fatalf("seed organization %s: %v", orgID, err)
+	}
+	if _, err := tx.Exec(ctx, `INSERT INTO organization_members (org_id, user_id, role, status) VALUES ($1, $2, 'owner', 'active')`, orgID, "owner-"+orgID); err != nil {
+		t.Fatalf("seed owner for %s: %v", orgID, err)
+	}
+	if err := tx.Commit(ctx); err != nil {
+		t.Fatalf("commit seed tx for %s: %v", orgID, err)
+	}
+}
+
+func hold(id, scope, target string) Hold {
+	return Hold{ID: id, Scope: scope, TargetRef: target, HoldRef: "Matter 2026-17"}
+}
+
+// TestControlLifecycleRetentionRepositoryUnderRLS proves what EP-9 C1 requires of
+// the store: the revision compare-and-set, the window bounds at the database, an
+// append-only history, one active hold per target, release, the check answer,
+// tenant isolation under RLS, a content-free audit intent per write, and that
+// hard-deleting the organisation leaves no row behind.
+func TestControlLifecycleRetentionRepositoryUnderRLS(t *testing.T) {
+	ctx, db := openRetentionLifecycleDB(t)
+	suffix := time.Now().UnixNano()
+	orgA := fmt.Sprintf("org-retention-a-%d", suffix)
+	orgB := fmt.Sprintf("org-retention-b-%d", suffix)
+	seedRetentionOrganization(t, ctx, db, orgA)
+	seedRetentionOrganization(t, ctx, db, orgB)
+	repo := NewRepository(db)
+	actor := Actor{ID: "actor-1", Role: "owner"}
+
+	empty, err := repo.GetPolicy(ctx, orgA)
+	if err != nil || empty.Revision != 0 || empty.ThreadDays != nil {
+		t.Fatalf("a new organisation keeps everything: %+v err=%v", empty, err)
+	}
+	days := 90
+	first, err := repo.PutPolicy(ctx, orgA, actor, 0, &days)
+	if err != nil || first.Revision != 1 || first.ThreadDays == nil || *first.ThreadDays != 90 || first.UpdatedBy != "actor-1" {
+		t.Fatalf("first write: %+v err=%v", first, err)
+	}
+	var conflict *RevisionConflictError
+	if _, err := repo.PutPolicy(ctx, orgA, actor, 0, nil); !errors.As(err, &conflict) || conflict.Current != 1 {
+		t.Fatalf("a stale write must conflict at revision 1, got %v", err)
+	}
+	keep, err := repo.PutPolicy(ctx, orgA, actor, 1, nil)
+	if err != nil || keep.Revision != 2 || keep.ThreadDays != nil {
+		t.Fatalf("setting keep: %+v err=%v", keep, err)
+	}
+
+	// The database refuses a window outside 30..3650 even from a writer that is not
+	// the service.
+	for _, bad := range []int{29, 3651} {
+		err := db.WithOrgScope(ctx, orgA, func(tx pgx.Tx) error {
+			_, err := tx.Exec(ctx, `UPDATE org_retention_policies SET thread_days = $2 WHERE org_id = $1`, orgA, bad)
+			return err
+		})
+		if err == nil {
+			t.Fatalf("a window of %d days must be refused by the table", bad)
+		}
+	}
+
+	// Holds: one active hold per target; placing it again answers the existing one.
+	orgHold, err := repo.PlaceHold(ctx, orgA, actor, hold("lh_"+strings.Repeat("a", 32), ScopeOrg, orgA))
+	if err != nil || orgHold.Existed || orgHold.Hold.TargetRef != orgA || orgHold.Hold.ReleasedAt != nil {
+		t.Fatalf("org hold: %+v err=%v", orgHold, err)
+	}
+	threadHold, err := repo.PlaceHold(ctx, orgA, actor, hold("lh_"+strings.Repeat("b", 32), ScopeThread, "thr-1"))
+	if err != nil || threadHold.Existed {
+		t.Fatalf("thread hold: %+v err=%v", threadHold, err)
+	}
+	again, err := repo.PlaceHold(ctx, orgA, actor, hold("lh_"+strings.Repeat("c", 32), ScopeThread, "thr-1"))
+	if err != nil || !again.Existed || again.Hold.ID != threadHold.Hold.ID {
+		t.Fatalf("a second hold on a held thread must answer the first: %+v err=%v", again, err)
+	}
+	if err := db.WithOrgScope(ctx, orgA, func(tx pgx.Tx) error {
+		_, err := tx.Exec(ctx, `INSERT INTO org_legal_holds (id, org_id, scope, target_ref, hold_ref, created_by) VALUES ($1, $2, 'org', 'other-org', 'm', 'x')`, "lh_"+strings.Repeat("d", 32), orgA)
+		return err
+	}); err == nil {
+		t.Fatal("an org hold must target its own organisation")
+	}
+
+	check, err := repo.Check(ctx, orgA, []string{"thr-1", "thr-2"})
+	if err != nil || !check.OrgHeld || check.Revision != 2 || check.WindowDays != nil || len(check.HeldThreadIDs) != 1 || check.HeldThreadIDs[0] != "thr-1" {
+		t.Fatalf("check must report the org hold and the held thread only: %+v err=%v", check, err)
+	}
+
+	released, err := repo.ReleaseHold(ctx, orgA, orgHold.Hold.ID, Actor{ID: "compliance-1", Role: "compliance"})
+	if err != nil || released.ReleasedAt == nil || released.ReleasedBy == nil || *released.ReleasedBy != "compliance-1" {
+		t.Fatalf("release: %+v err=%v", released, err)
+	}
+	if _, err := repo.ReleaseHold(ctx, orgA, orgHold.Hold.ID, actor); !errors.Is(err, ErrHoldAlreadyReleased) {
+		t.Fatalf("a second release must be ErrHoldAlreadyReleased, got %v", err)
+	}
+	if _, err := repo.ReleaseHold(ctx, orgA, "lh_"+strings.Repeat("e", 32), actor); !errors.Is(err, ErrHoldNotFound) {
+		t.Fatalf("an unknown hold must be ErrHoldNotFound, got %v", err)
+	}
+	if check, err := repo.Check(ctx, orgA, nil); err != nil || check.OrgHeld {
+		t.Fatalf("a released org hold no longer holds: %+v err=%v", check, err)
+	}
+	if replaced, err := repo.PlaceHold(ctx, orgA, actor, hold("lh_"+strings.Repeat("f", 32), ScopeOrg, orgA)); err != nil || replaced.Existed {
+		t.Fatalf("a released target can be held again: %+v err=%v", replaced, err)
+	}
+
+	// The runtime role can neither rewrite a hold nor delete one, nor touch the
+	// history.
+	for _, statement := range []string{
+		`UPDATE org_legal_holds SET target_ref = 'thr-9' WHERE org_id = $1`,
+		`UPDATE org_legal_holds SET hold_ref = 'tampered' WHERE org_id = $1`,
+		`DELETE FROM org_legal_holds WHERE org_id = $1`,
+		`DELETE FROM org_retention_policies WHERE org_id = $1`,
+		`UPDATE org_retention_history SET actor_id = 'tampered' WHERE org_id = $1`,
+		`DELETE FROM org_retention_history WHERE org_id = $1`,
+		`UPDATE org_retention_audit_outbox SET payload = '{}'::jsonb WHERE org_id = $1`,
+		`DELETE FROM org_retention_audit_outbox WHERE org_id = $1`,
+	} {
+		err := db.WithOrgScope(ctx, orgA, func(tx pgx.Tx) error {
+			_, err := tx.Exec(ctx, statement, orgA)
+			return err
+		})
+		if err == nil {
+			t.Fatalf("org_core_app must not be able to run %q", statement)
+		}
+	}
+
+	var history int
+	if err := db.Pool.QueryRow(ctx, `
+SELECT count(*) FROM org_retention_history WHERE org_id = $1`, orgA).Scan(&history); err != nil || history != 6 {
+		t.Fatalf("history rows = %d err=%v; want 2 policy writes, 3 placements, 1 release", history, err)
+	}
+	var audits int
+	var leaked int
+	if err := db.Pool.QueryRow(ctx, `
+SELECT count(*), count(*) FILTER (WHERE payload::text LIKE '%Matter 2026-17%')
+FROM org_retention_audit_outbox WHERE org_id = $1 AND subject = $2`, orgA, AuditSubject).Scan(&audits, &leaked); err != nil || audits != 6 || leaked != 0 {
+		t.Fatalf("audit intents = %d (hold reference in %d) err=%v; want 6 with no reference", audits, leaked, err)
+	}
+
+	// Tenant isolation: B's scope reads and writes none of A's rows.
+	if other, err := repo.Check(ctx, orgB, []string{"thr-1"}); err != nil || other.OrgHeld || len(other.HeldThreadIDs) != 0 || other.Revision != 0 {
+		t.Fatalf("organisation B must not see A's holds or policy: %+v err=%v", other, err)
+	}
+	for _, table := range []string{"org_retention_policies", "org_legal_holds", "org_retention_history", "org_retention_audit_outbox"} {
+		var visible int
+		err := db.WithOrgScope(ctx, orgB, func(tx pgx.Tx) error {
+			return tx.QueryRow(ctx, fmt.Sprintf(`SELECT count(*) FROM %s WHERE org_id = $1`, table), orgA).Scan(&visible)
+		})
+		if err != nil || visible != 0 {
+			t.Fatalf("RLS leaked %d %s rows of A into B's scope (err=%v)", visible, table, err)
+		}
+	}
+	if err := db.WithOrgScope(ctx, orgB, func(tx pgx.Tx) error {
+		_, err := tx.Exec(ctx, `INSERT INTO org_legal_holds (id, org_id, scope, target_ref, hold_ref, created_by) VALUES ($1, $2, 'thread', 'thr-x', 'm', 'x')`, "lh_"+strings.Repeat("9", 32), orgA)
+		return err
+	}); err == nil {
+		t.Fatal("a hold for A under B's scope must be refused by RLS")
+	}
+
+	// A write for an organisation that does not exist is a typed error, and the
+	// check route treats a missing organisation as not found, never as "no hold".
+	missing := fmt.Sprintf("org-retention-missing-%d", suffix)
+	if _, err := repo.PutPolicy(ctx, missing, actor, 0, &days); !errors.Is(err, ErrOrganizationNotFound) {
+		t.Fatalf("a write for a missing organisation must be ErrOrganizationNotFound, got %v", err)
+	}
+	if _, err := repo.Check(ctx, missing, nil); !errors.Is(err, ErrOrganizationNotFound) {
+		t.Fatalf("a check for a missing organisation must be ErrOrganizationNotFound, got %v", err)
+	}
+
+	// Erasure: hard-deleting the organisation takes every row with it through the
+	// foreign keys, without gdpr_hard_delete_organization being redefined. The audit
+	// outbox has no foreign key, as the other outboxes, so an erasure's audit trail
+	// is not erased with it.
+	var receipt []byte
+	if err := db.Pool.QueryRow(ctx, `SELECT gdpr_hard_delete_organization($1)::text`, orgA).Scan(&receipt); err != nil {
+		t.Fatalf("hard delete: %v", err)
+	}
+	var outcome struct {
+		Success bool `json:"success"`
+	}
+	if err := json.Unmarshal(receipt, &outcome); err != nil || !outcome.Success {
+		t.Fatalf("hard delete did not succeed: %s (%v)", receipt, err)
+	}
+	for _, table := range []string{"org_retention_policies", "org_legal_holds", "org_retention_history"} {
+		var left int
+		if err := db.Pool.QueryRow(ctx, fmt.Sprintf(`SELECT count(*) FROM %s WHERE org_id = $1`, table), orgA).Scan(&left); err != nil || left != 0 {
+			t.Fatalf("%d %s rows survived the hard delete of the organisation (err=%v)", left, table, err)
+		}
+	}
+}
+
+// TestControlLifecycleRetentionGrantsAreLeastPrivilege pins what org_core_app may
+// do on each table migration 031 creates. 009's default privileges would otherwise
+// give it all four on every one of them (D1-751).
+func TestControlLifecycleRetentionGrantsAreLeastPrivilege(t *testing.T) {
+	ctx, db := openRetentionLifecycleDB(t)
+	want := map[string]string{
+		"org_retention_policies":     "SELECT,INSERT",
+		"org_legal_holds":            "SELECT,INSERT",
+		"org_retention_history":      "SELECT,INSERT",
+		"org_retention_audit_outbox": "SELECT,INSERT",
+	}
+	for table, need := range want {
+		var canSelect, canInsert, canUpdate, canDelete bool
+		if err := db.Pool.QueryRow(ctx, `
+SELECT has_table_privilege('org_core_app', $1::text, 'SELECT'),
+       has_table_privilege('org_core_app', $1::text, 'INSERT'),
+       has_table_privilege('org_core_app', $1::text, 'UPDATE'),
+       has_table_privilege('org_core_app', $1::text, 'DELETE')`, table).Scan(&canSelect, &canInsert, &canUpdate, &canDelete); err != nil {
+			t.Fatalf("inspect org_core_app privileges on %s: %v", table, err)
+		}
+		var got []string
+		for name, held := range map[string]bool{"SELECT": canSelect, "INSERT": canInsert, "UPDATE": canUpdate, "DELETE": canDelete} {
+			if held {
+				got = append(got, name)
+			}
+		}
+		if canUpdate || canDelete || !canSelect || !canInsert {
+			t.Errorf("org_core_app holds %v on %s; the code needs %s (and column UPDATE where stated)", got, table, need)
+		}
+	}
+	columnUpdate := map[string]map[string]bool{
+		"org_retention_policies": {"thread_days": true, "revision": true, "updated_by": true, "updated_at": true, "org_id": false},
+		"org_legal_holds":        {"released_by": true, "released_at": true, "scope": false, "target_ref": false, "hold_ref": false, "org_id": false, "created_by": false},
+	}
+	for table, columns := range columnUpdate {
+		for column, need := range columns {
+			var held bool
+			if err := db.Pool.QueryRow(ctx, `SELECT has_column_privilege('org_core_app', $1::text, $2::text, 'UPDATE')`, table, column).Scan(&held); err != nil {
+				t.Fatalf("inspect column privilege %s.%s: %v", table, column, err)
+			}
+			if held != need {
+				t.Errorf("org_core_app UPDATE on %s.%s = %v, want %v", table, column, held, need)
+			}
+		}
+	}
+}
diff --git a/apps/Control Plane/org-core/internal/retention/service.go b/apps/Control Plane/org-core/internal/retention/service.go
new file mode 100644
index 000000000..9162c0293
--- /dev/null
+++ b/apps/Control Plane/org-core/internal/retention/service.go	
@@ -0,0 +1,251 @@
+package retention
+
+import (
+	"context"
+	"crypto/rand"
+	"encoding/hex"
+	"errors"
+	"fmt"
+	"log"
+	"strings"
+)
+
+// ErrOrganizationNotFound is returned for an organisation that does not exist (a
+// write) or is not live (the check route). Reads of a live organisation that never
+// wrote a policy return revision 0 and keep.
+var ErrOrganizationNotFound = errors.New("organization not found")
+
+// ErrHoldNotFound means the organisation has no hold with that id.
+var ErrHoldNotFound = errors.New("legal hold not found")
+
+// ErrHoldAlreadyReleased means the hold was released before; a release is never
+// repeated, so the first releaser stays the one on record.
+var ErrHoldAlreadyReleased = errors.New("legal hold already released")
+
+// ErrNothingRetained refuses a thread hold on a thread whose content was never
+// retained (CodeNothingRetained).
+var ErrNothingRetained = errors.New("nothing is retained for this thread")
+
+// RevisionConflictError means the write named a revision that is no longer the
+// current one. Current is the revision the caller should re-read and retry from.
+type RevisionConflictError struct {
+	Current int64
+}
+
+func (e *RevisionConflictError) Error() string {
+	return fmt.Sprintf("retention policy revision conflict: current revision is %d", e.Current)
+}
+
+// Actor is who made a write, as the audit row records it. Role is the caller's
+// role from org-core's membership table, never a forwarded header.
+type Actor struct {
+	ID   string
+	Role string
+}
+
+// AuditRow is one claimed outbox row.
+type AuditRow struct {
+	EventID string
+	Subject string
+	Payload map[string]any
+}
+
+// FlushResult counts one publisher pass.
+type FlushResult struct {
+	Published    int
+	DeadLettered int
+}
+
+// Store is the persistence the service needs. *Repository satisfies it; the HTTP
+// tests use an in-memory store so the real service and routes run without a
+// database.
+type Store interface {
+	GetPolicy(ctx context.Context, orgID string) (*Policy, error)
+	PutPolicy(ctx context.Context, orgID string, actor Actor, expectedRevision int64, threadDays *int) (*Policy, error)
+	ListHolds(ctx context.Context, orgID string) ([]Hold, error)
+	PlaceHold(ctx context.Context, orgID string, actor Actor, hold Hold) (PlaceResult, error)
+	ReleaseHold(ctx context.Context, orgID, holdID string, actor Actor) (Hold, error)
+	Check(ctx context.Context, orgID string, threadIDs []string) (CheckResult, error)
+	ClaimAudit(ctx context.Context, limit int) ([]AuditRow, error)
+	MarkAuditPublished(ctx context.Context, eventID string) error
+	MarkAuditFailed(ctx context.Context, eventID string, publishErr error) (deadLettered bool, err error)
+}
+
+// ThreadRetention answers whether session-core retained any content for a thread.
+// NothingRetained is true only for a thread whose retention receipt says Zero
+// Data Retention or a waived run (DEC-32). session-core owns that receipt; org-core
+// never reads its database.
+type ThreadRetention interface {
+	NothingRetained(ctx context.Context, orgID, threadID string) (bool, error)
+}
+
+// AuditPublisher is satisfied by org-core's NATS client (PublishAudit), the same
+// seam as org.AuditPublisher; declared here so this package does not import org.
+type AuditPublisher interface {
+	PublishAudit(ctx context.Context, subject, eventID string, payload map[string]any) error
+}
+
+// Service is the one place the retention policy and holds are validated, written
+// and answered.
+type Service struct {
+	store     Store
+	threads   ThreadRetention
+	publisher AuditPublisher
+}
+
+// NewService builds the service. threads may be nil: a thread hold is then placed
+// without asking whether anything is retained, because an unneeded hold deletes
+// nothing while a wrongly refused one could let held content be swept. publisher
+// may be nil until the outbox loop is wired; writes still record their audit
+// intent.
+func NewService(store Store, threads ThreadRetention, publisher AuditPublisher) *Service {
+	return &Service{store: store, threads: threads, publisher: publisher}
+}
+
+// Policy returns the stored policy for the admin read.
+func (s *Service) Policy(ctx context.Context, orgID string) (*Policy, error) {
+	return s.store.GetPolicy(ctx, orgID)
+}
+
+// PutPolicy validates the body and replaces the organisation's window. A body that
+// fails validation is a *ValidationError and writes nothing.
+func (s *Service) PutPolicy(ctx context.Context, orgID string, actor Actor, req PutRequest) (*Policy, error) {
+	if strings.TrimSpace(actor.ID) == "" || strings.TrimSpace(actor.Role) == "" {
+		return nil, errors.New("an actor id and role are required to write a retention policy")
+	}
+	if err := ValidatePut(req); err != nil {
+		return nil, err
+	}
+	return s.store.PutPolicy(ctx, orgID, actor, *req.ExpectedRevision, req.ThreadDays)
+}
+
+// Holds returns the organisation's holds for the admin read.
+func (s *Service) Holds(ctx context.Context, orgID string) (HoldList, error) {
+	holds, err := s.store.ListHolds(ctx, orgID)
+	if err != nil {
+		return HoldList{}, err
+	}
+	if holds == nil {
+		holds = []Hold{}
+	}
+	return HoldList{OrganizationID: orgID, Holds: holds}, nil
+}
+
+// PlaceHold validates and places a hold. A thread hold on a thread whose content
+// was never retained is refused with ErrNothingRetained. When the retention answer
+// is unavailable the hold is placed: holding too much is recoverable by a release,
+// holding too little is not.
+func (s *Service) PlaceHold(ctx context.Context, orgID string, actor Actor, req PlaceHoldRequest) (PlaceResult, error) {
+	if strings.TrimSpace(actor.ID) == "" || strings.TrimSpace(actor.Role) == "" {
+		return PlaceResult{}, errors.New("an actor id and role are required to place a legal hold")
+	}
+	scope, target, holdRef, err := NormalizePlace(orgID, req)
+	if err != nil {
+		return PlaceResult{}, err
+	}
+	if scope == ScopeThread && s.threads != nil {
+		nothing, err := s.threads.NothingRetained(ctx, orgID, target)
+		switch {
+		case err != nil:
+			log.Printf("retention: thread retention unknown for org=%s, placing the hold: %v", orgID, err)
+		case nothing:
+			return PlaceResult{}, ErrNothingRetained
+		}
+	}
+	id, err := newHoldID()
+	if err != nil {
+		return PlaceResult{}, err
+	}
+	return s.store.PlaceHold(ctx, orgID, actor, Hold{
+		ID:             id,
+		OrganizationID: orgID,
+		Scope:          scope,
+		TargetRef:      target,
+		HoldRef:        holdRef,
+		CreatedBy:      actor.ID,
+	})
+}
+
+// ReleaseHold releases one active hold.
+func (s *Service) ReleaseHold(ctx context.Context, orgID, holdID string, actor Actor) (Hold, error) {
+	if strings.TrimSpace(actor.ID) == "" || strings.TrimSpace(actor.Role) == "" {
+		return Hold{}, errors.New("an actor id and role are required to release a legal hold")
+	}
+	holdID = strings.TrimSpace(holdID)
+	if !validHoldID(holdID) {
+		return Hold{}, ErrHoldNotFound
+	}
+	return s.store.ReleaseHold(ctx, orgID, holdID, actor)
+}
+
+// Check answers the sweeper: the window, the revision, whether the org is held,
+// and which of the asked threads are held. Computed on every call; never cached.
+func (s *Service) Check(ctx context.Context, orgID string, req CheckRequest) (CheckResult, error) {
+	ids, err := NormalizeCheck(req)
+	if err != nil {
+		return CheckResult{}, err
+	}
+	result, err := s.store.Check(ctx, orgID, ids)
+	if err != nil {
+		return CheckResult{}, err
+	}
+	if result.HeldThreadIDs == nil {
+		result.HeldThreadIDs = []string{}
+	}
+	result.OrganizationID = orgID
+	return result, nil
+}
+
+// FlushAuditOutbox publishes pending retention audit intents, the same loop the
+// SIEM and identity outboxes run.
+func (s *Service) FlushAuditOutbox(ctx context.Context, limit int) (FlushResult, error) {
+	if limit < 1 || limit > 1000 {
+		return FlushResult{}, errors.New("retention audit outbox limit must be between 1 and 1000")
+	}
+	if s.publisher == nil {
+		return FlushResult{}, errors.New("retention audit publisher is unavailable")
+	}
+	rows, err := s.store.ClaimAudit(ctx, limit)
+	if err != nil {
+		return FlushResult{}, err
+	}
+	result := FlushResult{}
+	var publishErrors error
+	for _, row := range rows {
+		if err := s.publisher.PublishAudit(ctx, row.Subject, row.EventID, row.Payload); err != nil {
+			deadLettered, markErr := s.store.MarkAuditFailed(ctx, row.EventID, err)
+			if deadLettered {
+				result.DeadLettered++
+			}
+			publishErrors = errors.Join(publishErrors, err, markErr)
+			continue
+		}
+		if err := s.store.MarkAuditPublished(ctx, row.EventID); err != nil {
+			publishErrors = errors.Join(publishErrors, err)
+			continue
+		}
+		result.Published++
+	}
+	return result, publishErrors
+}
+
+// newHoldID is "lh_" and 32 hex characters, the shape migration 031 checks.
+func newHoldID() (string, error) {
+	var raw [16]byte
+	if _, err := rand.Read(raw[:]); err != nil {
+		return "", fmt.Errorf("generate legal hold id: %w", err)
+	}
+	return "lh_" + hex.EncodeToString(raw[:]), nil
+}
+
+func validHoldID(id string) bool {
+	if len(id) != 35 || !strings.HasPrefix(id, "lh_") {
+		return false
+	}
+	for _, c := range id[3:] {
+		if !(c >= '0' && c <= '9' || c >= 'a' && c <= 'f') {
+			return false
+		}
+	}
+	return true
+}
diff --git a/apps/Control Plane/org-core/internal/retention/service_test.go b/apps/Control Plane/org-core/internal/retention/service_test.go
new file mode 100644
index 000000000..27ef9a545
--- /dev/null
+++ b/apps/Control Plane/org-core/internal/retention/service_test.go	
@@ -0,0 +1,126 @@
+package retention
+
+import (
+	"context"
+	"errors"
+	"testing"
+)
+
+// recordingStore is a Store that records the hold it was asked to place and
+// serves canned audit rows; the rest answer nothing.
+type recordingStore struct {
+	placed    *Hold
+	audit     []AuditRow
+	published []string
+	failed    []string
+}
+
+func (s *recordingStore) GetPolicy(context.Context, string) (*Policy, error) { return &Policy{}, nil }
+func (s *recordingStore) PutPolicy(_ context.Context, orgID string, actor Actor, _ int64, days *int) (*Policy, error) {
+	return &Policy{OrganizationID: orgID, ThreadDays: days, Revision: 1, UpdatedBy: actor.ID}, nil
+}
+func (s *recordingStore) ListHolds(context.Context, string) ([]Hold, error) { return nil, nil }
+func (s *recordingStore) PlaceHold(_ context.Context, _ string, _ Actor, hold Hold) (PlaceResult, error) {
+	s.placed = &hold
+	return PlaceResult{Hold: hold}, nil
+}
+func (s *recordingStore) ReleaseHold(context.Context, string, string, Actor) (Hold, error) {
+	return Hold{}, ErrHoldNotFound
+}
+func (s *recordingStore) Check(context.Context, string, []string) (CheckResult, error) {
+	return CheckResult{}, nil
+}
+func (s *recordingStore) ClaimAudit(context.Context, int) ([]AuditRow, error) { return s.audit, nil }
+func (s *recordingStore) MarkAuditPublished(_ context.Context, eventID string) error {
+	s.published = append(s.published, eventID)
+	return nil
+}
+func (s *recordingStore) MarkAuditFailed(_ context.Context, eventID string, _ error) (bool, error) {
+	s.failed = append(s.failed, eventID)
+	return false, nil
+}
+
+type fixedThreads struct {
+	nothing bool
+	err     error
+	asked   []string
+}
+
+func (f *fixedThreads) NothingRetained(_ context.Context, _, threadID string) (bool, error) {
+	f.asked = append(f.asked, threadID)
+	return f.nothing, f.err
+}
+
+var owner = Actor{ID: "u-owner", Role: "owner"}
+
+func TestThreadHoldOnANothingRetainedThreadIsRefused(t *testing.T) {
+	store := &recordingStore{}
+	threads := &fixedThreads{nothing: true}
+	service := NewService(store, threads, nil)
+
+	_, err := service.PlaceHold(context.Background(), "org-1", owner, PlaceHoldRequest{Scope: ScopeThread, ThreadID: "thr-zdr", HoldRef: "Matter 1"})
+	if !errors.Is(err, ErrNothingRetained) {
+		t.Fatalf("a ZDR or waived thread has nothing to hold: err=%v", err)
+	}
+	if store.placed != nil {
+		t.Fatal("a refused hold must write nothing")
+	}
+
+	// An org hold on a ZDR organisation is allowed: it holds whatever non-ZDR
+	// content exists, so the thread reader is not asked.
+	threads.asked = nil
+	if _, err := service.PlaceHold(context.Background(), "org-1", owner, PlaceHoldRequest{Scope: ScopeOrg, HoldRef: "Matter 1"}); err != nil {
+		t.Fatalf("org hold: %v", err)
+	}
+	if len(threads.asked) != 0 || store.placed == nil || store.placed.TargetRef != "org-1" {
+		t.Fatalf("an org hold targets the organisation without a thread lookup: asked=%v placed=%+v", threads.asked, store.placed)
+	}
+}
+
+func TestThreadHoldIsPlacedWhenRetentionIsUnknown(t *testing.T) {
+	for name, threads := range map[string]ThreadRetention{
+		"reader error": &fixedThreads{err: errors.New("session-core unreachable")},
+		"no reader":    nil,
+		"retained":     &fixedThreads{nothing: false},
+	} {
+		store := &recordingStore{}
+		result, err := NewService(store, threads, nil).PlaceHold(context.Background(), "org-1", owner, PlaceHoldRequest{Scope: ScopeThread, ThreadID: "thr-1", HoldRef: "Matter 1"})
+		if err != nil || store.placed == nil || store.placed.TargetRef != "thr-1" || !validHoldID(result.Hold.ID) {
+			t.Fatalf("%s: a hold whose retention is not known to be empty must be placed: result=%+v err=%v", name, result, err)
+		}
+	}
+}
+
+func TestWritesNeedAnActorWithARole(t *testing.T) {
+	service := NewService(&recordingStore{}, nil, nil)
+	if _, err := service.PutPolicy(context.Background(), "org-1", Actor{ID: "u"}, PutRequest{ExpectedRevision: revPtr(0)}); err == nil {
+		t.Fatal("a policy write without the actor's role must be refused: the audit row records it")
+	}
+	if _, err := service.PlaceHold(context.Background(), "org-1", Actor{Role: "owner"}, PlaceHoldRequest{Scope: ScopeOrg, HoldRef: "m"}); err == nil {
+		t.Fatal("a hold without an actor must be refused")
+	}
+	if _, err := service.ReleaseHold(context.Background(), "org-1", "not-a-hold-id", owner); !errors.Is(err, ErrHoldNotFound) {
+		t.Fatalf("a malformed hold id is not found, never sent to the store: %v", err)
+	}
+}
+
+type flakyPublisher struct{ fail map[string]bool }
+
+func (p flakyPublisher) PublishAudit(_ context.Context, _, eventID string, _ map[string]any) error {
+	if p.fail[eventID] {
+		return errors.New("nats down")
+	}
+	return nil
+}
+
+func TestFlushPublishesAndRecordsFailures(t *testing.T) {
+	store := &recordingStore{audit: []AuditRow{{EventID: "e1", Subject: AuditSubject}, {EventID: "e2", Subject: AuditSubject}}}
+	service := NewService(store, nil, flakyPublisher{fail: map[string]bool{"e2": true}})
+	result, err := service.FlushAuditOutbox(context.Background(), 10)
+	if err == nil || result.Published != 1 || len(store.published) != 1 || store.published[0] != "e1" || len(store.failed) != 1 || store.failed[0] != "e2" {
+		t.Fatalf("flush: result=%+v published=%v failed=%v err=%v", result, store.published, store.failed, err)
+	}
+	if _, err := NewService(store, nil, nil).FlushAuditOutbox(context.Background(), 10); err == nil {
+		t.Fatal("a flush without a publisher must fail, not drop rows")
+	}
+}
diff --git a/apps/Control Plane/org-core/internal/retention/types.go b/apps/Control Plane/org-core/internal/retention/types.go
new file mode 100644
index 000000000..bb385930d
--- /dev/null
+++ b/apps/Control Plane/org-core/internal/retention/types.go	
@@ -0,0 +1,139 @@
+// Package retention is org-core's retention policy and legal holds of record
+// (EP-9 C1): how long an organisation keeps personal threads, and which org or
+// thread holds are active.
+//
+// org-core stores, validates and answers. It deletes nothing: session-core asks
+// the internal check route which threads its sweeper may consider and drops every
+// held one (EP-9 C2, C3). The records hold ids, numbers, a hold reference and
+// actor ids, never thread content, so they carry no retention class of their own
+// and go with the organisation.
+package retention
+
+import "time"
+
+const (
+	// MinThreadDays and MaxThreadDays bound the thread window (D-C2). The clock is
+	// the thread's last activity, so a thread in use is never past its window.
+	MinThreadDays = 30
+	MaxThreadDays = 3650
+
+	// ScopeOrg holds everything the organisation retains; ScopeThread holds one
+	// thread. An org hold's target is the organisation id itself.
+	ScopeOrg    = "org"
+	ScopeThread = "thread"
+
+	// MaxCheckThreadIDs is the most thread ids one check call may name, so the
+	// sweeper pages its candidates instead of sending an org's whole history.
+	MaxCheckThreadIDs = 500
+
+	// MaxThreadIDLength bounds a thread id; MaxHoldRefLength bounds the matter or
+	// case reference a placer gives a hold.
+	MaxThreadIDLength = 128
+	MaxHoldRefLength  = 200
+
+	// MaxListedHolds caps the admin list: every active hold plus the most recent
+	// released ones up to this many rows.
+	MaxListedHolds = 500
+
+	// MaxBodyBytes bounds one request body. A check body of 500 ids of 128 bytes
+	// fits well inside it.
+	MaxBodyBytes = 96 << 10
+
+	// AuditEvent and AuditSubject are the durable audit row every write leaves in
+	// org_retention_audit_outbox (migration 031 pins the subject).
+	AuditEvent   = "org_retention_changed"
+	AuditSubject = "verevon.audit.v2.control.org-core." + AuditEvent
+
+	// AuditMaxAttempts bounds publication retries before a row is dead-lettered,
+	// as the other org-core outboxes do.
+	AuditMaxAttempts = 8
+
+	// CodeNothingRetained is the typed refusal of a thread hold on a thread whose
+	// content was never retained (Zero Data Retention or a waived run): there is
+	// nothing to hold, and the placer is told so instead of being given a hold that
+	// protects nothing. ZDRFeature is its feature key in zdr-refusals.json.
+	CodeNothingRetained = "legal_hold_nothing_retained"
+	ZDRFeature          = "legal_hold"
+)
+
+// EnvEnabled is the switch for the whole feature. Off, the routes are not mounted.
+const EnvEnabled = "ORG_RETENTION_POLICY_ENABLED"
+
+// Enabled reads EnvEnabled strictly: only the literal "true" turns it on, so a
+// typo or "1" leaves the routes unmounted.
+func Enabled(getenv func(string) string) bool {
+	return getenv(EnvEnabled) == "true"
+}
+
+// Policy is the organisation's retention record. A zero Revision means nothing
+// was ever written. A nil ThreadDays means keep: no thread is ever past a window.
+type Policy struct {
+	OrganizationID string     `json:"organization_id"`
+	ThreadDays     *int       `json:"thread_days"`
+	Revision       int64      `json:"revision"`
+	UpdatedBy      string     `json:"updated_by"`
+	UpdatedAt      *time.Time `json:"updated_at"`
+}
+
+// PutRequest replaces the policy. ExpectedRevision is a pointer so a body that
+// omits it is refused instead of reading as "first write". ThreadDays null or
+// absent sets keep.
+type PutRequest struct {
+	ExpectedRevision *int64 `json:"expected_revision"`
+	ThreadDays       *int   `json:"thread_days"`
+}
+
+// Hold is one legal hold. ReleasedAt is nil while the hold is active.
+type Hold struct {
+	ID             string     `json:"id"`
+	OrganizationID string     `json:"organization_id"`
+	Scope          string     `json:"scope"`
+	TargetRef      string     `json:"target_ref"`
+	HoldRef        string     `json:"hold_ref"`
+	CreatedBy      string     `json:"created_by"`
+	CreatedAt      time.Time  `json:"created_at"`
+	ReleasedBy     *string    `json:"released_by"`
+	ReleasedAt     *time.Time `json:"released_at"`
+}
+
+// Active reports whether the hold still holds.
+func (h Hold) Active() bool { return h.ReleasedAt == nil }
+
+// HoldList is the admin read: active holds first, then released ones, newest
+// first within each.
+type HoldList struct {
+	OrganizationID string `json:"organization_id"`
+	Holds          []Hold `json:"holds"`
+}
+
+// PlaceHoldRequest places a hold. ThreadID is required for a thread hold and
+// refused for an org hold, whose target is the organisation.
+type PlaceHoldRequest struct {
+	Scope    string `json:"scope"`
+	ThreadID string `json:"thread_id,omitempty"`
+	HoldRef  string `json:"hold_ref"`
+}
+
+// PlaceResult is a placed hold and whether it was already active: placing a hold
+// on a held target answers the existing hold and writes nothing.
+type PlaceResult struct {
+	Hold    Hold `json:"hold"`
+	Existed bool `json:"existed"`
+}
+
+// CheckRequest is the sweeper's question: which of these threads are held.
+type CheckRequest struct {
+	ThreadIDs []string `json:"thread_ids"`
+}
+
+// CheckResult answers it at one policy revision. WindowDays nil means keep.
+// OrgHeld true means every thread is held whatever HeldThreadIDs says.
+// HeldThreadIDs is the subset of the asked ids under an active thread hold, in
+// bytewise order.
+type CheckResult struct {
+	OrganizationID string   `json:"organization_id"`
+	WindowDays     *int     `json:"window_days"`
+	Revision       int64    `json:"revision"`
+	OrgHeld        bool     `json:"org_held"`
+	HeldThreadIDs  []string `json:"held_thread_ids"`
+}
diff --git a/apps/Control Plane/org-core/internal/retention/validate.go b/apps/Control Plane/org-core/internal/retention/validate.go
new file mode 100644
index 000000000..6b4aeecfa
--- /dev/null
+++ b/apps/Control Plane/org-core/internal/retention/validate.go	
@@ -0,0 +1,151 @@
+package retention
+
+import (
+	"fmt"
+	"sort"
+	"strings"
+	"unicode/utf8"
+)
+
+// Error codes a validation failure can carry. They are stable: the admin view
+// maps them to text.
+const (
+	CodeExpectedRevisionRequired = "expected_revision_required"
+	CodeWindowOutOfRange         = "thread_days_out_of_range"
+	CodeInvalidScope             = "invalid_scope"
+	CodeInvalidThreadID          = "invalid_thread_id"
+	CodeThreadIDNotAllowed       = "thread_id_not_allowed"
+	CodeInvalidHoldRef           = "invalid_hold_ref"
+	CodeTooManyThreadIDs         = "too_many_thread_ids"
+)
+
+// FieldError is one problem with a request. Path is a JSON path such as
+// "thread_ids[3]".
+type FieldError struct {
+	Path    string `json:"path"`
+	Code    string `json:"code"`
+	Message string `json:"message"`
+}
+
+// ValidationError carries every problem found, so an admin sees them all at once.
+type ValidationError struct {
+	Errors []FieldError
+}
+
+func (e *ValidationError) Error() string {
+	if len(e.Errors) == 0 {
+		return "invalid retention request"
+	}
+	return fmt.Sprintf("invalid retention request: %s: %s", e.Errors[0].Path, e.Errors[0].Message)
+}
+
+func (e *ValidationError) add(path, code, message string) {
+	e.Errors = append(e.Errors, FieldError{Path: path, Code: code, Message: message})
+}
+
+func (e *ValidationError) orNil() error {
+	if len(e.Errors) == 0 {
+		return nil
+	}
+	return e
+}
+
+// ValidatePut checks a policy write. A window is either null (keep) or a whole
+// number of days inside MinThreadDays..MaxThreadDays; the bounds stop a typo from
+// emptying an organisation (a window of 1) or reading as "keep" while deleting
+// (a negative number).
+func ValidatePut(req PutRequest) error {
+	invalid := &ValidationError{}
+	if req.ExpectedRevision == nil || *req.ExpectedRevision < 0 {
+		invalid.add("expected_revision", CodeExpectedRevisionRequired, "expected_revision is required and must be zero or greater (0 for the first write)")
+	}
+	if req.ThreadDays != nil && (*req.ThreadDays < MinThreadDays || *req.ThreadDays > MaxThreadDays) {
+		invalid.add("thread_days", CodeWindowOutOfRange, fmt.Sprintf("thread_days must be null (keep) or between %d and %d", MinThreadDays, MaxThreadDays))
+	}
+	return invalid.orNil()
+}
+
+// NormalizePlace checks a hold placement and returns it with the target resolved:
+// an org hold targets orgID, a thread hold its thread id. The hold reference is
+// trimmed; it names a matter, so it must be present and short.
+func NormalizePlace(orgID string, req PlaceHoldRequest) (scope, target, holdRef string, err error) {
+	invalid := &ValidationError{}
+	scope = strings.TrimSpace(req.Scope)
+	threadID := strings.TrimSpace(req.ThreadID)
+	switch scope {
+	case ScopeOrg:
+		if threadID != "" {
+			invalid.add("thread_id", CodeThreadIDNotAllowed, "an org hold covers the whole organisation and takes no thread_id")
+		}
+		target = orgID
+	case ScopeThread:
+		if !ValidThreadID(threadID) {
+			invalid.add("thread_id", CodeInvalidThreadID, threadIDRule())
+		}
+		target = threadID
+	default:
+		invalid.add("scope", CodeInvalidScope, `scope must be "org" or "thread"`)
+	}
+	holdRef = strings.TrimSpace(req.HoldRef)
+	if holdRef == "" || utf8.RuneCountInString(holdRef) > MaxHoldRefLength || strings.ContainsAny(holdRef, "\r\n\t") {
+		invalid.add("hold_ref", CodeInvalidHoldRef, fmt.Sprintf("hold_ref is required: a matter or case reference of at most %d characters on one line", MaxHoldRefLength))
+	}
+	if err := invalid.orNil(); err != nil {
+		return "", "", "", err
+	}
+	return scope, target, holdRef, nil
+}
+
+// NormalizeCheck checks the sweeper's question and returns the ids deduplicated
+// in bytewise order. An empty list is allowed: it asks for the window and the org
+// hold alone. The cap counts raw entries, so a caller cannot pass it by repeating.
+func NormalizeCheck(req CheckRequest) ([]string, error) {
+	invalid := &ValidationError{}
+	if len(req.ThreadIDs) > MaxCheckThreadIDs {
+		invalid.add("thread_ids", CodeTooManyThreadIDs, fmt.Sprintf("at most %d thread ids per call", MaxCheckThreadIDs))
+		return nil, invalid
+	}
+	seen := make(map[string]struct{}, len(req.ThreadIDs))
+	ids := make([]string, 0, len(req.ThreadIDs))
+	for i, id := range req.ThreadIDs {
+		// A check id is compared as given: trimming here would let " t1" match a
+		// hold on "t1" for a caller that never sent "t1".
+		if !ValidThreadID(id) {
+			invalid.add(fmt.Sprintf("thread_ids[%d]", i), CodeInvalidThreadID, threadIDRule())
+			continue
+		}
+		if _, dup := seen[id]; dup {
+			continue
+		}
+		seen[id] = struct{}{}
+		ids = append(ids, id)
+	}
+	if err := invalid.orNil(); err != nil {
+		return nil, err
+	}
+	sort.Strings(ids)
+	return ids, nil
+}
+
+// ValidThreadID accepts the ids session-core issues (UUIDs and prefixed ids):
+// 1..MaxThreadIDLength ASCII letters, digits and "._:-", starting with a letter or
+// digit. Anything else is refused rather than stored as a target nothing matches.
+func ValidThreadID(id string) bool {
+	if len(id) == 0 || len(id) > MaxThreadIDLength {
+		return false
+	}
+	for i := 0; i < len(id); i++ {
+		c := id[i]
+		switch {
+		case c >= 'a' && c <= 'z', c >= 'A' && c <= 'Z', c >= '0' && c <= '9':
+		case i > 0 && (c == '.' || c == '_' || c == ':' || c == '-'):
+		default:
+			return false
+		}
+	}
+	return true
+}
+
+func threadIDRule() string {
+	return fmt.Sprintf("thread_id must be 1 to %d letters, digits or ._:- starting with a letter or digit", MaxThreadIDLength)
+}
diff --git a/apps/Control Plane/org-core/internal/retention/validate_test.go b/apps/Control Plane/org-core/internal/retention/validate_test.go
new file mode 100644
index 000000000..cb1aff158
--- /dev/null
+++ b/apps/Control Plane/org-core/internal/retention/validate_test.go	
@@ -0,0 +1,110 @@
+package retention
+
+import (
+	"errors"
+	"strings"
+	"testing"
+)
+
+func intPtr(v int) *int { return &v }
+func revPtr(v int64) *int64 { return &v }
+
+func codesOf(err error) []string {
+	var invalid *ValidationError
+	if !errors.As(err, &invalid) {
+		return nil
+	}
+	codes := make([]string, 0, len(invalid.Errors))
+	for _, e := range invalid.Errors {
+		codes = append(codes, e.Code)
+	}
+	return codes
+}
+
+func TestValidatePutBoundsTheWindowAndRequiresTheRevision(t *testing.T) {
+	cases := []struct {
+		name string
+		req  PutRequest
+		want []string
+	}{
+		{"keep", PutRequest{ExpectedRevision: revPtr(0)}, nil},
+		{"lower bound", PutRequest{ExpectedRevision: revPtr(3), ThreadDays: intPtr(MinThreadDays)}, nil},
+		{"upper bound", PutRequest{ExpectedRevision: revPtr(3), ThreadDays: intPtr(MaxThreadDays)}, nil},
+		{"below", PutRequest{ExpectedRevision: revPtr(0), ThreadDays: intPtr(29)}, []string{CodeWindowOutOfRange}},
+		{"above", PutRequest{ExpectedRevision: revPtr(0), ThreadDays: intPtr(3651)}, []string{CodeWindowOutOfRange}},
+		{"zero", PutRequest{ExpectedRevision: revPtr(0), ThreadDays: intPtr(0)}, []string{CodeWindowOutOfRange}},
+		{"negative", PutRequest{ExpectedRevision: revPtr(0), ThreadDays: intPtr(-30)}, []string{CodeWindowOutOfRange}},
+		{"no revision", PutRequest{ThreadDays: intPtr(90)}, []string{CodeExpectedRevisionRequired}},
+		{"negative revision", PutRequest{ExpectedRevision: revPtr(-1)}, []string{CodeExpectedRevisionRequired}},
+		{"both", PutRequest{ThreadDays: intPtr(1)}, []string{CodeExpectedRevisionRequired, CodeWindowOutOfRange}},
+	}
+	for _, tc := range cases {
+		got := codesOf(ValidatePut(tc.req))
+		if strings.Join(got, ",") != strings.Join(tc.want, ",") {
+			t.Errorf("%s: codes = %v, want %v", tc.name, got, tc.want)
+		}
+	}
+}
+
+func TestNormalizePlaceResolvesTheTargetFromTheScope(t *testing.T) {
+	scope, target, ref, err := NormalizePlace("org-1", PlaceHoldRequest{Scope: "org", HoldRef: "  Matter 2026-17 "})
+	if err != nil || scope != ScopeOrg || target != "org-1" || ref != "Matter 2026-17" {
+		t.Fatalf("an org hold targets the organisation: scope=%q target=%q ref=%q err=%v", scope, target, ref, err)
+	}
+	scope, target, _, err = NormalizePlace("org-1", PlaceHoldRequest{Scope: "thread", ThreadID: " thr_01H ", HoldRef: "Matter"})
+	if err != nil || scope != ScopeThread || target != "thr_01H" {
+		t.Fatalf("a thread hold targets the thread: scope=%q target=%q err=%v", scope, target, err)
+	}
+
+	refusals := []struct {
+		name string
+		req  PlaceHoldRequest
+		want string
+	}{
+		{"unknown scope", PlaceHoldRequest{Scope: "space", HoldRef: "m"}, CodeInvalidScope},
+		{"org with thread", PlaceHoldRequest{Scope: "org", ThreadID: "t1", HoldRef: "m"}, CodeThreadIDNotAllowed},
+		{"thread without id", PlaceHoldRequest{Scope: "thread", HoldRef: "m"}, CodeInvalidThreadID},
+		{"thread id with slash", PlaceHoldRequest{Scope: "thread", ThreadID: "t/1", HoldRef: "m"}, CodeInvalidThreadID},
+		{"thread id too long", PlaceHoldRequest{Scope: "thread", ThreadID: strings.Repeat("a", MaxThreadIDLength+1), HoldRef: "m"}, CodeInvalidThreadID},
+		{"blank reference", PlaceHoldRequest{Scope: "org", HoldRef: "   "}, CodeInvalidHoldRef},
+		{"long reference", PlaceHoldRequest{Scope: "org", HoldRef: strings.Repeat("r", MaxHoldRefLength+1)}, CodeInvalidHoldRef},
+		{"multi-line reference", PlaceHoldRequest{Scope: "org", HoldRef: "a\nb"}, CodeInvalidHoldRef},
+	}
+	for _, tc := range refusals {
+		_, _, _, err := NormalizePlace("org-1", tc.req)
+		if codes := codesOf(err); len(codes) == 0 || codes[0] != tc.want {
+			t.Errorf("%s: codes = %v, want %s first", tc.name, codes, tc.want)
+		}
+	}
+}
+
+func TestNormalizeCheckCapsRawEntriesAndDeduplicates(t *testing.T) {
+	ids, err := NormalizeCheck(CheckRequest{ThreadIDs: []string{"t2", "t1", "t2"}})
+	if err != nil || strings.Join(ids, ",") != "t1,t2" {
+		t.Fatalf("ids must be deduplicated in bytewise order: %v err=%v", ids, err)
+	}
+	if ids, err := NormalizeCheck(CheckRequest{}); err != nil || len(ids) != 0 {
+		t.Fatalf("an empty list asks for the window alone: %v err=%v", ids, err)
+	}
+
+	same := make([]string, MaxCheckThreadIDs+1)
+	for i := range same {
+		same[i] = "t1"
+	}
+	if codes := codesOf(func() error { _, err := NormalizeCheck(CheckRequest{ThreadIDs: same}); return err }()); len(codes) != 1 || codes[0] != CodeTooManyThreadIDs {
+		t.Fatalf("the cap counts raw entries: %v", codes)
+	}
+	// An id is compared as sent: a padded id is refused, not trimmed into a match.
+	if _, err := NormalizeCheck(CheckRequest{ThreadIDs: []string{" t1"}}); err == nil {
+		t.Fatal("a padded thread id must be refused")
+	}
+}
+
+func TestEnabledIsStrict(t *testing.T) {
+	for value, want := range map[string]bool{"true": true, " true ": false, "": false, "1": false, "TRUE": false, "yes": false, "false": false} {
+		got := Enabled(func(string) string { return value })
+		if got != want {
+			t.Errorf("Enabled(%q) = %v, want %v", value, got, want)
+		}
+	}
+}
diff --git a/apps/Control Plane/org-core/migrations/031_org_retention_policies.down.sql b/apps/Control Plane/org-core/migrations/031_org_retention_policies.down.sql
new file mode 100644
index 000000000..6b6cd92d2
--- /dev/null
+++ b/apps/Control Plane/org-core/migrations/031_org_retention_policies.down.sql	
@@ -0,0 +1,10 @@
+-- Reverses 031. Dropping org_legal_holds releases every legal hold at once and
+-- loses the record of what was held, and dropping org_retention_history loses who
+-- set each window and placed or released each hold. Roll back only while no hold
+-- is active (SELECT count(*) FROM org_legal_holds WHERE released_at IS NULL returns
+-- 0) and no retention sweeper reads the policy (SESSION_RETENTION_SWEEP=off), or
+-- after that loss is accepted. Undelivered audit intents are lost too.
+DROP TABLE IF EXISTS org_retention_audit_outbox;
+DROP TABLE IF EXISTS org_retention_history;
+DROP TABLE IF EXISTS org_legal_holds;
+DROP TABLE IF EXISTS org_retention_policies;
diff --git a/apps/Control Plane/org-core/migrations/031_org_retention_policies.up.sql b/apps/Control Plane/org-core/migrations/031_org_retention_policies.up.sql
new file mode 100644
index 000000000..61fa55f32
--- /dev/null
+++ b/apps/Control Plane/org-core/migrations/031_org_retention_policies.up.sql	
@@ -0,0 +1,184 @@
+-- EP-9 C1: the organisation's retention policy and legal holds of record.
+--
+-- The design reserved 030; 030 is org_key_encryption_keys (WS17.E2), so this is
+-- 031.
+--
+-- org-core stores how long an organisation keeps personal threads and which org
+-- or thread holds are active. It deletes nothing itself: session-core reads the
+-- answer through POST /internal/orgs/:orgId/retention/check and sweeps (EP-9 C2,
+-- C3), and a hold is never released by anything but an owner or compliance
+-- member. organizations.compliance.data_retention_days (002) is not read: it has
+-- no revision, no audit and an unknown writer (D-C4); this record replaces it.
+--
+-- Everything here is an id, a number, a hold reference and an actor id. No thread
+-- content, title or message is stored, so a Zero Data Retention organisation's
+-- records hold nothing to retain. Every table cascades from organizations(id),
+-- which is how gdpr_hard_delete_organization() (003) removes them without being
+-- redefined.
+--
+-- Every statement is idempotent (IF NOT EXISTS / DROP ... IF EXISTS), so a re-run
+-- on a database that already has the tables changes nothing.
+
+-- One row per organisation: the thread window and the revision every write moves.
+-- A missing row is revision 0 and no window, which means keep (today's behaviour).
+-- A NULL window after a write is an explicit "keep". The clock is the thread's last
+-- activity (D-C2); the bounds are the same 30..3650 days the service checks.
+CREATE TABLE IF NOT EXISTS org_retention_policies (
+  org_id      TEXT        PRIMARY KEY REFERENCES organizations(id) ON DELETE CASCADE,
+  thread_days INTEGER     CHECK (thread_days IS NULL OR thread_days BETWEEN 30 AND 3650),
+  revision    BIGINT      NOT NULL CHECK (revision > 0),
+  updated_by  TEXT        NOT NULL CHECK (btrim(updated_by) <> ''),
+  updated_at  TIMESTAMPTZ NOT NULL DEFAULT NOW()
+);
+
+-- A hold on the whole organisation (target_ref is the org id) or on one thread
+-- (target_ref is the thread id). hold_ref is the matter or case reference the
+-- placer gives, never content. A hold is released by setting released_by and
+-- released_at together; it is never deleted, so the record of what was held
+-- survives its release.
+CREATE TABLE IF NOT EXISTS org_legal_holds (
+  id          TEXT        PRIMARY KEY CHECK (id ~ '^lh_[0-9a-f]{32}$'),
+  org_id      TEXT        NOT NULL REFERENCES organizations(id) ON DELETE CASCADE,
+  scope       TEXT        NOT NULL CHECK (scope IN ('org', 'thread')),
+  target_ref  TEXT        NOT NULL CHECK (length(target_ref) BETWEEN 1 AND 128 AND target_ref = btrim(target_ref)),
+  hold_ref    TEXT        NOT NULL CHECK (btrim(hold_ref) <> '' AND length(hold_ref) <= 200),
+  created_by  TEXT        NOT NULL CHECK (btrim(created_by) <> ''),
+  created_at  TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+  released_by TEXT,
+  released_at TIMESTAMPTZ,
+  CONSTRAINT org_legal_holds_org_target
+    CHECK (scope <> 'org' OR target_ref = org_id),
+  CONSTRAINT org_legal_holds_release_complete
+    CHECK ((released_by IS NULL) = (released_at IS NULL)
+           AND (released_by IS NULL OR btrim(released_by) <> ''))
+);
+
+-- At most one active hold per target: a second hold on a held thread is the same
+-- hold, and the service answers it with the existing one.
+CREATE UNIQUE INDEX IF NOT EXISTS idx_org_legal_holds_one_active
+  ON org_legal_holds (org_id, scope, target_ref) WHERE released_at IS NULL;
+
+CREATE INDEX IF NOT EXISTS idx_org_legal_holds_org_created
+  ON org_legal_holds (org_id, created_at DESC, id);
+
+-- Append-only record of every policy write, hold placement and hold release: who,
+-- at which revision or on which hold, and the state before and after.
+-- org_core_app can insert and read it and nothing else.
+CREATE TABLE IF NOT EXISTS org_retention_history (
+  id           BIGINT      GENERATED ALWAYS AS IDENTITY PRIMARY KEY,
+  org_id       TEXT        NOT NULL REFERENCES organizations(id) ON DELETE CASCADE,
+  change_kind  TEXT        NOT NULL CHECK (change_kind IN ('policy', 'hold_placed', 'hold_released')),
+  revision     BIGINT      CHECK (revision IS NULL OR revision >= 0),
+  hold_id      TEXT,
+  actor_id     TEXT        NOT NULL CHECK (btrim(actor_id) <> ''),
+  before_state JSONB       NOT NULL CHECK (jsonb_typeof(before_state) = 'object'),
+  after_state  JSONB       NOT NULL CHECK (jsonb_typeof(after_state) = 'object'),
+  created_at   TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+  CONSTRAINT org_retention_history_subject CHECK (
+    (change_kind = 'policy' AND revision IS NOT NULL AND hold_id IS NULL)
+    OR (change_kind <> 'policy' AND hold_id IS NOT NULL)
+  )
+);
+
+CREATE INDEX IF NOT EXISTS idx_org_retention_history_org
+  ON org_retention_history (org_id, id);
+
+-- Durable audit intent for every write above, in the shape of
+-- organization_siem_audit_outbox (022). The subject is pinned to the retention
+-- event and the scoped write transaction inserts beside the change it records. The
+-- payload is content-free: window, revision, hold id, scope and target id; the
+-- hold reference is not copied into it.
+CREATE TABLE IF NOT EXISTS org_retention_audit_outbox (
+  event_id TEXT PRIMARY KEY,
+  org_id TEXT NOT NULL,
+  subject TEXT NOT NULL,
+  payload JSONB NOT NULL,
+  attempts INTEGER NOT NULL DEFAULT 0,
+  processing_at TIMESTAMPTZ,
+  next_attempt_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+  published_at TIMESTAMPTZ,
+  dead_lettered_at TIMESTAMPTZ,
+  last_error TEXT,
+  created_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+  updated_at TIMESTAMPTZ NOT NULL DEFAULT NOW(),
+  CONSTRAINT org_retention_audit_outbox_event_id_nonempty
+    CHECK (length(event_id) BETWEEN 1 AND 128 AND event_id = btrim(event_id)),
+  CONSTRAINT org_retention_audit_outbox_org_id_nonempty
+    CHECK (btrim(org_id) <> ''),
+  CONSTRAINT org_retention_audit_outbox_subject_authority
+    CHECK (subject = 'verevon.audit.v2.control.org-core.org_retention_changed'),
+  CONSTRAINT org_retention_audit_outbox_payload_object
+    CHECK (jsonb_typeof(payload) = 'object'),
+  CONSTRAINT org_retention_audit_outbox_payload_identity
+    CHECK (payload->>'event_id' = event_id AND payload->>'org_id' = org_id),
+  CONSTRAINT org_retention_audit_outbox_payload_no_reference
+    CHECK (NOT (payload ? 'hold_ref') AND NOT ((payload->'details') ? 'hold_ref')),
+  CONSTRAINT org_retention_audit_outbox_attempts_bounded
+    CHECK (attempts >= 0 AND attempts <= 8),
+  CONSTRAINT org_retention_audit_outbox_terminal_state
+    CHECK (published_at IS NULL OR dead_lettered_at IS NULL),
+  CONSTRAINT org_retention_audit_outbox_dead_letter_complete
+    CHECK (
+      dead_lettered_at IS NULL
+      OR (attempts = 8 AND published_at IS NULL AND last_error IS NOT NULL)
+    )
+);
+
+CREATE INDEX IF NOT EXISTS idx_org_retention_audit_outbox_pending
+  ON org_retention_audit_outbox (next_attempt_at, created_at, event_id)
+  WHERE published_at IS NULL AND dead_lettered_at IS NULL;
+
+-- Least privilege for org_core_app (009's default privileges grant all four on
+-- every new table; see 024). Each table is revoked in full and granted exactly
+-- what the scoped transactions run:
+--
+--   org_retention_policies     SELECT, INSERT, UPDATE of the written columns
+--                              (never deleted: the revision must not reset)
+--   org_legal_holds            SELECT, INSERT, UPDATE of the release columns only
+--                              (a hold's scope, target and reference never change,
+--                              and a hold is never deleted)
+--   org_retention_history      SELECT, INSERT (append-only)
+--   org_retention_audit_outbox SELECT, INSERT (claimed and marked by the publisher
+--                              on the owner pool, never here)
+REVOKE ALL ON org_retention_policies FROM org_core_app;
+GRANT SELECT, INSERT ON org_retention_policies TO org_core_app;
+GRANT UPDATE (thread_days, revision, updated_by, updated_at) ON org_retention_policies TO org_core_app;
+
+REVOKE ALL ON org_legal_holds FROM org_core_app;
+GRANT SELECT, INSERT ON org_legal_holds TO org_core_app;
+GRANT UPDATE (released_by, released_at) ON org_legal_holds TO org_core_app;
+
+REVOKE ALL ON org_retention_history FROM org_core_app;
+GRANT SELECT, INSERT ON org_retention_history TO org_core_app;
+GRANT USAGE, SELECT ON SEQUENCE org_retention_history_id_seq TO org_core_app;
+
+REVOKE ALL ON org_retention_audit_outbox FROM org_core_app;
+GRANT SELECT, INSERT ON org_retention_audit_outbox TO org_core_app;
+
+ALTER TABLE org_retention_policies ENABLE ROW LEVEL SECURITY;
+DROP POLICY IF EXISTS org_retention_policies_rls_isolation ON org_retention_policies;
+CREATE POLICY org_retention_policies_rls_isolation
+  ON org_retention_policies
+  USING (org_id = current_setting('app.current_org', true))
+  WITH CHECK (org_id = current_setting('app.current_org', true));
+
+ALTER TABLE org_legal_holds ENABLE ROW LEVEL SECURITY;
+DROP POLICY IF EXISTS org_legal_holds_rls_isolation ON org_legal_holds;
+CREATE POLICY org_legal_holds_rls_isolation
+  ON org_legal_holds
+  USING (org_id = current_setting('app.current_org', true))
+  WITH CHECK (org_id = current_setting('app.current_org', true));
+
+ALTER TABLE org_retention_history ENABLE ROW LEVEL SECURITY;
+DROP POLICY IF EXISTS org_retention_history_rls_isolation ON org_retention_history;
+CREATE POLICY org_retention_history_rls_isolation
+  ON org_retention_history
+  USING (org_id = current_setting('app.current_org', true))
+  WITH CHECK (org_id = current_setting('app.current_org', true));
+
+ALTER TABLE org_retention_audit_outbox ENABLE ROW LEVEL SECURITY;
+DROP POLICY IF EXISTS org_retention_audit_outbox_rls_isolation ON org_retention_audit_outbox;
+CREATE POLICY org_retention_audit_outbox_rls_isolation
+  ON org_retention_audit_outbox
+  USING (org_id = current_setting('app.current_org', true))
+  WITH CHECK (org_id = current_setting('app.current_org', true));
