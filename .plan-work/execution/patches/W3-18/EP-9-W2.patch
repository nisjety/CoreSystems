+    }
+    let tool_loop = std::fs::read_to_string(concat!(env!("CARGO_MANIFEST_DIR"), "/src/tool_loop.rs"))
+        .expect("tool_loop.rs is readable");
+    assert!(
+        tool_loop.contains("org_agent_policy::org_allows_paid_providers("),
