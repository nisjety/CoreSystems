+): Promise<{ id: string }> {
+  return requestJson<{ id: string }>(`/api/v1/skills/${encodeURIComponent(id)}`, {
+    method: 'PATCH',
+    body: JSON.stringify(body.settings ? { ...body, settings: { ...body.settings, planMode: true } } : body),
