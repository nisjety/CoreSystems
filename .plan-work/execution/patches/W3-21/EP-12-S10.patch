+            "iss": "auth-core",
+            "exp": 4_102_444_800_i64,
+            "org_id": "org-a",
+            "user_id": "user-a",
+            "zdr": zdr,
+            "scopes": ["session:read"],
+        }))
+        .expect("a user token decodes")
+    }
+
+    fn key_claims() -> Claims {
+        serde_json::from_value(json!({
+            "sub": "apikey:key-1",
+            "iss": "auth-core",
+            "exp": 4_102_444_800_i64,
+            "org_id": "org-a",
+            "zdr": false,
+            "principal_type": "api_key",
+            "key_id": "key-1",
+            "acting_user_id": "user-a",
+            "scopes": ["agent:runs"],
+        }))
+        .expect("an api key token decodes")
