+    expect(previewIsEditable({ ...EDITABLE, rawOnly: true })).toBe(false)
+    expect(previewIsEditable({ ...EDITABLE, kind: 'other' })).toBe(false)
+    expect(previewIsEditable({ ...EDITABLE, editableFields: [] })).toBe(false)
+  })
