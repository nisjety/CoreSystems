+    #[test]
+    fn goal_body_answers_found_inside_data() {
+        let Json(body) = goal_body(ThreadGoalResponse {
+            goal: Some(goal("goal_1", "active")),
+            found: true,
+        });
+        assert_eq!(body["data"]["found"], true);
