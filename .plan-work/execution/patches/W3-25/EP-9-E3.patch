+    );
+    let agent =
+        std::fs::read_to_string(src_path("runtime_loop/agent.rs")).expect("runtime_loop/agent.rs");
+    for needle in [
+        "crate::egress_proxy::run_ceiling(",
+        "zdr,",
+        "waived: ctx.route.is_waived(),",
+    ] {
+        assert!(
+            agent.contains(needle),
