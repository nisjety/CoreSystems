+        fn a_different_ledger_has_a_different_digest() {
+            let one = ledger_with(vec![(ClaimStatus::Supported, vec![1, 2])]);
+            let two = ledger_with(vec![(ClaimStatus::Conflict, vec![1, 2])]);
+            assert_ne!(one.digest(), two.digest());
+        }
+    }
 }
