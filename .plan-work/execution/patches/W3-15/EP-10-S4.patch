+fn descriptor_fingerprint_with(descriptor: &JsonValue, input: &JsonValue) -> Option<String> {
+    let text = |key: &str| descriptor.get(key).and_then(JsonValue::as_str);
+    if descriptor.get("version").and_then(JsonValue::as_u64)
