+-- Safe to run twice (every DROP is IF EXISTS).
+
+BEGIN;
+
+ALTER TABLE approval_continuation_descriptors
+    DROP COLUMN IF EXISTS revised_at,
+    DROP COLUMN IF EXISTS original_action_fingerprint,
+    DROP COLUMN IF EXISTS revision;
