+            let request = request.into_inner();
+            let rows = self.rows.lock().unwrap();
+            let found = rows
+                .iter()
+                .filter(|row| {
+                    row.artifact_id == request.artifact_id
+                        && (request.version == 0 || row.version == request.version)
