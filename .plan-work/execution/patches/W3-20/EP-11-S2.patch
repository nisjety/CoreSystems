+    #[tokio::test]
+    #[ignore = "requires DATABASE_URL to a disposable Postgres with session-core migrations"]
+    async fn list_and_get_follow_the_list_agent_skills_visibility() {
+        let pool = connect().await;
+        let org = new_org();
+        let shared = seed_skill(&pool, &org, "user", OWNER, "accepted", &[SHAREE]).await;
+        write_as(&pool, None, "UPDATE agent_skills SET content = 'v2' WHERE id = $1", &shared).await;
+
+        let request = |reader: &str| pb::ListAgentSkillVersionsRequest {
+            org_id: org.clone(),
+            skill_id: shared.clone(),
+            for_user_id: reader.to_owned(),
+            ..Default::default()
+        };
+        let listed = list_versions(&pool, &user(&org, OWNER), request("")).await.unwrap();
+        assert_eq!(listed.versions.iter().map(|v| v.version).collect::<Vec<_>>(), [2, 1]);
+        assert!(listed.versions[0].content.is_empty(), "a listing omits the text unless asked");
+        assert_eq!(listed.versions[0].name, format!("skill {shared}"));
+        assert!(list_versions(&pool, &user(&org, SHAREE), request("")).await.is_ok());
+
+        let refused = list_versions(&pool, &user(&org, STRANGER), request(OWNER)).await.unwrap_err();
+        assert_eq!(refused.code(), tonic::Code::NotFound, "for_user_id is ignored for a user caller");
+        let service = VerifiedIdentity::service_for_test(&org, &["session:read"], false);
+        assert!(list_versions(&pool, &service, request(SHAREE)).await.is_ok());
+
+        let mut paged = request("");
+        paged.limit = 1;
+        let page = list_versions(&pool, &user(&org, OWNER), paged).await.unwrap();
+        assert_eq!(page.versions.len(), 1);
+        assert!(page.has_more);
+
+        let first = get_as(&pool, &user(&org, OWNER), &org, &shared, 1).await.unwrap();
+        assert_eq!(first.version.unwrap().content, "first text");
+        let newest = get_as(&pool, &user(&org, OWNER), &org, &shared, 0).await.unwrap();
+        assert_eq!(newest.version.unwrap().version, 2);
+        assert!(get_as(&pool, &user(&org, OWNER), &org, &shared, 7).await.unwrap().gone);
+        let hidden = get_as(&pool, &user(&org, STRANGER), &org, &shared, 1).await.unwrap();
+        assert!(hidden.gone, "a skill the reader cannot see reads as gone");
+        let other_org = get_as(&pool, &owner(), &org, &shared, 1).await.unwrap_err();
+        assert_eq!(other_org.code(), tonic::Code::PermissionDenied);
+    }
