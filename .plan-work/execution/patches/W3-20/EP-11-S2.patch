+      { kind: 'same', text: 'c' },
+      { kind: 'added', text: 'd' },
+    ])
+  })
+
+  it('an_unchanged_text_has_no_changes', () => {
+    expect(diffSkillLines('x\ny', 'x\ny').every((line) => line.kind === 'same')).toBe(true)
+  })
+})
