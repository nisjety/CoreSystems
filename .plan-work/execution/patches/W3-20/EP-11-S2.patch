+    scope: 'org',
+    review_state: 'accepted',
+    ...overrides,
+  }
+}
+
+function version(n: number, content: string): SkillVersion {
+  return {
+    version: n,
+    digest: String(n).repeat(64),
+    name: 'Utrulling',
+    description: '',
+    content,
+    trigger_keywords: [],
+    trigger_file_patterns: [],
+    tool_restrictions: [],
+    actor_kind: 'user',
+    actor_id: 'user-1',
+    created_at: '2026-11-04T10:00:00Z',
