+    /// The backfill statements of 0096, run against a row written while the triggers were off
+    /// (as every accepted row was before the migration).
+    #[tokio::test]
+    #[ignore = "requires DATABASE_URL to a disposable Postgres with session-core migrations"]
+    async fn backfill_gives_every_accepted_skill_v1() {
+        let pool = connect().await;
+        let org = new_org();
+        let mut tx = pool.begin().await.unwrap();
+        // Replica mode skips ordinary triggers: the row looks as it did before 0096.
+        sqlx::query("SET LOCAL session_replication_role = replica")
+            .execute(&mut *tx)
+            .await
+            .unwrap();
+        let mut ids = Vec::new();
+        for state in ["accepted", "proposed"] {
+            let id = format!("skill_{}", new_ulid());
+            sqlx::query(
+                "INSERT INTO agent_skills (id, org_id, name, content, review_state, scope, owner_user_id)
+                 VALUES ($1, $2, $1, 'old text', $3, 'user', $4)",
+            )
+            .bind(&id)
+            .bind(&org)
+            .bind(state)
+            .bind(OWNER)
+            .execute(&mut *tx)
+            .await
+            .unwrap();
+            ids.push(id);
+        }
+        tx.commit().await.unwrap();
+        let revisions_before: i64 =
+            sqlx::query_scalar("SELECT COUNT(*) FROM skill_revisions WHERE org_id = $1")
+                .bind(&org)
+                .fetch_one(&pool)
+                .await
+                .unwrap();
+
+        let migration = include_str!("../migrations/0096_agent_skill_versions.sql");
+        let backfill = &migration[migration
+            .find("SELECT set_config('mp.actor_kind', 'system'")
+            .expect("the backfill")..];
+        let mut tx = pool.begin().await.unwrap();
+        for statement in backfill.split(";\n").map(str::trim).filter(|s| !s.is_empty()) {
+            sqlx::query(statement).execute(&mut *tx).await.unwrap();
+        }
+        tx.commit().await.unwrap();
+
+        let accepted = version_rows(&pool, &ids[0]).await;
+        assert_eq!(accepted.len(), 1);
+        assert_eq!(accepted[0].0, 1);
+        assert_eq!((accepted[0].2.as_str(), accepted[0].3.as_str()), ("system", "migration:0096"));
+        assert!(version_rows(&pool, &ids[1]).await.is_empty(), "a proposal gets no version");
+        let revisions_after: i64 =
+            sqlx::query_scalar("SELECT COUNT(*) FROM skill_revisions WHERE org_id = $1")
+                .bind(&org)
+                .fetch_one(&pool)
+                .await
+                .unwrap();
+        assert_eq!(revisions_after, revisions_before, "the backfill writes no revision");
+    }
