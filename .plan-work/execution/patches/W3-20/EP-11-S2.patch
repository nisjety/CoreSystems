+function skill(overrides: Partial<Skill> = {}): Skill {
+  return {
+    id: 'skill-1',
+    org_id: 'org-1',
+    name: 'Utrulling',
+    description: '',
+    content: 'step one\nstep two',
+    trigger_keywords: [],
