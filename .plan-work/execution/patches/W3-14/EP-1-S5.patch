+            Err(BrokerError::Refused)
+        }
+
+        async fn validate_grant(
+            &self,
+            bearer: &str,
+            _grant_id: &str,
+        ) -> Result<ValidateGrantResponse, BrokerError> {
+            self.bearers.lock().unwrap().push(bearer.to_owned());
+            self.answer.clone()
