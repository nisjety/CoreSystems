+-- their audit events already left through session_audit_outbox, so nothing is copied first.
+--
+-- Safe to run twice (every DROP is IF EXISTS).
+
+BEGIN;
+
+DROP TABLE IF EXISTS retention_sweep_runs;
+
+COMMIT;
