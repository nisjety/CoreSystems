+            &owner(&base),
+            ORG,
+            &["https://example.org/"],
+            "fetch_url",
+        )
+        .await
+        .expect("an unreadable host is refused");
+        assert!(refusal.contains("cannot be read"), "{refusal}");
+        let shadow = fetch_refusal(
+            WebDomainPolicyMode::Shadow,
+            &checker,
+            &owner(&base),
+            ORG,
+            &["https://example.org/"],
+            "fetch_url",
+        )
+        .await;
+        assert_eq!(shadow, None, "shadow refuses nothing");
