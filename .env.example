# CoreSystem Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit .env to version control

# =============================================
# Database Configuration
# =============================================
DB_USER=coresystem
DB_PASSWORD=<openssl rand -base64 32>
DB_HOST=coresystem-postgres-local
DB_PORT=5432

# =============================================
# Redis Configuration
# =============================================
REDIS_PASSWORD=redis
REDIS_HOST=coresystem-redis-local
REDIS_PORT=6379

# =============================================
# NATS Configuration
# =============================================
NATS_HOST=coresystem-nats-local
NATS_PORT=4222
NATS_TOKEN=nats

# =============================================
# Security & Authentication
# =============================================
JWT_SECRET=dev-jwt-secret-change-in-production
BETTER_AUTH_SECRET=<openssl rand -base64 32>
INTERNAL_SERVICE_SECRET=dev-service-secret-change-in-production

# =============================================
# Service URLs (External/Public)
# =============================================
# Used by browser/frontend for API calls
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_URL=http://localhost:3011

# Used by services for callbacks/webhooks
APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3011

# =============================================
# AI & ML Configuration
# =============================================
# OpenAI
OPENAI_API_KEY=your-openai-api-key-here

# Azure OpenAI
AZURE_OPENAI_API_KEY_GPT5_MINI=your-azure-openai-key
AZURE_OPENAI_ENDPOINT_GPT5_MINI=https://your-endpoint.openai.azure.com
AZURE_OPENAI_API_VERSION_GPT5_MINI=2025-01-01-preview
AZURE_OPENAI_DEPLOYMENT_GPT5_MINI=gpt-5o-mini

# Azure OpenAI Embeddings
AZURE_OPENAI_API_KEY_EMBEDDING=your-embedding-key
AZURE_OPENAI_ENDPOINT_EMBEDDING=https://your-endpoint.openai.azure.com
AZURE_OPENAI_API_VERSION_EMBEDDING=2024-12-01-preview
AZURE_OPENAI_DEPLOYMENT_EMBEDDING=text-embedding-3-large
AZURE_OPENAI_EMBEDDING_DIMENSIONS=3072

# Cohere Reranking
COHERE_RERANK_ENDPOINT=https://your-cohere-endpoint
COHERE_RERANK_API_KEY=your-cohere-api-key
COHERE_RERANK_MODEL=Cohere-rerank-v4.0-pro
COHERE_RERANK_TOP_N=5

# =============================================
# Vector Database
# =============================================
QDRANT_URL=http://coresystem-qdrant-local:6333
QDRANT_API_KEY=

# =============================================
# Document Intelligence
# =============================================
AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=https://your-di-endpoint.cognitiveservices.azure.com
AZURE_DOCUMENT_INTELLIGENCE_KEY=your-di-key

# =============================================
# OAuth Providers
# =============================================
# Microsoft OAuth
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret
MICROSOFT_TENANT_ID=common

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# =============================================
# Feature Flags
# =============================================
ENABLE_RAG=true
ENABLE_LETTA=true
ENABLE_DUAL_PUBLISH=true
EMAIL_PASSWORD_ENABLED=true
ORGANIZATION_ENABLED=true
SSO_ENABLED=true
ADMIN_ENABLED=true

# =============================================
# Admin Configuration
# =============================================
ADMIN_USER_IDS=WIg7ckmm0qf7SxZCnZRChH5cysE1tjoY
ADMIN_ROLES=admin,superadmin

# =============================================
# Organization Settings
# =============================================
ALLOW_USER_CREATE_ORG=true
ORG_LIMIT_PER_USER=5
ORG_CREATOR_ROLE=owner
ORG_MEMBERSHIP_LIMIT=100
ORG_INVITATION_EXPIRES_IN=172800
ORG_REQUIRE_EMAIL_VERIFICATION=false

# =============================================
# Environment
# =============================================
NODE_ENV=development
ENVIRONMENT=development

# =============================================
# Novu Self-Hosted — Required Secrets
# Generate with: openssl rand -hex 32
# =============================================

# MongoDB credentials (Novu dedicated instance on port 27018)
NOVU_MONGO_USER=novu
NOVU_MONGO_PASSWORD=<openssl rand -hex 24>

# Novu internal Redis password
NOVU_REDIS_PASSWORD=<openssl rand -hex 16>

# JWT signing key for Novu API and WebSocket services
NOVU_JWT_SECRET=<openssl rand -hex 32>

# Provider credential encryption key — MUST be exactly 32 characters
NOVU_STORE_ENCRYPTION_KEY=<exactly-32-chars-hex>

# API key generated in Novu dashboard (Settings → API Keys)
NOVU_SECRET_KEY=<generated-by-novu-dashboard>

# Public URLs reachable by users' browsers (browser-side Inbox component)
NOVU_API_ROOT_URL=http://localhost:3200
NOVU_WS_URL=http://localhost:3202
NOVU_DASHBOARD_URL=http://localhost:4000

# Application base URL — used by event bridge to build notification action links
APP_BASE_URL=http://localhost:3000
